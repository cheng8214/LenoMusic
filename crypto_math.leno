// crypto_math.leno —— RSA 相关的大整数小工具（**单一实现**）
//
// ★ 2026-11-09：这 4 个函数原先在 `qq_crypto.leno` 与 `netease_crypto.leno` 里
//   **各有一份、逐字相同**（评估文档 §4.5.4 点名的重复点：「`powmod/hex2int/int2hex` 两份」）。
//   抽到这里，两边只 import 一次；`padleft` 则直接改用标准库 `strings.pad_start`
//   （那本来就是"左补零"的原语，和之前 `pad2` 是同一类重复）。
//
// ⚠ 关于精度：Leno 的 `int` 是**任意精度**（实测 2^1024 精确、1024 位模幂算得住），
//   所以 `powmod` 的 `result * base` 不会像 int64 那样溢出 —— 这不是靠运气。
import "Crypto" as crypto

// ★ 2026-11-09：`powmod` 已删 —— 标准库新增了 `maths.pow_mod(base, exp, m)`，
//   语义完全相同，而且：
//     · 三个参数都在 int64 内时走原生 int64 快路径（实测快 8–12 倍）
//     · 参数超 int64 时走 bignum 路径（1024 位 RSA 照算，实测与这里原实现一致）
//     · `m <= 0` / `exp < 0` 会**明确抛错**，而原实现是静默返回 1
//   两边调用点已改成 `maths.pow_mod(...)`。

// 十六进制串 → 大整数（借 Crypto.hex_to_bytes ⇒ 别手写字符解析）
export func hex2int(string hex): int {
    Array[int] bytes = crypto.hex_to_bytes(hex)
    int acc = 0
    for bytes to b { acc = acc * 256 + b }
    return acc
}

// 大整数 → 十六进制串（**不含前导 0**；位数不够的地方由 `strings.pad_start` 补）
export func int2hex(int value): string {
    Array[int] raw = []
    int x = value
    while x > 0 {
        raw.add(x % 256)
        x = x / 256
    }
    Array[int] rev = []
    int i = raw.len() - 1
    while i >= 0 {
        rev.add(raw[i])
        i = i - 1
    }
    return crypto.bytes_to_hex(rev)
}
