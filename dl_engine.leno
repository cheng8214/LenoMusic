// dl_engine.leno — 音乐下载器的引擎层（无 UI / 无 print / 无 main）
//
// 分层理由（与 CLI 版 musicdl.leno 的关系：核心逻辑完全共用，只是入口不同）：
//   ① **跨线程只能传纯字符串数组**（struct 实例不能跨线程 ✗，见 cleaner_master 的注释）
//      ⇒ 本模块对外一律用 `Array[string]` 行；SongInfo 只出现在 encode() 内部，不出模块；
//   ② worker 必须是**具名全局函数**（闭包会被 GC ✗）⇒ search_entry / dl_entry 都是全局函数，
//      参数只有字符串数组与 channel；进度一律经 channel 回传，UI 线程用定时器排空。
//
// ⚠ import 必须在**任何使用它的语句之前**（含 const 定义 ✓ 实测踩过）：
//   下面的 `export const int F_ID = srow.F_ID` 写在 import 之前会报
//   「未定义的变量: srow」+「初始化值类型是 any」——模块级初始化按**文本顺序**进行，
//   别名在import 那行才被绑定 ⇒ import 提到文件最前是硬要求，不是风格问题 ✓
//   （同 player.leno 文件头那条约定。）
import strings
import dirs
import files
import "web_net" as net
import "./parsing.leno" as parsing
import "./songrow.leno" as srow
import "./kuwo_core.leno" as kuwo
import "./kuwo_lyric.leno" as lyric
import "./netease_core.leno" as netease
import "./netease_lyric.leno" as netlyric
import "./kugou_core.leno" as kugou
import "./kugou_lyric.leno" as kugoulyric
import "./thirdparty.leno" as thirdparty   // 复用它那份"HEAD / Range 探直链真实体积"（remotelen ✓）
import "./qq_core.leno" as qq
import "./qq_lyric.leno" as qqlyric
import "./yinyueku_core.leno" as yyk
import "./yinyueku_lyric.leno" as yyklyric

use net.(Response, HttpClient)
use kuwo.SongInfo
//
// 歌曲行（SONG_ROW）字段顺序 —— GUI 的表格列、下载任务都按它取值。
//   0 id / 1 歌名 / 2 歌手 / 3 专辑 / 4 时长(秒) / 5 格式 / 6 列表标注大小 / 7 标注字节数
//   8 **音源 id**（"kuwo" / "netease" / "kugou" / "qq"；缺这一项的行一律当 kuwo ⇒ 向后兼容 ✓ 见 srcid()）
//   9 搜索时第三方已取回的直链（空 ⇒ 落盘时现取 ✓ 见 songurl）
//   ⚠ 2026-10-09：下标常量已沉到 `songrow.leno`（唯一事实来源 ✓），这里**原样转发**
//     一份，保住既有的 `eng.F_xxx` 调用 ⇒ GUI / 下载窗口 / player 零改动 ✓
//     为什么值得转发而不是让外面直接 import songrow：调用点已经很多，
//     转发一次换来"不用改 5 个文件"，而字段顺序仍然只有一处能改 ✓
export const int F_ID = srow.F_ID
export const int F_NAME = srow.F_NAME
export const int F_ARTIST = srow.F_ARTIST
export const int F_ALBUM = srow.F_ALBUM
export const int F_DURATION = srow.F_DURATION
export const int F_EXT = srow.F_EXT
export const int F_SIZETEXT = srow.F_SIZETEXT
export const int F_BYTES = srow.F_BYTES
// 音源标记（2026-10-08 加网易源时新增）：取直链与抓歌词都按它分发到对应音源模块 ✓
export const int F_SRC = srow.F_SRC
// 直链（2026-10-08 加第三方聚合接口时新增）：搜索时第三方**已经取回来的直链**，落盘时直接用 ✓
//   为什么必须带在行里：网易那条 flac 通路（qinglvai）对**游客每日只给 3 首**⇒
//   搜索那一次已经吃掉配额，落盘时再取一次必然失败 ✗（实测 42903）
//   · 空串 / 老行没有第 10 项 ⇒ 回落 `directurl(client, src, id)`（向后兼容 ✓）
export const int F_URL = srow.F_URL
//
// 进度消息（channel 里的 Array[string]，固定 5 段；kind 在第 0 段）：
//   ["search", 音源id, 入表条数, 隐藏条数(没有歌曲大小 ⇒ 没入表), ""]
//   ["serror", "",      "",     "",   原因]
//   ["resolve",任务序,  "0",    "0",  ""]        取直链中
//   ["start",  任务序,  "0",    期望字节, 落盘路径]
//   ["progress",任务序, 已下字节, 远端总字节, 落盘路径]
//   ["done",   任务序,  最终字节, 期望字节, 落盘路径]
//   ["fail",   任务序,  "0",    "0",  原因]
//   ["cancelled",任务序,"0",    "0",  ""]
//   ["fatal",  "0",     "0",    "0",  原因]
//   ["lyric",  任务序,  歌词字节, "0",  歌词路径]   ← 歌词已落盘（音频是否成功都会尝试）
//
// 任务标志（flags，纯字符串数组 ⇒ 可跨线程）：
//   "lyric"     = 下音频的同时把同名 .lrc 也下下来
//   "lyriconly" = **只下歌词**（跳过音频），供"我已经有音频了"的用法
// 分片大小：1 MB。太小 ⇒ 请求过多；太大 ⇒ 进度条一跳一大格
const int CHUNK = 1048576
// 单个分片请求的最大重试次数（网络抖动/服务端偶发 5xx）
const int MAXRETRY = 3
// **多首歌并行**的 worker **出厂默认**上限（2026-10-07）：每个 worker 一条 HTTP 连接、
//   各推自己的 1MB 分片。4 路对家用宽带足够；再多只是互相抢带宽，还可能被服务端限流 ✓
//   ⚠ 真正生效的值来自**设置**（dl_settings.leno，可在"设置"窗口里改）—— 这里只是默认值 ✓
//   （写法照 文件搜索 的"多个 worker 各领一批"，见 dl_entry_shard ✓）
export const int DL_DEFAULT_WORKERS = 4

// 本次该开几个 worker：任务数 与 用户设置的上限 取小（任务少就少开 ✓）
//   · `maxworkers` ≤ 0 ⇒ 回落出厂默认（设置没读到/被清空也不会开 0 个线程 ✗）
//   · 主界面用它起线程、下载窗口用它显示"N 个线程并行下" ⇒ 口径只在这一处 ✓
export func dl_workers(int jobcount, int maxworkers): int {
    int maxw = maxworkers
    if maxw < 1 { maxw = DL_DEFAULT_WORKERS }
    if jobcount < 1 { return 1 }
    if jobcount > maxw { return maxw }
    return jobcount
}

// 并行切法（**规范性定义**，只此一处）：第 `shard` 个 worker 是否负责第 `idx` 个任务
//   · `dl_entry_shard` 里用的是**步进**写法（从 shard 起、每次 +nshards）—— 与本法等价且更快；
//     两者的一致性由 test/test_parallel_dl.leno **对拍**（不重不漏 ✓）
//   · 取模（而不是连续切片）：长短任务自动交错均衡，不会出现"某一路全是大家伙" ✗
export func dl_mine(int idx, int shard, int nshards): bool {
    if nshards < 1 { nshards = 1 }
    if idx < 0 { return false }
    return idx % nshards == shard
}

// ==================== 音源注册表 ====================
// 行格式：[id, 显示名, "1"/"0" 是否可用, 说明]
// 移植 musicdl-master 的其它源时：这里加一行 + search_entry 里加一个分支即可（GUI 不用动 ✓）
export func sources(): Array[Array[string]] {
    Array[Array[string]] out = []
    out.add(["kuwo", "酷我", "1", "官方 mobi.s 取链（DES 加密）+ 第三方兜底"])
    out.add(["netease", "网易云", "1", "weapi（AES×2 + RSA）；未登录只有 320k mp3，付费曲无直链"])
    out.add(["kugou", "酷狗", "1", "移动端搜索 + CDN 取链（免签名）；免费曲能给 flac，付费曲无直链"])
    out.add(["qq", "QQ音乐", "1", "官方 musicu.fcg（需设备指纹 QIMEI36）；免费曲能给 flac，付费曲无直链"])
    out.add(["migu", "咪咕", "0", "待移植"])
    out.add(["yinyueku", "音乐库", "1", "聚合站 api.php（免登录免签名）；代价：列表体积要逐首取直链探出来"])
    return out
}

// ==================== 工具（同时给 GUI 用）====================

// 秒 → "4:29"（GUI 与 CLI 口径一致）
export func fmtduration(int secs): string {
    return kuwo.formatduration(secs)
}

// 歌曲行 → 一行摘要（下载对话框里显示用）
//   ⚠ 保持原口径：段数不够一律空串；否则**即使歌手为空也照样留" - "**（不擅自改显示 ✗）
export func songlabel(Array[string] row): string {
    if row.len() <= F_ARTIST { return "" }
    return srow.rowname(row) + " - " + srow.rowartist(row)
}

// 歌曲行 → **消毒基名**（落盘音频与歌词共用的那个名字：sanitizefilename("歌名 - 歌手")）
//   为什么单独暴露它（★ 2026-10-09，移植自二创 LenoMusic-main ✓）：播放队列要拿它去**认领**
//   已经下好的本地文件与同名 .lrc（见 resolve_locals ✓）—— 不能"按搜索行的格式列拼一个确切文件名"
//   ✗，因为落盘扩展名由服务端给的格式定（realext），跟列表里的"格式"列不一定一致 ⇒ 拼名字会漏 ✓
export func base_of(Array[string] row): string {
    if row.len() <= F_ARTIST { return "" }
    return kuwo.sanitizefilename(srow.rowname(row) + " - " + srow.rowartist(row))
}

// 歌曲行 → 期望字节数（列表标注；可能为 0/偏低，仅用于进度分母的初值）
export func songbytes(Array[string] row): int {
    return srow.rowbytes(row)
}

// 行 → 音源 id（老行没有第 8 项 / 空串 ⇒ 当 kuwo ✓ 向后兼容）
export func srcid(Array[string] row): string {
    string s = srow.rowsrc(row)
    if s == "" { return "kuwo" }
    return s
}

// 行 → 搜索时第三方**已经取回来的直链**（没有第 10 项 / 空串 ⇒ "" = 由调用方现取 ✓ 向后兼容）
export func songurl(Array[string] row): string {
    return srow.rowurl(row)
}

// 这一行"有没有歌曲大小"——没有就不进结果表（2026-10-08 用户口径：取到的信息里没有大小 ⇒ 别加进 table）
//   为什么"没有大小"就等于"下不了"：三个音源观测到的口径完全一致 ✓
//     酷我：MINFO 里没有可用档位 ⇒ 格式/体积都空
//     网易：搜索后紧跟的那次批量取直链没给 url ⇒ 体积空（见 netease_core 头部 ④）
//     酷狗：`pay_type*`/`price*`/`*privilege` 判定为付费 ⇒ 体积空（见 kugou_core 头部 ②）
//   ⇒ 过滤只做在**引擎**这一处（GUI 不各写一套），且必须在 songs 落地**之前**做：
//      表格行与 songs 是按下标一一对应的（pickchecked/右键都按行号取 songs[i]）
//      ⇒ 只"隐藏不删"会下错歌 ✗
export func has_size(Array[string] row): bool {
    return srow.rowhas_size(row)
}

// 按音源把客户端的 UA 与**请求头表重置**成该源要的那一套
//   为什么必须 replaceHeaders：`addHeaders` 是追加 ⇒ 多音源共用一个客户端时，
//   网易的 Referer 会与 QQ 的 y.qq.com Referer **叠成两个实现** ✗；而取音频分片用的
//   `Range` 头本身也是整表替换 ⇒ 干脆"每次解析前重置一次"，谁都不污染谁 ✓
export func preparefor(HttpClient client, string src) {
    if src == "netease" {
        client.setUserAgent(netease.useragent())
        client.replaceHeaders(netease.headers())
    } else if src == "kugou" {
        client.setUserAgent(kugou.useragent())
        client.replaceHeaders(kugou.headers())
    } else if src == "qq" {
        client.setUserAgent(qq.useragent())
        client.replaceHeaders(qq.headers())
    } else if src == "yinyueku" {
        client.setUserAgent(yyk.useragent())
        client.replaceHeaders(yyk.headers())
    } else {
        client.setUserAgent(kuwo.useragent())
        client.replaceHeaders(kuwo.headers())
    }
}

// 按音源取直链（空串 = 拿不到）。**唯一**的取直链入口 ⇒ 下载与试听走同一条路 ✓
export func directurl(HttpClient client, string src, string songid): string {
    if src == "netease" { return netease.getdirecturl(client, songid) }
    if src == "kugou" { return kugou.getdirecturl(client, songid) }
    if src == "qq" { return qq.getdirecturl(client, songid) }
    if src == "yinyueku" { return yyk.getdirecturl(client, songid) }
    return kuwo.getdirecturl(client, songid)
}

// SongInfo → 歌曲行（本模块内部使用：struct 不出模块 ✓）
func encode(SongInfo s): Array[string] {
    Array[string] row = []
    row.add(s.id)
    row.add(s.name)
    row.add(s.artist)
    row.add(s.album)
    row.add(_str(s.duration))
    row.add(s.ext)
    row.add(s.sizeText)
    row.add(_str(s.sizeBytes))
    return row
}

// 非阻塞投递（通道满/未建 ⇒ 直接丢，进度丢一帧无所谓 ✓）
func sendmsg(any ch, Array[string] msg) {
    if ch is Channel {
        var c = ch
        c.try_send(msg)
    }
}

// 本地文件字节数（不存在/打不开 ⇒ 0）—— 与 web_net 的 _fileSize 同口径
func fsize(string path): int {
    if not files.exists(path) { return 0 }
    var f = null
    try {
        f = files.open(path, "rb")
    } catch e {
        return 0
    }
    if f == null { return 0 }
    int n = f.len()
    f.close()
    return n
}

// "bytes 0-1048575/26012257" 里的总长；拿不到返回 -1
func totalfromrange(string cr): int {
    if cr == "" { return -1 }
    int slash = strings.find(cr, "/")
    if slash < 0 { return -1 }
    string tail = cr.slice(slash + 1, cr.len()).trim()
    if tail == "" or tail == "*" { return -1 }
    // 全是数字才收，否则-1（响应头里什么脏值都可能有）
    for tail.byte_len() to i {
        var b = tail.byte(i)
        if b is int {
            if b < 48 or b > 57 { return -1 }
        }
    }
    return _int(tail)
}

// ==================== 控制命令（暂停/取消）====================
// 命令通道里只有 "pause" / "resume" / "cancel" 三种字符串。
// 收到 "pause" 就**阻塞等待**下一条命令（所以 UI 线程必须保证：关窗时一定要补发 cancel，
// 否则 worker 会一直挂在 receive 上；反正它只是睡在通道上，不占 CPU，也不会碰任何控件 ✓）
func waitcmd(any cmd): string {
    // ⚠ 必须"直接"在收窄后的变量上调用：`var c = cmd` 拿到的仍是 any ⇒ 编译器报
    //   "不能在 any 类型上调用方法"（实测 ✓）
    if cmd is Channel {
        var m = cmd.try_receive()
        if m == null { return "" }
        string s = _str(m)
        if s != "pause" { return s }
        while true {
            var m2 = cmd.receive()
            if m2 == null { return "cancel" }        // 通道已关 ⇒ 当作取消
            string s2 = _str(m2)
            if s2 == "resume" { return "" }
            if s2 == "cancel" { return "cancel" }
        }
    }
    return ""
}

// ==================== ① 搜索 ====================
// ★ 2026-10-08 拆成"两阶段"，只为**并行**（原先一把梭串行：4 源 10 条实测 ≈ 20~25 s ✗）：
//     阶段 A  `search_source(src, …)`   **一个音源**的官方搜索（1~2 次请求）⇒ 行
//     阶段 B  `probe_rows(rows)`        一批行逐首问第三方聚合接口（无损直链就在这里）
//     收尾    `keep_downloadable(rows)` 没有歌曲大小的行**不入表**（= 拿不到直链 ✓ 见 has_size）
//   ⚠ 过滤必须放在**阶段 B 之后**：付费/原唱曲官方给不出体积（阶段 A 看不到大小），
//     它们正是靠阶段 B 补上直链才可下的 ⇒ 阶段 A 就过滤会把它们全丢掉 ✗
//   ⚠ 行的数量与耗时都由第三方请求主导 ⇒ 阶段 B 按**行**切片并行（见 musicdl_gui 的 probe_worker ✓）
//   ⚠ 每个线程**自己建客户端**：共用会互相覆盖头表（见 preparefor ✓）
//   ⚠ 线程入口必须是**主脚本文件**的函数（语言硬约束，见 threads.c 的前置校验）
//      ⇒ 本模块只提供"能被线程调用的纯函数"，起线程一律在 musicdl_gui.leno ✓

// 阶段 A：**一个音源**的官方搜索。进度消息：["search", src, 命中数, 0, ""] / ["serror", src, …]
//   返回的**不过滤**（没体积的行交给阶段 B 补 ✓）
export func search_source(string src, string keyword, int limit, any ch): Array[Array[string]] {
    Array[Array[string]] rows = []
    HttpClient client = net.createClient()
    if not client.isOk() {
        sendmsg(ch, ["serror", src, "", "", "网络客户端初始化失败"])
        return rows
    }
    client.setUserAgent(kuwo.useragent())
    client.setTimeout(20000)
    client.setSSLVerify(false, false)
    if src == "kuwo" {
        // 网络/解析失败 ⇒ kuwo.search 自己返回空列表（不抛异常）；这里再兜一层 try
        Array[SongInfo] songs = []
        try {
            songs = kuwo.search(client, keyword, limit)
        } catch e {
            // ⚠ 这里原先是 `_str(e)` ⇒ 界面只会显示 `<object>`，等于把真因扔了（见 B4）
            sendmsg(ch, ["serror", src, "", "", errmsg(e)])
        }
        for songs to s {
            rows.add(encode(s))
        }
        sendmsg(ch, ["search", src, _str(songs.len()), "0", ""])
    } else if src == "netease" {
        // 网易：weapi 要 Referer（见 netease_core.prepare）；返回的**已经是行**（自带音源标记）
        //   ⇒ 不必再经 encode ✓。搜索内部已顺带批量补齐体积与"能不能下" ✓
        preparefor(client, "netease")
        Array[Array[string]] nrows = []
        try {
            nrows = netease.searchrows(client, keyword, limit)
        } catch e {
            sendmsg(ch, ["serror", src, "", "", errmsg(e)])
        }
        for nrows to r {
            rows.add(r)
        }
        sendmsg(ch, ["search", src, _str(nrows.len()), "0", ""])
    } else if src == "kugou" {
        // 酷狗：移动端搜索（免签名）⇒ 三档体积与付费标记搜索时就带回来了，不额外发请求 ✓
        preparefor(client, "kugou")
        Array[Array[string]] krows = []
        try {
            krows = kugou.searchrows(client, keyword, limit)
        } catch e {
            sendmsg(ch, ["serror", src, "", "", errmsg(e)])
        }
        for krows to r {
            rows.add(r)
        }
        sendmsg(ch, ["search", src, _str(krows.len()), "0", ""])
    } else if src == "qq" {
        // QQ：搜索响应自带各档体积与付费标记 ⇒ 不额外发请求；
        //   搜索内部带**空结果重试**（公开兜底 q36 偶发空 ⇒ 见 qq_core 头部 ②）
        preparefor(client, "qq")
        Array[Array[string]] qrows = []
        try {
            qrows = qq.searchrows(client, keyword, limit)
        } catch e {
            sendmsg(ch, ["serror", src, "", "", errmsg(e)])
        }
        for qrows to r {
            rows.add(r)
        }
        sendmsg(ch, ["search", src, _str(qrows.len()), "0", ""])
    } else if src == "yinyueku" {
        // 音乐库：聚合站 api.php（免登录免签名）⇒ 搜索响应**不给体积/档位**，
        //   格式与大小靠阶段 B 逐首取直链 + HEAD 探出来（见 yinyueku_core 头部 ① ✓）
        preparefor(client, "yinyueku")
        Array[Array[string]] yrows = []
        try {
            yrows = yyk.searchrows(client, keyword, limit)
        } catch e {
            sendmsg(ch, ["serror", src, "", "", errmsg(e)])
        }
        for yrows to r {
            rows.add(r)
        }
        sendmsg(ch, ["search", src, _str(yrows.len()), "0", ""])
    }
    client.close()
    return rows
}

// 阶段 B：把这一批行**逐首**补第三方聚合直链（原地改 ext/体积/直链 ⇒ 返回值就是同一批行 ✓）
//   各源的口径由各自的 `proberow` 定（网易/QQ 每行都试、酷狗只试"三档都不可下"的行 ✓）
//   酷我行是空过（第 8 项当 kuwo ⇒ 没有第三方通路，直接跳过 ⇒ 不发任何请求 ✓）
export func probe_rows(Array[Array[string]] rows): Array[Array[string]] {
    if rows.len() == 0 { return rows }
    HttpClient client = net.createClient()
    if not client.isOk() { return rows }        // 建不出来 ⇒ 原样返回（保持官方结果 ✓）
    client.setTimeout(20000)
    client.setSSLVerify(false, false)
    string cur = ""
    int i = 0
    while i < rows.len() {
        Array[string] row = rows[i]
        string src = srcid(row)
        // 同一片里的行往往同源 ⇒ 只在**换源**时重置头表（重置是整表替换，不必每行都来一遍 ✓）
        if src != cur {
            if src == "netease" or src == "qq" or src == "kugou" or src == "yinyueku" {
                preparefor(client, src)
                cur = src
            } else {
                cur = ""
            }
        }
        if src == "netease" {
            netease.proberow(client, row)
        } else if src == "qq" {
            qq.proberow(client, row)
        } else if src == "kugou" {
            kugou.proberow(client, row)
        } else if src == "yinyueku" {
            yyk.proberow(client, row)
        }
        i = i + 1
    }
    client.close()
    return rows
}

// ★ 2026-10-09 新增：给"官方接口没给体积"的行补上 格式 / 体积 / 直链 —— **榜单页专用**
//   （搜索页不必用它：那边阶段 B 的 `probe_rows` 已经把能补的都补了 ✓）
//   为什么需要：榜单接口**确实不给体积**（2026-10-09 实测：酷我 kbangserver 的 musiclist 只有
//   `id/name/artist/album/formats/duration/param…`；官方取直链的 `mobi.s` 也只回 `format/bitrate/url`）
//   ⇒ 榜单的「大小」列天然为空 ✗。而光调 `probe_rows` 补不上，有两条断点：
//     ① 榜单路径压根没跑过阶段 B；
//     ② 即使跑，`probe_rows` 对**酷我是空过**（没有第三方聚合通路 ✓ 见它的注释）—— 而榜单第一项就是酷我 ✗
//   做法（逐行两段）：
//     ① 有第三方通路的源先跑 `proberow`（网易/QQ/酷狗，与搜索**同口径** ✓）
//     ② 仍没有体积 ⇒ 取**官方直链**（`directurl` = 唯一的取直链入口 ✓）再 `HEAD` 探一次真实字节数
//        （CDN 不支持 HEAD 时会自动退到 `Range: bytes=0-0` ✓ 见 thirdparty.remotelen ✓）
//   顺带把直链写回 F_URL ⇒ 之后下载 / 试听不必再解析一次 ✓（与"搜索时已取回的直链"同一用法 ✓）
//   ⚠ 拿不到就**原样留着**（榜单不做 has_size 过滤 ⇒ 空着也不挡"能下"，下载时按 Range 头算真总量 ✓）
//   ⚠ 每行 2~4 个请求 ⇒ 必须**并行调**（GUI 按行切片起线程 ✓ 见 musicdl_gui.startBangFill ✓）
export func fill_sizes(Array[Array[string]] rows): Array[Array[string]] {
    if rows.len() == 0 { return rows }
    HttpClient client = net.createClient()
    if not client.isOk() { return rows }        // 建不出来 ⇒ 原样返回（保持现状 ✓）
    client.setTimeout(20000)
    client.setSSLVerify(false, false)
    string cur = ""
    int i = 0
    while i < rows.len() {
        Array[string] row = rows[i]
        i = i + 1
        if has_size(row) { continue }           // 已经有体积（少数行自带 / 前面已补过）⇒ 不动 ✓
        string src = srcid(row)
        if src != cur { preparefor(client, src); cur = src }   // 换源 ⇒ UA/头表重置（同阶段 B ✓）
        row = padrow(row, src)                  // ★ 先补段（见 padrow 的注释：越界赋值会抛 ✗）
        // ① 第三方聚合（三个源各有通路；酷我在这里是空过 ✓）
        //   ★ 音乐库不找"第三方"：它**自己**就是聚合站 ⇒ 拿它自己的取链接口补（同形状 ✓）
        if src == "netease" {
            netease.proberow(client, row)
        } else if src == "qq" {
            qq.proberow(client, row)
        } else if src == "kugou" {
            kugou.proberow(client, row)
        } else if src == "yinyueku" {
            yyk.proberow(client, row)
        }
        if has_size(row) { continue }
        // ② 官方直链 + 探真实体积（酷我只能走这条 ✓；另三源第三方没给也再试一次 ✓）
        string link = directurl(client, src, srow.rowid(row))
        if link == "" { continue }
        row[srow.F_URL] = link
        if srow.rowext(row) == "" {             // ext 只在为空时回填（有的源已按 formats 标好 ✓）
            string ext = kuwo.extfromurl(link)
            if ext != "" { row[srow.F_EXT] = ext }
        }
        int n = thirdparty.remotelen(client, link)
        if n > 0 {
            row[srow.F_BYTES] = _str(n)
            // 用**行契约里那份** formatter（"10.32 MB"，与三个 core 的显示口径一致 ✓）
            // —— 别用 `strings.fmt_size`：那是"KB/MB 取整、不保留小数"的通用版，列表里会与搜索页不一致 ✗
            row[srow.F_SIZETEXT] = srow.fmtsize(n)
        }
    }
    client.close()
    return rows
}

// 把行补成"10 段齐全"（缺哪补哪；已有值不动 ✓）
//   ⚠ 为什么必须补：**酷我的行只有 8 段**（走的是 `encode(SongInfo)`；网易/QQ/酷狗是各自 core
//     直接拼的 10 段行 ✓），而 Leno 的 `row[i] = v` **不会自动扩容** —— 越界直接抛
//     「数组索引越界: 索引 9, 长度 8」✗（2026-10-09 实测踩到）。
//   第 8 段写成**该行真实的音源**（不是空串）⇒ 行从此自带来源，与另三源的行走同一套 ✓
//   （只写"空"的行等价于 kuwo ✓ 见 srcid 的默认口径；空着不写会一直靠默认值兜 ✓）
func padrow(Array[string] row, string src): Array[string] {
    while row.len() <= srow.F_URL { row.add("") }
    if srow.rowsrc(row) == "" { row[srow.F_SRC] = src }
    return row
}

// 把行切成 k 份**轮转片**（第 j 份拿 j、j+k、j+2k…）⇒ 交给 k 条线程并行探测 ✓
//   ★ 必须轮转、**不能切连续片** ✗：行是"按音源分段"的，而各源每行耗时差 3~5 倍
//     （酷我 0 ms / 网易 ≈ 1 s，见 A8）⇒ 连续片会让某条线程独占全部网易行、其余线程闲着
//     （实测：连续片 8.06 s，轮转片 6.5 s，k=8 ✓）
//   ★ 不重不漏是**硬要求**（丢一首＝少一首歌，重一首＝表格与 songs 下标错位 ✗✗）
//     ⇒ 放在引擎里当纯函数，离线回归能直接压它（见 test/test_parallel_dl.leno ✓）
export func slice_rows(Array[Array[string]] rows, int k): Array[Array[Array[string]]] {
    Array[Array[Array[string]]] parts = []
    int total = rows.len()
    if k < 1 { k = 1 }
    if k > total { k = total }
    int j = 0
    while j < k {
        Array[Array[string]] part = []
        int t = j
        while t < total {
            part.add(rows[t])
            t = t + k
        }
        parts.add(part)
        j = j + 1
    }
    return parts
}

// 收尾：没有歌曲大小的行**不入表**（= 拿不到直链 ✓ 见 has_size 的注释）
export func keep_downloadable(Array[Array[string]] rows): Array[Array[string]] {
    Array[Array[string]] out = []
    for rows to r {
        if has_size(r) {
            out.add(r)
        }
    }
    return out
}

// ★ 串行版"一把梭"（A → B → 过滤）。**GUI 不走这里**（它自己并行跑两阶段 ✓）；
//   留着是给脚本 / 无界面自检 / 回归测试一个现成入口（CLI 与 GUI 的口径因此只有一份 ✓）
export func search_entry(Array[string] srcids, string keyword, int limit, any ch): Array[Array[string]] {
    Array[Array[string]] rows = []
    for srcids to src {
        Array[Array[string]] one = search_source(src, keyword, limit, ch)
        for one to r {
            rows.add(r)
        }
    }
    probe_rows(rows)
    return keep_downloadable(rows)
}

// ==================== ② 分片下载 ====================
// 为什么不用 web_net 的 downloadResume：它内部 NOPROGRESS=1 ⇒ **拿不到任何字节进度**，
//   进度条只能"跳 0 → 100"。这里改成自己发 `Range: bytes=a-b`，每片 1MB 一报告，
//   顺带白拿了断点续传（起始偏移 = 本地已有字节数）✓
//
// 返回落盘字节数；>0 = 成功，-2 = 被取消，其余(-1) = 失败。
// 进度经 ch 上报，控制命令经 cmd 收。
// ⚠ 导出是给**无 GUI 的并行测试**直接调用的（test/test_parallel_dl.leno：把"直链"指向本机
//   服务端 ⇒ 离线就能压 N 线程并行、共用通道按 idx 归位、取消广播）；产品路径仍只走 dl_entry_shard ✓
// ==================== ①.5 （原"试听：只拉前一段"已退役 ✓ 2026-10-09）====================
// 为什么删：那一套是"先拉 1~2MB 到临时文件立刻出声 + 后台静默下整首、下完切过去"，
//   现在被"**播整表 + 边下边播**"取代（播放器直接播那个正在长大的最终文件 ⇒ 更简单、也更快 ✓）
//   ⇒ `dl_preview` / `dl_preview_url` 连同 `preview_worker` 一起删掉 ✓
//   ⚠ 唯一值得留的知识点：**下载是顺序追加写、文件前缀自洽**，所以"半截文件也能播"——
//     这正是边下边播能成立的前提（见 dl_one 那边每一片的追加写 ✓）

export func dl_one(HttpClient client, string link, string outpath, any ch, int jobIdx, any cmd): int {
    int got = fsize(outpath)          // 本地已有的部分 ⇒ 从这里续传
    int total = -1                    // 远端真实总长（来自 Content-Range），未知 = -1
    int retries = 0
    while true {
        if waitcmd(cmd) == "cancel" { return -2 }
        int end = got + CHUNK - 1
        client.replaceHeaders(["Range: bytes=" + _str(got) + "-" + _str(end)])
        Response r = client.get(link)
        if r.statusCode == 200 {
            // 服务端忽略 Range ⇒ 整体覆盖写（一次性，粒度就到不了更细了 —— 但结果正确 ✓）
            files.write(outpath, r.rawBody())
            int n = fsize(outpath)
            sendmsg(ch, ["progress", _str(jobIdx), _str(n), _str(n), outpath])
            return n
        }
        if r.statusCode == 416 {
            // Range 不可满足 ⇒ 本地文件已不低于远端长度 ⇒ 视为已完成（也覆盖"上次下完了"）
            if got > 0 { return got }
            retries = retries + 1
            if retries > 1 { return -1 }
            continue
        }
        if r.statusCode != 206 {
            // 网络抖动 / 5xx / 被限流：重试几次再放弃
            retries = retries + 1
            if retries > MAXRETRY { return -1 }
            continue
        }
        string raw = r.rawBody()
        int blen = raw.byte_len()
        if blen == 0 {
            // 再要也没有了 ⇒ 到底（总长未知时这是唯一的结束判据）
            if got > 0 { return got }
            return -1
        }
        if got == 0 {
            files.write(outpath, raw)
        } else {
            var f = files.open(outpath, "ab")
            f.write(raw)
            f.close()
        }
        got = fsize(outpath)
        int t = totalfromrange(r.getHeader("content-range"))
        if t > 0 { total = t }
        sendmsg(ch, ["progress", _str(jobIdx), _str(got), _str(total), outpath])
        retries = 0
        if total > 0 {
            if got >= total { return got }
            if blen < CHUNK {
                // 已知总长却没下满，还提前截断 ⇒ 是断流，重试
                retries = retries + 1
                if retries > MAXRETRY { return -1 }
                continue
            }
        } else {
            // 总长未知：短包即结束
            if blen < CHUNK { return got }
        }
    }
}

// ==================== ③ 下载 worker（**多首歌并行**）====================
// jobs = 歌曲行数组；返回 **[本 worker 那一份]** 的 [成功数, 失败数, 歌词数]（字符串，跨线程回传免收窄 ✓）
// flags 见文件头"任务标志"
//
// 并行口径（2026-10-07，写法照 文件搜索 的"多个 worker 各领一批" ✓）：
//   · `nshards` 个 worker 同时跑，第 `shard` 个只处理下标满足 `i % nshards == shard` 的任务
//     —— 用**取模**而不是连续切片：长短任务自动交错均衡，不会出现"某一路全是大家伙" ✗
//   · 所有 worker **共用一个 ch**：消息第 1 段始终是**全量下标** ⇒ UI 侧按 idx 归位即可 ✓
//   · 暂停/取消得**每个 worker 一条 cmd 通道**（一条被某个 worker 取走，别的就永远收不到 ✗）
//   · 每个 worker 自带 HttpClient（net 的客户端不是线程安全的 ✓）；解析走 jsons（无模块全局 ✓）、
//     DES 表是只读查找表 ✓ ⇒ 并行不踩共享状态（LenoWeb 有"8 线程并发 HTTP"的现成回归 ✓）
export func dl_entry_shard(Array[Array[string]] jobs, string outdir, any ch, any cmd, Array[string] flags, int shard, int nshards): Array[string] {
    if nshards < 1 { nshards = 1 }
    if shard < 0 { shard = 0 }
    int ok = 0
    int fail = 0
    int lrcok = 0
    // 本 worker 那一份的任务数：出错提前返回时报它（报总任务数会把失败数放大 N 倍 ✗）
    int mine = (jobs.len() - shard + nshards - 1) / nshards
    if mine < 0 { mine = 0 }
    bool wantlyric = hasflag(flags, "lyric") or hasflag(flags, "lyriconly")
    bool lyriconly = hasflag(flags, "lyriconly")
    // 目录必须先建：write 到不存在的目录会抛异常（docs/移植音乐下载器实录与待办.md B2 同款坑）
    if not dirs.exists(outdir) {
        try {
            dirs.mkdir_p(outdir)
        } catch e {
            sendmsg(ch, ["fatal", "0", "0", "0", "无法创建目录：" + outdir])
            return ["0", _str(mine), "0"]
        }
    }
    HttpClient client = net.createClient()
    if not client.isOk() {
        sendmsg(ch, ["fatal", "0", "0", "0", "网络客户端初始化失败"])
        return ["0", _str(mine), "0"]
    }
    client.setUserAgent(kuwo.useragent())
    // 请求头**每首歌解析前会按音源重置**（见 preparefor）⇒ 这里只做初值 ✓
    preparefor(client, "kuwo")
    client.setTimeout(30000)
    client.setSSLVerify(false, false)
    int i = shard
    while i < jobs.len() {
        if waitcmd(cmd) == "cancel" {
            sendmsg(ch, ["cancelled", _str(i), "0", "0", ""])
            break
        }
        Array[string] job = jobs[i]
        // 音频与歌词共用同一个基名：<歌名> - <歌手>（歌词固定 .lrc，与音频扩展名无关 ✓）
        //   ⚠ 保持原口径：歌手为空也照样留" - "（与player 拆文件名的口径一致，见 player 头注✓）
        string base = kuwo.sanitizefilename(srow.rowname(job) + " - " + srow.rowartist(job))
        string lrcout = outdir + _sep() + base + ".lrc"

        if lyriconly {
            // 只下歌词：跳过取直链与音频，直接抓 .lrc
            sendmsg(ch, ["start", _str(i), "0", "0", lrcout])
            int lb = savelyricsafe(job, lrcout, srcid(job))
            if lb > 0 {
                ok = ok + 1
                lrcok = lrcok + 1
                // 先 done 再 lyric：UI 侧 lyric 会把状态补成"完成 xxx +歌词"（顺序反了就被覆盖 ✓）
                sendmsg(ch, ["done", _str(i), _str(lb), "0", lrcout])
                sendmsg(ch, ["lyric", _str(i), _str(lb), "0", lrcout])
            } else {
                fail = fail + 1
                sendmsg(ch, ["fail", _str(i), "0", "0", "这首没有歌词"])
            }
            i = i + nshards          // 下一首仍归本 worker（取模分片 ⇒ 步子就是 nshards ✓）
            continue
        }

        sendmsg(ch, ["resolve", _str(i), "0", "0", ""])
        // ★ 每首歌按**自己的音源**重置 UA 与头表：上一首取分片时写进去的 Range 头/别家 Referer
        //   不会污染这一首（Range 头是整表替换的写法 ⇒ 必须重置 ✓ 见 preparefor 注释）
        preparefor(client, srcid(job))
        // ★ 搜索时第三方**已经把直链取回来了**（下标 9）⇒ 优先用它：网易那条通路对游客
        //   每日只给 3 首、配额在搜索时就用掉了 ⇒ 这里再取一次必然失败 ✗（见 F_URL 注释 ✓）
        string link = songurl(job)
        if link == "" {
            try {
                link = directurl(client, srcid(job), srow.rowid(job))
            } catch e {
                link = ""
            }
        }
        if link == "" {
            fail = fail + 1
            sendmsg(ch, ["fail", _str(i), "0", "0", "取直链失败"])
        } else {
            // 落盘名用**直链后缀**校正过的扩展名（比列表里宣传的档位可信，见 kuwo_core 注释）
            string realext = kuwo.extfromurl(link)
            if realext == "" { realext = srow.rowext(job) }
            if realext == "" { realext = "flac" }
            string finalpath = outdir + _sep() + base + "." + realext
            // ★ 2026-10-09（对齐二创 LenoMusic-main 的想法）：**没下完的先带 `@` 前缀**，下完才改名 ✓
            //   为什么要它：半截文件若就叫最终名 ⇒ ① 别的播放器 / 资源管理器双击会误播它 ✗
            //     ② 我们的 `resolve_locals` 会把它当"本地已有"⇒ 双击这首会**直接播半截**、
            //        而且**不会**触发边下边播 ✗✗（这正是群友指出的那个坑 ✓）
            //   ⇒ 一切"算不算已下载"的判定都**排掉 `@` 开头的**（见 find_local / resolve_locals /
            //     player.is_audio 三处 ✓）—— 三处口径必须一致 ✓
            //   ⚠ 老文件兼容：只有**最终名**存在（旧版本下的）⇒ 仍按它续传（不把老下载判成"没下过" ✓）
            string outpath = outdir + _sep() + "@" + base + "." + realext
            if fsize(outpath) <= 0 and fsize(finalpath) > 0 { outpath = finalpath }
            sendmsg(ch, ["start", _str(i), "0", srow.rowbytes_text(job), outpath])
            int got = -1
            try {
                got = dl_one(client, link, outpath, ch, i, cmd)
            } catch e {
                got = -1
            }
            if got > 0 {
                // ★ 下完 ⇒ 把 `@` 去掉（改名失败就**保留 `@` 名**并如实回传路径 ✓ 不硬来 ✗）
                string realpath = outpath
                if outpath != finalpath {
                    try {
                        if files.exists(finalpath) { files.delete(finalpath) }
                        dirs.rename(outpath, finalpath)
                        realpath = finalpath
                    } catch e {
                        realpath = outpath              // 被占用 / 权限 ⇒ 留着 `@` 名（下次还能续 ✓）
                    }
                }
                ok = ok + 1
                sendmsg(ch, ["done", _str(i), _str(got), srow.rowbytes_text(job), realpath])
            } else if got == -2 {
                // 被取消：不算失败（半截文件留着，下次重下会自动从断点续传 ✓）
                sendmsg(ch, ["cancelled", _str(i), "0", "0", ""])
                break
            } else {
                fail = fail + 1
                sendmsg(ch, ["fail", _str(i), "0", "0", "下载失败（网络中断或直链失效）"])
            }
        }
        // 歌词与音频成败**无关**：直链失效时歌词往往还拿得到，用户反而更需要它 ✓
        if wantlyric {
            int lb = savelyricsafe(job, lrcout, srcid(job))
            if lb > 0 {
                lrcok = lrcok + 1
                sendmsg(ch, ["lyric", _str(i), _str(lb), "0", lrcout])
            }
        }
        i = i + nshards              // 取模分片：下一首 = i + nshards ✓
    }
    client.close()
    return [_str(ok), _str(fail), _str(lrcok)]
}

// 单 worker 版 = 1 份的第 0 份 ⇒ **CLI 版（musicdl.leno）与单任务原样不动** ✓
export func dl_entry(Array[Array[string]] jobs, string outdir, any ch, any cmd, Array[string] flags): Array[string] {
    return dl_entry_shard(jobs, outdir, ch, cmd, flags, 0, 1)
}

// 歌词抓取包一层 try：worker 线程**绝不能进 error 态**（否则 join 抛异常、UI 侧收尾逻辑全乱）
// src 分发：**酷狗要整行**（命中歌词需要歌名与时长），另两个源只要 id ✓
func savelyricsafe(Array[string] job, string lrcout, string src): int {
    int n = 0
    try {
        if src == "kugou" {
            n = kugoulyric.savelyric_by(job, lrcout)
        } else if src == "netease" {
            n = netlyric.savelyric(job[0], lrcout)
        } else if src == "qq" {
            n = qqlyric.savelyric(job[0], lrcout)
        } else if src == "yinyueku" {
            n = yyklyric.savelyric(job[0], lrcout)
        } else {
            n = lyric.savelyric(job[0], lrcout)
        }
    } catch e {
        n = 0
    }
    return n
}

// flags 里有没有某项（纯字符串数组 ⇒ 跨线程安全 ✓）
func hasflag(Array[string] flags, string name): bool {
    for flags to f {
        if f == name { return true }
    }
    return false
}

// 异常 → **一行**可读文案（UI 状态栏 / 日志 / channel 回传都用它）
//
// ⚠ 千万别用 `_str(e)`：那个写法给的是 `<object>`，异常信息**全部丢失**（实测，见 docs 的 B4）。
//   异常对象实测带 `msg` / `line` / `file` / `stack` 四个字段，可读的写法有三种：
//     ① `print(e)`            —— 打印成 {msg: …, line: …, file: …, stack: […]} 形态
//     ② 插值 `$"{e}"`         —— 就是 msg 全文（**多行**：首行是原因，后面是 [位置] 与 [调用栈]）
//     ③ 直接取字段 `e.line` / `e.file`
//   这里取②的**首行**：塞进状态栏一行最合适；要看位置/栈，用 `print(e)` 或取 `e.msg`。
// 本地有没有这一首（找到 ⇒ 完整路径；没有 ⇒ ""）—— 给界面的"定位 / 删除"用 ✓
//   ⚠ 为什么不"按搜索行的格式列拼一个确切文件名" ✗：落盘的扩展名由**服务端给的格式**定
//     （`realext` ✓ 见 dl_entry_shard 里那段），跟搜索行里的"格式"列**不一定一致** ⇒ 拼名字会漏 ✗
//   ⇒ 按"<歌名> - <歌手>.*"扫目录前缀匹配 ✓（顺手排掉 .lrc ✓ 那是歌词不是音频 ✓）
export func find_local(Array[string] job, string outdir): string {
    if job.len() <= F_ARTIST { return "" }
    if not dirs.exists(outdir) { return "" }
    string base = kuwo.sanitizefilename(job[F_NAME] + " - " + job[F_ARTIST])
    if base == "" { return "" }
    var names = dirs.listdir(outdir)
    for names to nm {
        string s = _str(nm)
        if s.slice(0, 0) == "@" { continue }     // ★ `@` = 还没下完的半截文件 ⇒ **不算"已有"** ✓（见落盘处）
        if s.len() > base.len() + 1 {
            if s.take(0, base.len()) == base {
                if s.slice(s.len() - 4, s.len()) != ".lrc" {
                    string full = dirs.join(outdir, s)
                    if files.exists(full) { return full }
                }
            }
        }
    }
    return ""
}

// 一次列目录，把**每一行**"本地是否已有这一首"解析出来（有 ⇒ 完整路径；没有 ⇒ ""）
//   ★ 2026-10-09（移植自二创 LenoMusic-main ✓）：播放队列来源改成"当前界面那张表"之后，
//     入队时要给每行标出"要不要边下边播" ⇒ 几十上百行逐行调 find_local 会退化成
//     O(行数 × 目录项数) ✗ ⇒ 这里**只扫一次目录**，再拿每行的消毒基名去前缀匹配 ✓
//   ⚠ 判据与 find_local **逐字一致**：`<基名>` 前缀 + 非 .lrc + 文件真的在 ⇒ 才算
//     —— 这样"播放队列认为本地有没有"与"右键定位/删除认为有没有"永远同口径 ✓
export func resolve_locals(Array[Array[string]] rows, string outdir): Array[string] {
    Array[string] out = []
    Array[string] names = []
    if dirs.exists(outdir) {
        var ls = dirs.listdir(outdir)
        for ls to nm {
            string s = _str(nm)
            if s.slice(0, 0) == "@" { continue }   // ★ `@` = 还没下完 ⇒ 不算"本地已有"（否则双击会播半截 ✗）
            if s.len() > 4 and s.slice(s.len() - 4, s.len()) != ".lrc" { names.add(s) }
        }
    }
    int i = 0
    while i < rows.len() {
        string base = base_of(rows[i])
        string hit = ""
        if base != "" {
            int k = 0
            while k < names.len() {
                string s = names[k]
                if s.len() > base.len() + 1 and s.take(0, base.len()) == base {
                    string full = dirs.join(outdir, s)
                    if files.exists(full) {
                        hit = full
                        k = names.len()        // 命中即收手 ✓
                    }
                }
                k = k + 1
            }
        }
        out.add(hit)
        i = i + 1
    }
    return out
}

export func errmsg(any e): string {
    string t = $"{e}"
    if t == "" { return "未知错误" }
    Array[string] lines = t.split("\n")
    if lines.len() > 0 {
        string head = lines[0].trim()
        if head != "" { return head }
    }
    return t.trim()
}

// ==================== ①.6 榜单（各音源自己的排行榜）====================
// 来源：本段移植自二创（LenoMusic-main(1) 的 dl_engine.leno，2026-10-09 ✓）
// 用途：GUI 的「榜单」页 —— 选音源 ⇒ 选该音源的榜单 ⇒ 取榜单歌曲行（与搜索行同构 ✓）
//   · 菜单：kuwo / qq 内置常量（免网络 ✓）；netease / kugou 现拉一次列表接口
//   · 歌曲：按 src 分派到各 core（kuwo 走 kbangserver，其余走各自榜单接口 ✓）
//   ⚠ 榜单行**不做 has_size 过滤**：榜单接口多数不给体积（sizeText 空）⇒ 照 keep_downloadable
//     的口径会被全部丢掉 ✗ ⇒ 榜单路径直接返回这些行（下载时再按 Range 头算真总量 ✓）
//   ★ 2026-10-09：这些"没体积"的行由 GUI 拿到后**逐首补**（`fill_sizes` ⇒ 格式/体积/直链 ✓）
//     ⇒ 界面上「大小」列不再长期空着 ✓；补不到的行照样留着（榜单不按体积过滤 ✓）
export func bang_menu(string src): Array[Array[string]] {
    if src == "netease" { return netease.toplistmenu() }
    if src == "kugou" { return kugou.toplistmenu() }
    if src == "qq" { return qq.toplistmenu() }
    return kuwo.bangmenu()
}

// 取一个榜单的歌曲行（行结构与搜索行同构 ⇒ GUI 表格 / 下载窗口 / 下载 worker 全都能直接用 ✓）
//   失败（建不出客户端 / 网络挂 / 解析空）⇒ 返回空数组，调用方按"没取到"处理 ✓
//   ⚠ 本函数**不起线程**（语言硬约束：线程入口必须与调用方同文件 ✓）⇒ 由 GUI 在自己的 worker 里调 ✓
//   ⚠ kuwo 分支出SongInfo（struct）⇒ 在这里 encode 成行（**struct 不能跨线程** ✓ 语言硬约束）
export func bang_rows(string src, string bid, int limit): Array[Array[string]] {
    Array[Array[string]] rows = []
    if bid == "" { return rows }
    HttpClient client = net.createClient()
    if not client.isOk() { return rows }
    client.setTimeout(20000)
    client.setSSLVerify(false, false)
    if src == "netease" {
        preparefor(client, "netease")
        try { rows = netease.bangrows(client, bid, limit) } catch e { rows = [] }
    } else if src == "kugou" {
        preparefor(client, "kugou")
        try { rows = kugou.bangrows(client, bid, limit) } catch e { rows = [] }
    } else if src == "qq" {
        preparefor(client, "qq")
        try { rows = qq.bangrows(client, bid, limit) } catch e { rows = [] }
    } else {
        preparefor(client, "kuwo")
        Array[SongInfo] songs = []
        try { songs = kuwo.bang(client, bid, limit) } catch e { songs = [] }
        for songs to s { rows.add(encode(s)) }
    }
    client.close()
    return rows
}
