// musicdl_gui.leno — 音乐下载器（GUI 版）
//
// 与 CLI 版（musicdl.leno）共用同一套"引擎"：网络/取直链/落盘在 dl_engine.leno
//   · dl_engine 复用 kuwo_core.leno（CLI 同款）+ kuwo_des.leno（官方接口 DES 加密）
//   · 本文件只管界面与交互；跨线程的数据一律是**纯字符串数组**（见 dl_engine 头部约定）
//
// 分层（2026-10-07 把下载窗口拧出 ⇒ 三个文件各管一层 ✓；★ 2026-10-11 再把两个**页面**拧出 ✓）
//   dl_engine.leno    ← 纯逻辑：网络 / 取直链 / 落盘 / 行格式（不 import SDL3 ⇒ 可单测 ✓）
//   dl_window.leno    ← 下载窗口：对话框 + 任务表 + 总进度 + 开始/暂停/取消/打开目录 ✓
//   search_page.leno  ← 搜索页：搜索行 / 音源勾选 / 操作行 / 结果表 / 状态行 + 两阶段并行搜索 ✓
//   bang_page.leno    ← 榜单页：站点·榜单下拉 / 榜单表 + 逐首补格式·大小 + 「只看有大小」✓
//   musicdl_gui.leno  ← **本文件**：窗口/页签骨架 + "要下哪些歌"的判定 + 起线程 + 两个页的接线
//     （当时本文件 2997 行、单个 struct 72 个方法 ⇒ 太厚 ✗；拆完约 2100 行，且两个页各自能单独读 ✓）
//
// 界面结构
//   Window
//   ├── TitleBar（自绘标题栏）
//   └── VBox root
//       ├── HBox 搜索行：关键词 Edit（回车即搜） + 搜索按钮 + 每源条数 SpinBox
//       ├── HBox 音源行：音源复选框（可勾选，来自 dl_engine.sources()） + 输出目录 + 选择目录
//       ├── HBox 操作行：下载勾选 / 下载选中行 / 全选 / 全不选 + 已选统计
//       ├── Table 结果表（第 0 列复选框；右击弹上下文菜单）
//       ├── ProgressBar（搜索/下载的"忙"指示）
//       └── HBox 状态栏：状态文字 + 操作提示
//
//   下载对话框（模态）：**本体在 dl_window.leno**（任务表 + 总进度 + 当前任务 + 五个按钮）
//     本文件只做三件事：判定"要下哪些歌" → 把数据与状态栏交给它 → 每 120ms 调它的 tick() ✓
//
// 线程模型（照 cleaner_master / cache_cleaner 的套路）
//   搜索：**两阶段并行**（2026-10-08 改）—— 阶段 A：每个音源一条线程（官方搜索，channel 回传命中数）；
//         阶段 B：每片行一条线程（逐首补第三方无损直链）。UI 侧 120ms 一拍排空 channel，
//         等"线程全停 + 通道排空"后由 advanceSearch 推进下一阶段 / 收尾 ✓
//   下载：**多首歌并行** —— threads.start(dl_worker_shard, ..., shard, nshards) × N 个 worker
//         （N = dl_engine.dl_workers(任务数)，各领一份 i % N == shard 的任务）+ 共用一个 channel
//         回传逐片进度（消息带全量下标）+ **每个 worker 一条**命令通道做暂停/取消 ✓
//   worker 必须是**入口脚本自己的具名全局函数**（理由见下方包装函数的注释），UI 线程只做
//   "排空 channel + 刷控件" ✓
//   ⚠ 两个页面拆成模块后这条约束**更硬**了（2026-10-11 实测）：`threads.start` 判的是
//     "入口函数的 module 必须为空"（threads.c:130）⇒ **模块里写不出合法的线程入口** ✗
//     ⇒ 四个 worker（搜索两条、榜单三条里的三条）都留在**本文件**，
//       由 `set_workers(...)` 当**函数值**交给各自那个页 ✓（见下面 ⚠ 与两个页的文件头 ⚠⚠）
//   ⚠ 下载窗口同理：**起线程的仍是本文件**（dl_worker_shard 也留在本文件），
//     窗口只置一个 `wantStart` 意图、由本文件的定时器接手起线程（详见 dl_window.leno 文件头 ⚠）
//
// 运行：cd D:\CLeno\Leno 后
//   build\leno.exe leno_gui\应用\音乐下载器\musicdl_gui.leno
import "SDL3" as SDL3
import "sdl_filedialog" as fdlg
import dirs
import files
import strings
import threads
import times
import "./dl_engine.leno" as eng
import "./songrow.leno" as srow             // 行字段的**具名存取**（歌名/歌手…；唯一事实来源 ✓ 见其文件头）
import "./dl_window.leno" as dlw
import "./dl_settings.leno" as dlset        // 设置：读/写/钳位（纯逻辑 ⇒ 能被 test/ 单测 ✓）
import "./dl_settings_win.leno" as dlswin    // "设置"弹窗（SDL3）—— 标题栏右侧 ⚙ 打开 ✓
import "./dl_about_win.leno" as dlabout     // "关于"弹窗（SDL3）—— 标题栏右侧那个 ⓘ 打开 ✓
import "./player_bar.leno" as pb             // 播放条（嵌在主界面里 ✓ 见它的文件头）
import "./player.leno" as pl                 // 只为了 strip_ext（删歌时顺带删同名 .lrc ✓）
import "./dl_history.leno" as hist           // 下载历史（`DDL` 自检要读它的访问器 ✓；窗口那边也用它 ✓）
import "./bang_page.leno" as bangpg          // 榜单页（★ 2026-10-11 从本文件拧出 ⇒ 本文件只接线 ✓ 见它的文件头）
                                             //   ⚠ 别名别叫 `bang` ✗ —— 本文件有个**字段**就叫 bang（BangPage?）
                                             //     同名会把模块遮蔽掉，`bang.create_...` 会被当成"在字段上找方法"✗
import "./search_page.leno" as spg           // 搜索页（★ 2026-10-11 从本文件拧出 ✓ 同理，别名避开字段名 `page`）
import "./dl_flow.leno" as dlf               // 下载编排 + 边下边播（★ 2026-10-11 从本文件拧出 ✓）

use SDL3.(Event, Renderer, Window, TitleBar, Label, Button, CheckBox, Table, ProgressBar, HBox, VBox, Edit, SpinBox, Separator, Scancode, ComboBox, ImageView, TabControl)
use dlw.DlWindow
use pb.PlayerBar
use dlset.DlSettings
use bangpg.BangPage
use spg.SearchPage
use dlf.DlFlow

// 歌曲行的列下标（F_ID / F_NAME / …）已收敛到 dl_engine.leno 的 `export const` ⇒ 用 `eng.F_xxx` ✓
// （原先本文件自己复制了一份；下载窗口再拆一个文件就会变成三份 ⇒ 单一事实来源 ✓）

// ==================== 线程入口包装（必须写在**本文件**里！） ====================
// ⚠ 实测踩坑：`threads.start(eng.search_entry, ...)` 会**当场**抛错
//   "线程入口必须是当前文件的函数 ✗ 收到的是模块 'dl_engine' 里的 'search_entry'
//    （子线程不会加载别的模块的全局变量 ⇒ 模块函数在子线程里跑不起来）"
//   ⇒ 子线程入口必须是**本文件的具名全局函数**，在里面再调引擎层的模块函数
//   （cleaner_master 的 scan_entry/delete_entry 就是这个套路 ✓）
// 另外：入口**不能是闭包**（闭包会被 GC ✗）
// ★ 2026-10-08 搜索拆成**两阶段并行**（原先一条线程串完所有源 + 所有第三方请求 ≈ 20~25 s ✗）：
//   阶段 A：**一个音源**一条线程（各源官方搜索互不相干）
//   阶段 B：**一片行**一条线程（第三方直链请求才是耗时大头：10 条 ≈ 7~11 s）
//   ⚠ 阶段 B 的 worker 不传通道：它只补行、不发消息（进度由 UI 侧"进入阶段 B"时显示 ✓）
func search_src_worker(string src, string keyword, int limit, any ch): Array[Array[string]] {
    return eng.search_source(src, keyword, limit, ch)
}

func probe_worker(Array[Array[string]] rows): Array[Array[string]] {
    return eng.probe_rows(rows)
}

// "逐首补体积"的并行度 —— 搜索阶段 B 用它，榜单侧用它补格式/大小（**同一套口径** ✓）。
//   ★ 2026-10-11：常量搬到 `dl_engine.leno`（`eng.PROBE_THREADS` ✓）—— 榜单页拆出去后，
//     两个页面都要它 ⇒ 再留一份在本文件就是两处定义、迟早写岔 ✗（实测数据随常量一起搬过去了 ✓）
//   实测（4 源 × 10 条，40 行 / 约 23 行真去问接口）：串行 ~26 s → 5 路 ~9.0 s → **8 路 ~5.6 s**

// ⚠ 下载窗口（dl_window.leno）的"开始"也走这个入口 —— 起线程的必须还是本文件 ✓
//   shard / nshards = 本 worker 领第几份 / 共几份（**多首歌并行**，切法见 dl_engine.dl_entry_shard ✓）
func dl_worker_shard(Array[Array[string]] jobs, string outdir, any ch, any cmd, Array[string] flags, int shard, int nshards): Array[string] {
    return eng.dl_entry_shard(jobs, outdir, ch, cmd, flags, shard, nshards)
}

// ★ 2026-10-09：`preview_worker` 随"试听（拉前一段）"整套退役 —— 现在双击就是"播放整表 + 边下边播" ✓
//   （那条下载走的是现成的 `dl_worker_shard`，不需要新 worker ✓ 见 startStreamFor）

// ★ 2026-10-11（拆分时实测到的**语言硬约束**，值得记牢 ✓）：
//   `threads.start(f, …)` 的判据是 **`f` 所属的 module 必须为空**（`threads.c:130` 那段——
//   子 VM 只继承**调用方 VM** 的 globals，且把自己的 current_module_frame 置 NULL ⇒ 模块函数
//   进不了函数体）。⇒ **任何被 import 的模块里都写不出合法的线程入口** ✗（不只是"当前文件"，
//   而是"**入口脚本自己**"：榜单页拆成模块后，它自己的 worker 当场就被拦了 ✓ 实测过 ✓）。
//   那模块要不要起线程？**要 —— 由宿主把 worker 当函数值传进去**：
//     模块里收 `func(string):Array[Array[string]]` 这种字段，再 `threads.start(field, …)` ✓
//     此时 `f` 仍是**入口脚本**的函数（module == NULL）⇒ 合法 ✓（探针实测 join 回了正确值 ✓）
//   ⇒ 所以下面这三条**必须留在这里**（入口脚本 = 本文件），榜单页通过 create_bang_page 收走它们 ✓
func bang_menu_worker(string src): Array[Array[string]] {
    Array[Array[string]] menu = []
    try { menu = eng.bang_menu(src) } catch e { menu = [] }
    return menu
}

func bang_worker(string src, string bid, int limit): Array[Array[string]] {
    Array[Array[string]] rows = []
    try { rows = eng.bang_rows(src, bid, limit) } catch e { rows = [] }
    return rows
}

// 榜单"逐首补格式/大小"worker（只做转发 ⇒ 真正的请求都在 eng.fill_sizes 里 ✓）
func bang_fill_worker(Array[Array[string]] part): Array[Array[string]] {
    return eng.fill_sizes(part)
}

// ==================== 无头自检钩子（环境变量；与 dashboard / cleaner_master 同一套约定 ✓）====================
// 为什么值得有：本应用是 GUI 的（搜索要联网、下载要点按钮）⇒ 没有它就只能"人手开窗看" ✗
//   DSHOT=<png>  截这一张就退出（默认第 2 帧；DSHOT_AT=<帧> 可调）
//   DAUTO=<帧>   跑够这么多帧就退出（不截图也行）
// ⇒ 标题栏那两个图标、整体布局都能被**无头核对**（assert\run_gui_checks.leno 的无头清单 ✓）
var dlShot = ""
int dlShotAt = 2
int dlAuto = 0
int dlFrames = 0

// ==================== 主结构 ====================
struct MusicDlApp {
    // ===== 主窗口控件（**只剩宿主自己那一份** —— 搜索页/榜单页的控件都随页搬走了 ✓）=====
    Window win
    TitleBar titleBar
    Button dirBtn
    CheckBox lyricBox            // 「同时下载歌词」：**本文件建**（值来自设置 ✓）⇒ 交搜索页摆进操作行 ✓
    Label stateLbl               // 状态栏：搜索页建（它是页内那一行 ✓）⇒ 这里只是**共享引用**（见 setupUI ✓）
    Label dirLbl
    ProgressBar busyBar          // 忙指示：搜索进度 + 下载进度**共用** ⇒ 留在这儿，搜索页只写它的值 ✓
    string rowIcon = ""          // 歌名前的行图标（两张表都用它 ✓ 见 setupUI）
    string outdir = ""

    // ===== ★ 2026-10-11：可记忆状态的"攒批落盘"与窗口尺寸快照（见 mark_dirty / persist_all）=====
    bool settingsDirty = false       // 有改动还没落盘
    int settingsIdle = 0             // 连着几拍没人再动（凑够 8 拍才写盘 ✓）
    int winW = 0                     // 主窗口尺寸的**快照**（退出前落盘用；别在退出时现问窗口 ✗）
    int winH = 0

    // ===== 搜索页（★ 2026-10-11 整页搬去 search_page.leno ⇒ 本文件只留一个引用 ✓）=====
    //   它自带：搜索行/音源勾选/操作行/结果表/状态行 + 两阶段并行搜索 + 格式过滤 + 已选统计 ✓
    //   本文件只做四件事：把它的四行一表摆进 page0、每 120ms 调 tick()、装 7 个回调、经 getter 读它 ✓
    SearchPage? page = null

    // ===== 下载编排 + 边下边播（★ 2026-10-11 整块搬去 dl_flow.leno ⇒ 本文件只留一个引用 ✓）=====
    //   开窗（复用/建目录/open_download）、起线程（wantStart/retry 的接手）、边下边播的下载半边
    //   都在它那儿 ✓；本文件只做：create + set_dl_worker/set_outdir_provider、
    //   每拍 tick_playback / tick_download、经只读口（dl_ref/is_downloading/play_rows/sync_locals）✓
    //   ★ `dl_worker_shard` 仍留在**本文件**（线程入口语言硬约束 ✓ 见顶部 ⚠）—— 当值交给它 ✓
    DlFlow? flow = null

    // ===== 播放条（player.leno 管规则 + player_bar.leno 画界面 ✓）=====
    //   ★ 嵌在主界面里（表格**下方**、状态栏上方 ✓）—— **不另开窗口** ✓；每 120ms 调它的 tick() ✓
    PlayerBar? pbar = null

    // ===== 设置（dl_settings.leno 纯逻辑 + dl_settings_win.leno 弹窗 ✓）=====
    //   `workers` = 并行下载线程数（**多首歌同时下**）；启动时读一次，改设置后立刻重读 ✓
    //   入口是**标题栏右侧**的两个动作按钮：`download`（下载窗口）与 `settings`（设置）✓
    //   图标用**框架内置矢量名** "download" / "settings"（吃 `icon_color` ⇒ 明暗标题栏都看得见 ✓）
    DlSettings cfg

    // ===== 页签（2026-10-09 新增 ✓ 参考 leno_gui/应用/数据看板/dashboard.leno 的做法）=====
    //   为什么改成页签：原来第一行要塞「关键词+格式+条数+搜索」和「音源+目录」两行，
    //     榜单再加进来就挤不下了 ⇒ 榜单独立成页，搜索页一行都不用将就 ✓
    //   为什么播放条**不放进页里**：它在 TabControl **外面** ⇒ 切页不打断播放 ✓
    TabControl tab
    int curPage = 0
    // 左侧导航按钮（选中态靠文字前的● 标记 —— 图标以后再补★ 先不用图标免得引入依赖 ✗）
    Button navSearch
    Button navBang

    // ===== 榜单页（★ 2026-10-11 整页搬去 bang_page.leno ⇒ 本文件只留一个引用 ✓）=====
    //   它自带控件、两条线程（菜单/歌曲）、逐首补格式/大小那批线程，以及"只看有大小"的过滤 ✓
    //   本文件只做五件事：把它挂进 tab（第 1 页）、每 120ms 调 tick()、切页时调 on_shown()、
    //   经 ctx_* 访问器读它的行、以及装好它那 5 个回调（见 setupUI 里那段 ✓）
    BangPage? bang = null

    // ===== 右键菜单的"作用对象"（2026-10-09 ✓ 让搜索表/榜单表共用同一套菜单）=====
    //   两张表的菜单项与处理**完全一样**，只是数据源不同 ⇒ 只记"这次菜单落在哪张表上"，
    //   由 ctx_* 访问器统一取"当前表/当前行"（见 buildMenu 那里的注释 ✓）
    int menuCtx = 0                   // 0 = 搜索表（songs）/ 1 = 榜单表（bang 的行 ✓ 见 ctx_row）

    // 自检用：buildMenu 最近一次收到的"作用对象"（见文件末的 DCTX 钩子 ✓）
    int gCtxSeen = -1                 // 期望 1（榜单表）
    int gCtxRowSeen = -9              // 期望 0（右击的那一行）
    bool gCtxWasOpen = false          // 目标 4 用：切页**之前**菜单是否真的开着（防"没开也算通过" ✗）

    // ==================== 界面上"可记忆项"的落盘（2026-10-08 ✓ / 2026-10-11 扩面 ✓）====================
    //   ★ 记什么（全部在这里现取一遍界面状态 ✓）：每源条数 / 音源勾选 / 「同时下载歌词」勾选
    //     + **音量 / 循环档 / 输出目录 / 格式过滤 / 榜单页（站点+榜单+只看有大小）/ 窗口尺寸** ✓
    //   ⚠ 2026-10-11 用户实测："音量这些居然没有保存，二次打开就归 0" —— 后 6 项原先**一项都没记** ✗
    //   ⚠ 先 `load()` 再覆盖本文件的这几项 ⇒ 不会把设置弹窗刚写的（并行线程数）抹掉 ✗
    //   ⚠ **别在 tick 里每拍直接调**：它会真写盘 ⇒ 统一走 mark_dirty() 的攒批（见那儿 ✓）
    func persist_all() {
        DlSettings s = dlset.load()
        s.lyric = lyricBox.is_checked()     // 主窗口那个勾选框 = 同一份设置（设置弹窗也是它 ✓）
        // ---- ★ 搜索页那三项（条数 / 音源勾选 / 格式偏好）都问它要 ✓ 别直摸它的控件 ✗ ----
        if page is SearchPage => sp {
            s.limit = sp.limit()
            s.sources = sp.picked_sources()   // 直接存数组：全不勾就是空数组 ✓（"存过没"另用 sourcesSet 标 ✓）
            s.fmt = sp.fmt_pref()             // ⚠ 存的是**用户偏好**，不是下拉现值 ✗（见该字段的注释 ✓）
        }
        s.sourcesSet = true
        // ---- ★ 播放条：音量 / 循环档（走 PlayerBar 的口子 ⇒ 不直接摸 Player/控件 ✓）----
        if pbar is PlayerBar => b {
            s.volume = b.volume_pct()
            s.loop = b.loop_mode()
        }
        // ---- ★ 输出目录 ----
        s.outdir = outdir
        // ---- ★ 榜单页：上次看的站点 / 榜单 / 「只看有大小」（都问榜单页要 ✓ 别直摸它的控件 ✗）----
        if bang is BangPage => bp {
            s.bangSrc = bp.chosen_src()
            s.bangId = bp.chosen_id()
            s.bangOnly = bp.only_checked()
        }
        // ---- ★ 窗口尺寸（用 resize 事件里的**快照**，不是现问窗口 ✓ 见 winW ✓）----
        s.winW = winW
        s.winH = winH
        if dlset.save(s) { cfg = s }        // 存成功就把内存里的 cfg 跟上（状态栏/搜索都读它 ✓）
    }

    // ===== ★★ 2026-10-11：落盘的**攒批** =====
    //   为什么必须有：拖一次音量滑块会连发几十次 on_change、拖一次窗口边框更是几十条 resize
    //   ⇒ 每次都写盘就是几十次文件写（本仓"别做无谓的活"的同一条纪律 ✓ 见文件头 ⚠①）
    //   做法：用户一动就置脏；120ms 一拍里数拍，**连续 8 拍（≈1 秒）没人再动**才写一次 ✓
    //   ⚠ 退出前必须 flush（`flush_settings`）：攒着的那一拍不落就丢了 ✗（✕ / ESC 那两条路要调 ✓）
    //   （两个计数器是**字段**：`settingsDirty` / `settingsIdle` ✓ 声明在"数据"那一段里 ✓）
    func mark_dirty() {
        settingsDirty = true
        settingsIdle = 0
    }

    // 立刻落盘（退出路径调 ✓；没脏就什么也不做 ✓）
    func flush_settings() {
        if not settingsDirty { return }
        settingsDirty = false
        settingsIdle = 0
        persist_all()
    }



    // ==================== 主循环定时器（120ms 一拍） ====================
    // 搜索进度、下载进度、忙指示都在这里推进 —— 唯一一处"UI 线程排空 channel"的地方
    func onTick() {
        // ★ 榜单页：两条/一批线程的结果都由它自己收（菜单 → 歌曲，顺序有依赖 ⇒ 它内部先收菜单 ✓）
        if bang is BangPage => bp { bp.tick() }
        // ★ 边下边播（2026-09 起）：播放器要歌 ⇒ 起**单任务**下载 + 排空回信通道（编排搬去 dl_flow.leno ✓）
        if flow is DlFlow => f { f.tick_playback() }
        // ===== 无头自检钩子：全部收口到下面四个方法（2026-10-11 ✓ 一个都不开 ⇒ 每拍 4 次判断零成本）=====
        selfcheck_dl_tick()        // DDLOPEN（空任务开窗）/ DDL（搜索 -> 下 1 首 -> 查历史）
        selfcheck_play_tick()      // DPLAY（播放/边下边播）/ 关于 / 悬停 / 歌词浮层
        selfcheck_click_tick()     // DPCLICK / DSEEK / DCTX / DDBL / 退出路径
        selfcheck_search_tick()    // DSEARCH（自动搜索）
        // ★ 歌词面板里点了"立即下载歌词" ⇒ 由**本文件**去下（要起线程 + 开下载窗口，只有这里能做 ✓）
        //   ⚠ 拿得到歌曲 ID 的前提：当前这首**在搜索结果里**（试听时记下的那行 ✓ gPrevRow）
        //     列表里的歌（磁盘文件名）没有 ID ✗ ⇒ 老实说清"去搜索结果里右键"✓ 不瞎猜 ✗
        if pbar is PlayerBar => pbLyr {
            if pbLyr.wantLyricFetch {
                pbLyr.wantLyricFetch = false
                string nowTag = pbLyr.cur_tag()
                // ⚠ `gPrevRow` 随"试听"退役（2026-10-09）⇒ 改成在**当前播放队列**里找这一首
                //   （队列项带整行 ⇒ 有歌曲 ID ✓ 与旧判据同口径：按显示名比 ✓）
                int hit = -1
                int k = 0
                // 当前播放队列问 dl_flow 要（★ 2026-10-11 搬走之后 ✓ 原先的模块级 gPlayRows）
                Array[Array[string]] prows = []
                if flow is DlFlow => fl4 { prows = fl4.play_rows() }
                while k < prows.len() {
                    if eng.songlabel(prows[k]) == nowTag {
                        hit = k
                        k = prows.len()
                    }
                    k = k + 1
                }
                if hit >= 0 {
                    onDownloadLyricOnly([prows[hit]])
                    stateLbl.set_text("去下这首的歌词：" + nowTag)
                } else {
                    stateLbl.set_text("这首不在搜索结果里（" + nowTag + "）-> 到搜索结果里右键「下载歌词」")
                }
                SDL3.markFrameRedraw()
            }
        }
        // ★ 歌单右击菜单里"动文件 / 弹窗 / 开目录"的那几项（2026-10-08 ✓）
        //   ⚠ 播放条**故意不碰**这些（不弹系统框、不开资源管理器 ✗）⇒ 它只置标志，由这里办 ✓
        //     动文件/弹窗的实现与搜索结果右键菜单**同一套**（`dlw.reveal` / `SDL3.msgBox` / `dlw.openfolder` ✓）
        if pbar is PlayerBar => pbCtx {
            if pbCtx.ctxWant != "" {
                string act = pbCtx.ctxWant
                string pth = pbCtx.ctxWantPath
                pbCtx.ctxWant = ""
                pbCtx.ctxWantPath = ""
                if act == "open" {
                    if not dlw.openfolder(outdir) { stateLbl.set_text("打开目录失败：" + outdir) }
                } eif act == "delall" {
                    // ★ 「删除全部本地文件…」（2026-10-09，用户要求）：删**播放列表里已下载的**那些
                    //   ⚠ 只删"列表里有的"（下载目录里其它文件一律不碰 ✓）；不可撤销 ⇒ 先弹确认框 ✓
                    Array[string] delfs = []
                    if pbar is PlayerBar => b2 {
                        int q2 = 0
                        while q2 < b2.queue_count() {
                            string lp2 = b2.queue_local(q2)
                            if lp2 != "" and files.exists(lp2) { delfs.add(lp2) }
                            q2 = q2 + 1
                        }
                    }
                    if delfs.len() == 0 {
                        stateLbl.set_text("列表里没有已下载的文件")
                        SDL3.markFrameRedraw()
                    } else {
                        int cnt = delfs.len()
                        SDL3.msgBox("删除全部本地文件", [
                            "会删掉列表里 " + _str(cnt) + " 个已下载的文件**及其同名 .lrc 歌词**（不可撤销）。",
                            "删完会**清空播放列表**；下载目录里不在这个列表的文件、历史记录都不受影响。"
                        ], "删除", "取消", true, func() { delete_all_local() })
                    }
                } eif pth != "" {
                    if act == "reveal" {
                        if dlw.reveal(pth) {
                            stateLbl.set_text("已在资源管理器里定位：" + pth)
                        } else {
                            stateLbl.set_text("定位失败：" + pth)
                        }
                    } eif act == "delfile" {
                        // ⚠ 回调式（框架明说**不要**写成 `if msgBox(...)` ✗ —— 主循环已经在跑 ✓）
                        SDL3.msgBox("删除本地文件", [
                            "要删掉这一首的本地文件吗？",
                            dirs.basename(pth),
                            pth,
                            "（会同时删掉同名 .lrc 歌词；不进回收站，删了就没了）"
                        ], "删除", "取消", true, func() {
                            string qq = pth
                            bool ok = true
                            try {
                                files.delete(qq)
                            } catch e {
                                ok = false
                            }
                            if ok {
                                // ★ 2026-10-20：与「删除全部」同口径 —— 同名 .lrc 一起删 ✓
                                int ldn = 0
                                string lq = pl.strip_ext(qq) + ".lrc"
                                try {
                                    if files.exists(lq) { files.delete(lq); ldn = 1 }
                                } catch e {
                                    ldn = 0        // 歌词删不掉不影响音频已删 ✓
                                }
                                if pbar is PlayerBar => bb { bb.rescan() }   // 列表跟着刷新（删的是正在播的那首 ⇒ 它也会停 ✓）
                                string lx = ""
                                if ldn > 0 { lx = "（含同名歌词）" }
                                stateLbl.set_text("已删除：" + qq + lx)
                            } else {
                                stateLbl.set_text("删除失败：" + qq + "（若正在播放它 -> 先切到别的歌再删）")
                            }
                            SDL3.markFrameRedraw()
                        })
                    }
                }
                SDL3.markFrameRedraw()
            }
        }
        try {
            // ★ 搜索页：排空搜索通道 + 推进阶段 + 脉冲"忙"指示都由它自己收（见 search_page.tick ✓）
            if page is SearchPage => sp6 { sp6.tick() }
            // 下载窗口点了"开始" ⇒ 由 dl_flow 起线程（worker 是本文件的函数值 ✓）+ 排空通道刷窗口 ✓
            if flow is DlFlow => f { f.tick_download() }
            // 播放条：同一拍推进（放完自动下一首 + 刷进度/时间/按钮态 ✓）
            if pbar is PlayerBar => b { b.tick() }
            // ★ 设置落盘的攒批（见 mark_dirty ✓）：连续 8 拍（≈1 秒）没人再动 ⇒ 写一次盘
            //   （拖音量滑块 / 拖窗口边框都会连发几十次 ⇒ 不攒批就是几十次文件写 ✗）
            if settingsDirty {
                settingsIdle = settingsIdle + 1
                if settingsIdle >= 8 {
                    settingsDirty = false
                    settingsIdle = 0
                    persist_all()
                }
            }
        } catch e {
            stateLbl.set_text("刷新出错：" + eng.errmsg(e))
            SDL3.markFrameRedraw()
        }
    }


    // ==================== ★ 播放 / 边下边播（2026-10-09，移植自二创 LenoMusic-main ✓）====================
    //   "当前界面显示的那张表"整张喂给播放器：已下载的直接播 ✓，没下过的边走边下边播 ✓
    //   ★ 2026-10-11：下载编排（开窗/起线程）与"边下边播"的**下载半边**都搬去 dl_flow.leno ✓
    //     本文件只留"取哪张表的行"（它才知道当前页 ✓），组队列/回灌播放器都在 dl_flow.play_table ✓

    // 从 `ctxId`（0 = 搜索表 / 1 = 榜单表）的第 row 行起播整张表
    func playFrom(int ctxId, int row) {
        // ★ 2026-10-20 修（群友反馈："搜索时点播放没反应、也没提示"✗）：
        //   搜索分两阶段（A 各源返回 → B 逐首补直链，见 search_page ✓）。A/B 期间表里已经有行，
        //   但**还没过滤掉拿不到直链的** ⇒ 不能把"整张未过滤表"灌进播放队列（B 结束表会变，
        //   队列与表就错位 ✗ 见上一版注释）。
        //   ⇒ 现在**放开边下边播**，但只播**点中的这一首**（单曲队列）：
        //     · 想听就立刻能听（引擎会现取直链；取不到就播失败并给错误 ✓）
        //     · 队列里只有这一首 ⇒ 与"最终表"不存在顺序错位问题 ✓
        //     · 搜索收尾后再双击 = 从最终表起播整表 ✓
        if ctxId == 0 and search_busy() {
            if page is SearchPage => sp {
                Array[string] one = sp.row(row)          // 显示行 → 数据行 ✓
                if one.len() > 0 {
                    Array[Array[string]] only = []
                    only.add(one)
                    if flow is DlFlow => f { f.play_table(only, 0) }
                    // 放在 play_table 之后：它会写"播放：…"，这里再补一句**搜索中的限制** ✓
                    //   ⚠ 必须走播放条的 flash：状态行每拍会被"正在播…/已搜到…"改写 ✗
                    string hint = "搜索还在补直链：先只播这首「" + eng.songlabel(one)
                                  + "」（边下边播，没直链的会失败）；搜索完成后再双击可播整表"
                    if pbar is PlayerBar => hb { hb.flash_host(hint, 5000) } else { stateLbl.set_text(hint) }
                } else {
                    if pbar is PlayerBar => hb2 { hb2.flash_host("这一行还没有数据，等搜索结果回来再点", 3000) }
                }
            }
            return
        }
        // 榜单页的行问它自己要（2026-10-11 搬走之后 ✓）；搜索表经它的只读口 ✓
        Array[Array[string]] rows = search_rows_all()
        int srcRow = row                         // ★ 双击/右键给的是**显示行**（可能已排序）
        if ctxId == 1 {
            if bang is BangPage => bp { rows = bp.rows(); srcRow = bp.source_row(row) }
        } else {
            if page is SearchPage => sp { srcRow = sp.source_row(row) }
        }
        if flow is DlFlow => f { f.play_table(rows, srcRow) }
    }

    // ★ 2026-10-20：删除**播放列表里已下载的全部文件**（确认框之后的实际动作）
    //   · 音频 + 同名 .lrc 一起删（用户要求 ✓）
    //   · 删之前先停播 + 清列表：正在播的那首占着文件句柄 ⇒ 不释放就删不掉 ✗
    //   · 删完列表保持空（用户要求 ✓）；下载目录里不在列表的文件、历史记录一律不碰 ✓
    func delete_all_local() {
        Array[string] delfs = []
        if pbar is PlayerBar => b2 {
            int q2 = 0
            while q2 < b2.queue_count() {
                string lp2 = b2.queue_local(q2)
                if lp2 != "" and files.exists(lp2) { delfs.add(lp2) }
                q2 = q2 + 1
            }
        }
        if delfs.len() == 0 {
            stateLbl.set_text("列表里没有已下载的文件")
            SDL3.markFrameRedraw()
            return
        }
        // 先释放句柄 + 清空列表（顺序很重要：清单已经收好 ✓）
        if flow is DlFlow => f0 { f0.clear_queue_rows() }
        if pbar is PlayerBar => b0 { b0.clear_playlist() }
        int dn = 0
        int ln = 0
        for delfs to f2 {
            string ap = _str(f2)
            try {
                files.delete(ap)
                dn = dn + 1
            } catch e {
                dn = dn + 0            // 删不掉（被其它程序占用等）⇒ 跳过，最后报个数 ✓
            }
            // ★ 同名歌词一起删（"歌名 - 歌手.lrc" 与音频同基名 ✓）
            string lp3 = pl.strip_ext(ap) + ".lrc"
            try {
                if files.exists(lp3) { files.delete(lp3); ln = ln + 1 }
            } catch e {
                ln = ln + 0            // 歌词删不掉就算了（不影响音频已删的事实 ✓）
            }
        }
        string lr = ""
        if ln > 0 { lr = "，歌词 " + _str(ln) + " 个" }
        stateLbl.set_text("已删除音频 " + _str(dn) + " 个" + lr + "；播放列表已清空（历史保留）")
        SDL3.markFrameRedraw()
    }

    func onDownloadChecked() {
        Array[Array[string]] jobs = search_picked_all()      // = 搜索页里"勾选且过格式过滤"的那些 ✓
        // 全被格式过滤掉了 ⇒ 说清原因（否则只会冒出"先勾选…"，看着像按钮坏了 ✗）
        int checked = search_checked_count()
        string want = search_fmt_want_now()
        if jobs.len() == 0 and checked > 0 and want != "" {
            stateLbl.set_text("勾选的 " + _str(checked) + " 首都不是 " + want + " —— 换格式，或切回「全部格式」")
            SDL3.markFrameRedraw()
            return
        }
        if flow is DlFlow => f { f.start_download(jobs) }   // 开窗/复用/建目录/带词与否都在 dl_flow ✓
    }

    // 标题栏「下载」图标（2026-10-07）：**"打开下载窗口"的入口** ✓
    //   · 已开着 ⇒ 只置前（不重复开 ✓，见 dl_flow.reuse_dl_if_open）
    //   · 有勾选/选中 ⇒ 判定 → 开窗 → 起线程 ✓
    //   ★ 2026-10-09 改（用户口径）：**一首都没勾也照开窗** —— 原先弹"还没有要下载的歌"把人拦在门外 ✗，
    //     而"打开窗口看看（任务表 / 历史页签）"本身就是合理需求 ✓
    //     空任务由窗口自己表达（见 dl_flow.start_download 与 dl_window.build 的注释 ✓）
    //     ★ 2026-10-10：工具栏「下载勾选」**也**改成了随时可点（同一口径 ✓ 见 updateCount）
    func onDownloadAction() {
        if flow is DlFlow => f { f.start_download(search_picked_all()) }
    }

    func onDownloadSelected() {
        Array[Array[string]] jobs = search_selected_picked()   // 选中的行，**同样吃格式过滤** ✓
        int seln = search_sel_count()
        string want = search_fmt_want_now()
        if jobs.len() == 0 and seln > 0 and want != "" {
            stateLbl.set_text("选中的 " + _str(seln) + " 首都不是 " + want + " —— 换格式，或切回「全部格式」")
            SDL3.markFrameRedraw()
            return
        }
        if flow is DlFlow => f { f.start_download(jobs) }   // 同上 ✓
    }

    // 只下歌词（右键菜单 / 已有音频时用）
    func onDownloadLyricOnly(Array[Array[string]] jobs) {
        if jobs.len() == 0 {
            stateLbl.set_text("先勾选（或右键选中）要下歌词的歌曲")
            SDL3.markFrameRedraw()
            return
        }
        // 复用检查/建目录/开窗都在 dl_flow.open_lyric_only ✓（右键"只下这一首的歌词"也不会开出第二个框 ✓）
        if flow is DlFlow => f { f.open_lyric_only(jobs) }
    }

    func onLyricSelected() {
        // 「只下歌词」不管格式 ⇒ 拿**不过滤**的那份（见搜索页 selected_all ✓）
        onDownloadLyricOnly(search_selected_all())
    }

    // ==================== 右键菜单 ====================
    //   ★ 2026-10-09：搜索表与榜单表**共用同一套菜单**（榜单表原先压根没接右键 ⇒ 切到榜单页
    //     只能一首一首来、想"选中一批再下"没法做 ✗）。做法：只记"这次菜单落在**哪张表**上"，
    //     下面三个访问器把"当前表 / 当前行数 / 当前第 i 行（那一首）"统一取出来
    //     ⇒ 菜单项与处理逻辑**零分支**，两个页面永远一致 ✓
    //   ⚠ 别想着"把行数组存成字段去引用另一张表"：那要靠数组的引用语义跨赋值，不好保证 ✗
    func ctx_table(): Table {
        if menuCtx == 1 { return bangTableRef() }
        return searchTableRef()
    }
    func ctx_len(): int {
        if menuCtx == 1 { return bangRowCount() }
        return searchRowCount()
    }
    func ctx_row(int i): Array[string] {
        if menuCtx == 1 {
            if bang is BangPage => bp { return bp.row(i) }
            return []
        }
        if page is SearchPage => sp { return sp.row(i) }
        return []
    }
    // 当前表里**勾选**的行（搜索页仍走 pickchecked 的格式过滤口径 ✓；榜单页没有格式选择器 ⇒ 不过滤 ✓）
    func ctx_picked(): Array[Array[string]] {
        Array[Array[string]] out = []
        Array[int] chk = ctx_table().get_checked_rows()
        for chk to i {
            if i >= 0 and i < ctx_len() { out.add(ctx_row(i)) }
        }
        return out
    }

    // ---- 自检（DCTX / DDBL）用：两个页的"表格 / 行数"（走它们的只读口 ✓ 不直摸字段 ✗）----
    //   只在 setupUI 之后跑 ⇒ 此刻两页必已建好 ✓（兜底那条只是防"没建就调"的静态检查 ✓）
    func bangTableRef(): Table {
        if bang is BangPage => bp { return bp.table_ref() }
        return searchTableRef()
    }
    func bangRowCount(): int {
        if bang is BangPage => bp { return bp.row_count() }
        return 0
    }
    func searchTableRef(): Table {
        if page is SearchPage => sp { return sp.table_ref() }
        return bangTableRef()
    }
    func searchRowCount(): int {
        if page is SearchPage => sp { return sp.row_count() }
        return 0
    }
    // ---- 菜单/自检的"当前表是不是搜索表"那套口径（**格式过滤只对搜索页有意义** ✓）----
    //   两张表共用一套菜单 ⇒ `menuCtx == 0` 时才问搜索页要过滤 ✓（榜单页没有格式选择器 ✓）
    func ctx_fmt_want(): string {
        if menuCtx == 1 { return "" }
        if page is SearchPage => sp { return sp.fmt_want() }
        return ""
    }
    func ctx_fmt_ok(Array[string] row): bool {
        if menuCtx == 1 { return true }
        if page is SearchPage => sp { return sp.fmt_ok(row) }
        return true
    }
    // ---- 读搜索页的几个只读口（集中在这儿 ⇒ 自检/下载动作用起来只有一行 ✓ 别到处写 narrowing ✗）----
    func search_busy(): bool {
        if page is SearchPage => sp { return sp.searching_now() }
        return false
    }
    func search_rows_all(): Array[Array[string]] {
        if page is SearchPage => sp { return sp.rows() }
        return []
    }
    func search_keyword_now(): string {
        if page is SearchPage => sp { return sp.keyword() }
        return ""
    }
    func search_picked_all(): Array[Array[string]] {
        if page is SearchPage => sp { return sp.picked() }
        return []
    }
    func refresh_search_count() {
        if page is SearchPage => sp { sp.refresh_count() }
    }
    func search_fmt_want_now(): string {
        if page is SearchPage => sp { return sp.fmt_want() }
        return ""
    }
    func search_checked_count(): int {
        if page is SearchPage => sp { return sp.checked_count() }
        return 0
    }
    func search_sel_count(): int {
        if page is SearchPage => sp { return sp.selected_count() }
        return 0
    }
    func search_selected_picked(): Array[Array[string]] {
        if page is SearchPage => sp { return sp.selected_picked() }
        return []
    }
    func search_selected_all(): Array[Array[string]] {
        if page is SearchPage => sp { return sp.selected_all() }
        return []
    }

    // ★ 双击某行 = **试听**（2026-10-09 改 ✓ 与右键「试听（同时后台下载整首）」**同一条入口** ✓）
    //   为什么改：双击原先 = 「下载这一首」，但**下载**在界面上本就有两条更明确的路
    //   （勾选后「下载勾选」/ 右键「下载这一首」✓），而"点了就想先听听"一直没快捷方式 ✗
    //   ⇒ 把最顺手的双击给试听；想下载仍有右键与按钮 ✓（不是砍功能，是换更顺的分配 ✓）
    //   ⚠ 与菜单同一取舍：**不套格式过滤**（点名单曲 ⇒ 拦了会像"点了没反应" ✗ 见 fmt 那一段 ✓）
    //   ⚠ `ctxId`（0=搜索表 songs、1=榜单表 bangSongs）与 menuCtx 同口径，但**绝不写 menuCtx**
    //     —— 那是右键菜单的字段，双击去动它会让"菜单落在哪张表"串味 ✗ ⇒ 这里只做分支 ✓
    func previewRow(int ctxId, int row) {
    }

    // 用这一行去别处搜：关键词 = "歌名 歌手"（歌手为空就只搜歌名 ✓）
    //   ⚠ 榜单接口**常缺 `singername`**（见各 core 的注释 ✓）⇒ 不能拼成 " - " 或空歌手时留个空格 ✗
    func searchkw(Array[string] row): string {
        string n = srow.rowname(row).trim()
        string a = srow.rowartist(row).trim()
        if a == "" { return n }
        if n == "" { return a }
        return n + " " + a
    }

    // 右键菜单项的图标路径（文件名见 images/*.png ✓ 用户 2026-10-09 提供的一批彩色小图标 ✓）
    //   ⚠ 菜单项给图标的键是 `image`（**不是** `icon` ✗ 写错框架只 warn_once、不画图标 ✓ 见 sdl_menu）
    //   ⚠ 图标尺寸/内边距是**菜单级**的（`MenuBar.set_image_size` ✓ 在 setupUI 里统一设 18 ✓）
    func micon(string file): string {
        return dirs.join(dirs.join(dirs.res_dir(), "images"), file)
    }

    func buildMenu(int row) {
        Table t = ctx_table()
        gCtxSeen = menuCtx              // 自检留痕（DCTX 钩子读它 ✓）
        gCtxRowSeen = row
        t.clearContextItems()
        Array[int] checked = t.get_checked_rows()
        if row >= 0 {
            t.addContextItem({label: "播放（边下边播）", id: "playrow", image: micon("audition.png")})
            t.addContextItem({label: "下载这一首", id: "dlrow", image: micon("download_song.png")})
            t.addContextItem({label: "只下这一首的歌词", id: "lyricrow", image: micon("download_lyric.png")})
            t.addContextItem({label: "复制「歌名 - 歌手」", id: "copy", image: micon("copyname.png")})
            // ★ 2026-10-09：拿这一首去**搜索页**搜（榜单页专用）
            //   为什么只在榜单页给：榜单行只带**一个站点**（即"这首在酷我榜上"）⇒ 想看看别的站
            //   有没有、比对音质，就得换个关键词再搜一遍 ✓；而搜索页本来就在搜、这个词就是你刚输入的 ⇒
            //   再给一项只会是重复 ✗
            if menuCtx == 1 { t.addContextItem({label: "搜索这首歌（跳到搜索页）", id: "searchthis", image: micon("search.png")}) }
        }
        if checked.len() > 0 {
            // ★ 菜单上写清"实际会下几首"：格式过滤开着时，勾选数与下载数会不一样 ✗
            //   （否则菜单说"下载勾选的 5 首"、实际只下 3 首 ⇒ 看着像漏了 ✓）
            //   ⚠ 格式过滤是**搜索页**的东西（榜单页没有那个下拉 ✓）⇒ 只在搜索页算它 ✓
            string want = ctx_fmt_want()
            string head = "下载勾选的 " + _str(checked.len()) + " 首"
            if want != "" {
                int m = 0
                for checked to i {
                    if i >= 0 and i < ctx_len() and ctx_fmt_ok(ctx_row(i)) { m = m + 1 }
                }
                head = "下载勾选的 " + _str(m) + " / " + _str(checked.len()) + " 首（只要 " + want + "）"
            }
            t.addContextItem({label: head, id: "dlchecked", image: micon("download_checked.png")})
            t.addContextItem({label: "只下勾选的 " + _str(checked.len()) + " 首歌词", id: "lyricchecked", image: micon("download_lyric.png")})
        }
        t.addContextSeparator()
        t.addContextItem({label: "全选", id: "all", image: micon("select_all.png")})
        t.addContextItem({label: "全不选", id: "none", image: micon("select_none.png")})
        t.addContextSeparator()
        t.addContextItem({label: "在资源管理器里定位", id: "reveal", image: micon("open_folder.png")})      // ★★★ 2026-10-08：定位/删除本地文件
        t.addContextItem({label: "删除本地文件…", id: "delfile", image: micon("delete_file.png")})
        t.addContextItem({label: "打开下载目录", id: "open", image: micon("download_batch.png")})
    }

    func onMenu(int row, string id) {
        bool hasRow = row >= 0 and row < ctx_len()
        if id == "playrow" {
            if hasRow { playFrom(menuCtx, row) }     // ★ 右键「播放」= 从这一行起播整张表（边下边播 ✓）
            return
        }
        if id == "dlrow" {
            if hasRow {
                if flow is DlFlow => f { f.start_download([ctx_row(row)]) }
            }
            return
        }
        if id == "dlchecked" {
            // 搜索页走原口径（含格式过滤 + 勾选按钮联动 ✓）；榜单页没有那些控件 ⇒ 直接下勾选的 ✓
            if menuCtx == 0 {
                onDownloadChecked()
            } else {
                if flow is DlFlow => f { f.start_download(ctx_picked()) }
            }
            return
        }
        if id == "lyricrow" {
            if hasRow { onDownloadLyricOnly([ctx_row(row)]) }
            return
        }
        if id == "lyricchecked" {
            // ⚠ 口径照旧：搜索页那条吃**格式过滤**（pickchecked 老口径 ✓）、榜单页不过滤 ✓
            Array[Array[string]] jobs = ctx_picked()
            if menuCtx == 0 { jobs = search_picked_all() }
            onDownloadLyricOnly(jobs)
            return
        }
        if id == "copy" {
            if hasRow {
                SDL3.setClipboardText(eng.songlabel(ctx_row(row)))
                stateLbl.set_text("已复制：" + eng.songlabel(ctx_row(row)))
            }
            return
        }
        // ★ 2026-10-09：拿这一首去搜索页搜（榜单页专用，见 buildMenu 的注释 ✓）
        //   顺序要紧：**先填关键词再切页再发起搜索** —— `onSearch` 读的正是输入框里的词 ✓
        if id == "searchthis" {
            if hasRow {
                string kw = searchkw(ctx_row(row))
                if kw == "" {
                    stateLbl.set_text("这一行没有歌名/歌手，没法去搜（榜单接口少数行会缺）")
                } else {
                    if page is SearchPage => sp4 { sp4.keyword_into(kw) }
                    tab.set_active(0)        // 跳到搜索页（会触发 tab.on_change ⇒ onTabChanged ✓）
                    if search_busy() {
                        // ⚠ 搜索页的 on_search 开头就有"已在搜就返回"的守卫（见它 ✓）⇒ 这条**不能**假装搜过了 ✗
                        stateLbl.set_text("关键词已填好：" + kw + " —— 上一次搜索还在跑，等它完再回车 ")
                    } else {
                        if page is SearchPage => sp5 { sp5.start_search(kw) }   // 状态栏由它自己写"正在搜索「…」"
                    }
                }
                SDL3.markFrameRedraw()
            }
            return
        }
        if id == "all" {
            Table t = ctx_table()
            t.check_all()
            if menuCtx == 0 { refresh_search_count() }     // "已选 N / M 首"那行只有搜索页有 ✓
            SDL3.markFrameRedraw()
            return
        }
        if id == "none" {
            Table t = ctx_table()
            t.uncheck_all()
            if menuCtx == 0 { refresh_search_count() }
            SDL3.markFrameRedraw()
            return
        }
        // ★★★ 2026-10-08：在资源管理器里**定位**（选中）这一首的本地文件
        //   ⚠ 走的必须是 `explorer /select,` ✗ 不能拿"打开目录"那套 —— 后者对文件会用默认程序打开它 ✗（用户实测点名 ✓）
        if id == "reveal" {
            if hasRow {
                string p = eng.find_local(ctx_row(row), outdir)
                if p == "" {
                    stateLbl.set_text("本地还没有这首（" + eng.songlabel(ctx_row(row)) + "）-> 先下载它 ")
                } else if dlw.reveal(p) {
                    stateLbl.set_text("已在资源管理器里定位：" + p)
                } else {
                    stateLbl.set_text("定位失败：" + p)
                }
            }
            SDL3.markFrameRedraw()
            return
        }
        // 删除本地文件（**先确认** ✓ 弹模态框；不删歌词 .lrc、也不进回收站 ✓ 会在框里说清 ✓）
        if id == "delfile" {
            if hasRow {
                string p = eng.find_local(ctx_row(row), outdir)
                if p == "" {
                    stateLbl.set_text("本地还没有这首，没东西可删（" + eng.songlabel(ctx_row(row)) + "）")
                } else {
                    // ⚠ 回调式（框架明说**不要**写成 `if msgBox(...)` ✗ —— 主循环已经在跑 ✓）
                    SDL3.msgBox("删除本地文件", [
                        "要删掉这一首的本地文件吗？",
                        eng.songlabel(ctx_row(row)),
                        p,
                        "（只删音频，不动同名 .lrc 歌词；不进回收站，删了就没了）"
                    ], "删除", "取消", true, func() {
                        string q = p
                        bool ok = true
                        try {
                            files.delete(q)
                        } catch e {
                            ok = false
                        }
                        if ok {
                            if pbar is PlayerBar => b { b.rescan() }      // 列表跟着刷新（删的是正在播的那首 ⇒ 它也会停 ✓）
                            stateLbl.set_text("已删除：" + q)
                        } else {
                            // 最常见的原因：正在播它（占着文件句柄 ✗）⇒ 说清怎么办 ✓
                            stateLbl.set_text("删除失败：" + q + "（若正在播放它 -> 先切到别的歌再删）")
                        }
                        SDL3.markFrameRedraw()
                    })
                }
            }
            SDL3.markFrameRedraw()
            return
        }
        if id == "open" {
            // 打开目录的实现随下载窗口一起搬到了 dl_window.leno（那里也有"打开目录"按钮 ⇒ 一份 ✓）
            if not dlw.openfolder(outdir) { stateLbl.set_text("打开目录失败：" + outdir) }
            SDL3.markFrameRedraw()
            return
        }
    }

    // ==================== 输出目录 ====================

    func onPickDir() {
        fdlg.showOpenFolderDialog(win, func(Array[string] paths, int filter) {
            if paths != null and paths.len() > 0 {
                outdir = paths[0]
                dirLbl.set_text(outdir)
                dirLbl.set_tip(outdir)                    // ⚠ 注记也要跟着换（截断时悬停看全路径 ✓）
                mark_dirty()                              // ★ 输出目录也记住（下次开机还是它 ✓）
                stateLbl.set_text("输出目录已改为（已记住）：" + outdir)
                SDL3.markFrameRedraw()
            }
        }, {default_location: outdir})
    }

    // ==================== 设置 ====================

    // 打开「⚙ 设置」（在搜索行最右侧）：真改了就把新值立刻接上，并回一句到状态栏 ✓
    //   · 线程数只影响**下一次**开始下载（正在下的那批照旧 ✓）—— 设置窗口里也写着这句
    //   · 纯逻辑（读/写/钳位）在 dl_settings.leno，画界面在 dl_settings_win.leno ✓
    func onSettings() {
        if dlswin.show_settings_window() {
            cfg = dlset.load()
            // ★ 2026-10-08 修：设置里改了「默认同时保存歌词」⇒ **当场回灌**主窗口那个勾选框 ✓
            //   先前只在启动时套一次（见文件末尾 setupUI 之后那句 ✓）⇒ 用户在设置里取消勾选、
            //   回头看主窗口**还勾着** ✗（用户实测就是这条 ✓）
            //   ⚠ `set_checked` 是纯赋值（不触发 on_change ✓ 见 sdl_checkbox）⇒ 不会反向写盘循环 ✓
            lyricBox.set_checked(cfg.lyric)
            string extra = if cfg.lyric then "，默认带歌词" else ""
            stateLbl.set_text("设置已保存：并行 " + _str(cfg.workers) + " 线程" + extra)
            SDL3.markFrameRedraw()
        }
    }

    // 打开「ⓘ 关于」（标题栏最右那个）：版本 / 致谢 / 免责声明 ✓
    //   · 纯展示 ⇒ 没有返回值、也不改任何状态（关掉就完事 ✓）
    //   · 文案与致谢名单都在 dl_about_win.leno 顶部那两个常量里（要加人就加一行 ✓）
    func onAbout() {
        dlabout.show_about_window()
        stateLbl.set_text("关于：版本 / 致谢 / 免责声明")
        SDL3.markFrameRedraw()
    }

    // ==================== UI 构建 ====================

    func setupUI() {
        // 标题栏右侧按钮组：**下载窗口入口** + **设置**（与最小化/最大化/关闭同一排 ✓）
        // ★ 2026-10-09：这两个按钮改用**框架内置矢量名**（`"download"` / `"settings"`）
        //   —— 原先用应用自带 PNG（`images/download.png` / `setting.png`，是**给深色标题栏配的
        //   纯白 glyph**）⇒ 标题栏改成浅色后它们直接"消失" ✗；矢量图标吃 `icon_color` ⇒ 永不白 ✓
        // ★ 标题栏的 `title_icon`（应用 logo）与表格行图标**仍是 PNG**，所以下面三条仍要记牢：
        //     ① 路径必须是**绝对**的：标题栏把字符串**原样**交给 SDL_image ⇒ 相对路径跟着
        //        **进程 cwd** 走，换个工作目录启动就加载失败（画成一个小点 ✗）
        //     ② 读**随包资源**要用 `dirs.res_dir()`，**不能**用 `script_dir()` ✗ ——
        //        单文件打包后资源释放到缓存目录，`script_dir()` 还是 exe 所在目录 ⇒ 取不到 ✗
        //        （未打包时两者**完全一致** ⇒ 开发态照常 ✓ 见 docs/单文件打包使用指南.md §7）
        //     ③ 资源清单在本应用目录的 `resource.toml`（`[pack] resources = ["images/**"]` ✓）
        string imgDir = dirs.join(dirs.res_dir(), "images")
        string iconApp = dirs.join(imgDir, "index.png")
        // 搜索结果每行"歌名前"的那个小音符（表格 `image_col` 用 ✓ 见 createTable / fillTable ✓）
        rowIcon = dirs.join(imgDir, "music.png")
        // ★ 侧栏两个入口的图标（2026-10-09 用户提供 ✓ 48×48 蓝色描边线性图标 + 透明底）
        string iconNavSearch = dirs.join(imgDir, "sousuo.png")
        string iconNavBang = dirs.join(imgDir, "bangdan.png")
        // ★ 标题栏那个「关于」ⓘ（2026-10-09 用户提供 ✓ 群友「小半头砖」的素材 ⇒ 致谢里写着 ✓）
        //   ⚠ 标题栏的动作按钮**图片图标不吃 `icon_color`**（按原色画 ✓ 见 sdl_titlebar）⇒
        //     这张图是**深色** glyph，放浅灰标题栏上没问题 ✓（纯白的放上去会"消失" ✗ 前两个按钮
        //     当初就是因此改用内置矢量名的 ✓）
        string iconAbout = dirs.join(imgDir, "about.png")
        // 资源缺失时标题栏只会画个**小点、不报错** ⇒ 这里补一句明确警告（打包漏声明资源最常见 ✗）
        //   ⚠ 五个都查：少任何一个都会在界面上"少一块"，但**不会报错** ⇒ 只能靠这句提醒 ✓
        Array[string] needIcons = [iconApp, rowIcon, iconNavSearch, iconNavBang, iconAbout]
        bool iconsOk = true
        for needIcons to ic { if not files.exists(ic) { iconsOk = false } }
        if not iconsOk {
            print("[musicdl] 图标资源缺失：" + imgDir + "（打包请声明 resource.toml 的 [pack] resources）\n")
        }
        if dlShot != "" { print("[musicdl] 图标目录（自检）：" + imgDir + "\n") }
        titleBar = SDL3.createTitleBar({
            title: "Leno 音乐下载器", h: 32, font_size: 14,
            // ★ 标题前的应用图标（2026-10-07 新增）：只有文字时标题前面空一块、观感差 ✗
            //   与文字**整体**居中/左对齐，尺寸比窗口按钮图标略大一点（18 vs 16 ✓）
            title_icon: iconApp, title_icon_size: 18,
            // ★ 浅灰标题栏（2026-10-09 改 ✓）：标题栏**默认配色是深色**（#262830），
            //   而本应用整体是浅色（页面 #F0F0F5 / 页签 #F5F6F8，`setTheme(lightTheme())` ✓）
            //   ⇒ 头顶压着一整块黑、割裂感强 ✗ ⇒ 改成浅灰工具条 + 深字/深图标 + 底部发丝线 ✓
            //   ⚠ 用浅灰（#E8E8EE，浅色主题的 bgAlt）而不是纯白：白条**比页面还亮**，反而"浮"起来 ✗；
            //     浅灰正好比页面(#F0F0F5)深一档 ⇒ 一条明确的"工具条"，也是 Win11/macOS 的做法 ✓
            //   ⚠ 各键都是**框架现成的入口**（见 sdl_titlebar 的 _opts_keys ✓）
            bg_color: #E8E8EEFF,
            text_color: #1E1E28FF,          // 浅色主题的主文字色（与页面同源 ✓）
            //   ⚠ `icon_color` **只管矢量图标**（窗口三键 + 内置矢量动作）——图片图标是按原色画的 ✗
            //     （实测：download.png/setting.png 是**纯白** glyph，放浅色栏上直接"消失" ✗）
            //     ⇒ 两个动作按钮改用**内置矢量名**（"download"/"settings"）⇒ 跟着这个色走、永不会白 ✓
            icon_color: #3C414BFF,          // 深灰而不纯黑，浅底上更耐看 ✓
            sep_color: #D5D8DFFF,     // 发丝分隔线（比底色深一档 ⇒ 与页面分开 ✓）
            hover_color: #D9DBE3FF,         // 悬停：再深一档灰 ✓
            //   关闭键悬停：用**浅红**而不是深红 —— 图标色是深的，压在深红上会糊成一片 ✗
            //   （框架的关闭图标不随悬停换色 ⇒ 浅红底 + 深 ✕ 才看得清 ✓）
            close_hover_color: #FDE7E9FF,
            actions: [
                {id: "download", icon: "download", tip: "下载勾选的歌（打开下载窗口；已开着就切到前台）"},
                {id: "settings", icon: "settings", tip: "设置：并行下载线程数、默认是否带歌词"},
                // ★ 「关于」放**最后**（= 最靠内、紧挨设置 ✓ 用户 2026-10-09：放设置旁边 ✓）
                //   ⚠ 这里是**图片路径**（不是内置矢量名）⇒ 按原色画、不吃 `icon_color`（见上面 iconAbout ✓）
                {id: "about", icon: iconAbout, tip: "关于：版本 / 致谢 / 免责声明"}
            ]
        })
        titleBar.on_action(func(string id) {
            // 下载入口：判定 / 防重复 / 起线程都在那几处，这里只做"该说清的说清" ✓
            if id == "download" { onDownloadAction() }
            eif id == "settings" { onSettings() }
            eif id == "about" { onAbout() }
        })
        win.add(titleBar)
        float titleH = titleBar.get_h()

        var root = SDL3.createVBox({pad_x: 12, pad_y: 10, spacing: 8})

        // ---- 搜索页（页 0）：整页在 search_page.leno ✓ 这里只"建页 + 套初值 + 摆四行一表 + 接线" ----
        //   ★ 2026-10-09：整页交给一个 VBox + `tab.setPageLayout(0, page0)` ⇒ **页内也布局驱动**
        //     （窗口缩放时页里跟着重排 ✓ 不用一行绝对坐标；做法照数据看板 dashboard.leno ✓）
        //   ⚠ `spacing` 别给 0：三行控件行的高（34/30/32）里控件自己就占了 32/30/32 ⇒ 行间只剩
        //     2~4px、"操作行 → 表格"更是**只有 1px**（实测 ✓ 表格像贴在按钮上 ✗）⇒ 统一给 6 ✓
        var page0 = SDL3.createVBox({pad_x: 0, pad_y: 0, spacing: 6})
        //   `lyricBox`（"同时下载歌词"）由**本文件**建：它是"要记住的设置项"那一族 ✓ 且搜索页要把它
        //     摆进操作行 ⇒ **必须赶在建页之前**建好（当参数交过去 ✓）
        lyricBox = SDL3.createCheckBox({text: "同时下载歌词", checked: cfg.lyric, font_size: 13})
        //   `busyBar`（"忙"指示）也由本文件建（下载进度共用 ✓）—— ⚠ 同样**必须赶在建页之前** ✗✗
        //     2026-10-11 踩过：先 create_search_page、之后才建 busyBar ⇒ 页里拿的是**当时那个空对象**，
        //     `set_value` 写进去谁也不画 ⇒ 用户看到的就是"**搜索进度没有**"✗（搜索/下载两条都哑了 ✓）
        busyBar = SDL3.createProgressBar({h: 6, show_text: false})
        busyBar.set_value(0.0)
        //   ★ 2026-10-11：节奏是"先建页 → 套初值（set_*）→ 再 make_*"（顺序反了等于白设 ✗ 见 search_page 文件头）
        page = spg.create_search_page(rowIcon, lyricBox, busyBar)
        if page is SearchPage => spg0 {
            spg0.set_limit(cfg.limit)                       // 每源条数（读盘时已钳到 LIMIT_MIN..MAX ✓）
            spg0.set_fmt_pref(cfg.fmt)                      // 格式偏好（下拉要等搜完才填 ⇒ 先记着 ✓）
            spg0.set_sources(cfg.sources, cfg.sourcesSet)    // 音源勾选记忆 ✓
            // 两个线程入口：**必须**是本文件（入口脚本）的具名函数 ⇒ 当值交给它 ✓（见文件头 ⚠⚠）
            spg0.set_workers(search_src_worker, probe_worker)
            // ---- 7 个回调（"要宿主出手"的那几件事 ✓ 见 search_page 文件头）----
            spg0.set_on_dirty(func() { mark_dirty() })
            spg0.set_on_dl_checked(func() { onDownloadChecked() })
            spg0.set_on_dl_selected(func() { onDownloadSelected() })
            spg0.set_on_dbl_play(func(int row) { playFrom(0, row) })
            spg0.set_on_ctx_menu(func(int row) { menuCtx = 0; buildMenu(row) })
            spg0.set_on_ctx_select(func(int row, string id) { menuCtx = 0; onMenu(row, id) })
            spg0.set_on_search_done(func(int hits, int hidden, int ms) {
                // ★ 搜索自检收尾（`DSEARCH=<词>`）：打印结果后走正常退出路径（见 gAutoSearch 的注释 ✓）
                if gAutoSearch != "" {
                    print("[dsearch] 命中 " + _str(hits) + " 首 / 隐藏 " + _str(hidden) + " 首 / 耗时 " + _str(ms) + " ms\n")
                    gAutoSearch = ""
                    // ⚠ 配了双击/播放自检就**先别退**（`DSEARCH=… DDBL=1`）：行刚进表、本拍马上要退
                    //   ⇒ 注入根本没机会 ✗（由那两道钩子在自己断言完再 requestExit ✓ 见 gDblTarget 注释 ✓）
                    if gDblStep == 0 and gPlayStep == 0 { SDL3.requestExit() }
                }
            })
            // ---- 摆"四行一表"（顺序与拆分前**逐行一致** ✓）----
            page0.add(spg0.make_search_row(), {grow: 0, shrink: 0, align: 3})
            //   ⚠ 源行是**交叉**的：本页的复选框在前、宿主的"输出目录 + 选择目录"在后 ✓
            //     （所以页只把复选框"追加"进这一行 ⇒ 视觉与拆分前一模一样 ✓）
            var row2 = SDL3.createHBox({h: 30, pad_x: 0, pad_y: 0, spacing: 10})
            row2.add(SDL3.createLabel({text: "音源：", font_size: 13}), {grow: 0, shrink: 0, align: 1})
            spg0.build_sources_into(row2)
            // ★ 弹性空隙放在这里 ⇒「输出目录 + 路径 + 选择目录」整组被推到**行右侧**、
            //   贴着"选择目录"按钮（原来空隙在路径标签上，把它顶到了复选框旁边 ✗）
            row2.add(SDL3.createLabel({text: ""}), {grow: 1, shrink: 0, align: 1})
            row2.add(SDL3.createLabel({text: "输出目录：", font_size: 13}), {grow: 0, shrink: 0, align: 1})
            dirLbl = SDL3.createLabel({text: outdir, font_size: 12, truncate: 1, max_w: 320.0})
            dirLbl.set_tip(outdir)
            // grow:0（不再抢剩余空间） + shrink:1（窗口变窄时由它让位 ⇒ 配合 max_w 走省略号）
            row2.add(dirLbl, {grow: 0, shrink: 1, align: 1})
            dirBtn = SDL3.createButton({w: 88, h: 28, text: "选择目录", font_size: 13})
            dirBtn.on_click(func() { onPickDir() })
            row2.add(dirBtn, {grow: 0, shrink: 0, basis: 88, align: 3})
            page0.add(row2, {grow: 0, shrink: 0, align: 3})
            page0.add(spg0.make_action_row(), {grow: 0, shrink: 0, align: 3})
            page0.add(spg0.make_table(), {grow: 1, shrink: 1, align: 3})
            // ---- 忙指示（属搜索页 ⇒ 挂 page0 ✓ 本体见上面（**建页之前**就建好了 ✓））----
            page0.add(busyBar, {grow: 0, shrink: 0, align: 3})
            // ---- 状态行（页内那条 ✓ 本文件拿它的引用写别的信息 ⇒ 见 status_label ✓）----
            stateLbl = spg0.status_label()
            page0.add(spg0.make_status_row(), {grow: 0, shrink: 0, align: 3})
        }

            // ---- 页签：0 = 搜索、1 = 榜单 ----
                      //   ★ 做法照 leno_gui/应用/数据看板/dashboard.leno：TabControl **隐藏标签栏**
            //     （`show_header:false`）当纯页面容器，切页由左侧按钮 `set_active` 驱动 ✓
                  //   ⚠ `tabs` 仍要照常传（`set_active` 按下标校验 ⇒ 越界/同页被TabControl 自己忽略 ✓）
               //   ⚠ 不用 `tab_h:0` 代替 show_header：那样标签文字照样画，只是画在上方 ⇒ 换个位置就露馅 ✗
               //   ⚠ bg_color 必须显式给：Tab 内容区用自己的 _bgColor 打底（默认取主题色 ⇒ 与页面浅灰
              //     不一致，会看到一条明显色带 ✗）
                // ---- 左侧导航 + 页签内容 ----
                        //   ⚠ **侧栏要窄**：搜索页表格自然宽 986px 已经超过窗口 1060 能给的宽度
                        //     ⇒ 侧栏每宽 1px 都从表格那里扣（dashboard 那种 190px 文字侧栏更不行 ✗
                        //     —— 这里的横向预算和仪表盘完全不同）
                        //   ★ 侧栏 = **按钮宽 + 12**，不是按钮宽本身（2026-10-09 修「两个入口看着没居中」✓）：
                        //     根容器有 padX=12 ⇒ 按钮左边天然有 12px 空白；侧栏若只给按钮宽，按钮**右**
                        //     边就是 0（紧贴页签）⇒ 左 12 / 右 0 看着整组偏左 ✗（用户截图指的就是它 ✓）
                        //     现在侧栏做 12 + 按钮 + 12（左侧那 12 由根容器给 ⇒ 这里只补右侧 12 ✓）：
                        //     按钮 92 ⇒ 侧栏 104。按钮在侧栏里 **align:0 左贴**（居中反而会变成左 18 / 右 6 ✗
                        //     见 sdl_layout 的 VBox `align:1` 是"在侧栏内居中"，不是"相对窗口居中" ✓）
                        //     ⇒ 按钮左右各 12px 空白，视觉居中 ✓（代价：页签窄，无妨 ✓）
                        //   ⚠ Button 的两个坑（都实测踩过）：
                            //     ① `background` 是**开关**（true/false），颜色要另外给 `bg_color`
                                //        —— 传颜色给它会打 `[ui] 警告` 并按 true 处理（按钮停在默认 primary 蓝 ✗）
                                //     ② Button 的**默认底色就是 primary 蓝** ⇒ 启动必须主动同步一次选中态
                              //        （`tab.on_change` 只在切页时回调，不主动调一次开局就是两个蓝按钮 ✗）
                        //   ★ 图标（2026-10-09 用户提供 ✓）：搜索 = `images/sousuo.png`、
                        //     榜单 = `images/bangdan.png`（48×48 蓝色**描边**线性图标 + 透明底 ✓）
                        //     · 尺寸 20：描边只有 3px/48 ⇒ 缩到 18 时不足 1.1px，看着发虚 ✗
                        //       （旧的 music.png / list.png 是**实心**图，18px 够；描边图要大一档 ✓）
                        //     · 仍用 `image_tint`（选深字 / 未选灰字）：黄色选中底上"蓝图标"会发闷 ✗
                        //       ⇒ 跟着文字色走最干净 ✓；tint 是**调制**，蓝色底子会让灰偏冷一点，
                        //       所以 `onTabChanged` 里**每次切页都同步一次 tint**（与文字色同源 ✓）
                        //   ★ 尺寸（2026-10-09 调大 ✓ 原先又扁又小）：**92 × 36**、图标 20、字号 14
                        //     ⚠ 两处旧坑一起修掉了：
                        //       ① `h:28` 被 `add(..., basis:24)` **改写成 24**（布局用 basis 当主轴尺寸 ✓）
                        //          ⇒ 按钮其实只有 24 高、比看上去还扁 ✗ ⇒ 现在 h 与 basis **同写 36** ✓
                        //       ② 框架里图标尺寸被 `h - 2*pad`（pad=6）**钳位** ⇒ h=24 时图标只能是 12px
                        //          （给了 image_size:18 也没用 ✗）⇒ h=36 时 36-12=24 > 18 ⇒ 图标真的是 18 ✓
                        //     ⚠ **变宽就必须同时修框架的"整块居中"**（2026-10-09 ✓ 已修 sdl_button）：
                        //       框架原先只把**文字**在"图标右边的剩余区"里居中 ⇒ 96 宽时左 6 / 右 30 ✗，
                        //       越宽越偏左（所以"变长"直接卡在这，不是单纯把 w 写大就完事 ✗）
                        //       框架改成 [图标 + 间距 + 文字] 整块居中后，本处只要写 w 即可 ✓
                        var side = SDL3.createVBox({pad_x: 0, pad_y: 16, spacing: 8})
                                                navSearch = SDL3.createButton({w: 92, h: 36, text: "搜索", font_size: 14, padding: 0,
                                      background: true, bg_color: #F2D33CFF, text_color: #1F1F1FFF,
                                image_path: iconNavSearch, image_size: 20, image_gap: 8,
                                image_tint: #1F1F1FFF})
                                navSearch.set_tip("搜索页：关键词 -> 勾选 -> 下载")
                             navSearch.on_click(func() { tab.set_active(0) })
                           side.add(navSearch, {grow: 0, shrink: 0, basis: 36, align: 0})
                                         navBang = SDL3.createButton({w: 92, h: 36, text: "榜单", font_size: 14, padding: 0,
                                background: true, bg_color: #FFFFFFFF, text_color: #5A5A5AFF,
                           image_path: iconNavBang, image_size: 20, image_gap: 8,
                            image_tint: #5A5A5AFF})
                              navBang.set_tip("榜单页：各站排行榜")
                                    navBang.on_click(func() { tab.set_active(1) })
                                side.add(navBang, {grow: 0, shrink: 0, basis: 36, align: 0})
                                  // 弹性空隙放最后 ⇒ 两个菜单项被顶到**上面**（下面留白给以后加"下载队列 / 设置"入口 ✓）
                              side.add(SDL3.createLabel({text: ""}), {grow: 1, shrink: 0, align: 1})

                        tab = SDL3.createTabControl({x: 0, y: 0, w: 992, h: 520,
                            tabs: ["搜索", "榜单"], active: 0, show_header: false, border: false,
                            bg_color: #F5F6F8FF})
                        tab.setPageLayout(0, page0)              // 页 0 = 搜索页（布局驱动 ✓）
                        // ★ 页 1 = 榜单页：**整页在 bang_page.leno** ✓ 这里只"建 + 装 + 接线"（2026-10-11 ✓）
                        //   五个回调逐一对应它文件头列的那五件事（置脏 / 右击 / 选中 / 双击 / 自检收尾 ✓）
                        bang = bangpg.create_bang_page(rowIcon, cfg.bangSrc, cfg.bangId, cfg.bangOnly,
                                                       gBangSizeCheck, gBangOnlyCheck)
                        if bang is BangPage => bpg {
                            // ⚠ 这三个是**线程入口**：必须是本文件（入口脚本）的具名函数 ⇒ 当值交给它 ✓
                            //   （模块自己写的 worker 会被 threads.start 拦 ✗ 见本文件顶部那段 ⚠）
                            bpg.set_workers(bang_menu_worker, bang_worker, bang_fill_worker)
                            bpg.set_on_dirty(func() { mark_dirty() })
                            // 右击：宿主得先**认领"这次菜单落在哪张表"**，它的 ctx_* 访问器才落到榜单页 ✓
                            bpg.set_on_ctx_menu(func(int row) { menuCtx = 1; buildMenu(row) })
                            bpg.set_on_ctx_select(func(int row, string id) { menuCtx = 1; onMenu(row, id) })
                            bpg.set_on_dbl_play(func(int row) { playFrom(1, row) })
                            bpg.set_on_selfcheck_done(func() {
                                // ⚠ 开着 DSHOT 时**别抢着退**：把截图帧推到"补完之后"（此刻表格才是最终样子 ✓）
                                //   （这段决策原先写在榜单页的 finishBangFill 里 ✗ ⇒ 只有宿主知道帧号 ⇒ 收上来 ✓）
                                if dlShot == "" { SDL3.requestExit() } else { dlShotAt = dlFrames + 2 }
                            })
                            tab.setPageLayout(1, bpg.make_page())    // 页 1 = 榜单页 ✓
                        }
                  tab.on_change(func(int idx) { onTabChanged(idx) })

                        // 侧栏 + 页签内容并排（TabControl 吃剩余宽度 ⇒ 窗口缩放时页内跟着重排 ✓）
                        var body = SDL3.createHBox({pad_x: 0, pad_y: 0, spacing: 0})
                        body.add(side, {grow: 0, shrink: 0, basis: 104, align: 3})
                        body.add(tab, {grow: 1, shrink: 1, align: 3})
                root.add(body, {grow: 1, shrink: 1, align: 3})

          // ---- 播放条（★ 2026-10-09：移到 TabControl **外面** ⇒ 切页不打断播放 ✓）----
                //   它自带两行：① 歌名 + 进度 + 时间  ② 上一首/播放/下一首/循环 + 音量 + 重扫 + 序号
                //   目录 = 输出目录（downloads/ ⇒ 播的是已下好的本地文件 ✓）
           pbar = pb.create_player_bar(outdir, imgDir, stateLbl)
                root.add(pbar.box, {grow: 0, shrink: 0, align: 3})

                // ---- 下载编排 + 边下边播（★ 2026-10-11 整块搬去 dl_flow.leno ⇒ 这里只建 + 接线 ✓）----
                //   ⚠ 得在 stateLbl（搜索页建 ✓）与 pbar 都就位**之后**建 —— 同 busyBar 那次的教训 ✓
                DlFlow fl0 = dlf.create_dl_flow(stateLbl, pbar, lyricBox, cfg)
                fl0.set_outdir_provider(func(): string { return outdir })   // 活口：用户改目录立刻生效 ✓
                // ⚠ dl_worker_shard 是**线程入口** ⇒ 必须是本文件（入口脚本）的具名全局函数 ⇒ 当值交给它 ✓
                //   （模块里写不出合法线程入口 ✗ 见本文件顶部那段 ⚠）
                fl0.set_dl_worker(dl_worker_shard)
                flow = fl0

                // ★ 启动时**主动同步一次**侧栏选中态：
    //   · `tab.on_change` 只在**切页**时回调 ⇒ 不这么调一次，开局两个按钮会停在
        //   Button 的**默认底色（primary 蓝）** ✗（`background` 构造参数会被默认 type 覆盖 ⇒ 实测）
  onTabChanged(0)
        win.setRootAt(root, 0, titleH)
    }

    // ---- 切页：第一次进榜单页才拉菜单（懒加载 ⇒ 不拖慢启动 ✓）----
    func onTabChanged(int idx) {
            curPage = idx
            // 选中态：黄底 + 深字（图标**跟着文字色**一起切 ✓ —— `set_image_tint` 是运行时接口 ✓）
            //   两个入口都走这一个回调（点侧栏按钮 / 程序 set_active）⇒ 状态不会漂移 ✓
            //   ⚠ 图标色必须在这里同步：`image_tint` 只在构造时给 = 切页后图标还留着上一个态的颜色 ✗
            if idx == 0 {
                    navSearch.set_bg_color(#F2D33CFF)
                      navSearch.set_text_color(#1F1F1FFF)
                      navSearch.set_image_tint(#1F1F1FFF)
                      navBang.set_bg_color(#FFFFFFFF)
                  navBang.set_text_color(#5A5A5AFF)
                  navBang.set_image_tint(#5A5A5AFF)
                    } else {
                  navSearch.set_bg_color(#FFFFFFFF)
                        navSearch.set_text_color(#5A5A5AFF)
               navBang.set_bg_color(#F2D33CFF)
              navBang.set_text_color(#1F1F1FFF)
              navBang.set_image_tint(#1F1F1FFF)
              navSearch.set_image_tint(#5A5A5AFF)
                    }
       // ★ 2026-10-11：进榜单页 ⇒ 交给榜单页自己（首次进它会套上"上次看的站点"并拉菜单 ✓）
       //   ⚠ 别在这儿替它做：`set_selected` 会触发 on_change，而两条线程共用一个槽位 ✗
       //     （那段说明现在写在 bang_page.on_shown 里 ✓ 单一事实来源 ✓）
       if idx == 1 {
           if bang is BangPage => bp { bp.on_shown() }
       }
          SDL3.markFrameRedraw()
      }


    // ==================== 事件与主入口 ====================

    // 还有"在下"的任务吗（决定主窗口能不能直接关 ✓）—— 判据在 dl_flow.is_downloading ✓
    func downloadingNow(): bool {
        if flow is DlFlow => f { return f.is_downloading() }
        return false
    }

    // ★★ 2026-10-11 修（用户实测："窗口都关闭了，偶发音乐还在播放"✗✗）：
    //   原先"停播 + 释放音频设备"只写在 `win.run` **返回之后**（见 run 末尾那段 ✓）——
    //   而框架的主循环**只有等所有在册窗口都销毁才返回** ✗（见 sdl_window 的 `_runWids.len() == 0` ✓）
    //   ⇒ 只要关主窗口那一刻还有别的窗口在册（下载窗口明明开着 / 已经点了"关闭"、但要等**下一拍事件**
    //     才真正销毁的对话框与下载窗口 ✓），`win.run` 就不返回 ⇒ `pbar.shutdown()` 永远跑不到
    //   ⇒ 窗口全没了、`Sound` 还在发声 ✓（"偶发"就是因为要看当时有没有那个窗口在册 ✓）
    //   ⇒ 收尾改两条腿：① 本函数（主窗口一决定关就**立刻**停声 + 让程序整体退出 ✓）
    //                  ② run 末尾那条（requestExit / SDL_QUIT 的路径兜底；两处都可重复调用 ✓）
    func shutdownAudio() {
        if pbar is PlayerBar => b { b.shutdown() }
    }

    func handleEvent(Event ev): bool {
        // ★ 2026-10-11：窗口大小跟着记住（窗口是 Resizable 的 ⇒ 下次开机还是这个大小 ✓）
        //   ⚠ 只记**尺寸**：SDL3 模块有 getSize/setSize，但**没有"取窗口位置"的接口** ✗ ⇒ 位置不记
        //   ⚠ 只在事件里取**快照**存字段（`winW/winH`）：退出路径里窗口可能已经销毁 ⇒ 那时别碰窗口 ✗
        //   ⚠ 拖边框会连发几十条 ⇒ 走 mark_dirty 攒批（见那儿 ✓）
        if ev.isWindowResized() {
            //   ⚠ `win` 是**值类型**（struct）⇒ 别写 `if win != null`（编译器会警告"比较无意义"✗）；
            //     本回调只可能在窗口活着时进来 ✓
            var sz0 = win.getSize()
            winW = sz0.w
            winH = sz0.h
            mark_dirty()
        }
        // ★ 播放条的浮层先看事件：它开着时，点别处 / 按 ESC 由它收起（= 失去焦点即收 ✓）
        //   ⚠ 必须排在下面"ESC 关窗口"**之前**：否则开着歌单按 ESC 会直接退程序 ✗
        if pbar is PlayerBar => pb2 { if pb2.on_event(ev) { return true } }
        // ★ 2026-10-07：改非模态后主窗口才**关得掉**（模态时它的全部事件被跳过 ⇒ 点 ✕ 等于没点）
        //   ⇒ 这里必须拦一下：还在下就直接退，进程一结束线程被带走 ⇒ 可能留下**半截文件** ✗
        //   拦法用框架的 `cancelClose()`（"关闭到托盘"同款机制 ✓）：窗口不关，状态栏说清怎么办
        bool winClose = ev.isQuit() or ev.isWindowClose() or titleBar.is_close_requested()
        bool escQuit = ev.isKeyDown() and ev.scancode() == Scancode.ESCAPE
        if (winClose or escQuit) and downloadingNow() {
            if winClose { win.cancelClose() }      // 只有窗口关闭需要走 cancelClose（框架机制 ✓）
            titleBar.clear_close_request()
            stateLbl.set_text("还有下载在跑 —— 先在下载窗口点「取消」（或关掉它）再退出，免得留下半截文件")
            SDL3.markFrameRedraw()
            return true
        }
        if ev.isQuit() or ev.isWindowClose() {
            flush_settings()                         // ★ 攒批的改动先落盘（此刻控件还在 ✓）
            shutdownAudio()                          // ★ 先停声（见 shutdownAudio 的注释 ✓）
            return false
        }
        if titleBar.is_close_requested() {
            titleBar.clear_close_request()
            flush_settings()                         // ★ 同上：退出前把攒着的那一拍落下去 ✓
            shutdownAudio()                          // ★ 点 ✕ = 退出程序：立刻停声 + 把剩下的窗口一起收掉 ✓
            SDL3.requestExit()
            return false
        }
        if ev.isKeyDown() and ev.scancode() == Scancode.ESCAPE {
            flush_settings()                         // ★ ESC 同口径（见上 ✓）
            shutdownAudio()
            SDL3.requestExit()
            return false
        }
        return true
    }

    func run() {
        // 无控制台：**打包成 exe 后双击不弹黑框** ✓
        //   · 打包器在**语义分析阶段**就会看到这句 `_console(false)`（只认字面量 false/0，
        //     写成变量检测不到 ✗）⇒ 自动改用无控制台的 `leno_vm_gui.exe` 作基底 ✓
        //     （命令行 `--console` 可反过来强制控制台版 ✓；两者优先级见 main.c 的注释 ✓）
        //   · ★ 为什么套一层"是否打包"：开发态 `build\leno.exe app.leno` 是从终端启的，
        //     `_console(false)` 会把**你那个终端窗口**一起藏掉 ✗
        //     判据用文档给的那条（打包指南 §7）：**打包后 `res_dir() != script_dir()`** ✓
        if dirs.res_dir() != dirs.script_dir() { _console(false) }
        SDL3.ttfInit()
        SDL3.setTheme(SDL3.lightTheme())
        // 读设置（文件不存在 / 坏了 ⇒ 出厂默认 ✓，见 dl_settings.load）——**建窗口之前**读：
        //   ① "默认带歌词"要能直接套到工具栏那个勾选框上（setupUI 之前 ✓ 老口径 ✓）
        //   ② ★ 2026-10-11：**窗口尺寸**也要在这儿定（createWindow 就得给 w/h ✓）
        cfg = dlset.load()
        // ★ 窗口尺寸：记住上次的（0 = 没存过 ⇒ 出厂 1060×680 ✓；下限已在 load 里钳到 780×460 ✓）
        int w0 = dlset.WIN_W_DEF
        int h0 = dlset.WIN_H_DEF
        if cfg.winW > 0 { w0 = cfg.winW }
        if cfg.winH > 0 { h0 = cfg.winH }
        win = SDL3.createWindow({title: "Leno 音乐下载器", w: w0, h: h0, flags: 0x20})
        if not win.ok {
            SDL3.ttfQuit()
            return
        }
        win.setMinSize(780, 460)
        // 尺寸**快照**（退出前落盘用 ✓ 见 handleEvent 的 resize 分支）：别在退出时现问窗口 ✗
        winW = w0
        winH = h0

        // 窗口 / 任务栏图标（运行时）：**PNG 直接可用** ✓（`win.setIcon` 内部会把像素拷进窗口
        //   ⇒ 拷完即可释放 surface ✓）
        //   ⚠ 这跟"打包进 exe 的图标"是两码事：exe 那个**只认 .ico** ✗
        //     （见 docs/单文件打包使用指南.md §4.2：PNG/JPG 必须先转成 ICO 容器 ✓）
        string appIcon = dirs.join(dirs.res_dir(), "images", "index.png")
        if files.exists(appIcon) {
            var iconSurf = SDL3.loadImage(appIcon)
            if iconSurf != null {
                win.setIcon(iconSurf)
                SDL3.destroySurface(iconSurf)
            }
        }

        // 输出目录：★ 2026-10-11 起**记住上次选的**（用户实测：每次开机都要重选一遍 ✗）
        //   没存过 / 存的是空串 ⇒ 出厂默认 = 脚本目录/downloads（与 CLI 版一致，两边的下载文件放一处）
        outdir = dirs.script_dir() + _sep() + "downloads"
        if cfg.outdir != "" { outdir = cfg.outdir }
        //   ⚠ 格式偏好（`cfg.fmt`）不在这儿套 ✗ —— 它归**搜索页**（`set_fmt_pref` 在 setupUI 建页时调 ✓
        //     下拉的选项要等搜完才填 ⇒ 那之前它只是"记着" ✓ 见 search_page 的 fmtPref 注释 ✓）

        setupUI()
        // ★ 自检钩子：DBANG=1 ⇒ 启动就切到「榜单」页（照数据看板 dashboard 的 DPAGE 约定 ✓）
        //   配合 DSHOT 用：DBANG=1 DSHOT=x.png DSHOT_AT=150 ⇒ 能截到榜单加载完的样子 ✓
        var dbang = _env("DBANG")
        if dbang != null and _int(_str(dbang)) > 0 {
            tab.set_active(1)
            // DBANGSRC=<1..4>顺带选中某个站点（自检用：kuwo/qq 是**内置菜单**、瞬时 ✓；
            //   netease/kugou 的菜单是**现拉接口** ⇒ 另一条代码路径，得单独验 ✓）
            //   ★ 2026-10-11：改走榜单页的口子（`select_src` 与用户点下拉同一条路 ✓）
            var dbs = _env("DBANGSRC")
            if dbs != null {
                int si = _int(_str(dbs))
                if si > 0 and si <= 4 {
                    if bang is BangPage => bpg { bpg.select_src(si - 1) }
                }
            }
        }
        // ⚠ setupUI 之后才能碰控件：状态栏报一下并行度 ✓
        //   （"默认带歌词"已在建那个勾选框时套上 `cfg.lyric` ✓ 见 setupUI 里的 lyricBox ✓ 别在这儿再来一次 ✗）
        // ★★ 2026-10-11：**上次用的**也套回来（用户实测："音量这些居然没有保存，二次打开就归 0" ✓）
        //   音量/循环走 PlayerBar 的口子（宿主不直接摸 Player/控件 ✓ 见 set_volume_pct 的注释）；
        //   套初值**不置脏** ⇒ 不会"开机就平白写一次盘" ✗（set_volume_pct 直接写滑块字段 ⇒ 不触发回调 ✓）
        if pbar is PlayerBar => pb0 {
            // ⚠ 顺序要紧：**先套初值、后装回调** —— 套初值时控件可能回调 on_change（值变了才会 ✓
            //   见 sdl_slider:92），此刻回调还没装 ⇒ 不会置脏 ⇒ 不会"开机就平白写一次盘" ✓
            pb0.set_volume_pct(cfg.volume)
            pb0.set_loop_mode(cfg.loop)
            // 用户动了"要记住"的东西（拖音量 / 点循环）⇒ 宿主攒批落盘 ✓
            pb0.set_on_state_change(func() { mark_dirty() })
        }
        stateLbl.set_text("就绪（并行 " + _str(cfg.workers) + " 线程；标题栏右上「下载 / 设置」两个图标）")
        // 全局 120ms 一拍：搜索进度、下载进度、"忙"指示（定时器是模块级全局的 ⇒ 模态对话框
        // 打开期间照样触发，所以下载进度条能在模态窗里动起来 ✓）
        win.addTimer(120, func() { onTick() })
        // ★ 33ms 只为一件事：让播放条左边的**唱片转起来**（120ms 一拍太卡 ✗）。
        //   不播时 `animate()` 立刻返回 ⇒ 不在播就是零开销 ✓（见 player_bar.animate ✓）
        win.addTimer(33, func() {
            if pbar is PlayerBar => b { b.animate() }
        })

        // ---- 自检钩子（见文件头那段 ✓）：截图/自动退出必须放**叠加层** ----
        //   叠加层在所有控件/弹层之后、present 之前 ⇒ 此刻帧才完整 ✓
        //   （放 onRender 回调里读只能拿到"只有底色"的空白图 ✗ —— dashboard 踩过 ✓）
        if dlShot != "" or dlAuto > 0 {
            win.setOverlay(func(Renderer r) {
                dlFrames = dlFrames + 1
                if dlShot != "" and dlFrames >= dlShotAt {
                    var wsz = win.getSize()
                    // DCROP=<高> ⇒ 只截最下面这一条 ✓（小图看不清按钮/悬停时非常有用 ✓）
                    int cy2 = 0
                    int ch2 = wsz.h
                    var cp = _env("DCROP")
                    if cp != null { ch2 = _int(_str(cp)); cy2 = wsz.h - ch2 }
                    var s = r.readPixelsAt(0, cy2, wsz.w, ch2)
                    bool ok = false
                    if s != null { ok = SDL3.saveImagePNG(s, dlShot) }
                    print("[musicdl] 截图 " + dlShot + " ok=" + _str(ok) + " 帧=" + _str(dlFrames) + "\n")
                    _exit(0)
                }
                if dlAuto > 0 and dlFrames >= dlAuto {
                    print("[musicdl] DAUTO=" + _str(dlAuto) + " 帧跑完 -> 退出\n")
                    _exit(0)
                }
            })
        }

        win.run(
            func(Event ev): bool { return handleEvent(ev) },
            func(Renderer r) { }
        )
        // ★ 退出前收摊：**释放音频设备** ✓
        //   `player` 的 `Sound` 会占着 miniaudio 的设备与线程；不释放的话点退出可能"卡着" ✗
        //   ⚠ 本处是**兜底**：点 ✕ / ESC 那条路已经在 handleEvent 里提前停过声了（见 shutdownAudio 的
        //     注释 ✓）；这里覆盖的是 SDL_QUIT / `requestExit()`（自检钩子）那几条不进 handleEvent 的路 ✓
        //   （shutdownAudio 可重复调用：`Player.close()` 里 sound 已为 null 就直接过 ✓）
        //   ⚠ 这里**不能**补 `flush_settings()` ✗：走到这儿窗口已经销毁、控件都 dispose 了，
        //     再读它们（滑块值 / 勾选框）不安全 ⇒ 攒批的落盘一律放在 handleEvent 的退出分支里 ✓
        shutdownAudio()
        SDL3.ttfQuit()
    }

    // ==================== 无头自检钩子（onTick 的自检块收口 ✓ 2026-10-11）====================
    //   全部由环境变量驱动（见各 gXxx 全局的注释 ✓）；一个都没开时每拍只做几次判断 ⇒ 零成本 ✓
    //   ⚠ 四个方法之间的**相对次序**与收口前一致（有的断言依赖前一拍留下的状态 ✓）⇒ 别调换调用顺序 ✗
    func selfcheck_dl_tick() {
        // ★ 空任务开窗 自检（`DDLOPEN=1`，见 gDlOpenCheck 注释 ✓）：第 3 拍调一次标题栏那个入口
        if gDlOpenCheck {
            gDlOpenTick = gDlOpenTick - 1
            if gDlOpenTick <= 0 {
                onDownloadAction()                    // ← 就是标题栏那个「下载」图标做的事
                bool opened = false
                int n = -1
                if flow is DlFlow => fl0 {
                    DlWindow? dw = fl0.dl_ref()
                    if dw is DlWindow => w {
                        opened = w.open
                        n = w.jobs.len()
                        if gDlOpenHist {
                            w.tabs.set_active(1)      // 切到「历史」页签（只为看图 ✓）
                            SDL3.markFrameRedraw()
                        }
                    }
                }
                bool pass = opened and n == 0
                print("[ddlopen] " + (if pass then "通过" else "**不通过**") + "：窗口开着=" + _str(opened)
                      + " 任务=" + _str(n) + "\n")
                gDlOpenCheck = false
                if dlShot != "" {
                    dlShotAt = dlFrames + 3
                } eif not gDlOpenStay {
                    _exit(0)
                }
            }
        }
        // ★ 下载 + 历史 自检（`DDL=<关键词>`）：搜索 → 下第 1 首 → 等跑完 → 切「历史」页 → 打印断言
        //   为什么要它：这条链是"联网 × 线程 × 落盘 × 写历史" —— "下完了但历史没记上"这种问题
        //   光看代码发现不了（notehistory 挂在消息分支上 ✗），必须真跑一遍 ✓
        //   ⚠ 挑**免费曲**的关键词（付费曲会因取直链失败而记成"失败"，那是另一回事 ✗）
        if gAutoDl != "" {
            if gDlStep == 0 {
                if page is SearchPage => sp0 { sp0.start_search(gAutoDl) }   // 填词 + 起搜（= 按回车 ✓）
                gDlStep = 1
                gDlWait = 0
            } else if gDlStep == 1 {
                gDlWait = gDlWait + 1
                if not search_busy() and searchRowCount() > 0 {
                    // 挑**第一首可下的**（有体积 = 拿得到直链 ✓）：否则撞上付费曲会记成"失败"，
                    //   那测的就不是"历史有没有记上"了 ✗
                    Array[Array[string]] pick = []
                    Array[Array[string]] all = search_rows_all()
                    for all to s {
                        if pick.len() == 0 and eng.has_size(s) { pick.add(s) }
                    }
                    if pick.len() > 0 {
                        if flow is DlFlow => fl1 { fl1.start_download(pick) }   // 只下 1 首（可控、快 ✓）
                        gDlStep = 2
                        gDlWait = 0
                    } else if gDlWait > 500 {
                        print("[ddl] **不通过**：这一页没有可下的行（换关键词，或等接口恢复）\n")
                        gAutoDl = ""
                        _exit(1)
                    }
                } else if gDlWait > 500 {
                    print("[ddl] **不通过**：等不到搜索结果（" + gAutoDl + "）\n")
                    gAutoDl = ""
                    _exit(1)
                }
            } else if gDlStep == 2 {
                gDlWait = gDlWait + 1
                bool fin = false
                if flow is DlFlow => fl2 {
                    DlWindow? dw = fl2.dl_ref()
                    if dw is DlWindow => w { if w.finished { fin = true } }
                }
                if fin {
                    gDlStep = 3
                    gDlWait = 0
                } else if gDlWait > 1000 {
                    print("[ddl] **不通过**：下载没跑完（超时）\n")
                    gAutoDl = ""
                    _exit(1)
                }
            } else if gDlStep == 3 {
                int n = 0
                string first = ""
                string st = ""
                string sz = ""
                if flow is DlFlow => fl3 {
                    DlWindow? dw = fl3.dl_ref()
                    if dw is DlWindow => w {
                        w.tabs.set_active(1)              // 切到「历史」页（顺便验证页签可用 ✓）
                        n = w.histItems.len()
                        if n > 0 {
                            first = hist.hlabel(w.histItems[0])
                            st = hist.hstatus(w.histItems[0])
                            sz = hist.hsize(w.histItems[0])
                        }
                    }
                }
                bool ok = n > 0 and st == "完成"
                print("[ddl] " + (if ok then "通过" else "**不通过**") + "：历史 " + _str(n) + " 条　最新="
                      + first + " | " + sz + " | " + st + "\n")
                gAutoDl = ""
                if dlShot == "" { _exit(0) } else { dlShotAt = dlFrames + 2 }
            }
        }
    }

    // 播放/浮层类：DPLAY（先本地后流）/ 关于弹窗 / 悬停 / 歌词浮层
    func selfcheck_play_tick() {
        // 播放自检（见 gPlayStep 注释 ✓）：先播一首**本地**、再切一首**没下载**的（复现"进度条不动" ✓）
        //   全**离线**：A/B 两首都拿下载目录里已有的音频 ⇒ 不需要联网（只有声音需要一个音频设备 ✓）
        if gPlayStep > 0 {
            gPlayTick = gPlayTick + 1
            if gPlayStep == 1 {
                // ① 扫一遍下载目录，拿两首真音频（A = 当"本地那首"、B = 当"边下边播那首"）
                if pbar is PlayerBar => b {
                    b.rescan_now()                     // ★ 自检要"返回即齐" ⇒ 用同步版（界面「重扫」走异步 ✓）
                    if b.p is Player => q {
                        int need = 2                       // 离线版要 A/B 两个文件；联网版只用 A ✓
                        if gPlayMode == 2 { need = 1 }
                        if q.list.len() >= need {
                            gPlayFileA = q.list[0]
                            if q.list.len() >= 2 { gPlayFileB = q.list[1] }
                            q.set_volume(0.0)        // 自检**不出声**（音量不写盘 ✓ 见 set_volume 的注释 ✓）
                            print("[dplay] 先播本地：" + dirs.basename(gPlayFileA)
                                  + (if gPlayMode == 2 then "（联网版：待会儿播搜索结果里没下载的那首 ✓）"
                                     else "　B=" + dirs.basename(gPlayFileB) + "（离线版：B 当「流」顶一手 ✓）") + "\n")
                            b.set_queue(gPlayNames, [gPlayFileA, ""], gPlayNames, outdir, 0)
                            gPlayStep = 2
                            gPlayTick = 0
                        } else {
                            print("[dplay] 跳过：下载目录里音频太少（离线版要 2 首 / 联网版要 1 首 ✓）\n")
                            gPlayStep = 0
                            if dlShot == "" { SDL3.requestExit() }
                        }
                    }
                }
            } eif gPlayStep == 2 and gPlayTick >= 20 {
                // ② 本地那首播了约 2.4 秒 ⇒ 记下它的"位置 / 时长"（等会儿和流那边对照 ✓）
                if pbar is PlayerBar => b {
                    gPlayLocalPos = b.pos_secs()
                    gPlayLocalDur = b.dur_secs()
                    print("[dplay] 本地态：位置=" + _str(_int(gPlayLocalPos)) + "s　时长=" + _str(_int(gPlayLocalDur))
                          + "s　在流=" + _str(b.is_streaming()) + "\n")
                    if gPlayLocalPos <= 0.0 {
                        print("[dplay] 跳过：本地那首没放起来（本机没音频设备？）⇒ 这条自检要真播才行\n")
                        gPlayStep = 0
                        if dlShot == "" { SDL3.requestExit() }
                    } else {
                        if gPlayMode == 2 {
                            gPlayStep = 4                  // 联网版：先去等搜索结果（见下 ✓）
                            gPlayTick = 0
                        } else {
                            // ③ 切到**没有本地文件**的那一行 ⇒ 播放器走"边下边播"分支（= 用户点网络播放 ✓）
                            b.set_queue(gPlayNames, [gPlayFileA, ""], gPlayNames, outdir, 1)
                            // ④ 再手动喂"首片落盘"这一步 —— 宿主收到 dl_engine 的 "start" 消息时调的就是它 ✓
                            //    （离线复现的关键：真正的流是文件一路变大，这里用 B 这个完整文件顶上，
                            //      只验"**流的音频对象到底建没建起来**"这一个点 ✓）
                            b.begin_stream(gPlayFileB)
                            gPlayStep = 3
                            gPlayTick = 0
                        }
                    }
                }
            } eif gPlayStep == 4 {
                // 联网版：等搜索结果（配 `DSEARCH=<词>` ✓）⇒ 挑**第一首没下载的**，走真链路 ✓
                Array[Array[string]] srows = search_rows_all()
                if srows.len() > 0 {
                    Array[string] lls2 = eng.resolve_locals(srows, outdir)
                    int i3 = 0
                    int pick = -1
                    while i3 < srows.len() {
                        if lls2[i3] == "" and pick < 0 { pick = i3 }
                        i3 = i3 + 1
                    }
                    if pick < 0 {
                        print("[dplay] 跳过：这批搜索结果**全都已下载**（联网版要一首没下过的 ✓）\n")
                        gPlayStep = 0
                        if dlShot == "" { SDL3.requestExit() }
                    } else {
                        print("[dplay] 联网版：播搜索结果第 " + _str(pick) + " 行（没下载 ⇒ 真边下边播 ✓）\n")
                        playFrom(0, pick)
                        gPlayStep = 3
                        gPlayTick = 0
                    }
                } eif gPlayTick > 400 {
                    print("[dplay] 跳过：等了 400 拍搜索结果还没回来（联网自检，网络不通就算了 ✓）\n")
                    gPlayStep = 0
                    if dlShot == "" { SDL3.requestExit() }
                }
            } eif gPlayStep == 3 {
                if pbar is PlayerBar => b {
                    if gPlayTick == 8 or gPlayTick == 24 or gPlayTick == 40 or gPlayTick == 56
                       or gPlayTick == 88 or gPlayTick == 120 {
                        print("[dplay] 流 t=" + _str(_int(gPlayTick)) + "：位置=" + _str(_int(b.pos_secs()))
                              + "s　时长=" + _str(_int(b.dur_secs())) + "s　在流=" + _str(b.is_streaming())
                              + "　已下=" + _str(_int(b.buf_ratio() * 100.0)) + "%\n")
                    }
                    // 联网版要等首片落盘（下载起线程 + 拉第一片）⇒ 判定的时间点给宽一点 ✓
                    int due = if gPlayMode == 2 then 120 else 64
                    if gPlayTick >= due {
                        float p2 = b.pos_secs()
                        float d2 = b.dur_secs()
                        // 期望：位置自己在走（>1s ✓）＋ 时长是**这一首**的（≠ 上一首本地那首 ✓）
                        bool okp = p2 > 1.0 and d2 > 0.0 and _int(d2) != _int(gPlayLocalDur)
                        print("[dplay] " + (if okp then "通过" else "**不通过**")
                              + "：切到边下边播后 位置=" + _str(_int(p2)) + "s　时长=" + _str(_int(d2)) + "s"
                              + "（上一首本地=" + _str(_int(gPlayLocalDur)) + "s"
                              + " ⇒ 时长对上上一首 = 流的声**没建起来** ✗）\n")
                        gPlayStep = 0
                        if dlShot == "" { SDL3.requestExit() }
                    }
                }
            }
        }
        // 「关于」弹窗自检（见 gAboutTick 注释 ✓）：第 N 拍自动打开它 ✓
        if gAboutTick > 0 {
            gAboutTick = gAboutTick - 1
            if gAboutTick == 0 { onAbout() }
        }
        // 悬停自检（见 gHoverTick 注释 ✓）：把指针注入到播放键上 ✓
        if gHoverTick > 0 {
            gHoverTick = gHoverTick - 1
            if gHoverTick == 0 {
                if pbar is PlayerBar => b {
                    SDL3.testMoveAt(win.getID(), b.btnPlay.get_x() + b.btnPlay.get_w() / 2.0,
                                                  b.btnPlay.get_y() + b.btnPlay.get_h() / 2.0)
                    print("[dhover] 指针已移到播放键上\n")
                }
            }
        }
        // 歌词浮层自检（见 gLrcTick 注释 ✓）：第 2 拍把「词」面板打开（配 DSHOT 截它的样子 ✓）
        if gLrcTick > 0 {
            gLrcTick = gLrcTick - 1
            if gLrcTick == 0 {
                if pbar is PlayerBar => b { b.toggle_lrc() }
            }
        }
    }

    // 注入点击类：歌单按钮 / 进度条 / 右键菜单 / 双击 / 退出路径
    func selfcheck_click_tick() {
        // ★ 2026-10-18 歌单右击菜单自检（`DPLCTX=1`）：**关掉再右击还能不能弹** ✓
        //   为什么必须有：用户实测"歌单有时右击不出菜单"——真因是框架把浮层捕获区写进了
        //   "无窗口"槽（永远不会被清）⇒ **菜单只能弹一次**，关掉后再右击全被挡住 ✗
        //   （修在 sdl_core.setPopupCapture：无派发上下文时一律不登记 ✓）
        if gPlCtxStep > 0 {
            int ps2 = gPlCtxStep
            gPlCtxStep = gPlCtxStep + 1
            if pbar is PlayerBar => pbx {
                int wid2 = win.getID()
                float cx3 = pbx.lb.x + 60.0
                if ps2 == 2 {
                    pbx.toggle_pop()                 // 先开歌单（tick 里挂上去 ✓）
                } eif ps2 == 4 {
                    SDL3.testMoveAt(wid2, cx3, pbx.lb.y + 13.0)
                    SDL3.testRightClickAt(wid2, cx3, pbx.lb.y + 13.0)
                } eif ps2 == 5 {
                    bool first = pbx.lb.is_context_menu_open()
                    pbx.lb.get_context_menu().close()
                    // 第二次点在**另一个行**上（同时验"关掉之后"这条路 ✓）
                    int r2 = pbx.queue_count() - 1
                    if r2 > 6 { r2 = 6 }
                    if r2 < 0 { r2 = 0 }
                    float cy4 = pbx.lb.y + _float(r2) * 22.0 + 11.0
                    SDL3.testMoveAt(wid2, cx3, cy4)
                    SDL3.testRightClickAt(wid2, cx3, cy4)
                    print("[dplctx] 第一次右击菜单开着=" + _str(first) + "\n")
                } eif ps2 == 6 {
                    bool second = pbx.lb.is_context_menu_open()
                    bool pass = second
                    print("[dplctx] " + (if pass then "通过" else "**不通过**")
                          + "：关掉后再右击，菜单开着=" + _str(second) + "（期望 true）\n")
                    pbx.lb.get_context_menu().close()
                    SDL3.requestExit()
                }
            }
        }
        // 退出路径自检（见 gExitTicks 注释 ✓）
        // 歌单点击自检（见 gClickStep 注释 ✓）：注入真实点击 ⇒ 断言到底有没有落到控件上 ✓
        if gClickStep > 0 {
            int st = gClickStep
            gClickStep = gClickStep + 1
            if pbar is PlayerBar => b {
                int wid = win.getID()
                if st == 1 {
                    // ⚠ 先注入**移动**再点击：只发 down/up 时按钮的 hover 还不成立 ⇒ 点击会**偶发不生效** ✗
                    //   （实测过：同一坐标有时开门、有时不开 ✓ 真人点之前总会有移动 ✓）
                    float bx = b.btnList.get_x() + b.btnList.get_w() / 2.0
                    float by = b.btnList.get_y() + b.btnList.get_h() / 2.0
                    SDL3.testMoveAt(wid, bx, by)
                    bool ok = SDL3.testClickAt(wid, bx, by)
                    print("[dpclick] 注入点「列表」按钮 ok=" + _str(ok)
                          + "  按钮矩形=" + _str(_int(b.btnList.get_x())) + "," + _str(_int(b.btnList.get_y()))
                          + " " + _str(_int(b.btnList.get_w())) + "x" + _str(_int(b.btnList.get_h())) + "\n")
                } eif st == 4 {
                    print("[dpclick] 点完按钮：popOpen=" + _str(b.popOpen)
                          + "  歌单矩形=" + _str(_int(b.lb.x)) + "," + _str(_int(b.lb.y))
                          + " " + _str(_int(b.lb.w)) + "x" + _str(_int(b.lb.h)) + "\n")
                    // 点歌单第 3 行中点（itemH=22 ✓ 见 LIST_ROW）；同样先移动再点 ✓
                    float rx = b.lb.x + 40.0
                    float ry = b.lb.y + 4.0 + 22.0 * 2.0 + 11.0
                    SDL3.testMoveAt(wid, rx, ry)
                    bool ok = SDL3.testClickAt(wid, rx, ry)
                    print("[dpclick] 注入点歌单第 3 行 ok=" + _str(ok) + "\n")
                } eif st == 8 {
                    gClickRow3 = b.cur_index()
                    print("[dpclick] 点歌单第 3 行 -> 下标=" + _str(gClickRow3) + "（期望 2）\n")
                    // 再点**当前正在播的那一行**（第 1 行）：这里最容易"看着没反应" ✗
                    //   （`ListBox` 单选模式下点已选中行**不回调** ✓ ⇒ 靠 on_event 自己算行号 ✓）
                    SDL3.testMoveAt(wid, b.lb.x + 40.0, b.lb.y + 4.0 + 11.0)
                    bool ok = SDL3.testClickAt(wid, b.lb.x + 40.0, b.lb.y + 4.0 + 11.0)
                    print("[dpclick] 注入点「当前行」ok=" + _str(ok) + "\n")
                } eif st == 12 {
                    bool pass = gClickRow3 == 2 and b.cur_index() == 0
                    print("[dpclick] " + (if pass then "通过" else "**不通过**")
                          + "：点第 3 行 -> 下标 " + _str(gClickRow3) + "（期望 2）；"
                          + "再点当前行 -> 下标 " + _str(b.cur_index()) + "（期望 0）\n")
                    SDL3.requestExit()
                }
            }
        }
        // 进度条点击自检（见 gSeekStep 注释 ✓）：注入两次真实点击 ⇒ 断言"只有点在条上才跳转" ✓
        if gSeekStep > 0 {
            int st = gSeekStep
            gSeekStep = gSeekStep + 1
            if pbar is PlayerBar => b {
                int wid = win.getID()
                float sx = b.seekBar.get_x() + 200.0       // 横向取画布中段（条子铺满整宽 ✓ 横向不是判据 ✓）
                float sy = b.seekBar.get_y()
                float ch = b.seekBar.get_h()
                if st == 2 {
                    // ① 点**条子外面**（画布顶端往下 2px）：画布整行高 52、条子只占中间那条 ✓
                    stateLbl.set_text("")                  // 先清空 —— 要断言"一个字都没写"⇒ 得先没有 ✓
                    SDL3.testMoveAt(wid, sx, sy + 2.0)     // ⚠ 先 move 再 click（同 DPCLICK 的实测教训 ✓）
                    bool ok = SDL3.testClickAt(wid, sx, sy + 2.0)
                    print("[dseek] 注入点「条外」ok=" + _str(ok)
                          + "  画布 " + _str(_int(b.seekBar.get_w())) + "x" + _str(_int(ch))
                          + "  点 y=2（条子中心 ≈ " + _str(_int(ch / 2.0)) + "）\n")
                } eif st == 3 {
                    gSeekOffText = stateLbl.get_text()      // 条外点击后的状态栏（期望空串 ✓）
                    gSeekOffFx = b.clickFx                  // 涟漪该冒出来（期望 ≥ 0 ✓）
                    gSeekOffCy = b.clickCy                  // 且**就地**（期望 ≈ 2；条子中心是 26 ✓）
                    // ② 点**条子正中**：这次必须真去跳（没播过 ⇒ 状态栏会写"先播一首再拖进度"✓）
                    stateLbl.set_text("")
                    SDL3.testMoveAt(wid, sx, sy + ch / 2.0)
                    bool ok = SDL3.testClickAt(wid, sx, sy + ch / 2.0)
                    print("[dseek] 注入点「条上」ok=" + _str(ok) + "\n")
                } eif st == 4 {
                    string onBar = stateLbl.get_text()
                    // 涟漪的纵向必须**落在点击处**（≈2）：不是条子中心（≈26）⇒ 证明"就地冒"✓
                    bool local = _int(gSeekOffCy) <= 6
                    bool pass = gSeekOffText == "" and gSeekOffFx >= 0.0 and local and onBar != ""
                    print("[dseek] " + (if pass then "通过" else "**不通过**")
                          + "：条外点击 -> 状态栏=\"" + gSeekOffText + "\"（期望空 ⇒ 只留涟漪）"
                          + " 涟漪=" + (if gSeekOffFx >= 0.0 then "有" else "没有")
                          + " 纵坐标=" + _str(_int(gSeekOffCy)) + "（期望 ≈2 就地，条子中心 " + _str(_int(ch / 2.0)) + "）"
                          + "；条上点击 -> 状态栏=\"" + onBar + "\"（期望非空 ⇒ 真去跳）\n")
                    SDL3.requestExit()
                }
            }
        }
        // 右键菜单自检（见 gCtxStep 注释 ✓）：注入**真实右键** ⇒ 断言菜单建在正确的数据源上
        if gCtxStep > 0 {
            int st = gCtxStep
            gCtxStep = gCtxStep + 1
            if st == 1 {
                int wid = win.getID()
                if gCtxTarget == 2 or gCtxTarget == 4 {
                    // 目标 2 = **搜索表空白处**（row<0）：不必联网、不必先搜 ⇒ 专测"搜索页那条线还通着"
                    // 目标 4 = 同上注入（它只要"菜单开着"这个前提 ✓ 用空白处 ⇒ 免联网 ✓）
                    float bx = searchTableRef().get_x() + 200.0
                    float by = searchTableRef().get_y() + 200.0
                    SDL3.testMoveAt(wid, bx, by)
                    bool ok = SDL3.testRightClickAt(wid, bx, by)
                    print("[dctx] 注入右键到搜索表空白处 ok=" + _str(ok)
                          + (if gCtxTarget == 4 then "（目标 4：接着会切页）" else "") + "\n")
                } else if gCtxTarget == 3 {
                    // 目标 3 = **只测动作**（不点鼠标）：榜单第 0 行 ⇒ 「搜索这首歌（跳到搜索页）」
                    //   ⚠ 要配 DBANG=1 跑：否则当前页已经是搜索页，set_active(0) 不会触发切页回调 ✗
                    if bangRowCount() == 0 {
                        gCtxStep = 1        // 等榜单行（联网）✓
                    } else {
                        menuCtx = 1
                        onMenu(0, "searchthis")
                        print("[dctx] 目标 3：已调用菜单动作 searchthis\n")
                    }
                } else if bangRowCount() == 0 {
                    gCtxStep = 1            // 榜单行还没拉回来（联网）⇒ 下一拍再试 ✓
                } else {
                    // 目标 1 = 榜单表第 0 行：y = 表头 30 + 行高中点 13（row_h=26 ✓ 见 createTable）
                    float bx = bangTableRef().get_x() + 120.0
                    float by = bangTableRef().get_y() + 30.0 + 13.0
                    SDL3.testMoveAt(wid, bx, by)
                    bool ok = SDL3.testRightClickAt(wid, bx, by)
                    print("[dctx] 注入右键到榜单表第 0 行 ok=" + _str(ok)
                          + "  位置=" + _str(_int(bx)) + "," + _str(_int(by)) + "\n")
                }
            } eif st == 3 {
                // 期望：榜单表 ⇒ menuCtx=1 / row=0（那一行）；搜索表空白 ⇒ menuCtx=0 / row<0 ✓
                bool pass = false
                if gCtxTarget == 2 {
                    pass = gCtxSeen == 0 and gCtxRowSeen < 0
                    print("[dctx] " + (if pass then "通过" else "**不通过**")
                          + "：目标=2 -> buildMenu(menuCtx=" + _str(gCtxSeen) + ", row=" + _str(gCtxRowSeen) + ")\n")
                } else if gCtxTarget == 3 {
                    // 期望：切到搜索页（curPage=0）+ 关键词填成"歌名 歌手" + 真的起了搜索 ✓
                    pass = curPage == 0 and search_keyword_now().trim() != "" and search_busy()
                    print("[dctx] " + (if pass then "通过" else "**不通过**")
                          + "：目标=3 -> 切页后 curPage=" + _str(curPage)
                          + "  关键词=\"" + search_keyword_now() + "\""
                          + "  搜索中=" + _str(search_busy()) + "\n")
                } else if gCtxTarget == 4 {
                    // 目标 4 = **切页必须把残留的右击菜单收掉**（2026-10-09 框架修复的回归断言 ✓）
                    //   实测过的 bug：菜单由窗口第二遍统一绘制、只认 isOpen() ⇒ 切页后**照旧显示**，
                    //   而隐藏页收不到事件 ⇒ **点不动也关不掉** ✗（用户原话见 sdl_tab.closePopups ✓）
                    //   修法：TabControl 切页时调 menu.closeContextMenus(hwnd) ✓
                    //   ⚠ 断言就写在**同一拍**：`set_active` 是同步调用（closePopups 立刻跑完 ✓），
                    //     而本回调是**事件驱动**的、不是每帧都来 ⇒ 靠"下一拍再断言"会等不到 ✗
                    gCtxWasOpen = searchTableRef().get_context_menu().isOpen()
                    tab.set_active(1)                                  // ← 真的切一次页 ✓
                    bool nowOpen4 = searchTableRef().get_context_menu().isOpen()
                    pass = gCtxWasOpen and not nowOpen4 and curPage == 1
                    print("[dctx] " + (if pass then "通过" else "**不通过**")
                          + "：目标=4 -> 切页前菜单开着=" + _str(gCtxWasOpen)
                          + "  切页后开着=" + _str(nowOpen4) + "（期望 false）"
                          + "  当前页=" + _str(curPage) + "（期望 1）\n")
                } else {
                    pass = gCtxSeen == 1 and gCtxRowSeen == 0
                    print("[dctx] " + (if pass then "通过" else "**不通过**")
                          + "：目标=1 -> buildMenu(menuCtx=" + _str(gCtxSeen) + ", row=" + _str(gCtxRowSeen) + ")\n")
                }
                // ⚠ 开着 DSHOT 时**别抢着退**：让截图钩子先截到"菜单正开着"的样子 ✓（与 DHOVER 同一套 ✓）
                if dlShot == "" { SDL3.requestExit() }
            }
        }
        // 双击=试听 自检（见 gDblTarget 注释 ✓）：注入两次左键（框架按 400ms/10px 阈值判双击 ✓）
        //   ⚠ 为什么必须有：这条改动是**改语义**（下载 → 试听），而"双击到底还有没有反应"光看代码
        //     看不出来（框架的 dbl 判定在 mouseDown 里做、还要过复选框列 / 表头 / 列重排那几道闸 ✓）
        if gDblStep > 0 {
            int dblSt = gDblStep
            gDblStep = gDblStep + 1
            if dblSt == 1 {
                // 先等"有行"（联网 ✓）：表空了就点不到行 ⇒ 停在 1 重试（与 gCtxStep 同一手法 ✓）
                bool hasRow = searchRowCount() > 0
                if gDblTarget == 2 { hasRow = bangRowCount() > 0 }
                if not hasRow {
                    gDblStep = 1
                    gDblWait = gDblWait + 1
                    // ⚠ 不能无限等：接口被限流 / 关键词无匹配时表会一直空 ⇒ 约 36 秒后报"没等到行"收摊 ✓
                    if gDblWait > 300 {
                        print("[ddbl] **不通过**：等了 " + _str(gDblWait) + " 拍还没有行（搜索/榜单没回来）-> 没法注入\n")
                        gDblStep = 0
                        SDL3.requestExit()
                    }
                } else {
                    Table dt = searchTableRef()
                    if gDblTarget == 2 { dt = bangTableRef() }
                    int wid = win.getID()
                    // 列宽：搜索表 [40,280,…] / 榜单表 [40,300,…] ⇒ x 偏 200 / 150 都稳落在「歌名」列 ✓
                    // 行 y = 表头 30 + 行高 26 的中点 13（与 DCTX 目标 1 同一算法 ✓）
                    float cx2 = dt.get_x() + 200.0
                    float cy2 = dt.get_y() + 30.0 + 13.0
                    SDL3.testMoveAt(wid, cx2, cy2)
                    bool ok1 = SDL3.testClickAt(wid, cx2, cy2)
                    bool ok2 = SDL3.testClickAt(wid, cx2, cy2)
                    print("[ddbl] 注入双击到" + (if gDblTarget == 2 then "榜单表" else "搜索表")
                          + "第 0 行 ok=" + _str(ok1 and ok2)
                          + "  位置=" + _str(_int(cx2)) + "," + _str(_int(cy2)) + "\n")
                }
            } eif dblSt == 4 {
                // 期望：起了**播放队列**（表已喂进去 ✓），且**没**开下载窗口 ✓
                //   ★ 2026-10-09 二次改：双击从"试听（前一段）"变成"播放整表（边下边播）"⇒ 断言跟着变
                int qn = 0
                if pbar is PlayerBar => b { qn = b.queue_count() }
                DlWindow? dw = null
                if flow is DlFlow => f { dw = f.dl_ref() }
                bool dlOpen = dw is DlWindow
                bool ok = qn > 0 and not dlOpen
                print("[ddbl] " + (if ok then "通过" else "**不通过**")
                      + "：目标=" + _str(gDblTarget) + " -> 播放队列入队=" + _str(qn) + " 首"
                      + "  下载窗口=" + _str(dlOpen) + "（期望 false）"
                      + "  状态栏=\"" + stateLbl.get_text() + "\"\n")
                if dlShot == "" { SDL3.requestExit() }
            }
        }
        if gExitTicks > 0 {
            gExitTicks = gExitTicks - 1
            if gExitTicks == 0 {
                print("[diag] 走正常退出路径（requestExit）\n")
                SDL3.requestExit()
            }
        }
    }

    func selfcheck_search_tick() {
        // 搜索自检（见 gAutoSearch 注释 ✓）：第 2 拍界面已建好 ⇒ 自动搜一次
        if gAutoSearch != "" {
            gAutoSearchTick = gAutoSearchTick + 1
            if gAutoSearchTick == 2 {
                if page is SearchPage => sp3 { sp3.start_search(gAutoSearch) }   // 填词 + 起搜（= 按回车 ✓）
            }
        }
    }
}

// ==================== 程序入口 ====================
// 退出路径自检用：`DEXIT=<tick 数>` ⇒ 到点走**正常退出路径**（requestExit，不是 _exit 强杀 ✓）
//   为什么要它：DSHOT/DAUTO 走的都是 `_exit(0)` 强杀 ✗ ⇒ **永远测不出"退出卡住"** ✗（本仓踩过 ✓）
int gExitTicks = 0

// 歌单点击自检：`DPCLICK=1` ⇒ 用**注入真实点击**走一遍「列表」按钮 → 歌单第 3 行 ✓
//   为什么要它：人手点没法进无人值守的断言 ✗；而**直接调控件回调**又测不出"点没点到" ✗
//   （本仓有过"用窗口矩形坐标去点 ⇒ 整体偏一个标题栏高 ⇒ 点在按钮外面"的教训 ✓ 见 sdl_window:277）
int gClickStep = 0
int gClickRow3 = -1     // 自检记录：点第 3 行后的下标（期望 2 ✓）

// 进度条点击自检（`DSEEK=1`）：往**播放条那条进度线**上注入两次真实点击，断言
//   `[dseek] 通过/不通过：条外点击 -> 状态栏="…"（期望空 ⇒ 只留涟漪）；条上点击 -> 状态栏="…"（期望非空 ⇒ 真去跳）`
//   为什么要它（2026-10-11 用户口径）："**只有点在进度条那一条上才跳转**，画布里别处只是点击有波浪" ——
//     这是**改行为**，而且判据是**纵坐标的像素级闸门**（画布整行高 52、条子只占中间 8~12px ✓ 见
//     player_bar.on_seek_bar）：光看代码 / 编译都发现不了"条外那一片到底还跳不跳"✗ ⇒ 必须注入真点击 ✓
//   判据不依赖音频设备（这点很关键：本仓自检要能在没声卡的机器上跑 ✓）：
//     ① 条外点击 ⇒ **一个字的提示都不该写**（状态栏保持空 ✓）但**涟漪要冒**（`clickFx >= 0` ✓）
//     ② 涟漪要**就地**冒：`clickCy` 落在点击的那个 y（≈2）上，而**不是**条子中心（≈26）✓
//     ③ 条上点击 ⇒ 会走 seek 那条路：没播过 ⇒ 状态栏写"先播一首再拖进度"（非空 ✓）
int gSeekStep = 0
string gSeekOffText = ""      // 条外点击后的状态栏（期望空 ✓）
float gSeekOffFx = -1.0       // 条外点击后的涟漪起点（期望 ≥ 0 ✓）
float gSeekOffCy = -1.0       // 条外点击后的涟漪**纵坐标**（期望 ≈ 2，即**就地**而不是条子中心 26 ✓）

// 歌词浮层自检（`DLRC=1` ⇒ 第 2 拍把「词」面板打开 ✓）：
//   为什么要它：歌词浮层是**自绘画布**（折行 / 当前句放大 / 逐字刷色 / **纯文本静态列** ✓）——
//   这些只能"看"，而在无头/自动化里没人能点那颗「词」按钮 ✗；浮层属于**主窗口** ⇒ `DSHOT` 截得到 ✓
//   用法：`DLRC=1 DSHOT=<png> DSHOT_AT=150 build\leno.exe <本文件>`（配 `DCROP` 只截下面那一条 ✓）
//   想连"在播 + 有歌词"一起看：先往 `downloads\` 放同名 `.mp3 + .lrc`，再配 `DPLAY=1` ✓
int gLrcTick = 0

// ★ 2026-10-09：`gPreviewCh / gPreviewThread / PREVIEW_BYTES` 与 `gBgDl*` **整套退役** ——
//   它们服务的是"试听：拉前一段 + 静默下整首"那条老路；现在双击/右键「播放」= 播放整表 + 边下边播，
//   下载由"边下边播"那条单任务通道负责（★ 2026-10-11 起整套在 dl_flow.leno ✓ streamCh 那组字段）

// ★ 2026-10-09：`gPrevRow`（记"试听的是哪一行"）随试听一起退役 ——
//   "歌词面板里点立即下载歌词"现在拿**当前播放队列**（dl_flow.play_rows() ✓ 2026-10-11 搬走）去找那一首 ✓
//   判据同口径（按显示名 ✓）

// 悬停自检（本仓无头环境点不到、移不动鼠标 ⇒ 用注入 ✓）：
//   `DHOVER=1` ⇒ 第 2 拍把指针移到播放键上，配合 `DSHOT` 截图即可验"悬停色到底画没画" ✓
//   用法：DCROP=110 DSHOT=<png> DSHOT_AT=30 DHOVER=1 build\leno.exe <本文件> ✓
int gHoverTick = 0
// 搜索自检（`DSEARCH=<关键词>`）：第 2 拍自动跑一次**真搜索**（勾着的音源全部），
//   收尾时打印 `[dsearch] 命中 X 首 / 隐藏 Y 首 / 耗时 Z ms` 然后正常退出 ✓
//   为什么值得有：本应用的主路径是"手点搜索"，而搜索是**联网 + 两阶段并行**的 ——
//   没有它就只能人手开窗看，并行改造（切片 / join / 阶段切换）一概测不到 ✗
//   用法：DSEARCH=周杰伦\ 晴天 build\leno.exe musicdl_gui.leno
string gAutoSearch = ""
int gAutoSearchTick = 0

// 右键菜单自检（注入**真实右键** ⇒ 断言菜单建在正确的数据源上 ✓）
//   为什么值得有：2026-10-09 用户反馈"榜单没有右击菜单"就是这么漏的 —— 搜索表接了
//   `on_context_will_open`/`on_context_select`，榜单表只接了双击 ✗；光看代码/编译都发现不了，
//   所以这里用**注入真实右键**走一遍框架的完整链路（命中行 → 回调 → buildMenu）⇒ 再漏就当场报错 ✓
//   三种目标：
//     `DBANG=1 DCTX=1` ⇒ 榜单表第 0 行（要先切到榜单页并等行加载 ✓）期望 menuCtx=1 / row=0
//     `DCTX=2`         ⇒ 搜索表**空白处**（不必联网 ⇒ 专测"搜索页那条线还通着" ✓）期望 menuCtx=0 / row<0
//     `DBANG=1 DCTX=3` ⇒ 直接调「搜索这首歌（跳到搜索页）」这个动作（不点鼠标，专测跳页+填词+起搜 ✓）
//     `DCTX=4`         ⇒ **切页必须收掉残留的右击菜单**（2026-10-09 新增 ✓ 框架修复的回归断言）：
//                        搜索表空白处注入右键 ⇒ 记下"菜单开着" ⇒ `tab.set_active(1)` ⇒ 断言已关 ✓
//   （同一套"注入真事件"的惯例见 gClickStep / DHOVER ✓；配合 DSHOT 可截到"菜单正开着"✓）
int gCtxStep = 0
int gCtxTarget = 1
int gPlCtxStep = 0            // 歌单右击菜单自检（DPLCTX=1；见 selfcheck_click_tick ✓）

// 榜单"补格式/大小"自检（`DBANG=1 DBANGSIZE=1` ⇒ 等那批线程收尾，打印耗时/补到几首/首行有没有变 ✓）
//   为什么要它：这条链路是"联网 × 线程 × 顺序敏感"的 —— 顺序被轮转切片打乱过一次（设计时发现 ✓），
//   光看代码发现不了，而"榜单排名就是顺序"被打乱是**用户一眼就看出**的问题 ✗ ⇒ 必须钉住 ✓
//   （补的是真体积：酷我不给体积，只能 HEAD 探 ⇒ 这条自检同时也是"探体积链路"的回归 ✓）
bool gBangSizeCheck = false

// 「只看有大小」自检（`DBANG=1 DBANGSIZE=1 DBANGONLY=1`）：
//   等那批"补格式/大小"收尾后**自动勾上**那个勾选框 ⇒ 断言"列表行数 == 有大小的行数"且"每行都有大小"
//   （= 过滤确实在**补完之后**生效 ✓ —— 这就是用户要的时序：补之前套过滤只会得到空表 ✗）
bool gBangOnlyCheck = false

// 双击=试听 自检（`DDBL=1|2` ⇒ 等第 0 行出现后注入**真双击**，断言"起的是试听、没开下载窗口" ✓）
//   为什么要它：2026-10-09 把双击从"下载这一首"改成"试听"（见 previewRow ✓）—— 这是**改语义**，
//   而框架那边的 dbl 判定（400ms / 10px 阈值）在 `mouseDown` 里、还要过表头 / 列重排 / 复选框列
//   那几道闸 ⇒ "双击还有没有反应、反应的是不是试听"光看代码看不出来 ✗
//     `DSEARCH=<关键词> DDBL=1` ⇒ 搜索表第 0 行（等搜索结果回来 ✓）
//     `DBANG=1 DDBL=2`         ⇒ 榜单表第 0 行（等榜单行回来 ✓）
//   同惯例见 gCtxStep / gClickStep ✓；配 DSHOT 还能截到"试听中"的样子 ✓
int gDblStep = 0
int gDblTarget = 1
int gDblWait = 0        // 等行回来的拍数（超时就报"没等到行"⇒ 不挂死 ✓）

// 下载 + 历史 自检（`DDL=<关键词>`）：搜索 → 下第 1 首 → 等跑完 → 切「历史」页 → 打印
//   `[ddl] 通过/不通过：历史 N 条　最新=<歌名 - 歌手> | <大小> | <状态>`
//   为什么要它：下载窗口那个「历史」页签是"消息驱动 + 每次都落盘"的 —— 有没有真记上、
//   是不是**完成**（而不是"失败/取消"），光看代码看不出来 ⇒ 必须真下一首 ✓（见 onTick 那段 ✓）
string gAutoDl = ""
int gDlStep = 0
int gDlWait = 0

// 空任务开窗 自检（`DDLOPEN=1`）：不搜索、不勾选 ⇒ 直接调标题栏那个「下载」入口
//   `[ddlopen] 通过/不通过：窗口开着=true 任务=0`
//   为什么要它：2026-10-09 改了口径 —— 原先没勾选会**弹提示把窗口拦在外面**，
//   改完必须验证"真的开出了空窗口"（而不是又回到弹窗 / 点了没反应 ✗）
bool gDlOpenCheck = false
int gDlOpenTick = 3
bool gDlOpenStay = false        // `DDLOPEN=stay` ⇒ 断言完**不退出**，留着窗口给人肉眼/截图看布局 ✓
bool gDlOpenHist = false        // `DDLOPEN=hist` ⇒ 顺带切到「历史」页签（同上，为了看那一页 ✓）

// 「关于」弹窗自检（`DABOUT=1` ⇒ 第 3 拍自动打开它 ✓）
//   为什么要它：这个弹窗是"固定高度 + 多行文案" ⇒ 文案一长就可能被裁 ✗（画面之外看不出来）
//   ⚠ **DSHOT 截不到它**：DSHOT 读的是**主窗口渲染器**的像素，而模态是**另一个窗口** ✗
//     ⇒ 用桌面截屏（`Win32.captureScreen` / 系统截图）看，见 README 的自检那一节 ✓
int gAboutTick = 0

// 播放自检：`DSEARCH=<关键词> DPLAY=1` ⇒ 走一遍"① 先播一首本地（已下载）→ ② 再点一首没下载的（边下边播）"，
//   每约 1 秒打印一次"位置 / 时长 / 在流 / 已下%"，8 秒后断言"位置在走 + 时长是这首的" ✓
//   为什么要它：2026-10-10 用户报"先播了本地、再点网络播放 ⇒ **进度条不动**"。根因是
//   `try_open_stream()` 那句 `if sound != null { return }` —— 播过本地后 `sound` 一直非空
//   （`play_index` 只 stop 不销毁，为的是别把音频引擎也关掉 ⇒ 见 swap_sound ✓）⇒ 流的音频对象
//   **永远建不起来**，`position()` 取的是上一首那个已停的 Sound ⇒ 进度条钉死、时长也是上一首的 ✓
//   ⚠ 这条自检要**真出声**才有意义（没声卡 ⇒ 本地那首放不起来 ⇒ 会打印"跳过" ✓）
int gPlayStep = 0
int gPlayTick = 0
int gPlayMode = 1            // 1 = 离线版（A/B 两个本地文件 ✓ 不依赖联网）/ 2 = 联网版（走真下载链路 ✓）
string gPlayFileA = ""       // 当"本地那首"的音频（= 用户那句"播放了本地" ✓）
string gPlayFileB = ""       // 当"边下边播那首"的音频（文件已完整 ⇒ 只为验"声建起来了没" ✓）
float gPlayLocalPos = 0.0
float gPlayLocalDur = 0.0
// 队列显示名（两行同长同序 ✓ 第 2 行的本地路径给 "" ⇒ 播放器走"边下边播"分支 ✓）
Array[string] gPlayNames = ["A - 自检", "B - 自检"]

main() {
    var ex = _env("DEXIT")
    if ex != null { gExitTicks = _int(_str(ex)) }
    var sh = _env("DSHOT")
    if sh != null { dlShot = _str(sh) }
    var sa = _env("DSHOT_AT")
    if sa != null { dlShotAt = _int(_str(sa)) }
    var au = _env("DAUTO")
    if au != null { dlAuto = _int(_str(au)) }
    var dc = _env("DPCLICK")
    if dc != null { gClickStep = 1 }
    var dh = _env("DHOVER")
    if dh != null { gHoverTick = 2 }
    var sq = _env("DSEARCH")
    if sq != null { gAutoSearch = _str(sq) }
    var cx = _env("DCTX")
    if cx != null {
        int cxn = _int(_str(cx))
        if cxn > 0 { gCtxStep = 1; gCtxTarget = cxn }   // 1 = 榜单表 / 2 = 搜索表空白处 ✓
    }
    var dsk = _env("DSEEK")
    if dsk != null { if _int(_str(dsk)) > 0 { gSeekStep = 1 } }   // 进度条点击闸门（见 gSeekStep 注释 ✓）
    var dpc2 = _env("DPLCTX")
    if dpc2 != null { if _int(_str(dpc2)) > 0 { gPlCtxStep = 1 } }   // 歌单右击菜单（关掉再弹 ✓）
    var dlrc = _env("DLRC")
    if dlrc != null { if _int(_str(dlrc)) > 0 { gLrcTick = 2 } }  // 歌词浮层（见 gLrcTick 注释 ✓）
    var bs = _env("DBANGSIZE")
    if bs != null { gBangSizeCheck = true }
    var bo = _env("DBANGONLY")
    if bo != null { if _int(_str(bo)) > 0 { gBangOnlyCheck = true } }
    var db = _env("DDBL")
    if db != null {
        int dbn = _int(_str(db))
        if dbn > 0 { gDblStep = 1; gDblTarget = dbn }   // 1 = 搜索表 / 2 = 榜单表 ✓
    }
    var ab = _env("DABOUT")
    if ab != null { gAboutTick = 3 }        // 第 3 拍开「关于」（见 gAboutTick 注释 ✓）
    var dp = _env("DPLAY")
    if dp != null {
        int dpn = _int(_str(dp))
        if dpn > 0 { gPlayStep = 1; gPlayMode = dpn }   // 1 = 离线版 / 2 = 联网版（见 gPlayStep 注释 ✓）
    }
    var ddl = _env("DDL")
    if ddl != null { gAutoDl = _str(ddl) }  // 搜索→下第 1 首→查历史（见 gAutoDl 注释 ✓）
    var ddo = _env("DDLOPEN")
    if ddo != null {
        gDlOpenCheck = true                  // 空任务开窗（见 gDlOpenCheck 注释 ✓）
        string mode = _str(ddo)
        if mode == "stay" { gDlOpenStay = true }
        // `hist` / `histstay`：开完窗再切到「历史」页签（配 stay 用来肉眼 / 截图核对历史页布局 ✓）
        if mode == "hist" or mode == "histstay" {
            gDlOpenHist = true
            gDlOpenStay = true
        }
    }
    MusicDlApp app = new MusicDlApp()
    app.run()
}
