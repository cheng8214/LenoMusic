// musicdl_gui.leno — 音乐下载器（GUI 版）
//
// 与 CLI 版（musicdl.leno）共用同一套"引擎"：网络/取直链/落盘在 dl_engine.leno
//   · dl_engine 复用 kuwo_core.leno（CLI 同款）+ kuwo_des.leno（官方接口 DES 加密）
//   · 本文件只管界面与交互；跨线程的数据一律是**纯字符串数组**（见 dl_engine 头部约定）
//
// 分层（2026-10-07 把下载窗口拧出 ⇒ 三个文件各管一层 ✓）
//   dl_engine.leno    ← 纯逻辑：网络 / 取直链 / 落盘 / 行格式（不 import SDL3 ⇒ 可单测 ✓）
//   dl_window.leno    ← 下载窗口：对话框 + 任务表 + 总进度 + 开始/暂停/取消/打开目录 ✓
//   musicdl_gui.leno  ← **本文件**：主界面 + "要下哪些歌"的判定 + 起线程（见下面 ⚠）
//
// 界面结构
//   Window
//   ├── TitleBar（自绘标题栏）
//   └── VBox root
//       ├── HBox 搜索行：关键词 Edit（回车即搜） + 搜索按钮 + 每源条数 SpinBox
//       ├── HBox 音源行：音源复选框（可勾选，来自 dl_engine.sources()） + 输出目录 + 选择目录
//       ├── HBox 操作行：下载勾选 / 下载选中行 / 全选 / 全不选 + 已选统计
//       ├── Table 结果表（第 0 列复选框；右击弹上下文菜单）
//       ├── ProgressBar（搜索/下载的"忙"指示）
//       └── HBox 状态栏：状态文字 + 操作提示
//
//   下载对话框（模态）：**本体在 dl_window.leno**（任务表 + 总进度 + 当前任务 + 五个按钮）
//     本文件只做三件事：判定"要下哪些歌" → 把数据与状态栏交给它 → 每 120ms 调它的 tick() ✓
//
// 线程模型（照 cleaner_master / cache_cleaner 的套路）
//   搜索：threads.start(search_worker, ...) + channel 回传命中数 + 120ms 定时器排空
//   下载：**多首歌并行** —— threads.start(dl_worker_shard, ..., shard, nshards) × N 个 worker
//         （N = dl_engine.dl_workers(任务数)，各领一份 i % N == shard 的任务）+ 共用一个 channel
//         回传逐片进度（消息带全量下标）+ **每个 worker 一条**命令通道做暂停/取消 ✓
//   worker 必须是**本文件的具名全局函数**（理由见下方包装函数的注释），UI 线程只做
//   "排空 channel + 刷控件" ✓
//   ⚠ 下载窗口拆出去后这条约束照旧成立：**起线程的仍是本文件**（dl_worker_shard 也留在本文件），
//     窗口只置一个 `wantStart` 意图、由本文件的定时器接手起线程（详见 dl_window.leno 文件头 ⚠）
//
// 运行：cd D:\CLeno\Leno 后
//   build\leno.exe leno_gui\应用\音乐下载器\musicdl_gui.leno
import "SDL3" as SDL3
import "sdl_filedialog" as fdlg
import dirs
import files
import strings
import threads
import "./dl_engine.leno" as eng
import "./dl_window.leno" as dlw
import "./dl_settings.leno" as dlset        // 设置：读/写/钳位（纯逻辑 ⇒ 能被 test/ 单测 ✓）
import "./dl_settings_win.leno" as dlswin    // "设置"弹窗（SDL3）—— 标题栏右侧 ⚙ 打开 ✓
import "./player_bar.leno" as pb             // 播放条（嵌在主界面里 ✓ 见它的文件头）

use SDL3.(Event, Renderer, Window, TitleBar, Label, Button, CheckBox, Table, ProgressBar, HBox, VBox, Edit, SpinBox, Separator, Scancode, ComboBox, ImageView)
use dlw.DlWindow
use pb.PlayerBar
use dlset.DlSettings

// 歌曲行的列下标（F_ID / F_NAME / …）已收敛到 dl_engine.leno 的 `export const` ⇒ 用 `eng.F_xxx` ✓
// （原先本文件自己复制了一份；下载窗口再拆一个文件就会变成三份 ⇒ 单一事实来源 ✓）

// ==================== 线程入口包装（必须写在**本文件**里！） ====================
// ⚠ 实测踩坑：`threads.start(eng.search_entry, ...)` 会**当场**抛错
//   "线程入口必须是当前文件的函数 ✗ 收到的是模块 'dl_engine' 里的 'search_entry'
//    （子线程不会加载别的模块的全局变量 ⇒ 模块函数在子线程里跑不起来）"
//   ⇒ 子线程入口必须是**本文件的具名全局函数**，在里面再调引擎层的模块函数
//   （cleaner_master 的 scan_entry/delete_entry 就是这个套路 ✓）
// 另外：入口**不能是闭包**（闭包会被 GC ✗）
func search_worker(Array[string] srcids, string keyword, int limit, any ch): Array[Array[string]] {
    return eng.search_entry(srcids, keyword, limit, ch)
}

// ⚠ 下载窗口（dl_window.leno）的"开始"也走这个入口 —— 起线程的必须还是本文件 ✓
//   shard / nshards = 本 worker 领第几份 / 共几份（**多首歌并行**，切法见 dl_engine.dl_entry_shard ✓）
func dl_worker_shard(Array[Array[string]] jobs, string outdir, any ch, any cmd, Array[string] flags, int shard, int nshards): Array[string] {
    return eng.dl_entry_shard(jobs, outdir, ch, cmd, flags, shard, nshards)
}

// 试听 worker（同一条硬约束：线程入口必须是**本文件**的具名全局函数 ✓）
//   只做转发 ⇒ 真正的 HTTP 与"发消息"都在 dl_engine.dl_preview 里 ✓（与 search_worker 同款 ✓）
func preview_worker(string songId, string outpath, int bytes, string tag, string src, any ch): int {
    return eng.dl_preview(songId, outpath, bytes, ch, tag, src)
}

// ==================== 无头自检钩子（环境变量；与 dashboard / cleaner_master 同一套约定 ✓）====================
// 为什么值得有：本应用是 GUI 的（搜索要联网、下载要点按钮）⇒ 没有它就只能"人手开窗看" ✗
//   DSHOT=<png>  截这一张就退出（默认第 2 帧；DSHOT_AT=<帧> 可调）
//   DAUTO=<帧>   跑够这么多帧就退出（不截图也行）
// ⇒ 标题栏那两个图标、整体布局都能被**无头核对**（assert\run_gui_checks.leno 的无头清单 ✓）
var dlShot = ""
int dlShotAt = 2
int dlAuto = 0
int dlFrames = 0

// ==================== 主结构 ====================
struct MusicDlApp {
    // ===== 主窗口控件 =====
    Window win
    TitleBar titleBar
    Edit keywordEdit
    SpinBox limitSpin
    Button searchBtn
    ComboBox fmtBox             // 格式过滤（全部 / flac / mp3 / aac …；选项按搜到的内容生成 ✓ 见 refreshFmtItems）
    Button dlCheckedBtn
    Button dlSelBtn
    Button selAllBtn
    Button selNoneBtn
    Button dirBtn
    CheckBox lyricBox
    Label stateLbl
    Label countLbl
    Label dirLbl
    ProgressBar busyBar
    Table table
    string rowIcon = ""          // 歌名前的行图标（images/music.png ✓；**每次 set_rows 后都要重贴** ✗ 见 fillTable）
    HBox srcRow

    // ===== 音源（与 dl_engine.sources() 的行平行） =====
    Array[CheckBox] srcBoxes
    Array[string] srcIds
    Array[bool] srcAvail

    // ===== 数据 =====
    Array[Array[string]] songs       // 搜索结果（歌曲行）
    string outdir = ""

    // ===== 搜索线程状态 =====
    Thread? searchThread = null
    Channel? searchCh = null
    bool searching = false
    string searchErr = ""            // 搜索失败原因（worker 报错时记下，别让"没搜到结果"盖掉真因 ✓）
    int busyPhase = 0                // 进度条脉冲相位（"忙"指示）

    // ===== 下载窗口（2026-10-07 拧成独立模块 dl_window.leno ✓）=====
    //   窗口自带它的控件与每任务进度状态；本文件只持有它、每 120ms 调一次 tick() ✓
    //   从外面只碰三个字段：`jobs` / `flags`（交给它）与 `wantStart`（见 dlStartIfWanted ✓）
    //   ★ 它是**非模态**的 ⇒ 主窗口能继续点 ⇒ "已经开着就别再开"由本文件把关（reuseDlIfOpen ✓）
    DlWindow? dl = null

    // ===== 播放条（player.leno 管规则 + player_bar.leno 画界面 ✓）=====
    //   ★ 嵌在主界面里（表格**下方**、状态栏上方 ✓）—— **不另开窗口** ✓；每 120ms 调它的 tick() ✓
    PlayerBar? pbar = null

    // ===== 设置（dl_settings.leno 纯逻辑 + dl_settings_win.leno 弹窗 ✓）=====
    //   `workers` = 并行下载线程数（**多首歌同时下**）；启动时读一次，改设置后立刻重读 ✓
    //   入口是**标题栏右侧**的两个动作按钮：`download`（下载窗口）与 `settings`（设置）✓
    //   图标用应用自带的 images/download.png、images/setting.png（路径见 setupUI ✓）
    DlSettings cfg

    // ==================== 数据辅助 ====================

    // 歌曲行 → 表格行（表格列顺序见 setupUI 里的 headers）
    func tablerow(Array[string] s): Array[string] {
        return ["", s[eng.F_NAME], s[eng.F_ARTIST], s[eng.F_ALBUM], eng.fmtduration(_int(s[eng.F_DURATION])), s[eng.F_EXT], s[eng.F_SIZETEXT]]
    }

    func fillTable() {
        Array[Array[string]] rows = []
        for songs to s {
            rows.add(tablerow(s))
        }
        table.set_rows(rows)
        table.check_all()            // 默认全勾：搜到就能一键下
        // 图标不用管：表格配了 `image_path`（默认图标 ✓）⇒ 每行都画它、**换数据也不会掉** ✓
        //   （早先得每次 set_rows 后逐行 set_row_image 重贴 ✗ —— `set_rows` 会清/截断 rowImages
        //     见 sdl_table 里 `imgDefault` 的注释 ✓；框架补了默认图标这条就把坑根治了 ✓）
    }

    // 勾选行 → 歌曲行（**按当前格式过滤** ✓ 见下面的格式过滤那一段）
    func pickchecked(): Array[Array[string]] {
        Array[Array[string]] out = []
        Array[int] checked = table.get_checked_rows()
        for checked to i {
            if i >= 0 and i < songs.len() {
                if fmt_ok(songs[i]) { out.add(songs[i]) }
            }
        }
        return out
    }

    // ==================== 格式过滤（搜索行那个下拉框 ✓ 2026-10-08）====================
    //   为什么要有：一次搜回来常混着 flac / mp3 / aac；只想下某种后缀时，原先只能一行行取消勾选 ✗
    //   ★ 作用范围 = **批量下载**：
    //     · 「下载勾选」/「下载选中行」⇒ 过滤 ✓
    //     · 右键「下载这一首」/ 双击某行 ⇒ 是**显式点名单曲** ⇒ 不拦 ✓（拦了会像"点了没反应"）
    //   ⚠ 只**读** `fmtBox`（用户选的 ✓）；tick 里绝不 set_*（`set_selected` 会触发 on_change ✗
    //      —— 与音量滑块同一条纪律 ✓）

    // 当前"只要什么"："" = 全部 ✓；否则是**小写**扩展名（"mp3" ✓）
    func fmt_want(): string {
        // ⚠ 别写 `if fmtBox == null` ✗：struct 是**值类型**、默认立即分配（编译器会警告"与 null 比较无意义"✓）
        //   没搜过时 `get_selected()` 也不是有效项 ⇒ 下面 `<= 0` 一并兜住 ✓（返回 "" = 全部 ✓）
        if fmtBox.get_selected() <= 0 { return "" }        // 第 0 项 = 全部格式 ✓（-1 也当全部 ✓）
        return strings.to_lower(fmtBox.get_selected_text())
    }

    // 这一行符合当前过滤吗 ✓（没给扩展名的行算"未知" ⇒ 只有"全部"才放行 ✓）
    func fmt_ok(Array[string] row): bool {
        string want = fmt_want()
        if want == "" { return true }
        string e = "未知"
        if row.len() > eng.F_EXT and row[eng.F_EXT] != "" { e = strings.to_lower(row[eng.F_EXT]) }
        return e == want
    }

    // 下拉框选项 = 「全部格式」+ **搜到的**那些扩展名（去重 + 插入排序 ✓，几条而已）
    //   ⚠ `set_selected` **会触发 on_change**（sdl_combobox:177 ✓）⇒ 处理函数必须是幂等的 ✓
    func refreshFmtItems() {
        Array[string] exts = []
        for songs to s {
            string e = "未知"
            if s.len() > eng.F_EXT and s[eng.F_EXT] != "" { e = strings.to_lower(s[eng.F_EXT]) }
            bool has = false
            for exts to x { if x == e { has = true } }
            if not has { exts.add(e) }
        }
        Array[string] sorted = []
        for exts to e2 {
            int at = 0
            while at < sorted.len() and sorted[at] < e2 { at = at + 1 }
            sorted.insert(at, e2)
        }
        // 重搜后格式集合会变 ⇒ 尽量保住用户原来选的那项 ✓
        string keep = ""
        if fmtBox.get_selected() > 0 { keep = fmtBox.get_selected_text() }
        Array[string] its = []
        its.add("全部格式")
        for sorted to e3 { its.add(e3) }
        fmtBox.set_items(its)                  // 会把越界的 sel 复位成 -1 ✓（那也当"全部" ✓）
        int want = 0
        int i = 0
        while i < its.len() {
            if keep != "" and its[i] == keep { want = i }
            i = i + 1
        }
        fmtBox.set_selected(want)
        fmtBox.set_enabled(its.len() > 1)      // 只有一种格式 ⇒ 没得选（禁用更清楚 ✓ 仍可见 ✓）
        onFmtChanged()
    }

    // 换格式 ⇒ 状态栏说清"这一选会下几首"（避免"以为全下、其实只下了 3 首" ✗）
    func onFmtChanged() {
        string want = fmt_want()
        if want == "" {
            stateLbl.set_text("格式：全部 —— 勾选的都会下")
        } else {
            int n = 0
            for songs to s { if fmt_ok(s) { n = n + 1 } }
            stateLbl.set_text("格式：只要 " + want + " —— 搜到的 " + _str(songs.len()) + " 首里有 " + _str(n) + " 首")
        }
        // 批量按钮的提示也跟着走（用户不用去猜过滤还在不在 ✓）
        string what = if want == "" then "全部格式" else want
        dlCheckedBtn.set_tip("下载勾选的行（当前格式过滤：" + what + "）")
        updateCount()
        SDL3.markFrameRedraw()
    }

    // 勾选的音源 id（跳过不可用/未勾选）
    func picksources(): Array[string] {
        Array[string] out = []
        int i = 0
        while i < srcBoxes.len() {
            if srcAvail[i] and srcBoxes[i].is_checked() { out.add(srcIds[i]) }
            i = i + 1
        }
        return out
    }

    func updateCount() {
        Array[int] checked = table.get_checked_rows()
        int bytes = 0
        int match = 0                       // 勾选里"符合当前格式"的条数（★ 才是真正会下的 ✓）
        for checked to i {
            if i >= 0 and i < songs.len() {
                bytes = bytes + _int(songs[i][eng.F_BYTES])
                if fmt_ok(songs[i]) { match = match + 1 }
            }
        }
        string extra = ""
        string want = fmt_want()
        if want != "" { extra = "｜只要 " + want + "：符合 " + _str(match) + " 首" }
        countLbl.set_text("已选 " + _str(checked.len()) + " / " + _str(songs.len()) + " 首 · 合计约 " + strings.fmt_size(bytes) + extra)
        dlCheckedBtn.set_enabled(match > 0)     // 过滤后一首都不符 ⇒ 按钮灰着更清楚 ✓（点不动 ≠ 坏了 ✓）
    }

    // ==================== 搜索 ====================

    func onSearch() {
        if searching { return }
        string keyword = keywordEdit.get_text().trim()
        if keyword == "" {
            stateLbl.set_text("请输入关键词，例如：周杰伦 晴天")
            SDL3.markFrameRedraw()
            return
        }
        Array[string] srcs = picksources()
        if srcs.len() == 0 {
            stateLbl.set_text("至少勾选一个音源")
            SDL3.markFrameRedraw()
            return
        }
        int limit = _int(limitSpin.get_text())
        if limit < 1 { limit = 20 }

        searching = true
        searchErr = ""
        songs = []
        table.set_rows([])
        table.clear_selection()
        searchBtn.set_enabled(false)
        dlCheckedBtn.set_enabled(false)
        dlSelBtn.set_enabled(false)
        countLbl.set_text("已选 0 / 0 首")
        stateLbl.set_text("正在搜索「" + keyword + "」（音源：" + strings.join(srcs, "、") + "）…")
        busyPhase = 5
        busyBar.set_value(5.0)
        searchCh = threads.channel(4096)
        searchThread = threads.start(search_worker, srcs, keyword, limit, searchCh)
        SDL3.markFrameRedraw()
    }

    // 搜索收尾：join 取回结果行（worker 已结束 ⇒ join 立即返回）
    func finishSearch() {
        Array[Array[string]] rows = []
        if searchThread is Thread {
            var r = searchThread.join() as Array[Array[string]]
            if r != null { rows = r }
        }
        searchThread = null
        if searchCh is Channel { searchCh.close() }
        searchCh = null
        searching = false
        songs = rows
        fillTable()
        refreshFmtItems()          // ★ 下拉框选项 = 搜到的那些格式（全部/flac/mp3/aac… ✓）
        updateCount()
        searchBtn.set_enabled(true)
        busyBar.set_value(100.0)
        if rows.len() == 0 {
            // ★ 有错就报错：worker 抛异常时如果只说"没搜到结果"，用户根本无从下手
            //   （"青衣"那次就是这么被误判成"搜不到"的 ✓）
            if searchErr != "" {
                stateLbl.set_text("搜索失败：" + searchErr)
            } else {
                stateLbl.set_text("没搜到结果（接口可能被限流，或关键词无匹配）")
            }
        } else {
            stateLbl.set_text("搜索完成：命中 " + _str(rows.len()) + " 首（默认已全部勾选）")
        }
        SDL3.markFrameRedraw()
    }

    // ==================== 主循环定时器（120ms 一拍） ====================
    // 搜索进度、下载进度、忙指示都在这里推进 —— 唯一一处"UI 线程排空 channel"的地方
    func onTick() {
        // 退出路径自检（见 gExitTicks 注释 ✓）
        // 悬停自检（见 gHoverTick 注释 ✓）：把指针注入到播放键上 ✓
        if gHoverTick > 0 {
            gHoverTick = gHoverTick - 1
            if gHoverTick == 0 {
                if pbar is PlayerBar => b {
                    SDL3.testMoveAt(win.getID(), b.btnPlay.get_x() + b.btnPlay.get_w() / 2.0,
                                                  b.btnPlay.get_y() + b.btnPlay.get_h() / 2.0)
                    print("[dhover] 指针已移到播放键上\n")
                }
            }
        }
        // 歌单点击自检（见 gClickStep 注释 ✓）：注入真实点击 ⇒ 断言到底有没有落到控件上 ✓
        if gClickStep > 0 {
            int st = gClickStep
            gClickStep = gClickStep + 1
            if pbar is PlayerBar => b {
                int wid = win.getID()
                if st == 1 {
                    // ⚠ 先注入**移动**再点击：只发 down/up 时按钮的 hover 还不成立 ⇒ 点击会**偶发不生效** ✗
                    //   （实测过：同一坐标有时开门、有时不开 ✓ 真人点之前总会有移动 ✓）
                    float bx = b.btnList.get_x() + b.btnList.get_w() / 2.0
                    float by = b.btnList.get_y() + b.btnList.get_h() / 2.0
                    SDL3.testMoveAt(wid, bx, by)
                    bool ok = SDL3.testClickAt(wid, bx, by)
                    print("[dpclick] 注入点「列表」按钮 ok=" + _str(ok)
                          + "  按钮矩形=" + _str(_int(b.btnList.get_x())) + "," + _str(_int(b.btnList.get_y()))
                          + " " + _str(_int(b.btnList.get_w())) + "x" + _str(_int(b.btnList.get_h())) + "\n")
                } eif st == 4 {
                    print("[dpclick] 点完按钮：popOpen=" + _str(b.popOpen)
                          + "  歌单矩形=" + _str(_int(b.lb.x)) + "," + _str(_int(b.lb.y))
                          + " " + _str(_int(b.lb.w)) + "x" + _str(_int(b.lb.h)) + "\n")
                    // 点歌单第 3 行中点（itemH=22 ✓ 见 LIST_ROW）；同样先移动再点 ✓
                    float rx = b.lb.x + 40.0
                    float ry = b.lb.y + 4.0 + 22.0 * 2.0 + 11.0
                    SDL3.testMoveAt(wid, rx, ry)
                    bool ok = SDL3.testClickAt(wid, rx, ry)
                    print("[dpclick] 注入点歌单第 3 行 ok=" + _str(ok) + "\n")
                } eif st == 8 {
                    gClickRow3 = b.cur_index()
                    print("[dpclick] 点歌单第 3 行 ⇒ 下标=" + _str(gClickRow3) + "（期望 2）\n")
                    // 再点**当前正在播的那一行**（第 1 行）：这里最容易"看着没反应" ✗
                    //   （`ListBox` 单选模式下点已选中行**不回调** ✓ ⇒ 靠 on_event 自己算行号 ✓）
                    SDL3.testMoveAt(wid, b.lb.x + 40.0, b.lb.y + 4.0 + 11.0)
                    bool ok = SDL3.testClickAt(wid, b.lb.x + 40.0, b.lb.y + 4.0 + 11.0)
                    print("[dpclick] 注入点「当前行」ok=" + _str(ok) + "\n")
                } eif st == 12 {
                    bool pass = gClickRow3 == 2 and b.cur_index() == 0
                    print("[dpclick] " + (if pass then "通过" else "**不通过**")
                          + "：点第 3 行 ⇒ 下标 " + _str(gClickRow3) + "（期望 2）；"
                          + "再点当前行 ⇒ 下标 " + _str(b.cur_index()) + "（期望 0）\n")
                    SDL3.requestExit()
                }
            }
        }
        if gExitTicks > 0 {
            gExitTicks = gExitTicks - 1
            if gExitTicks == 0 {
                print("[diag] 走正常退出路径（requestExit）\n")
                SDL3.requestExit()
            }
        }
        // ★ 歌词面板里点了"立即下载歌词" ⇒ 由**本文件**去下（要起线程 + 开下载窗口，只有这里能做 ✓）
        //   ⚠ 拿得到歌曲 ID 的前提：当前这首**在搜索结果里**（试听时记下的那行 ✓ gPrevRow）
        //     列表里的歌（磁盘文件名）没有 ID ✗ ⇒ 老实说清"去搜索结果里右键"✓ 不瞎猜 ✗
        if pbar is PlayerBar => pbLyr {
            if pbLyr.wantLyricFetch {
                pbLyr.wantLyricFetch = false
                string nowTag = pbLyr.cur_tag()
                if gPrevRow.len() > eng.F_ARTIST and eng.songlabel(gPrevRow) == nowTag {
                    onDownloadLyricOnly([gPrevRow])
                    stateLbl.set_text("去下这首的歌词：" + nowTag)
                } else {
                    stateLbl.set_text("这首不在搜索结果里（" + nowTag + "）⇒ 到搜索结果里右键「下载歌词」")
                }
                SDL3.markFrameRedraw()
            }
        }
        // ★ 歌单右击菜单里"动文件 / 弹窗 / 开目录"的那几项（2026-10-08 ✓）
        //   ⚠ 播放条**故意不碰**这些（不弹系统框、不开资源管理器 ✗）⇒ 它只置标志，由这里办 ✓
        //     动文件/弹窗的实现与搜索结果右键菜单**同一套**（`dlw.reveal` / `SDL3.msgBox` / `dlw.openfolder` ✓）
        if pbar is PlayerBar => pbCtx {
            if pbCtx.ctxWant != "" {
                string act = pbCtx.ctxWant
                string pth = pbCtx.ctxWantPath
                pbCtx.ctxWant = ""
                pbCtx.ctxWantPath = ""
                if act == "open" {
                    if not dlw.openfolder(outdir) { stateLbl.set_text("打开目录失败：" + outdir) }
                } eif pth != "" {
                    if act == "reveal" {
                        if dlw.reveal(pth) {
                            stateLbl.set_text("已在资源管理器里定位：" + pth)
                        } else {
                            stateLbl.set_text("定位失败：" + pth)
                        }
                    } eif act == "delfile" {
                        // ⚠ 回调式（框架明说**不要**写成 `if msgBox(...)` ✗ —— 主循环已经在跑 ✓）
                        SDL3.msgBox("删除本地文件", [
                            "要删掉这一首的本地文件吗？",
                            dirs.basename(pth),
                            pth,
                            "（只删音频，不动同名 .lrc 歌词；不进回收站，删了就没了）"
                        ], "删除", "取消", true, func() {
                            string qq = pth
                            bool ok = true
                            try {
                                files.delete(qq)
                            } catch e {
                                ok = false
                            }
                            if ok {
                                if pbar is PlayerBar => bb { bb.rescan() }   // 列表跟着刷新（删的是正在播的那首 ⇒ 它也会停 ✓）
                                stateLbl.set_text("已删除：" + qq)
                            } else {
                                stateLbl.set_text("删除失败：" + qq + "（若正在播放它 ⇒ 先切到别的歌再删 ✓）")
                            }
                            SDL3.markFrameRedraw()
                        })
                    }
                }
                SDL3.markFrameRedraw()
            }
        }
        try {
            pollSearch()
            pollBgDownload()           // 试听配套的"整首下载"回信（进度/完成 ✓）
            dlStartIfWanted()          // 下载窗口点了"开始" ⇒ 由**本文件**起线程（语言硬约束 ✓）
            if dl is DlWindow => w {
                if w.open { w.tick() }  // 排空下载通道 + 刷新窗口（窗口本体在 dl_window.leno ✓）
            }
            // 播放条：同一拍推进（放完自动下一首 + 刷进度/时间/按钮态 ✓）
            if pbar is PlayerBar => b { b.tick() }
            pulseBusy()
        } catch e {
            stateLbl.set_text("刷新出错：" + eng.errmsg(e))
            SDL3.markFrameRedraw()
        }
    }

    func pulseBusy() {
        if searching {
            busyPhase = busyPhase + 9
            if busyPhase > 92 { busyPhase = 5 }
            busyBar.set_value(_float(busyPhase))
        }
    }

    func pollSearch() {
        int found = 0
        // 试听回信（与搜索同一套排空方式 ✓）：ready ⇒ 交给播放条播；fail ⇒ 说清原因 ✓
        if gPreviewCh is Channel {
            var pm = gPreviewCh.try_receive()
            while pm != null {
                if pm is Array => mv {
                    string kind = _str(mv[0])
                    if kind == "ready" {
                        string path = _str(mv[1])
                        string tag = _str(mv[2])
                        int n = _int(_str(mv[3]))
                        if pbar is PlayerBar => b { b.preview(path, tag) }
                        stateLbl.set_text("试听：" + tag + "（取了 " + _str(n / 1024) + " KB，约 " + _str(n / 16000) + " 秒）")
                    } else {
                        stateLbl.set_text("试听失败（" + _str(mv[1]) + "）—— 换一首或稍后再试")
                    }
                }
                pm = gPreviewCh.try_receive()
            }
        }
        if searchCh is Channel {
            var msg = searchCh.try_receive()
            int n = 0
            while msg != null and n < 4000 {
                if msg is Array => mv {
                    string kind = _str(mv[0])
                    if kind == "search" {
                        found = found + _int(mv[2])
                        stateLbl.set_text("音源 " + _str(mv[1]) + " 返回 " + _str(mv[2]) + " 条…")
                    } else if kind == "serror" {
                        searchErr = _str(mv[4])
                        stateLbl.set_text("搜索出错：" + searchErr)
                    }
                }
                msg = searchCh.try_receive()
                n = n + 1
            }
        }
        if not searching { return }
        // 线程还活着 ⇒ 继续等（worker 结束 + 通道排空后再收尾，避免丢最后几条消息）
        bool running = false
        if searchThread is Thread {
            if searchThread.state() == "running" { running = true }
        }
        if running { return }
        if searchCh is Channel {
            if searchCh.len() > 0 { return }
        }
        finishSearch()
    }

    // ==================== 下载：判定"要下哪些歌" + 起线程 ====================
    // 窗口本体（任务表 / 总进度 / 按钮 / 每任务状态）已在 dl_window.leno；本文件只做四件事：
    //   ① "要下哪些歌"的判定（勾选 / 选中行 / 只下歌词 —— 属业务策略 ✓）
    //   ② 输出目录先建（write 到不存在的目录会抛异常，见 docs/移植音乐下载器实录与待办.md B2）
    //   ③ threads.start 起线程（worker 入口必须与本调用同文件 ⇒ 见 dlStartIfWanted ✓）
    //   ④ 把数据与状态栏交给窗口：`dl = dlw.open_download(...)`

    // 本轮要不要带歌词：看工具栏那个勾选框（默认勾上）
    func downloadflags(): Array[string] {
        Array[string] flags = []
        if lyricBox.is_checked() { flags.add("lyric") }
        return flags
    }

    // 下载窗口已经开着？⇒ 置前 + 状态栏说明 + 返回 true（调用方据此**不重复开** ✓）
    //   ★ 2026-10-07 改非模态后必须有：主窗口能继续点，而原先每点一次都会 `new` 一个新窗口 ✗
    //   ⚠ 已有窗口在下**另一批**任务时不抢（抢掉 = 中断正在下的 ✗）⇒ 只置前 + 说明"先关掉它"
    func reuseDlIfOpen(): bool {
        if not dlw.reuse_if_open(dl) { return false }
        string what = "下载窗口"
        if dl is DlWindow => w {
            if w.lyriconly { what = "下载歌词窗口" }
        }
        stateLbl.set_text(what + "已经开着（已切到前台）—— 要开始新的一批，请先关掉它")
        SDL3.markFrameRedraw()
        return true
    }

    func startDownload(Array[Array[string]] jobs, Array[string] flags) {
        if reuseDlIfOpen() { return }          // ★ 一个应用只留一个下载窗口 ✓（非模态 ⇒ 必须自己管）
        if jobs.len() == 0 {
            stateLbl.set_text("先勾选（或右键选中）要下载的歌曲")
            SDL3.markFrameRedraw()
            return
        }
        if not ensuredir() { return }
        dl = dlw.open_download(jobs, flags, outdir, stateLbl, cfg.workers)   // 并行上限来自**设置** ✓
    }

    // ★ 试听（2026-10-07 改）：**两条腿一起走** ✓
    //   ① 拉"前一段"到临时文件 ⇒ 点了就有声 ✓（这一段是**截断文件** ⇒ 不能拖进度 ✗ 见 can_seek ✓）
    //   ② 顺手起一个**静默整首下载**（进输出目录 ✓）⇒ 下完自动切过去接着放 + 此后可拖 ✓
    //   为什么不是"等下完再播"：一首 4MB 要等好几秒才出声 ✗；也不是"只播前一段"：听不了整首 ✗
    //   走的是与搜索/下载完全相同的"线程 + 通道 + 120ms 排空"套路 ✓
    func startPreview(Array[string] one) {
        if one.len() <= eng.F_ARTIST { return }
        gPrevRow = one                                      // 记下"试听的是哪一行"⇒ 歌词面板能据此补下歌词 ✓
        string ext = "mp3"
        if one.len() > eng.F_EXT and one[eng.F_EXT] != "" { ext = one[eng.F_EXT] }
        string out = dirs.join(_tmpdir(), "leno_preview_" + one[eng.F_ID] + "." + ext)
        string tag = eng.songlabel(one)                    // "歌名 - 歌手" ✓（界面显示用 ✓）
        gPreviewCh = threads.channel(8)
        gPreviewThread = threads.start(preview_worker, one[eng.F_ID], out, PREVIEW_BYTES, tag, eng.srcid(one), gPreviewCh)
        startBgDownload(one)                               // ★ ② 同时整首下（静默 ✓）
        stateLbl.set_text("试听：正在取前一段并下载整首…（" + tag + "）")
        SDL3.markFrameRedraw()
    }

    // ★ 试听配套：**静默整首下载**到输出目录（复用现成的 dl_worker_shard + 通道 ✓）
    //   ⚠ 起线程必须由**本文件**做（语言硬约束：线程入口只能是起线程那个文件的具名全局函数 ✓）
    //     worker 入口就是现成的 `dl_worker_shard` ✓ ⇒ 不用新写转发 ✓
    //   ⚠ 命令通道只是 `dl_entry_shard` 的形参（暂停/取消用 ✓）；这里不需要取消 ⇒ 给一条空的即可 ✓
    func startBgDownload(Array[string] one) {
        if one.len() <= eng.F_ARTIST { return }
        string tag = eng.songlabel(one)
        if gBgDlRunning and gBgDlTag == tag { return }     // 同一首已在静默下 ⇒ 不重复起 ✗
        // ⚠ 更要防这一条：**下载窗口里正在下同一首** ⇒ 两个线程写**同一个路径**会把文件写坏 ✗✗
        //   （引擎的 send 用的是 try_send ⇒ 不会卡死，但并发写文件是真的会坏 ✓）
        if dl is DlWindow => w {
            if w.open {
                int i = 0
                while i < w.jobs.len() {
                    if eng.songlabel(w.jobs[i]) == tag {
                        stateLbl.set_text("这首已经在下载窗口里下着了 —— 试听照听，不再重复下 ✓")
                        return
                    }
                    i = i + 1
                }
            }
        }
        if not ensuredir() { return }
        gBgDlTag = tag
        gBgDlRunning = true
        gBgDlCh = threads.channel(4096)
        Channel cmd = threads.channel(64)
        // ⚠⚠ 必须**带上 "lyric"** ✗✗（2026-10-08 用户实测：先前用 `downloadflags()` ⇒ 跟着下载窗口那个
        //   勾选框走 ✗ ⇒ 用户没勾 ⇒ **整首下完了却没有 .lrc** ⇒ 试听中/下完都看不到歌词 ✓）
        //   引擎只在 `hasflag(flags,"lyric")` 时才抓歌词（`dl_engine:350` ✓）⇒ 不加就永远没有 ✓
        //   · 语义上也对：试听即整首（"接着看歌词"是它的一半目的 ✓）
        //   · 重复加一个 "lyric" 无害（引擎按 `hasflag` 判 ✓）
        Array[string] bgFlags = downloadflags()
        bgFlags.add("lyric")
        gBgDlThread = threads.start(dl_worker_shard, [one], outdir, gBgDlCh, cmd, bgFlags, 0, 1)
        if pbar is PlayerBar => b { b.set_dl_progress(0.0) }
    }

    // 后台整首下载的回信（通道式：与搜索/试听同一套 ✓；在 120ms 定时器里排空 ✓）
    //   消息格式见 dl_engine 头部：["progress", 任务序, 已下, 总, 路径] / ["done", …, 落盘路径] / ["fail", …, 原因]
    func pollBgDownload() {
        if gBgDlCh is Channel {
            var m = gBgDlCh.try_receive()
            while m != null {
                if m is Array => mv {
                    string kind = _str(mv[0])
                    if kind == "progress" {
                        int got = _int(mv[2])
                        int tot = _int(mv[3])
                        if tot > 0 {
                            float pct = _float(got * 100 / tot)
                            if pbar is PlayerBar => b { b.set_dl_progress(pct) }
                        }
                    } else if kind == "done" {
                        string path = _str(mv[4])              // ★ 落盘路径（第 4 段 ✓）
                        bool adopted = false
                        if pbar is PlayerBar => b { adopted = b.on_downloaded(path, gBgDlTag) }
                        if adopted {
                            stateLbl.set_text("整首下载完成：" + gBgDlTag + " —— 已切到本地完整文件（可拖进度 ✓）")
                        } else {
                            stateLbl.set_text("整首下载完成：" + gBgDlTag + "（已并入播放列表 ✓）")
                        }
                        gBgDlRunning = false
                    } else if kind == "fail" {
                        if pbar is PlayerBar => b { b.set_dl_progress(-1.0) }
                        stateLbl.set_text("整首下载没成功：" + gBgDlTag + " —— " + _str(mv[4]))
                        gBgDlRunning = false
                    }
                }
                m = gBgDlCh.try_receive()
            }
        }
    }

    func onDownloadChecked() {
        Array[Array[string]] jobs = pickchecked()
        // 全被格式过滤掉了 ⇒ 说清原因（否则只会冒出"先勾选…"，看着像按钮坏了 ✗）
        Array[int] checked = table.get_checked_rows()
        if jobs.len() == 0 and checked.len() > 0 and fmt_want() != "" {
            stateLbl.set_text("勾选的 " + _str(checked.len()) + " 首都不是 " + fmt_want() + " —— 换格式，或切回「全部格式」")
            SDL3.markFrameRedraw()
            return
        }
        startDownload(jobs, downloadflags())
    }

    // 标题栏「下载」图标（2026-10-07）：**"打开下载窗口"的入口**，点了必须有明确结果 ✓
    //   · 已开着 ⇒ 只置前（不重复开 ✓，见 reuseDlIfOpen）
    //   · 有勾选/选中 ⇒ 与工具栏「下载勾选」同一条路：判定 → 开窗 → 起线程 ✓
    //   · **一首都没勾 ⇒ 弹个提示框说清怎么办** —— 原先只在状态栏写一句，
    //     看起来就是"点了没反应" ✗（实测反馈就是它 ✓）
    //     ⚠ 工具栏那个按钮在同样情况下是**禁用**的（updateCount 里 set_enabled ✓）⇒ 那里保持原样：
    //       "灰着点不动"比"能点但没反应"清楚 ✓；而图标是入口，得能进得去 ✓
    func onDownloadAction() {
        if reuseDlIfOpen() { return }
        Array[Array[string]] jobs = pickchecked()
        if jobs.len() == 0 {
            stateLbl.set_text("还没勾选歌曲 —— 下载窗口需要先有任务")
            SDL3.markFrameRedraw()
            SDL3.msgBox("还没有要下载的歌", [
                "下载窗口是给「要下的那一批歌」用的，现在是空的。",
                "① 先在搜索框里搜索；② 在结果表里勾选（或右键某行「下载这一首」）。",
                "然后再点标题栏这个下载图标"
            ], "知道了", "", false, null)
            return
        }
        startDownload(jobs, downloadflags())
    }

    func onDownloadSelected() {
        Array[Array[string]] jobs = []
        Array[int] selRows = table.get_selected_rows()
        for selRows to i {
            if i >= 0 and i < songs.len() {
                if fmt_ok(songs[i]) { jobs.add(songs[i]) }      // ★ 同样吃格式过滤（见上面那段 ✓）
            }
        }
        if jobs.len() == 0 and selRows.len() > 0 and fmt_want() != "" {
            stateLbl.set_text("选中的 " + _str(selRows.len()) + " 首都不是 " + fmt_want() + " —— 换格式，或切回「全部格式」")
            SDL3.markFrameRedraw()
            return
        }
        startDownload(jobs, downloadflags())
    }

    // 只下歌词（右键菜单 / 已有音频时用）
    func onDownloadLyricOnly(Array[Array[string]] jobs) {
        if reuseDlIfOpen() { return }          // 同上：右键"只下这一首的歌词"也不会开出第二个框 ✓
        if jobs.len() == 0 {
            stateLbl.set_text("先勾选（或右键选中）要下歌词的歌曲")
            SDL3.markFrameRedraw()
            return
        }
        if not ensuredir() { return }
        dl = dlw.open_download(jobs, ["lyriconly"], outdir, stateLbl, cfg.workers)   // 同上：上限来自设置 ✓
    }

    func onLyricSelected() {
        Array[Array[string]] jobs = []
        Array[int] selRows = table.get_selected_rows()
        for selRows to i {
            if i >= 0 and i < songs.len() { jobs.add(songs[i]) }
        }
        onDownloadLyricOnly(jobs)
    }

    // 输出目录必须先存在（上面两个入口共用一份 ✓ —— 原先这段建目录的代码抄了两遍）
    func ensuredir(): bool {
        if dirs.exists(outdir) { return true }
        try {
            dirs.mkdir_p(outdir)
        } catch e {
            stateLbl.set_text("无法创建输出目录：" + outdir)
            SDL3.markFrameRedraw()
            return false
        }
        return true
    }

    // ⚠ 下载窗口的"开始"必须由**本文件**真正起线程：线程入口只能是**起线程那个文件**的
    //   具名全局函数（跨模块会当场抛"线程入口必须是当前文件的函数 ✗"，见文件头的实测记录），
    //   所以窗口只置 `wantStart`，本函数在 120ms 定时器里接手 ⇒ 谁起线程谁持有入口 ✓
    func dlStartIfWanted() {
        if dl is DlWindow => w {
            // ★ 右键「重试」（2026-10-08 ✓）：窗口只列**下标**，起线程仍由本文件做（语言硬约束 ✓）
            //   技巧：单个下标也走 `dl_entry_shard(jobs, …, shard = i, nshards = jobs.len())` ——
            //     该 worker 只领 `下标 % nshards == shard` 那一份 ⇒ 正好只下第 i 首 ✓
            //     而且它发消息时带的是**全量下标** ✓ ⇒ 窗口那张任务表天然对位 ✓（引擎一行都不用改 ✓）
            //   ⚠ 每个 worker 一条命令通道：暂停/取消得**人人发到**（一条被谁取走别人就收不到 ✗）
            if w.retryList.len() > 0 {
                Array[int] idxs = w.retryList
                w.retryList = []
                Channel rch = threads.channel(65536)
                Array[Thread] rts = []
                Array[Channel] rcs = []
                for idxs to r {
                    Channel rcmd = threads.channel(64)
                    rts.add(threads.start(dl_worker_shard, w.jobs, outdir, rch, rcmd, w.flags, r, w.jobs.len()))
                    rcs.add(rcmd)
                }
                w.attach(rts, rch, rcs)
            }
            if not w.wantStart { return }
            w.wantStart = false
            // **多首歌并行**：切成 n 份，n 个 worker 同时下（切法与取舍见 dl_engine.dl_entry_shard ✓）
            //   上限来自**设置**（dl_settings.leno ✓）；任务数比上限少就少开 ✓
            int n = eng.dl_workers(w.jobs.len(), cfg.workers)
            Channel msgch = threads.channel(65536)   // 所有 worker 共用（消息带全量下标 ⇒ UI 按 idx 归位 ✓）
            Array[Thread] ts = []
            Array[Channel] cs = []
            for n to k {
                Channel cmdch = threads.channel(64)  // **每个 worker 一条**命令通道（暂停/取消要人人发到 ✓）
                ts.add(threads.start(dl_worker_shard, w.jobs, outdir, msgch, cmdch, w.flags, k, n))
                cs.add(cmdch)
            }
            w.attach(ts, msgch, cs)
        }
    }

    // ==================== 右键菜单 ====================

    func buildMenu(int row) {
        table.clearContextItems()
        Array[int] checked = table.get_checked_rows()
        if row >= 0 {
            table.addContextItem({label: "试听（同时后台下载整首）", id: "playrow"})
            table.addContextItem({label: "下载这一首", id: "dlrow"})
            table.addContextItem({label: "只下这一首的歌词", id: "lyricrow"})
            table.addContextItem({label: "复制「歌名 - 歌手」", id: "copy"})
        }
        if checked.len() > 0 {
            // ★ 菜单上写清"实际会下几首"：格式过滤开着时，勾选数与下载数会不一样 ✗
            //   （否则菜单说"下载勾选的 5 首"、实际只下 3 首 ⇒ 看着像漏了 ✓）
            string want = fmt_want()
            string head = "下载勾选的 " + _str(checked.len()) + " 首"
            if want != "" {
                int m = 0
                for checked to i {
                    if i >= 0 and i < songs.len() and fmt_ok(songs[i]) { m = m + 1 }
                }
                head = "下载勾选的 " + _str(m) + " / " + _str(checked.len()) + " 首（只要 " + want + "）"
            }
            table.addContextItem({label: head, id: "dlchecked"})
            table.addContextItem({label: "只下勾选的 " + _str(checked.len()) + " 首歌词", id: "lyricchecked"})
        }
        table.addContextSeparator()
        table.addContextItem({label: "全选", id: "all"})
        table.addContextItem({label: "全不选", id: "none"})
        table.addContextSeparator()
        table.addContextItem({label: "在资源管理器里定位", id: "reveal"})      // ★★★ 2026-10-08：定位/删除本地文件
        table.addContextItem({label: "删除本地文件…", id: "delfile"})
        table.addContextItem({label: "打开下载目录", id: "open"})
    }

    func onMenu(int row, string id) {
        if id == "playrow" {
            if row >= 0 and row < songs.len() { startPreview(songs[row]) }
            return
        }
        if id == "dlrow" {
            if row >= 0 and row < songs.len() { startDownload([songs[row]], downloadflags()) }
            return
        }
        if id == "dlchecked" {
            onDownloadChecked()
            return
        }
        if id == "lyricrow" {
            if row >= 0 and row < songs.len() { onDownloadLyricOnly([songs[row]]) }
            return
        }
        if id == "lyricchecked" {
            onDownloadLyricOnly(pickchecked())
            return
        }
        if id == "copy" {
            if row >= 0 and row < songs.len() {
                SDL3.setClipboardText(eng.songlabel(songs[row]))
                stateLbl.set_text("已复制：" + eng.songlabel(songs[row]))
            }
            return
        }
        if id == "all" {
            table.check_all()
            updateCount()
            SDL3.markFrameRedraw()
            return
        }
        if id == "none" {
            table.uncheck_all()
            updateCount()
            SDL3.markFrameRedraw()
            return
        }
        // ★★★ 2026-10-08：在资源管理器里**定位**（选中）这一首的本地文件
        //   ⚠ 走的必须是 `explorer /select,` ✗ 不能拿"打开目录"那套 —— 后者对文件会用默认程序打开它 ✗（用户实测点名 ✓）
        if id == "reveal" {
            if row >= 0 and row < songs.len() {
                string p = eng.find_local(songs[row], outdir)
                if p == "" {
                    stateLbl.set_text("本地还没有这首（" + eng.songlabel(songs[row]) + "）⇒ 先下载它 ✓")
                } else if dlw.reveal(p) {
                    stateLbl.set_text("已在资源管理器里定位：" + p)
                } else {
                    stateLbl.set_text("定位失败：" + p)
                }
            }
            SDL3.markFrameRedraw()
            return
        }
        // 删除本地文件（**先确认** ✓ 弹模态框；不删歌词 .lrc、也不进回收站 ✓ 会在框里说清 ✓）
        if id == "delfile" {
            if row >= 0 and row < songs.len() {
                string p = eng.find_local(songs[row], outdir)
                if p == "" {
                    stateLbl.set_text("本地还没有这首，没东西可删（" + eng.songlabel(songs[row]) + "）")
                } else {
                    // ⚠ 回调式（框架明说**不要**写成 `if msgBox(...)` ✗ —— 主循环已经在跑 ✓）
                    SDL3.msgBox("删除本地文件", [
                        "要删掉这一首的本地文件吗？",
                        eng.songlabel(songs[row]),
                        p,
                        "（只删音频，不动同名 .lrc 歌词；不进回收站，删了就没了）"
                    ], "删除", "取消", true, func() {
                        string q = p
                        bool ok = true
                        try {
                            files.delete(q)
                        } catch e {
                            ok = false
                        }
                        if ok {
                            if pbar is PlayerBar => b { b.rescan() }      // 列表跟着刷新（删的是正在播的那首 ⇒ 它也会停 ✓）
                            stateLbl.set_text("已删除：" + q)
                        } else {
                            // 最常见的原因：正在播它（占着文件句柄 ✗）⇒ 说清怎么办 ✓
                            stateLbl.set_text("删除失败：" + q + "（若正在播放它 ⇒ 先切到别的歌再删 ✓）")
                        }
                        SDL3.markFrameRedraw()
                    })
                }
            }
            SDL3.markFrameRedraw()
            return
        }
        if id == "open" {
            // 打开目录的实现随下载窗口一起搬到了 dl_window.leno（那里也有"打开目录"按钮 ⇒ 一份 ✓）
            if not dlw.openfolder(outdir) { stateLbl.set_text("打开目录失败：" + outdir) }
            SDL3.markFrameRedraw()
            return
        }
    }

    // ==================== 输出目录 ====================

    func onPickDir() {
        fdlg.showOpenFolderDialog(win, func(Array[string] paths, int filter) {
            if paths != null and paths.len() > 0 {
                outdir = paths[0]
                dirLbl.set_text(outdir)
                stateLbl.set_text("输出目录已改为：" + outdir)
                SDL3.markFrameRedraw()
            }
        }, {default_location: outdir})
    }

    // ==================== 设置 ====================

    // 打开「⚙ 设置」（在搜索行最右侧）：真改了就把新值立刻接上，并回一句到状态栏 ✓
    //   · 线程数只影响**下一次**开始下载（正在下的那批照旧 ✓）—— 设置窗口里也写着这句
    //   · 纯逻辑（读/写/钳位）在 dl_settings.leno，画界面在 dl_settings_win.leno ✓
    func onSettings() {
        if dlswin.show_settings_window() {
            cfg = dlset.load()
            string extra = if cfg.lyric then "，默认带歌词" else ""
            stateLbl.set_text("设置已保存：并行 " + _str(cfg.workers) + " 线程" + extra)
            SDL3.markFrameRedraw()
        }
    }

    // ==================== UI 构建 ====================

    func buildSources() {
        Array[Array[string]] srcs = eng.sources()
        for srcs to s {
            string id = s[0]
            string name = s[1]
            bool avail = s[2] == "1"
            string note = s[3]
            CheckBox box = SDL3.createCheckBox({text: name, checked: avail, enabled: avail, font_size: 13, tip: note})
            // 勾选变化只做提示：真正的音源列表在点搜索时现取（避免缓存状态不一致 ✓）
            box.on_change(func(bool v) {
                stateLbl.set_text("音源已更新（当前可用音源只有酷我，其余待移植）")
                SDL3.markFrameRedraw()
            })
            srcRow.add(box, {grow: 0, shrink: 0, align: 1})
            srcBoxes.add(box)
            srcIds.add(id)
            srcAvail.add(avail)
        }
    }

    func setupUI() {
        // 标题栏右侧按钮组：**下载窗口入口** + **设置**（与最小化/最大化/关闭同一排 ✓）
        // ★ 2026-10-07：改用应用自带图标 `images/download.png` / `images/setting.png`
        //   ⚠ 三条都要记牢（前两条都是踩/文档里写着的）：
        //     ① 路径必须是**绝对**的：标题栏把字符串**原样**交给 SDL_image ⇒ 相对路径跟着
        //        **进程 cwd** 走，换个工作目录启动就加载失败（画成一个小点 ✗）
        //     ② 读**随包资源**要用 `dirs.res_dir()`，**不能**用 `script_dir()` ✗ ——
        //        单文件打包后资源释放到缓存目录，`script_dir()` 还是 exe 所在目录 ⇒ 取不到 ✗
        //        （未打包时两者**完全一致** ⇒ 开发态照常 ✓ 见 docs/单文件打包使用指南.md §7）
        //     ③ 资源清单在本应用目录的 `resource.toml`（`[pack] resources = ["images/**"]` ✓）
        string imgDir = dirs.join(dirs.res_dir(), "images")
        string iconDl = dirs.join(imgDir, "download.png")
        string iconSet = dirs.join(imgDir, "setting.png")
        string iconApp = dirs.join(imgDir, "index.png")
        // 搜索结果每行"歌名前"的那个小音符（表格 `image_col` 用 ✓ 见 createTable / fillTable ✓）
        rowIcon = dirs.join(imgDir, "music.png")
        // 资源缺失时标题栏只会画个**小点、不报错** ⇒ 这里补一句明确警告（打包漏声明资源最常见 ✗）
        if not files.exists(iconDl) or not files.exists(iconSet) or not files.exists(iconApp) {
            print("[musicdl] 图标资源缺失：" + imgDir + "（打包请声明 resource.toml 的 [pack] resources ✓）\n")
        }
        if dlShot != "" { print("[musicdl] 图标目录（自检）：" + imgDir + "\n") }
        titleBar = SDL3.createTitleBar({
            title: "Leno 音乐下载器", height: 32, font_size: 14,
            // ★ 标题前的应用图标（2026-10-07 新增）：只有文字时标题前面空一块、观感差 ✗
            //   与文字**整体**居中/左对齐，尺寸比窗口按钮图标略大一点（18 vs 16 ✓）
            title_icon: iconApp, title_icon_size: 18,
            actions: [
                {id: "download", icon: iconDl, tip: "下载勾选的歌（打开下载窗口；已开着就切到前台）"},
                {id: "settings", icon: iconSet, tip: "设置：并行下载线程数、默认是否带歌词"}
            ]
        })
        titleBar.on_action(func(string id) {
            // 下载入口：判定 / 防重复 / 起线程都在那几处，这里只做"该说清的说清" ✓
            if id == "download" { onDownloadAction() }
            eif id == "settings" { onSettings() }
        })
        win.add(titleBar)
        float titleH = titleBar.get_h()

        var root = SDL3.createVBox({padX: 12, padY: 10, spacing: 8})

        // ---- 搜索行 ----
        var row1 = SDL3.createHBox({h: 34, padX: 0, padY: 0, spacing: 8})
        // ★ 搜索框左边的小音符（2026-10-08 ✓）：`images\music.png`
        //   它是**彩色**图（绿色音符 + 透明底 ✓）⇒ 不用 tint ✓；不给 `image_mode` ⇒ 走默认
        //   `MODE_ASPECT_FIT`（保持比例、完整显示 ✓）—— 给了 1（拉伸）就会被拉变形 ✗
        var logo = SDL3.createImageView({w: 26, h: 26, image_path: rowIcon})
        logo.set_tip("音乐下载器：搜歌 → 勾选 → 下载（下载目录可在下面改）")
        row1.add(logo, {grow: 0, shrink: 0, basis: 26, align: 1})
        keywordEdit = SDL3.createEdit({
            text: "", w: 380, h: 32, font_size: 14,
            placeholder: "输入歌名 / 歌手，回车或点「搜索」（如：周杰伦 晴天）"
        })
        keywordEdit.on_enter(func() { onSearch() })
        row1.add(keywordEdit, {grow: 1, shrink: 1, align: 3})
        searchBtn = SDL3.createButton({w: 90, h: 32, text: "搜索", type: "primary", font_size: 14})
        searchBtn.set_tip("按勾选的音源搜索（当前只有酷我可用）")
        searchBtn.on_click(func() { onSearch() })
        row1.add(searchBtn, {grow: 0, shrink: 0, basis: 90, align: 3})
        // ★ 格式下拉框（2026-10-08 ✓）——一次搜回来常混着 flac / mp3 / aac，只想下某种后缀时
        //   不用一行行取消勾选 ✓
        //   · 选项**按搜到的内容生成**（`refreshFmtItems` ✓ 搜完才填 ✓）
        //   · 只作用于**批量下载**（「下载勾选」「下载选中行」✓）；右键「下载这一首」/ 双击某行
        //     是**显式点名单曲** ⇒ 不拦 ✓（拦了就像"点了没反应" ✗）
        row1.add(SDL3.createLabel({text: "格式", font_size: 13}), {grow: 0, shrink: 0, align: 1})
        fmtBox = SDL3.createComboBox({
            w: 120, h: 32, font_size: 13, item_h: 26, selected: 0,
            items: ["全部格式"],
            tip: "只下这种后缀的（搜索完成后按搜到的格式列出）"
        })
        fmtBox.on_change(func(int idx) { onFmtChanged() })
        fmtBox.set_enabled(false)      // 还没搜 ⇒ 只有「全部格式」一项 ⇒ 先灰着（搜完由 refreshFmtItems 打开 ✓）
        row1.add(fmtBox, {grow: 0, shrink: 0, basis: 120, align: 3})
        row1.add(SDL3.createLabel({text: "每源条数", font_size: 13}), {grow: 0, shrink: 0, align: 1})
        limitSpin = SDL3.createSpinBox({w: 86, h: 32, min: 5, max: 50, step: 5, value: 20, int_mode: true, font_size: 13})
        limitSpin.set_tip("每个音源最多取多少条（酷我接口的 rn 参数）")
        row1.add(limitSpin, {grow: 0, shrink: 0, basis: 86, align: 3})
        // 设置入口已移到**标题栏右侧的齿轮按钮**（上面的 actions: [{id:"settings", icon:"gear"}] ✓）
        root.add(row1, {grow: 0, shrink: 0, align: 3})

        // ---- 音源 + 输出目录行 ----
        srcRow = SDL3.createHBox({h: 30, padX: 0, padY: 0, spacing: 10})
        srcRow.add(SDL3.createLabel({text: "音源：", font_size: 13}), {grow: 0, shrink: 0, align: 1})
        buildSources()
        // ★ 弹性空隙放在这里 ⇒「输出目录 + 路径 + 选择目录」整组被推到**行右侧**、
        //   贴着"选择目录"按钮（原来空隙在路径标签上，把它顶到了复选框旁边 ✗）
        srcRow.add(SDL3.createLabel({text: ""}), {grow: 1, shrink: 0, align: 1})
        srcRow.add(SDL3.createLabel({text: "输出目录：", font_size: 13}), {grow: 0, shrink: 0, align: 1})
        dirLbl = SDL3.createLabel({text: outdir, font_size: 12, truncate: 1, max_w: 320.0})
        dirLbl.set_tip(outdir)
        // grow:0（不再抢剩余空间） + shrink:1（窗口变窄时由它让位 ⇒ 配合 max_w 走省略号）
        srcRow.add(dirLbl, {grow: 0, shrink: 1, align: 1})
        dirBtn = SDL3.createButton({w: 88, h: 28, text: "选择目录", font_size: 13})
        dirBtn.on_click(func() { onPickDir() })
        srcRow.add(dirBtn, {grow: 0, shrink: 0, basis: 88, align: 3})
        root.add(srcRow, {grow: 0, shrink: 0, align: 3})

        // ---- 操作行 ----
        var row3 = SDL3.createHBox({h: 32, padX: 0, padY: 0, spacing: 8})
        dlCheckedBtn = SDL3.createButton({w: 140, h: 30, text: "下载勾选", type: "success", font_size: 13})
        dlCheckedBtn.set_tip("下载列表里勾选的歌曲（默认全勾）")
        dlCheckedBtn.on_click(func() { onDownloadChecked() })
        dlCheckedBtn.set_enabled(false)
        row3.add(dlCheckedBtn, {grow: 0, shrink: 0, basis: 140, align: 3})
        dlSelBtn = SDL3.createButton({w: 120, h: 30, text: "下载选中行", font_size: 13})
        dlSelBtn.set_tip("下载表格里当前选中的行（Ctrl/Shift 可多选）")
        dlSelBtn.on_click(func() { onDownloadSelected() })
        dlSelBtn.set_enabled(false)
        row3.add(dlSelBtn, {grow: 0, shrink: 0, basis: 120, align: 3})
        // 歌词开关：紧跟在两个下载按钮后面（它是"下载"的选项，语义上属于下载这一组），
        // 后面用一条竖线把"下载动作"与"表格选择"分开，避免三类控件挤成一团（2026-10-07 调整 ✓）
        lyricBox = SDL3.createCheckBox({text: "同时下载歌词", checked: true, font_size: 13})
        lyricBox.set_tip("下载音频时顺带存一份同名 .lrc（酷我官方歌词，含译文行）")
        lyricBox.on_change(func(bool v) {
            stateLbl.set_text(if v then "下载时将同时保存 .lrc 歌词" else "下载时不再保存歌词（右键菜单仍可单独下歌词）")
            SDL3.markFrameRedraw()
        })
        row3.add(lyricBox, {grow: 0, shrink: 0, align: 1})
        // 分组间隔：本来想用一条竖向 Separator，但**实测 Separator 放进 HBox 里不渲染**
        //   （thickness/color/alpha/basis/align 各组合都试过，仍不可见 ⇒ 疑似布局没给它非零高度）
        //   ⇒ 改用"嵌套 HBox + 左内边距"制造视觉间隔，效果等价且可靠 ✓
        var selGroup = SDL3.createHBox({h: 32, padX: 14, padY: 0, spacing: 8})
        selAllBtn = SDL3.createButton({w: 70, h: 30, text: "全选", font_size: 13})
        selAllBtn.on_click(func() { table.check_all(); updateCount(); SDL3.markFrameRedraw() })
        selGroup.add(selAllBtn, {grow: 0, shrink: 0, basis: 70, align: 3})
        selNoneBtn = SDL3.createButton({w: 70, h: 30, text: "全不选", font_size: 13})
        selNoneBtn.on_click(func() { table.uncheck_all(); updateCount(); SDL3.markFrameRedraw() })
        selGroup.add(selNoneBtn, {grow: 0, shrink: 0, basis: 70, align: 3})
        row3.add(selGroup, {grow: 0, shrink: 0, align: 3})
        countLbl = SDL3.createLabel({text: "已选 0 / 0 首", font_size: 13})
        row3.add(countLbl, {grow: 1, shrink: 1, align: 2})
        root.add(row3, {grow: 0, shrink: 0, align: 3})

        // ---- 结果表格 ----
        // 第 0 列是复选框列（表头可全选/全不选）；其余 6 列与 dl_engine 的歌曲行字段对应
        table = SDL3.createTable({
            headers: ["", "歌名", "歌手", "专辑", "时长", "格式", "大小"],
            col_widths: [40.0, 300.0, 150.0, 200.0, 70.0, 66.0, 110.0],
            aligns: [1, 0, 0, 0, 1, 1, 2],
            header_aligns: [1, 0, 0, 0, 1, 1, 2],
            check_col: 0,
            // ★ 图标列（2026-10-08 ✓）：框架的 `image_col` = 把该列画成 **[图标 + 文字]** ✓
            //   ⇒ 图标自然落在**歌名前** ✓（列 1 = 歌名；列 0 是勾选列 ✓ 见 check_col ✓）
            //   18px 图标 + 6px 间距：row_h=26 下看着正好，也不挤掉歌名的地方 ✓
            image_col: 1, image_size: 18, image_gap: 6,
            // ★ 默认图标（2026-10-08 框架新增 ✓）：每行都用它 ⇒ **不必逐行 set_row_image** ✗
            //   先前必须每次 set_rows 后重贴（`set_rows` 会清 rowImages ✗ 见 fillTable 的历史注释 ✓）
            //   ⇒ 现在一次给、永不掉 ✓
            image_path: rowIcon,
            sortable: true, zebra: true, row_h: 26, header_h: 30, font_size: 14,
            multi: true,
            empty_text: "还没有结果 —— 输入关键词后回车搜索"
        })
        table.on_check(func(int col, Array[int] checked) { updateCount() })
        table.on_select(func(int row) { dlSelBtn.set_enabled(row >= 0) })
        table.on_dbl_click(func(int row, int col) {
            if row >= 0 and row < songs.len() { startDownload([songs[row]], downloadflags()) }
        })
        table.on_context_will_open(func(int row) { buildMenu(row) })
        table.on_context_select(func(int row, string id) { onMenu(row, id) })
        root.add(table, {grow: 1, shrink: 1, align: 3})

        // ★ 播放条（2026-10-07）：**嵌在表格下方、状态栏上方** ✓（不另开窗口 ✓）
        //   它自带两行：① 歌名 + 进度 + 时间  ② 上一首/播放/下一首/循环 + 音量 + 重扫 + 序号
        //   目录 = 输出目录（downloads/ ⇒ 播的是已下好的本地文件 ✓）
        pbar = pb.create_player_bar(outdir, imgDir, stateLbl)
        root.add(pbar.box, {grow: 0, shrink: 0, align: 3})

        // ---- 忙指示 + 状态栏 ----
        busyBar = SDL3.createProgressBar({h: 6, show_text: false})
        busyBar.set_value(0.0)
        root.add(busyBar, {grow: 0, shrink: 0, align: 3})
        var statusRow = SDL3.createHBox({h: 24, padX: 0, padY: 0, spacing: 12})
        stateLbl = SDL3.createLabel({text: "就绪", font_size: 13})
        statusRow.add(stateLbl, {grow: 1, shrink: 1, align: 1})
        statusRow.add(SDL3.createLabel({text: "双击某行 = 下载这一首；右键列表 = 批量/复制/打开目录", font_size: 12}), {grow: 0, shrink: 0, align: 2})
        root.add(statusRow, {grow: 0, shrink: 0, align: 3})

        win.setRootAt(root, 0, titleH)
    }

    // ==================== 事件与主入口 ====================

    // 还有"在下"的任务吗（决定主窗口能不能直接关 ✓）
    func downloadingNow(): bool {
        if dl is DlWindow => w {
            return w.open and w.started and not w.finished
        }
        return false
    }

    func handleEvent(Event ev): bool {
        // ★ 播放条的浮层先看事件：它开着时，点别处 / 按 ESC 由它收起（= 失去焦点即收 ✓）
        //   ⚠ 必须排在下面"ESC 关窗口"**之前**：否则开着歌单按 ESC 会直接退程序 ✗
        if pbar is PlayerBar => pb2 { if pb2.on_event(ev) { return true } }
        // ★ 2026-10-07：改非模态后主窗口才**关得掉**（模态时它的全部事件被跳过 ⇒ 点 ✕ 等于没点）
        //   ⇒ 这里必须拦一下：还在下就直接退，进程一结束线程被带走 ⇒ 可能留下**半截文件** ✗
        //   拦法用框架的 `cancelClose()`（"关闭到托盘"同款机制 ✓）：窗口不关，状态栏说清怎么办
        bool winClose = ev.isQuit() or ev.isWindowClose() or titleBar.is_close_requested()
        bool escQuit = ev.isKeyDown() and ev.scancode() == Scancode.ESCAPE
        if (winClose or escQuit) and downloadingNow() {
            if winClose { win.cancelClose() }      // 只有窗口关闭需要走 cancelClose（框架机制 ✓）
            titleBar.clear_close_request()
            stateLbl.set_text("还有下载在跑 —— 先在下载窗口点「取消」（或关掉它）再退出，免得留下半截文件")
            SDL3.markFrameRedraw()
            return true
        }
        if ev.isQuit() or ev.isWindowClose() { return false }
        if titleBar.is_close_requested() {
            titleBar.clear_close_request()
            return false
        }
        if ev.isKeyDown() and ev.scancode() == Scancode.ESCAPE { return false }
        return true
    }

    func run() {
        // 无控制台：**打包成 exe 后双击不弹黑框** ✓
        //   · 打包器在**语义分析阶段**就会看到这句 `_console(false)`（只认字面量 false/0，
        //     写成变量检测不到 ✗）⇒ 自动改用无控制台的 `leno_vm_gui.exe` 作基底 ✓
        //     （命令行 `--console` 可反过来强制控制台版 ✓；两者优先级见 main.c 的注释 ✓）
        //   · ★ 为什么套一层"是否打包"：开发态 `build\leno.exe app.leno` 是从终端启的，
        //     `_console(false)` 会把**你那个终端窗口**一起藏掉 ✗
        //     判据用文档给的那条（打包指南 §7）：**打包后 `res_dir() != script_dir()`** ✓
        if dirs.res_dir() != dirs.script_dir() { _console(false) }
        SDL3.ttfInit()
        SDL3.setTheme(SDL3.lightTheme())
        win = SDL3.createWindow({title: "Leno 音乐下载器", w: 1060, h: 680, flags: 0x20})
        if not win.ok {
            SDL3.ttfQuit()
            return
        }
        win.setMinSize(780, 460)

        // 窗口 / 任务栏图标（运行时）：**PNG 直接可用** ✓（`win.setIcon` 内部会把像素拷进窗口
        //   ⇒ 拷完即可释放 surface ✓）
        //   ⚠ 这跟"打包进 exe 的图标"是两码事：exe 那个**只认 .ico** ✗
        //     （见 docs/单文件打包使用指南.md §4.2：PNG/JPG 必须先转成 ICO 容器 ✓）
        string appIcon = dirs.join(dirs.res_dir(), "images", "index.png")
        if files.exists(appIcon) {
            var iconSurf = SDL3.loadImage(appIcon)
            if iconSurf != null {
                win.setIcon(iconSurf)
                SDL3.destroySurface(iconSurf)
            }
        }

        // 默认输出目录 = 脚本目录/downloads（与 CLI 版一致，两边的下载文件放一处）
        outdir = dirs.script_dir() + _sep() + "downloads"

        // 读设置（文件不存在 / 坏了 ⇒ 出厂默认 ✓，见 dl_settings.load）—— **setupUI 之前**读，
        //   这样"默认带歌词"能直接套到工具栏那个勾选框上 ✓
        cfg = dlset.load()

        setupUI()
        // ⚠ setupUI 之后才能碰控件：套上设置里的"默认带歌词"，并在状态栏报一下并行度 ✓
        lyricBox.set_checked(cfg.lyric)
        stateLbl.set_text("就绪（并行 " + _str(cfg.workers) + " 线程；标题栏右上「下载 / 设置」两个图标）")
        // 全局 120ms 一拍：搜索进度、下载进度、"忙"指示（定时器是模块级全局的 ⇒ 模态对话框
        // 打开期间照样触发，所以下载进度条能在模态窗里动起来 ✓）
        win.addTimer(120, func() { onTick() })
        // ★ 33ms 只为一件事：让播放条左边的**唱片转起来**（120ms 一拍太卡 ✗）。
        //   不播时 `animate()` 立刻返回 ⇒ 不在播就是零开销 ✓（见 player_bar.animate ✓）
        win.addTimer(33, func() {
            if pbar is PlayerBar => b { b.animate() }
        })

        // ---- 自检钩子（见文件头那段 ✓）：截图/自动退出必须放**叠加层** ----
        //   叠加层在所有控件/弹层之后、present 之前 ⇒ 此刻帧才完整 ✓
        //   （放 onRender 回调里读只能拿到"只有底色"的空白图 ✗ —— dashboard 踩过 ✓）
        if dlShot != "" or dlAuto > 0 {
            win.setOverlay(func(Renderer r) {
                dlFrames = dlFrames + 1
                if dlShot != "" and dlFrames >= dlShotAt {
                    var wsz = win.getSize()
                    // DCROP=<高> ⇒ 只截最下面这一条 ✓（小图看不清按钮/悬停时非常有用 ✓）
                    int cy2 = 0
                    int ch2 = wsz.h
                    var cp = _env("DCROP")
                    if cp != null { ch2 = _int(_str(cp)); cy2 = wsz.h - ch2 }
                    var s = r.readPixelsAt(0, cy2, wsz.w, ch2)
                    bool ok = false
                    if s != null { ok = SDL3.saveImagePNG(s, dlShot) }
                    print("[musicdl] 截图 " + dlShot + " ok=" + _str(ok) + " 帧=" + _str(dlFrames) + "\n")
                    _exit(0)
                }
                if dlAuto > 0 and dlFrames >= dlAuto {
                    print("[musicdl] DAUTO=" + _str(dlAuto) + " 帧跑完 ⇒ 退出 ✓\n")
                    _exit(0)
                }
            })
        }

        win.run(
            func(Event ev): bool { return handleEvent(ev) },
            func(Renderer r) { }
        )
        // ★ 退出前收摊：**释放音频设备** ✓
        //   `player` 的 `Sound` 会占着 miniaudio 的设备与线程；不释放的话点退出可能"卡着" ✗
        //   （这里覆盖所有退出路径：点 ✕ / ESC / requestExit 都会先返回 `win.run` ✓）
        if pbar is PlayerBar => pb2 { pb2.shutdown() }
        SDL3.ttfQuit()
    }
}

// ==================== 程序入口 ====================
// 退出路径自检用：`DEXIT=<tick 数>` ⇒ 到点走**正常退出路径**（requestExit，不是 _exit 强杀 ✓）
//   为什么要它：DSHOT/DAUTO 走的都是 `_exit(0)` 强杀 ✗ ⇒ **永远测不出"退出卡住"** ✗（本仓踩过 ✓）
int gExitTicks = 0

// 歌单点击自检：`DPCLICK=1` ⇒ 用**注入真实点击**走一遍「列表」按钮 → 歌单第 3 行 ✓
//   为什么要它：人手点没法进无人值守的断言 ✗；而**直接调控件回调**又测不出"点没点到" ✗
//   （本仓有过"用窗口矩形坐标去点 ⇒ 整体偏一个标题栏高 ⇒ 点在按钮外面"的教训 ✓ 见 sdl_window:277）
int gClickStep = 0
int gClickRow3 = -1     // 自检记录：点第 3 行后的下标（期望 2 ✓）

// ===== 试听（搜索结果右击「播放试听」✓）：拉"前一段"再播 ✓ =====
//   为什么是"前一段"：下载是顺序追加写 ⇒ 截断文件前缀自洽、能播 ✓（见 dl_engine.dl_preview ✓）
//   ⚠ 必须**起线程**去拉（同步拉会把界面卡死 ✗）；worker 入口得是本文件的具名全局函数 ✓（语言硬约束 ✓）
Channel? gPreviewCh = null
Thread? gPreviewThread = null
const int PREVIEW_BYTES = 1600000    // ≈1.5MB ⇒ 128kbps 下约 100 秒，试听足够 ✓

// ===== 试听配套的"后台整首下载"（2026-10-07 新增 ✓）=====
//   为什么要有它：只拉前一段 ⇒ 永远只能听个开头 ✗（想接着听就得再走一遍"下载"流程 ✓）
//     ⇒ 试听时**同时**把整首下到输出目录：立刻有声 ✓ + 下完它就是本地正规文件 ✓
//   · **静默**：不开下载窗口 ✗，进度回写到播放条（歌手行那句 "整首下载 42%" ✓）
//   · 下完 ⇒ 播放条自动切到完整文件、**接着刚才那一秒**播 ⇒ 此后进度条可拖 ✓（pb.on_downloaded ✓）
//   ⚠ 同一首别重复起线程：连点试听会让两个线程写**同一个路径** ✗（并发写 = 文件写坏 ✓）
//      ⇒ 用 gBgDlRunning + gBgDlTag 挡住 ✓（不同歌可以接替：后一首覆盖 tag ✓）
Channel? gBgDlCh = null
Thread? gBgDlThread = null
string gBgDlTag = ""
bool gBgDlRunning = false

// 最近一次"试听"的那一行（搜索结果里的整行 ✓）
//   为什么记它：歌词面板的"立即下载歌词"要**歌曲 ID** ✓；只有搜索结果的行才带 ID ✓
//   列表里的歌是磁盘文件名（没有 ID ✗）⇒ 那种情况只能提示用户去搜索结果里右键 ✓ 不瞎猜 ✗
Array[string] gPrevRow = []
// 悬停自检（本仓无头环境点不到、移不动鼠标 ⇒ 用注入 ✓）：
//   `DHOVER=1` ⇒ 第 2 拍把指针移到播放键上，配合 `DSHOT` 截图即可验"悬停色到底画没画" ✓
//   用法：DCROP=110 DSHOT=<png> DSHOT_AT=30 DHOVER=1 build\leno.exe <本文件> ✓
int gHoverTick = 0

main() {
    var ex = _env("DEXIT")
    if ex != null { gExitTicks = _int(_str(ex)) }
    var sh = _env("DSHOT")
    if sh != null { dlShot = _str(sh) }
    var sa = _env("DSHOT_AT")
    if sa != null { dlShotAt = _int(_str(sa)) }
    var au = _env("DAUTO")
    if au != null { dlAuto = _int(_str(au)) }
    var dc = _env("DPCLICK")
    if dc != null { gClickStep = 1 }
    var dh = _env("DHOVER")
    if dh != null { gHoverTick = 2 }
    MusicDlApp app = new MusicDlApp()
    app.run()
}
