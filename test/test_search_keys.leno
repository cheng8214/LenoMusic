// test_search_keys.leno —— 搜索表的「表头 ↔ 字段名」契约（2026-11-10，P1）
//
// 与 test_bang_keys 同款：`search_headers()` 与 `search_keys()` 必须**等长同序**，
// 错位编译期查不出来（表现是"歌手列里显示专辑"）。改表头/加列时这个测试会先红。
import "../search_page.leno" as sp

main() {
    Array[string] keys = sp.search_keys()
    Array[string] headers = sp.search_headers()

    assert_eq(keys.len(), headers.len(), "keys 与 headers 等长");
    assert_eq(keys.len(), 8, "8 列（勾选 + 6 个数据列 + 来源）");

    assert_eq(keys[0], "pad", "第 0 列 = 勾选框");
    assert_eq(headers[0], "", "第 0 列标题为空");
    assert_eq(keys[1], "name", "第 1 列 = 歌名");
    assert_eq(headers[1], "歌名", "第 1 列标题");
    assert_eq(keys[2], "artist", "第 2 列 = 歌手");
    assert_eq(headers[2], "歌手", "第 2 列标题");
    assert_eq(keys[3], "album", "第 3 列 = 专辑");
    assert_eq(headers[3], "专辑", "第 3 列标题");
    assert_eq(keys[4], "duration", "第 4 列 = 时长");
    assert_eq(headers[4], "时长", "第 4 列标题");
    assert_eq(keys[5], "ext", "第 5 列 = 格式");
    assert_eq(headers[5], "格式", "第 5 列标题");
    assert_eq(keys[6], "size", "第 6 列 = 大小");
    assert_eq(headers[6], "大小", "第 6 列标题");
    assert_eq(keys[7], "src", "第 7 列 = 来源");
    assert_eq(headers[7], "来源", "第 7 列标题");

    print("test_search_keys passed（8 列表头 ↔ 字段名逐位对应）")
}
