// test_netease_lyric_merge.leno — 网易云歌词「按时间戳并译文」的**金标回归**（纯逻辑、离线 ✓）
//
// 为什么必须有：`netease_lyric.leno` 的 tagof/aftertag 是「手搓字符游标 + 切片」，
//   而本语言的**切片口径曾经有两套**（见下面 ⓪）：语法 `s[a:b]` 是**闭区间（含 b）**、
//   方法 `slice(a,b)` 曾是**开区间**。2026-10-10 已统一成闭区间（主仓库 + 本项目调用点同步改写）。
//   当时（旧口径）的实现按**开区间**心算
//   （`s[i:(j + 1)]`、`line[i:(i + tag.len())]`）⇒ 在闭区间下**多咬一个字符**：
//     "[00:12.34]你好世界" 切出 "[00:12.34]你" ⇒ 后面那段"只认数字/:/."的校验必然失败
//     ⇒ tagof 恒返回 "" ⇒ mergetranslation 里两处 `if tag == "" { continue }` 全中
//     ⇒ **译文永远并不进去、行尾也不重排**，而且**一声不响**（表现只是"这首歌怎么没译文"）✗
//   ⇒ 这类"改起来看不出错、只是结果悄悄变了"的代码，必须先用公开接口把现状钉成金标 ✓
//
// 覆盖：切片两套口径自检 / 并译文（全并 · 缺行）/ 无译文原样返回 / 元信息行跳过 /
//       行首空格 / 标签后无文字 / 非法时间形状 / 空行不炸 / 落盘形态（CRLF、末尾不多空行）
//
// 跑：<发行包>\leno.exe test\test_netease_lyric_merge.leno
import "../netease_lyric.leno" as nl

var fails = 0

// 换行转义成 "|" 再比：失败时能一眼看出差在哪个位置（而不是两团等长的文本）
func esc(string s): string {
    return s.replace("\r\n", "|").replace("\n", "|")
}

func checkeq(string name, string got, string want) {
    string g = esc(got)
    string w = esc(want)
    if g == w {
        print($"[通过] {name}")
    } else {
        fails = fails + 1
        print($"[失败] {name}")
        print($"      got : {g}")
        print($"      want: {w}")
    }
}

main() {
    // ---- ⓪ 前置：先钉住**切片口径**本身（本 bug 的根因 ⇒ 改语言语义时先看这两条 ✓）----
    //   ★ 2026-10-10：方法 `slice` 已与语法统一成**闭区间**（此前是开区间）⇒ 两条都是 "bcd" ✓
    checkeq("语法 s[a:b] 闭区间（含 b）", "abcde"[1:3], "bcd")
    checkeq("方法 slice(a,b) 也是闭区间（含 b）", "abcde".slice(1, 3), "bcd")
    //   长度口径**另有名字**（别混）：take(a, n) = 从 a 取 n 个 ✓
    checkeq("长度口径 take(a,n)", "abcde".take(1, 2), "bc")

    // ---- ① 标准情形：译文按时间戳并到原文行**后面**（播放器浮层就认这个形态 ✓）----
    checkeq("译文并进原文（两行都并）",
            nl.mergetranslation("[00:12.34]原文一\n[00:20.00]原文二\n",
                                "[00:12.34]译文一\n[00:20.00]译文二\n"),
            "[00:12.34]原文一\r\n[00:12.34]译文一\r\n[00:20.00]原文二\r\n[00:20.00]译文二\r\n")

    // ---- ② 译文只给了一句 ⇒ 只并那句，另一句原样（不许整段丢掉 ✓）----
    checkeq("译文缺一行 ⇒ 只并那一行",
            nl.mergetranslation("[00:12.34]原文一\n[00:20.00]原文二\n",
                                "[00:12.34]译文一\n"),
            "[00:12.34]原文一\r\n[00:12.34]译文一\r\n[00:20.00]原文二\r\n")

    // ---- ③ 没有译文（纯音乐/无版权）⇒ 原文**原样**返回（连行尾都不动 ✓）----
    checkeq("无译文 ⇒ 原文原样",
            nl.mergetranslation("[00:12.34]原文一\n[00:20.00]原文二\n", ""),
            "[00:12.34]原文一\n[00:20.00]原文二\n")

    // ---- ④ 元信息行（[ti:]/[ar:]/[by:]…）既不是时间戳、也不能当译文源 ----
    //   注意：译文侧那行"译文垃圾"前面挂了 [ar:歌手] ⇒ tagof 认不出 ⇒ 不许混进来 ✓
    checkeq("元信息行跳过（两边都不认）",
            nl.mergetranslation("[ti:歌名]\n[00:12.34]原文一\n",
                                "[00:12.34]译文一\n[ar:歌手]\n译文垃圾\n"),
            "[ti:歌名]\r\n[00:12.34]原文一\r\n[00:12.34]译文一\r\n")

    // ---- ⑤ 行首带前导空格/制表符的标签也要认（tagof 会先跳空白 ✓）----
    checkeq("行首空格 + 标签",
            nl.mergetranslation("[00:12.34]原文一\n", "  [00:12.34]译文一\n"),
            "[00:12.34]原文一\r\n[00:12.34]译文一\r\n")

    // ---- ⑥ 标签正好到行尾（后面没字）⇒ 不算译文（aftertag 取到空串 ⇒ 跳过，别并个空行进去 ✓）----
    checkeq("标签后无文字 ⇒ 不算译文",
            nl.mergetranslation("[00:12.34]原文一\n[00:20.00]原文二\n", "[00:12.34]\n"),
            "[00:12.34]原文一\r\n[00:20.00]原文二\r\n")

    // ---- ⑦ 非法时间形状（[01:xx]/[12]）⇒ 整行不当标签（不是"错并"，是"不并" ✓）----
    checkeq("非法时间形状不认",
            nl.mergetranslation("[00:09]好的\n", "[01:xx]乱码\n[12]乱码\n"),
            "[00:09]好的\r\n")

    // ---- ⑧ 空行/空串不炸：不会崩、也不会在落盘里多留空行（结尾只能有一个 CRLF ✓）----
    checkeq("空行不炸、末尾不多空行",
            nl.mergetranslation("\n[00:12.34]原文一\n\n", "\n[00:12.34]译文一\n\n"),
            "[00:12.34]原文一\r\n[00:12.34]译文一\r\n")

    // ---- ⑨ 落盘口径：并过译文的文本行尾一律 CRLF（与 kuwo_lyric 的落盘形态对齐 ✓）----
    //   判据：把 CRLF 全剥掉之后，**不许**再剩下裸 LF
    string merged = nl.mergetranslation("[00:12.34]原文一\n", "[00:12.34]译文一\n")
    if merged.replace("\r\n", "").has("\n") {
        fails = fails + 1
        print("[失败] 并译文后行尾是 CRLF（没有裸 LF）")
    } else {
        print("[通过] 并译文后行尾是 CRLF（没有裸 LF）")
    }

    print("")
    if fails == 0 {
        print("=== 全部通过 ===")
    } else {
        print($"=== 有失败：{fails} 项  ===")
    }
}
