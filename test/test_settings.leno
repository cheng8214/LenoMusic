// test_settings.leno — 设置的**真文件读写**回归（纯逻辑、无 SDL3 ⇒ 无 GUI 可跑 ✓）
//
// 跑（仓库根目录）：<发行包>\leno.exe test\test_settings.leno
//   （Linux/macOS：<发行包>/leno test/test_settings.leno）
//
// ⚠ 会真写配置文件（用户配置目录：Windows `%APPDATA%` / Linux `$XDG_CONFIG_HOME` 下的
//   `LenoMusicDl/settings.json`）：**测完把原值写回去**，不留痕 ✓
//   （这也是"配置坏了不该让应用起不来"的另一面：读写必须真的经过文件系统才算测过 ✓）
import "../dl_settings.leno" as cfg
use cfg.DlSettings

main() {
    print("=== 设置读写（真文件）===")
    print("   " + cfg.store_path())

    DlSettings keep = cfg.load()          // 先记下原来的（测完放回去 ✓）

    DlSettings probe = new DlSettings()
    probe.workers = 7
    probe.lyric = not keep.lyric
    assert_eq(cfg.save(probe), true)
    DlSettings back = cfg.load()
    assert_eq(back.workers, 7)
    assert_eq(back.lyric, not keep.lyric)

    // 越界值：**落盘前**就该被钳住 ⇒ 文件里永远不出现非法值 ✓
    DlSettings wild = new DlSettings()
    wild.workers = 999
    cfg.save(wild)
    assert_eq(cfg.load().workers, cfg.WORKERS_MAX)

    DlSettings low = new DlSettings()
    low.workers = -3
    cfg.save(low)
    assert_eq(cfg.load().workers, cfg.WORKERS_MIN)

    // ---- 每源条数记忆（2026-10-08 ✓）----
    DlSettings lim = new DlSettings()
    lim.limit = 35
    assert_eq(cfg.save(lim), true)
    assert_eq(cfg.load().limit, 35)

    // 越界值同样"落盘前钳住"（与 workers 一个口径 ✓）
    DlSettings lw = new DlSettings()
    lw.limit = 999
    cfg.save(lw)
    assert_eq(cfg.load().limit, cfg.LIMIT_MAX)
    DlSettings ll = new DlSettings()
    ll.limit = -3
    cfg.save(ll)
    assert_eq(cfg.load().limit, cfg.LIMIT_MIN)

    // ---- 音源勾选记忆（2026-10-08 ✓）----
    //   重点是**真数组**过一遍文件（写 JSON 数组 + 读回按仓库范式逐元素取 ✓）
    //   ⚠ `sources` 与 `sourcesSet` 要一起给（应用侧 persist_settings 就是一起给的 ✓）
    DlSettings src = new DlSettings()
    src.sources = ["kuwo", "qq"]
    src.sourcesSet = true
    assert_eq(cfg.save(src), true)
    DlSettings b2 = cfg.load()
    assert_eq(b2.sourcesSet, true)
    assert_eq(b2.sources.len(), 2)
    assert_eq(b2.sources[0], "kuwo")
    assert_eq(b2.sources[1], "qq")
    assert_eq(cfg.sources_has(b2.sources, "qq"), true)
    assert_eq(cfg.sources_has(b2.sources, "netease"), false)

    // 空数组 = "一个都不要"，但**存过** ⇒ 不能回落成"没存过" ✗（否则下次启动又全勾上 ✓）
    DlSettings none = new DlSettings()
    none.sources = []
    none.sourcesSet = true
    cfg.save(none)
    DlSettings b3 = cfg.load()
    assert_eq(b3.sourcesSet, true)
    assert_eq(b3.sources.len(), 0)

    // ---- "从没存过勾选"必须**原样读回**（2026-10-08）----
    //   否则新装用户第一次保存（哪怕只改了线程数）就会把出厂默认"音源全勾"变成"全不勾" ✗
    DlSettings fresh = new DlSettings()          // sourcesSet 默认 false
    cfg.save(fresh)
    DlSettings fb = cfg.load()
    assert_eq(fb.sourcesSet, false)              // 仍是"没存过" ⇒ 应用会走默认全勾 ✓
    assert_eq(fb.sources.len(), 0)

    // ---- ★ 2026-10-11：音量 / 循环 / 输出目录 / 格式过滤 / 榜单页 / 窗口尺寸 ----
    //   用户实测："音量这些居然没有保存，二次打开就归 0" ⇒ 这几项也必须过一遍**真文件** ✓
    DlSettings ex = new DlSettings()
    ex.volume = 35
    ex.loop = 2
    ex.outdir = "D:\\音乐\\我的下载"
    ex.fmt = "flac"
    ex.bangSrc = "netease"
    ex.bangId = "3778678"
    ex.bangOnly = true
    ex.winW = 1280
    ex.winH = 800
    assert_eq(cfg.save(ex), true)
    DlSettings eb = cfg.load()
    assert_eq(eb.volume, 35)
    assert_eq(eb.loop, 2)
    assert_eq(eb.outdir, "D:\\音乐\\我的下载")      // 中文路径也要原样过一遍（UTF-8 ✓）
    assert_eq(eb.fmt, "flac")
    assert_eq(eb.bangSrc, "netease")
    assert_eq(eb.bangId, "3778678")
    assert_eq(eb.bangOnly, true)
    assert_eq(eb.winW, 1280)
    assert_eq(eb.winH, 800)

    // 越界值同样"落盘前钳住"（一个口径 ✓）
    DlSettings ew = new DlSettings()
    ew.volume = 999
    ew.loop = 7
    ew.winW = 10          // 比 setMinSize(780,460) 还小 ⇒ 拽回下限 ✓
    ew.winH = 10
    cfg.save(ew)
    DlSettings ebw = cfg.load()
    assert_eq(ebw.volume, cfg.VOLUME_MAX)
    assert_eq(ebw.loop, cfg.LOOP_MAX)
    assert_eq(ebw.winW, cfg.WIN_W_MIN)
    assert_eq(ebw.winH, cfg.WIN_H_MIN)
    DlSettings el = new DlSettings()
    el.volume = -5
    el.loop = -1
    cfg.save(el)
    DlSettings ebl = cfg.load()
    assert_eq(ebl.volume, cfg.VOLUME_MIN)
    assert_eq(ebl.loop, cfg.LOOP_MIN)

    // ⚠ 窗口尺寸 0 = "**没存过**"（不是"钳成 780" ✗）：应用据此用出厂 1060×680 ✓
    DlSettings e0 = new DlSettings()
    assert_eq(e0.winW, 0)
    cfg.save(e0)
    assert_eq(cfg.load().winW, 0)
    assert_eq(cfg.load().winH, 0)

    // 出厂默认：音量 80 / 列表循环 / 其余空（与 player.leno 的 Player 默认值对得上 ✓）
    DlSettings ed = cfg.load()                    // e0 刚落盘 ⇒ 文件里没这几项的值
    assert_eq(ed.volume, cfg.VOLUME_DEF)
    assert_eq(ed.loop, cfg.LOOP_DEF)
    assert_eq(ed.outdir, "")
    assert_eq(ed.fmt, "")
    assert_eq(ed.bangSrc, "")
    assert_eq(ed.bangId, "")
    assert_eq(ed.bangOnly, false)

    // ---- 试听缓存目录（★ 2026-10-22）----
    DlSettings cc = new DlSettings()
    cc.cachedir = "D:/LenoMusicCache"
    assert_eq(cfg.save(cc), true)
    assert_eq(cfg.load().cachedir, "D:/LenoMusicCache")
    // "" = 跟随输出目录/试听缓存（默认）✓
    DlSettings cd0 = new DlSettings()
    cd0.cachedir = ""
    assert_eq(cfg.save(cd0), true)
    assert_eq(cfg.load().cachedir, "")

    // 还原用户原来的设置（字段级 ✓；因为不补写 sources 键，默认行为也不会被改掉 ✓）
    cfg.save(keep)
    DlSettings fin = cfg.load()
    assert_eq(fin.workers, keep.workers)
    assert_eq(fin.lyric, keep.lyric)
    assert_eq(fin.limit, keep.limit)
    assert_eq(fin.sourcesSet, keep.sourcesSet)

    print("test_settings passed")
}
