// ⚠ import 必须放在**文件最前面**（在用到模块之前 ✗ —— 本文件先前把它们放在分隔注释之后，
//   后来新增的"歌词解析"用到 `strings` 就报"模块未导入"了 ✓ 2026-10-08 挪到顶上 ✓）
import dirs
import files
import strings
import "Music" as audio
import "./parsing.leno" as parsing
use audio.Sound

// ==================== 显示用：从文件名拆"歌名 / 歌手"（纯逻辑 ✓ 能离线单测）====================
// 依据：下载落盘的名字是 `sanitizefilename(job[1] + " - " + job[2])`
//       —— `job[1]` = **歌名**(F_NAME=1)、`job[2]` = **歌手**(F_ARTIST=2)（见 dl_engine:377 + 字段表 ✓）
//   ⇒ 即 **"歌名 - 歌手"**（与下载目录里的实物一致 ✓，如 `后来 - 刘若英.flac` ✓）
//   ⚠⚠ 2026-10-07 修：先前按"歌手 - 歌名"拆，于是播放条**大小两行正好接反** ✗
//      （大行显示歌手、小行显示歌名 ✗ —— 随手拿一个真实文件就能看出来 ✓）
//   ⚠ 按**最后**一处 `" - "` 切：歌名自己带 `" - "` 也不怕（`A - B - 歌手` ⇒ 歌名 `A - B` ✓）
//   ⚠ 拆不出（用户自己丢进来的歌 / 名字里没有分隔符）⇒ 歌手 ""、整条当歌名 ✓ —— 不硬猜 ✗

// ==================== 歌词折行（纯逻辑 ✓ 能离线单测）====================
// 为什么要有：一句 30+ 字的歌词，在"当前句"17pt 下会**超出浮层宽度顶到边上** ✗（先前实测 ✓）
//   ⚠ 判宽**不量字体**（那样就得有 Font、离线测不了 ✗）—— 改用**可视单元**：
//     中文/日文/韩文/全角标点 = 2 单元，其余 = 1 单元 ✓（CJK 大致就是半角两倍宽 ✓ 够准 ✓）
//     调用方按字号换算上限：1 单元 ≈ 字号 ÷ 2（`max_units = 可用宽 ÷ (字号/2)` ✓）

// 这个码点占"两个半角单元"吗（常用 CJK 范围；够了 ✓ 冷僻区不追求 ✓）
// ⚠ 用十进制写（十六进制字面量在这个语言里没把握 ✗ 别赌 ✓），注释里标 16 进制便于核对 ✓
export func is_wide_cp(int cp): bool {
    if cp < 0 { return false }
    if cp >= 4352 and cp <= 4447 { return true }          // 0x1100-0x115F 谚文字母
    if cp >= 11904 and cp <= 42191 { return true }        // 0x2E80-0xA4CF 部首/汉字/假名/注音…
    if cp >= 44032 and cp <= 55203 { return true }        // 0xAC00-0xD7A3 谚文音节
    if cp >= 63744 and cp <= 64255 { return true }        // 0xF900-0xFAFF 兼容汉字
    if cp >= 65072 and cp <= 65135 { return true }        // 0xFE30-0xFE6F 全角标点
    if cp >= 65280 and cp <= 65376 { return true }        // 0xFF00-0xFF60 全角形式
    if cp >= 65504 and cp <= 65510 { return true }        // 0xFFE0-0xFFE6 全角符号
    if cp >= 131072 { return true }                       // ≥0x20000 扩展汉字
    return false
}

// 一句歌词按单元折成 1..N 段（空串 ⇒ 空表 ✓；`maxUnits` 太小按 4 兜底 ✓ 免得死循环 ✗）
export func wrap_units(string text, int maxUnits): Array[string] {
    Array[string] parts = []
    if text == null { return parts }
    int total = text.len()
    if total == 0 { return parts }
    if maxUnits < 4 { maxUnits = 4 }
    string cur = ""
    int w = 0
    int i = 0
    while i < total {
        int cw = 1
        if is_wide_cp(strings.codepoint_at(text, i)) { cw = 2 }
        if w + cw > maxUnits and cur != "" {         // 放不下就断（**断在字与字之间** ✓ 不切半个字）
            parts.add(cur)
            cur = ""
            w = 0
        }
        cur = cur + text.take(i, 1)
        w = w + cw
        i = i + 1
    }
    if cur != "" { parts.add(cur) }
    return parts
}

// ==================== 歌词"空档"判定（纯逻辑 ✓ 能离线测）====================
// 为什么要有：长**前奏** / 长**间奏**时，画面上"什么都没在动" ✗ ⇒ 容易以为卡住了 ✓
//   ⇒ 到那种时候给一句话（"前奏中…" / "间奏中…"）✓
//   ⚠ 阈值**不能太敏感** ✗：普通句间隔（2~4 秒）不该冒提示 ✓（那会一直闪 ✓ 反而烦）
// 返回：0 = 不提示；1 = 还没到第一句（前奏）；2 = 这句唱过一阵、下一句还很远（间奏）
export func lyric_stage(float pos, float cur_t, float next_t, bool has_cur, bool has_next): int {
    if not has_cur {
        if cur_t - pos > 1.5 { return 1 }        // 第一句还早 ⇒ 前奏 ✓（第一句在 0:00 时**不**提示 ✓）
        return 0
    }
    if not has_next { return 0 }                 // 最后一句：不猜"什么时候结束" ✗
    if next_t - pos > 6.0 and pos - cur_t > 2.5 { return 2 }
    return 0
}

// 去掉扩展名（找**最后**一个点 ✓）："a.b.mp3" ⇒ "a.b"；没有点 ⇒ 原样 ✓
export func strip_ext(string name): string {
    if name == null { return "" }
    int dot = -1
    int q = name.find(".")
    while q >= 0 {
        dot = q
        q = name.find(".", q + 1)
    }
    if dot <= 0 { return name }
    return name.slice(0, dot - 1)
}

// 最后一处 `" - "` 的下标（没有 ⇒ -1 ✓）
func last_sep(string n): int {
    int sep = -1
    int q = n.find(" - ")
    while q >= 0 {
        sep = q
        q = n.find(" - ", q + 1)
    }
    return sep
}

// 歌手 = **最后**一个 " - " **之后**那段（拆不出 ⇒ "" ✓）
export func split_artist(string filename): string {
    if filename == null { return "" }
    string n = strip_ext(filename)
    int q = last_sep(n)
    if q <= 0 { return "" }
    int rest = n.len() - q - 3
    if rest <= 0 { return "" }
    return n.take(q + 3, rest)
}

// 歌名 = **最后**一个 " - " **之前**那段（拆不出 ⇒ 整条 ✓）
export func split_title(string filename): string {
    if filename == null { return "" }
    string n = strip_ext(filename)
    int q = last_sep(n)
    if q <= 0 { return n }
    return n.slice(0, q - 1)
}

// ==================== 歌词（.lrc）解析（纯逻辑 ✓ 能离线单测）====================
// 形如：[00:12.34]歌词文本 —— 一行可能挂**多个**时间标签（`[00:12][01:20]同一句` ⇒ 拆成两条 ✓）
//   ⚠ 元信息行 `[ti:歌名] [ar:歌手] [by:xxx]`：标签里没有 `mm:ss` 那个形状 ⇒ 整行跳过 ✓
//   ⚠ 时间认三种写法：`[mm:ss.xx]`（百分秒 ✓ 最常见）、`[mm:ss]`、`[mm:ss.xxx]` ✓
//   ⚠ 一切按**码点**走：歌词是中文 ⇒ 按字节切会切坏 ✗（`strings.to_codepoints` ✓）
export struct Lrc {
    Array[float] secs
    Array[string] texts
    // ★ 逐字时间（2026-10-08）：`wt_line[k]` = 第 k 个逐字时刻属于**哪一句**、
    //   `wt_sec[k]` = 那个字的**起始秒**（绝对，按歌里的秒数 ✓）
    //   为什么要扁平两个数组：嵌套数组（`Array[Array[float]]`）当**字段**用时类型推不出来 ✗（本仓踩过 ✓）
    //   ⚠ 没有逐字数据（普通 .lrc）的句子 ⇒ 在 `wt_line` 里**一段都没有**
    //      ⇒ 渲染侧自动退回"按字数线性" ✓✓（这就是"有就用、没有就退回" ✓）
    Array[int] wt_line
    Array[float] wt_sec
    //   和 `wt_sec` 一一对应：这个字的**结束秒** ✓（= 起点 + 时长 ✓）
    //   ⚠ 为什么必须要它：光有起点的话，"字与字之间的停顿"会被当成"这个字还在唱" ✗
    //     （那就又变回近似了 ✓）；有了结束 ⇒ 停顿期间**一格都不刷** ✓✓（真同步的关键 ✓）
    //   时长缺失/为 0（少见）⇒ 记 -1 ⇒ 退回"唱到下一个字的起点" ✓
    Array[float] wt_end
}

// 码点数组的一段 ⇒ 字符串（按码点拼 ✓）
func cp_slice(Array[int] cps, int from, int count): string {
    string out = ""
    int i = from
    int last = from + count
    while i < last {
        if i >= 0 and i < cps.len() { out = out + strings.from_codepoint(cps[i]) }
        i = i + 1
    }
    return out
}

// 时间标签 / 逐字标签的解析都在 `parsing.leno`（parse_secs / parse_word_span ✓
//   2026-10-09：原先是本文件里两段手搓码点游标（lrc_tag_secs / lrc_word_span，
//   各 30~40 行逐字节判 ASCII 数字）⇒ 同一套"严格解析"散在多处、还各用 -1 当失败哨兵✗
//   现在统一走 parsing：**多返回值 (值, 是否成功)**，调用处一行拿到"取值 + 判定" ✓
//   ⚠ 口径必须与原实现逐位一致（重构不改行为 ✓ 金标见 test/test_lrc_parse.leno）

// 第 i 句有几条逐字时间（0 = 这句会退回线性 ✓；界面/自检都能读 ✓）
export func word_count_at(Lrc l, int i): int {
    int c = 0
    int k = 0
    while k < l.wt_line.len() {
        if l.wt_line[k] == i { c = c + 1 }
        k = k + 1
    }
    return c
}

// 一行 ⇒ 往 out 里加 0..N 条（元信息/空行 ⇒ 0 条 ✓）
//   ★ 2026-10-08：同时认**逐字标签** `<起点,时长>`（酷我 `lrcx=1` 那种 ✓）：
//     标签剥掉（文本照常显示 ✓）、每个字的起点收进 `wt_*` ✓ ⇒ 卡拉OK式真同步 ✓
//   ⚠ `<0,0>` 打头的行 = **译文行**（上游要"并"到上一句 ✓）⇒ 不加新行、把文字接到上一句尾 ✓
//   ⚠ 时间戳是毫秒且偶尔会写成"相对本句"的 ⇒ 明显小于本句起点时按相对处理（加回本句起点 ✓）
func lrc_add_line(string line, Lrc out) {
    if line.trim() == "" { return }
    Array[int] cps = strings.to_codepoints(line)
    Array[float] ts = []
    int i = 0
    // 先把行首连续的 [..] 标签都吃掉（一行挂多个时间戳的情形 ✓）
    while i < cps.len() and cps[i] == 91 {               // '['
        int j = i + 1
        while j < cps.len() and cps[j] != 93 { j = j + 1 }   // ']'
        if j >= cps.len() { return }                     // 不闭合 ⇒ 这行不要 ✓
        // 时间标签 ⇒ (秒, 是否认得)——"认不出"就是元信息行 ⇒ 整行跳过 ✓
        //   ⚠ 解构出ok 比原来的"t < 0.0"更直白：失败时给的是 0.0，不是靠哨兵值区分 ✓
        var[float, bool](t, tok) = parsing.parse_secs(cp_slice(cps, i + 1, j - i - 1))
        if not tok { return }
        ts.add(t)
        i = j + 1
    }
    if ts.len() == 0 { return }                          // 没有任何时间标签 ⇒ 跳过（纯文本行 ✓）
    // ---- 剥逐字标签 + 收每个字的起点 ----
    string text = ""
    Array[float] wsec = []
    Array[float] wend = []
    float lastW = -1.0
    float lastWEnd = -1.0
    bool zeroLead = false
    int seen = 0
    while i < cps.len() {
        if cps[i] == 60 {                                // '<'
            int j = i + 1
            while j < cps.len() and cps[j] != 62 { j = j + 1 }   // '>'
            if j >= cps.len() {
                text = text + "<"                        // 不闭合 ⇒ 当普通字符 ✓（别吞内容 ✗）
                i = i + 1
            } else {
                string tag = cp_slice(cps, i + 1, j - i - 1).trim()
                if seen == 0 and tag.split(",").len() > 0 and tag.split(",")[0].trim() == "0" {
                    zeroLead = true
                }
                // 逐字标签 ⇒ (起点秒, 时长秒, 起点是否认得) ✓ 三返回值
                var[float, float, bool](w, wd, wok) = parsing.parse_word_span(tag)
                if wok {
                    lastW = w
                    lastWEnd = w + wd                    // 时长缺失(0) ⇒ end == start ⇒ 渲染侧退回"唱到下一个字" ✓
                }
                seen = seen + 1
                i = j + 1
            }
        } else {
            text = text + strings.from_codepoint(cps[i])
            if lastW >= 0.0 {
                wsec.add(lastW)                          // 这个字的起点 ✓（标签之后的字才有 ✓）
                wend.add(lastWEnd)
            }
            i = i + 1
        }
    }
    text = text.trim()
    if text == "" { return }                             // 剥完没字 ⇒ 不要 ✓
    // ---- 译文行：接到上一句尾（不加新行 ✓ 就是上游那个"并" ✓）----
    if zeroLead and out.secs.len() > 0 {
        int lastIdx = out.secs.len() - 1
        out.texts[lastIdx] = out.texts[lastIdx] + " " + text
        return
    }
    // ⚠ "相对/绝对"的判断**挪到解析完之后**（那时才知道每句的时长 ✓ 见 lrc_fix_words）
    //   这里只存**原始值** ✓ 不动它 ✗
    for ts to t2 {
        out.secs.add(t2)
        out.texts.add(text)
        int li = out.secs.len() - 1
        int k = 0
        while k < wsec.len() {                           // 同一句挂多个时间戳 ⇒ 逐字段也复制一份 ✓
            out.wt_line.add(li)
            out.wt_sec.add(wsec[k])
            out.wt_end.add(wend[k])
            k = k + 1
        }
    }
}

// 升序排（同时间的保持原顺序 ✓ 稳定 ✓）
//   ★ 重写（2026-10-08）：逐字段是按**句号**索引的 ⇒ 排序时句号会变 ⇒ 必须**同步重映射** ✗
//     做法：先排"下标"，再按新顺序把 secs / texts / wt_* 全部重建 ✓（比在插入排序里搬三段简单且不易错 ✓）
func lrc_sort(Lrc out) {
    int n = out.secs.len()
    if n <= 1 { return }
    Array[int] ord = []
    int i = 0
    while i < n { ord.add(i); i = i + 1 }
    i = 1
    while i < n {                                        // 插入排序（稳定 ✓）
        int cur = ord[i]
        float t = out.secs[cur]
        int j = i - 1
        while j >= 0 and out.secs[ord[j]] > t {
            ord[j + 1] = ord[j]
            j = j - 1
        }
        ord[j + 1] = cur
        i = i + 1
    }
    Array[float] ns = []
    Array[string] nt = []
    i = 0
    while i < n {
        ns.add(out.secs[ord[i]])
        nt.add(out.texts[ord[i]])
        i = i + 1
    }
    out.secs = ns
    out.texts = nt
    // 逐字段：old 句号 ⇒ new 句号 的重映射表，按新顺序重建 ✓
    Array[int] remap = []
    i = 0
    while i < n { remap.add(-1); i = i + 1 }
    i = 0
    while i < n { remap[ord[i]] = i; i = i + 1 }
    Array[int] nwl = []
    Array[float] nws = []
    Array[float] nwe = []
    i = 0
    while i < n {                                        // 按新句号顺序扫（保证组内次序不乱 ✓）
        int k = 0
        while k < out.wt_line.len() {
            // ★★ 必须走 `remap`（老句号→新句号）✗✗ 2026-10-08 实测踩过：
            //     `wt_line` 里存的还是**老句号**，直接拿它比新号 ⇒ 整组被分到错的行上
            //     ⇒ 该行的时间变成别的行的几十秒 ⇒ 逐字刷色**一格都不动** ✓（用户截图就是这个 ✓）
            if remap[out.wt_line[k]] == i {
                nwl.add(i)
                nws.add(out.wt_sec[k])
                nwe.add(out.wt_end[k])
            }
            k = k + 1
        }
        i = i + 1
    }
    out.wt_line = nwl
    out.wt_sec = nws
    out.wt_end = nwe
}

// 逐字时间的**校验与换算**（实测数据很脏 ✗ ⇒ 逐句单独判，不可信就整句丢掉 ⇒ 渲染退回线性 ✓✓）
//   为什么不能"整份文件一个判据"：同一份里**混着两种基准**，还有回跳 ✓（实测见提交说明 ✓）
//   两条路，任一成立就采用：
//     ① 行内相对：非递减（回跳按"前缀最大"修 ✓）且 末值 ≤ 行时长×1.3 + 0.8 秒
//     ② 歌内绝对：首值 ≥ 行起点 − 1 秒，且 末值 ≤ 行起点 + 行时长×1.3 + 0.8 秒
//   都不成立 ⇒ **整句丢掉**（该句在 wt_* 里一段都没有 ⇒ 界面自动退回"按字数线性" ✓）
func lrc_fix_words(Lrc out) {
    int n = out.secs.len()
    if n <= 0 or out.wt_line.len() == 0 { return }
    Array[int] nl = []
    Array[float] ns = []
    Array[float] ne = []
    int i = 0
    while i < n {
        Array[float] raw = []
        Array[float] rawe = []
        int k = 0
        while k < out.wt_line.len() {
            if out.wt_line[k] == i {
                raw.add(out.wt_sec[k])
                rawe.add(out.wt_end[k])
            }
            k = k + 1
        }
        if raw.len() > 0 {
            float lt = out.secs[i]
            // ⚠ 句长要拿"**下一个带逐字标签的行**"算 ✗ 不能拿"下一行" ——
            //   文件里夹着 `词：侯波`/`曲：玄昌俊` 这种短行 ✓ 拿它当句长会把正常长句误杀 ✓（第一版误杀 50 句 ✓）
            //   真实的"下一句"一定也带逐字标签 ✓ ⇒ 按它算才准 ✓
            float nt = lt + 30.0
            int jj = i + 1
            while jj < n {
                int kk2 = 0
                bool hasw = false
                while kk2 < out.wt_line.len() {
                    if out.wt_line[kk2] == jj { hasw = true }
                    kk2 = kk2 + 1
                }
                if hasw {
                    nt = out.secs[jj]
                    jj = n
                } else {
                    jj = jj + 1
                }
            }
            float dur = nt - lt
            if dur < 0.3 { dur = 0.3 }
            float mx = -1.0                                   // ① 前缀最大：把回跳抹平 ✓
            int j = 0
            while j < raw.len() {
                if raw[j] < mx { raw[j] = mx } else { mx = raw[j] }
                j = j + 1
            }
            float first = raw[0]
            float last = raw[raw.len() - 1]
            // ⚠ 判据的**重点在"首值"**（2026-10-08 实测调出来）：
            //   · 好数据：首值就落在句子开头那一带（相对值 ~0.5 秒 / 绝对值 ~行起点 ✓）
            //   · 脏数据：首值**跑到句子外面**去了（实测 [00:00.510] 那行的首值是 2.88 秒 ✗
            //     ⇒ 用户看到的就是"第一句都唱完了，逐字还停在第一个字" ✓）
            //   ⚠ 别拿"下一行时间"当句长去卡**末值** ✗：文件里夹着 `词：侯波` 这种短行 ✓
            //     会把正常的长句误杀 ✓（第一版就这么误杀了 51 句 ✓）
            float limFirst = dur * 1.3 + 0.8
            if limFirst < 2.0 { limFirst = 2.0 }
            // ★ 还要看**总跨度**跟句长是不是一个量级（2026-10-08 实测的关键一条）：
            //   脏数据会把 9 个字铺出 17 秒 ✗，而那一句只有 8 秒 ⇒ 走完一句才刷 1 个字
            //   ⇒ 看上去就是"卡在第一个字" ✗（用户截图 ✓）
            //   正常的逐字数据跨度 ≈ 句长 ✓ ⇒ 差太多就判脏、退回线性 ✓✓
            float limSpan = dur * 1.6 + 1.0
            if limSpan < 1.5 { limSpan = 1.5 }
            float span = last - first
            bool rel = (first <= limFirst and span <= limSpan)
            bool ab = (first >= lt - 1.0 and first <= lt + limFirst and span <= limSpan)
            // ⚠ 先判**绝对** ✗：绝对基准的数值（≈行起点）往往也满足"相对"的形式条件 ✓
            //   先判相对就会被当成"行内相对"再加一次行起点 ⇒ 时间翻倍 ✗（用例抓到过 ✓）
            if ab {
                int m = 0
                while m < raw.len() {
                    nl.add(i)
                    ns.add(raw[m])
                    ne.add(rawe[m])
                    m = m + 1
                }
            } eif rel {
                int m = 0
                while m < raw.len() {
                    nl.add(i)
                    ns.add(lt + raw[m])
                    ne.add(lt + rawe[m])
                    m = m + 1
                }
            }
            // 两条都不成立 ⇒ 该句整段丢掉（退回线性 ✓）
        }
        i = i + 1
    }
    out.wt_line = nl
    out.wt_sec = ns
    out.wt_end = ne
}

// 解析一整份 .lrc（换行 `\r\n` / `\n` / `\r` 都认 ✓）
export func lrc_from_text(string raw): Lrc {
    Lrc out = new Lrc()
    out.secs = []
    out.texts = []
    out.wt_line = []
    out.wt_sec = []
    out.wt_end = []
    if raw == null or raw == "" { return out }
    string s = raw.replace("\r\n", "\n")
    s = s.replace("\r", "\n")
    Array[string] lines = s.split("\n")
    for lines to ln { lrc_add_line(_str(ln), out) }
    lrc_sort(out)
    lrc_fix_words(out)          // ★ 逐字：逐句校验/换算，脏句丢掉 ⇒ 那段自动退回线性 ✓
    return out
}

// 逐字定位（**纯函数** ✓ 能离线测 ✓）：给定这句每个字的 (起点, 结束) 和当前时刻 ⇒
//   返回"已经唱到第几个字"（浮点 ✓ 亚字素 ✓）
//   · 字在**自己的 (起点,结束) 区间**里平滑推进 ✓
//   · ★ **字与字之间的空档不推进** ✓✓ —— 停顿期间一格格都不动 ✓（这就是"和唱歌同步"的关键 ✓）
//   · 结束缺失（-1）⇒ 退回"推进到下一个字的起点"（老近似 ✓，比不动好 ✓）
export func word_sung(Array[float] ws, Array[float] we, float p, int cnt): float {
    int n = ws.len()
    if n <= 0 { return 0.0 }
    float res = 0.0
    int m = 0
    while m < n {
        if ws[m] <= p {
            float e = -1.0
            if m < we.len() { e = we[m] }
            float nx = -1.0
            if m + 1 < n { nx = ws[m + 1] }
            // ⚠ 结束时间要**落在本字与下一字之间**才可信 ✗✗（2026-10-08 实测：酷我那个标签的
            //   第二个字段根本不是时长 —— 是 `首值 − 2×本行首值` 的怪癖 ✓ 会给出乱七八糟的值 ✓）
            if e <= ws[m] + 0.001 { e = nx }
            if e > ws[m] + 0.001 and nx > ws[m] and e > nx { e = nx }
            if e <= ws[m] + 0.001 {
                res = _float(m + 1)                          // 连下一个字也没有 ⇒ 一过起点就算唱完 ✓
            } else if p >= e {
                res = _float(m + 1)                          // 这个字唱完了 ⇒ 整字计入 ✓
            } else {
                float pr = (p - ws[m]) / (e - ws[m])
                if pr > 1.0 { pr = 1.0 }
                res = _float(m) + pr                         // 字内部平滑（亚字素 ✓）
            }
        }
        m = m + 1
    }
    if res > _float(cnt) { res = _float(cnt) }
    return res
}

// 当前唱到第几行：最后一个 `secs[i] <= sec` 的下标 ✓（一条都没到 ⇒ -1 ✓）
export func lrc_index_at(Array[float] secs, float sec): int {
    int hit = -1
    int i = 0
    while i < secs.len() {
        if secs[i] <= sec { hit = i } else { return hit }
        i = i + 1
    }
    return hit
}

// player.leno — 音乐下载器：**播放器状态机**（纯逻辑为主 ⇒ 能离线单测 ✓）
//
// 分工（照本应用既有分层：dl_engine / dl_window / musicdl_gui ✓）：
//   本文件           —— 列表 / 索引 / 播放暂停 / 循环 / 音量 / "放完自动下一首"的**规则**（可测 ✓）
//   player_bar.leno  —— 画界面（**嵌在主界面表格下方的播放条**，不另开窗口 ✓）
//   musicdl_gui.leno —— 接线：给它目录、把播放条加进根布局、每 120ms 调一次 tick() ✓
//
// ⚠ 为什么把"规则"与"发声"分开（这是本文件唯一的设计要点）：
//   离线单测里建 Sound 可能失败（无声卡 / 文件是假的 ✓），但"放完之后下一首该是谁"这种
//   规则**必须能测** ⇒ 拆成 `next_index_on_end()`（纯 ✓）+ `tick()`（带声音 ✓）✓
//
// ★ 底层用 LenoMusic（miniaudio：mp3/flac/wav/ogg 都能解 ✓）。已实测的三条（2026-10-07 ✓）：
//   · 下载是**顺序追加写最终文件** ⇒ 部分文件**前缀自洽** ⇒ 截断 mp3 也能 load/播/给位置 ✓
//   · `stop()` **保留播放位置** ⇒ 暂停 = stop、恢复 = play（模块里已包成 pause/resume ✓）
//   · `getDuration()` = 文件头声明的**总时长** ✗ 与"当前可播长度"不一定一致
//     ⇒ 对"还在下的那首"，进度条分母要按**已下比例**折算（二期"边下边播"再落地 ✓）
export const LOOP_OFF = 0        // 放完列表就停
export const LOOP_ALL = 1        // 放完回到第一首
export const LOOP_ONE = 2        // 单曲循环

export struct Player {
    Array[string] list               // 播放列表（**文件全路径**，已按文件名排序 ✓）—— 宿主没喂队列时的老口径
    // ===== ★ 播放队列（2026-10-09，移植自二创 LenoMusic-main ✓）=====
    //   来源改成"**当前界面显示的那张表**"（搜索页 / 榜单页都行）：三个数组**同长同序**，宿主一次喂进来 ✓
    //     `qName`  显示名（"歌名 - 歌手"，与表格 / 右键菜单同一口径 ✓ **未消毒**）
    //     `qLocal` 本地完整路径（"" = 还没下载 ⇒ 走**边下边播** ✓）
    //     `qTag`   消毒基名（认领下载落盘与同名 .lrc 用 ✓ 见 dl_engine.base_of）
    //   ⚠ 为什么非要有队列：老口径是"扫下载目录"⇒ **没下过的曲子根本不在列表里** ✗
    //     而"边下边播"恰恰要能对"还没下载的行"起播 ✓
    //   ⚠ 队列为空 ⇒ 下面所有取名字/取路径的方法**退回 `list`**（老路照常能用 ✓ 离线单测也还压得住）
    Array[string] qName
    Array[string] qLocal
    Array[string] qTag
    string outDir = ""               // 输出目录（按 qTag 拼同名 .lrc 的路径 ✓ 见 lrc_path）
    int index = -1                   // 当前下标（-1 = 没选）
    bool playing = false             // 用户意图：在播（暂停 ⇒ false ✓）
    float volume = 0.8
    bool muted = false
    int loopMode = 1                 // LOOP_ALL（列表循环；字段默认值只能是字面量 ✗ ⇒ 不写常量名 ✓）
                                     //   0=LOOP_OFF / 1=LOOP_ALL / 2=LOOP_ONE（见上面三个 export const ✓）
    Sound? sound = null
    string err = ""                  // 最近一次失败原因（无声卡 / 文件坏 ⇒ 界面要能说清 ✓）
    int endedCount = 0               // 自检计数：一共自动推进过几次 ✓

    // ★ 2026-10-09：`previewing / previewName / previewPath`（"试听：拉前一段"那套）**已退役** ——
    //   双击/右键现在是"播放整表 + 边下边播"（见 play_index / set_queue ✓），不再有"插播试听"这种态 ✓

    // ===== ★ 边下边播状态（2026-10-09，移植自二创 LenoMusic-main ✓）=====
    //   思路：宿主把整首**顺序追加写**到目标文件（我们 dl_engine 本来就是这个口径 ✓），
    //     播放器直接播这个"边下边长大的文件"：
    //       · 播到**已下边界**（`isAtEnd()` 但整首还没下完）⇒ 先停下，约每 1 秒探一次；缓冲长了一格
    //         就重建 Sound（从而读到新追加的数据 ✓）+ 跳回原处续播 ⇒ 界面上"无感" ✓
    //       · 用户拖到**未下载区** ⇒ 同样先停下等缓冲，够到目标秒再跳过去续播 ✓
    //   ⚠ 为什么必须"重建"而不是让老 Sound 接着读：Sound 是 createSound 那一刻按文件内容建的，
    //     后来追加的数据它**看不见** ✗ ⇒ 只能重开一个（miniaudio 读的是当前文件 ✓）
    //   ⚠ 前提（我们已满足 ✓）：下载是**顺序追加写最终文件** ⇒ 部分文件**前缀自洽**、能 load/能播 ✓
    bool streaming = false           // 当前这首在边下边播（还没下完 ✓）
    string streamPath = ""           // 正在播的那个"持续增长的文件"全路径
    int streamGot = 0                // 已下字节（宿主 progress 消息回灌 ✓）
    int streamTotal = 0              // 目标总字节（<=0 = 未知 ✓）
    bool streamDone = false          // 整首下完了吗
    float streamDur = 0.0            // 声明总时长（秒 ⇒ 进度条分母：停声期间也得留着 ✓）
    bool wantStream = false          // ★ 求宿主"开始下当前这首"（宿主 take_stream_request 取走 ✓）
    int wantIndex = -1               // 要下的是队列第几首
    bool waiting = false             // 缓冲不足，正停下等（界面无感 ✓）
    float waitPos = 0.0              // 等够之后要跳到的秒数
    bool waitForSeek = false         // true = 用户拖到未下区；false = 播到了已下边界 ✓
    int waitTicks = 0                // 重试计时（120ms 一拍 ⇒ 8 拍 ≈ 1 秒 ✓）
    int lastGot = 0                  // 上次探测时的已下字节（用来判"有没有长" ✓）
    int openTicks = 0                // 自愈节流：无声时约 1 秒重开一次（见 tick ✓）
    // ★★ 2026-10-10 修（用户实测："边下边播时，播一会儿**自己跳到下一首**"）：
    //   Sound 是**建的那一刻**按文件内容建的 ⇒ 后来追加/改名的数据它看不见 ✗（见文件头 ⚠）
    //   于是"整首已经下完了、但手里这个 Sound 还是**半截文件**建的"时，播到**旧末尾**就会
    //   `isAtEnd() == true`，而此时 `streamDone` 已是 true ⇒ tick 误当成"整首放完" ⇒ **切下一首** ✗✗
    //   ⇒ 记下"建这个 Sound 时文件下到了多少字节"，用它区分"真放完"与"只播到旧末尾" ✓
    int streamBuiltBytes = 0         // 建当前 Sound 时的 streamGot 快照（见上面那段 ⚠ ✓）
    float shadowPos = 0.0            // 影子位置：声一没（等缓冲 / 重建中）也能显示"听到哪儿了" ✓
    // ★★ 2026-10-10 修（用户实测："先播了本地、再点网络播放 ⇒ **进度条不动**"）：
    //   `sound` 这个字段**不代表"这一首的声"** —— 换歌时我们**故意只 `stop()` 不销毁**
    //   （销毁会让 miniaudio 引擎引用归 0、下次播放要重开音频设备 ⇒ 见 swap_sound ✓）
    //   ⇒ 播过一首本地之后再切"边下边播"，`sound` 里躺着的还是**上一首那个已停的对象** ✗
    //   而 `try_open_stream()` 原先拿 `if sound != null { return }` 当"已经有声了" ⇒ 流的对象
    //   **永远建不起来**：`position()` / `duration()` 读的都是上一首 ⇒ 进度条钉死在原地 ✗✗
    //   ⇒ 用下面这个标志明确回答"**本次这条流**的声建起来了没"，凡是判"有没有声"的地方一律用它 ✓
    //     （`sound` 只当"有没有对象"，不再当"是不是这一首" ✓）
    bool streamOpened = false        // 本次边下边播的 Sound 建起来了吗（见上面那段 ⚠ ✓）

    // ---- 歌词（2026-10-08 ✓）：**懒加载** —— 换歌才重读一次，其它时候零开销 ✓ ----
    Lrc lrc
    float lrcShift = 0.0             // 歌词整体偏移（秒；正 = 歌词延后 ✓ 默认 0 ✓ 见 lyric_pos）
    string lrcFor = ""               // 已经读的是**哪个歌词文件**（路径 ✓ 变了才重读 ✗ 见 ensure_lrc）
    int lrcMtime = -1                // 上次读的那份的**修改时间**（文件被覆盖/晚到时靠它发现 ✓）
    int lrcSize = -1                 // 以及**大小**（mtime 秒级粒度、同秒覆盖会漏 ✗ 靠它兜住 ✓）
    string scanDir = ""              // 最近一次 `scan` 的目录（试听态"去输出目录找同名歌词"要用 ✓）
    bool lrcTried = false

    // ==================== 列表（纯逻辑 ✓ 离线可测）====================

    // 扫一个目录里的音频文件（按文件名升序 ✓）；返回扫到几个
    //   ⚠ `dirs.listdir` 给的是**名字**（不含路径 ✗）⇒ 自己 join ✓
    func scan(string dir): int {
        stop_all()                        // ★ 只停不销毁（同 set_queue：别把音频引擎也关了 ✗）
        // ★ 2026-10-09：`scan` 是"扫下载目录"这条**老口径**的入口 ⇒ 顺手把播放队列清掉，
        //   否则 has_queue() 仍为真 ⇒ 列表/取名字全走队列，而 list 被重扫了却没人用 ✗（界面会"看起来没刷新" ✓）
        //   即：喂过队列之后又想回到"播目录里的歌"，必须显式走这里 ✓（播放条的「重扫」就是这个意思 ✓）
        qName = []
        qLocal = []
        qTag = []
        scanDir = dir                     // ★ 记下这次的目录（2026-10-08）：试听态取歌词要用 ✓ 见 lrc_path
        list = []
        index = -1
        if not dirs.exists(dir) { return 0 }
        // ⚠ `dirs.listdir` 返回的**不是数组**（对它调 `.len()` 会报「类型 object 上不存在方法 'len'」✗）
        //   但**可以直接 for 迭代**拿到名字 ✓ ⇒ 这里只用迭代，不碰 `.len()` ✓
        var names = dirs.listdir(dir)
        Array[string] hits = []
        for names to n {
            string nm = _str(n)
            if is_audio(nm) { hits.add(dirs.join(dir, nm)) }
        }
        list = sort_by_name(hits)
        if list.len() > 0 { index = 0 }
        return list.len()
    }

    // 是不是音频：按扩展名（**大小写都认** ✓）
    //   ⚠ 写成显式大小写表：这里不去依赖 `strings.lower` 的可用性（少一个踩坑点 ✓）
    func is_audio(string name): bool {
        // ★ 未下完的半截文件带 `@` 前缀 ⇒ **不是**能播的成品（扫目录时不该列出来 ✓ 对齐二创 ✓）
        //   ⚠ 与 dl_engine 的 find_local / resolve_locals 同一口径：三处都排 `@` ✓
        if name.slice(0, 0) == "@" { return false }
        string e = dirs.extname(name)
        for ext_cases() to x {
            if e == x { return true }
        }
        return false
    }

    func ext_cases(): Array[string] {
        return [".mp3", ".MP3", ".flac", ".FLAC", ".wav", ".WAV", ".ogg", ".OGG", ".m4a", ".M4A"]
    }

    // 按**文件名**（不含目录 ✓）排序 —— 插入排序：列表通常几十条，够用且无依赖 ✓
    //   ⚠ 比较必须**大小写不敏感**：直接 `a < b` 是字节序 ⇒ "C.MP3" 会排在 "a.flac" 之前 ✗
    //     （实测踩过 ✓）⇒ 折 ASCII 小写再比，与资源管理器一致 ✓
    func sort_by_name(Array[string] paths): Array[string] {
        Array[string] out = []
        for paths to p {
            int at = 0
            string key = dirs.basename(_str(p))
            while at < out.len() and name_less(dirs.basename(out[at]), key) { at = at + 1 }
            out.insert(at, _str(p))
        }
        return out
    }

    // 文件名比较：ASCII 折小写后按码点比（非 ASCII 原样 ⇒ 与字节序一致 ✓）
    func name_less(string a, string b): bool {
        Array[int] ca = strings.to_codepoints(a)
        Array[int] cb = strings.to_codepoints(b)
        int n = ca.len()
        if cb.len() < n { n = cb.len() }
        int i = 0
        while i < n {
            int x = lower_cp(ca[i])
            int y = lower_cp(cb[i])
            if x != y { return x < y }
            i = i + 1
        }
        return ca.len() < cb.len()
    }

    func lower_cp(int c): int {
        if c >= 65 and c <= 90 { return c + 32 }      // 'A'..'Z' ⇒ 'a'..'z'
        return c
    }

    // ==================== 播放队列（宿主喂表 ✓ 纯逻辑可离线测）====================

    // 换一队（宿主在"双击 / 右键播放"时调一次 ✓）：三个数组**同长同序** ✓
    //   ⚠ 顺带 `close()`：换队 = 换一个播放上下文 ⇒ 正在播的要停掉、边下边播状态也要清 ✓
    func set_queue(Array[string] names, Array[string] localPaths, Array[string] tags, string outdir) {
        // ⚠ 用 `stop_all()`（停 + 清流式状态）而不是 `close()`：后者会销毁音频对象 ⇒ 引擎引用归 0
        //   ⇒ 紧接着的第一次播放要**重新打开音频设备**（几百毫秒的停顿 ✗ 见 swap_sound ✓）
        stop_all()
        qName = names
        qLocal = localPaths
        qTag = tags
        outDir = outdir
        index = -1
        err = ""
    }

    // 只刷新"本地已有路径"（下完一首 / 删了文件之后由宿主调 ✓ 队列顺序与其余字段都不动 ✓）
    func set_locals(Array[string] localPaths) {
        if localPaths.len() == qName.len() { qLocal = localPaths }
    }

    // 队列在不在用（空 ⇒ 退回"扫目录"的老口径 ✓）
    func has_queue(): bool { return qName.len() > 0 }

    // 队列第 i 首的本地路径（"" = 还没下载 ✓）
    func local_at(int i): string {
        if i < 0 or i >= qLocal.len() { return "" }
        return qLocal[i]
    }

    // 队列第 i 首的消毒基名（拼 .lrc 路径用 ✓）
    func tag_at(int i): string {
        if i < 0 or i >= qTag.len() { return "" }
        return qTag[i]
    }

    func count(): int {
        if has_queue() { return qName.len() }
        return list.len()
    }

    // 当前这首的**本地文件**（未下载 ⇒ "" ⇒ 界面知道"这首在边下边播" ✓）
    func current(): string {
        if has_queue() { return local_at(index) }
        if index < 0 or index >= list.len() { return "" }
        return list[index]
    }

    func current_name(): string {
        if has_queue() { return name_at(index) }     // 队列里存的就是显示名（不再折 basename ✓）
        string c = current()
        if c == "" { return "" }
        return dirs.basename(c)
    }

    // 按**下标**取曲名（播放条的歌单 / 状态栏要逐行显示 ✓；越界返回 "" ✓ 不崩）
    func name_at(int i): string {
        if has_queue() {
            if i < 0 or i >= qName.len() { return "" }
            return qName[i]
        }
        if i < 0 or i >= list.len() { return "" }
        return dirs.basename(list[i])
    }

    // 按路径找下标（找不到 -1 ✓）
    //   队列模式：比"本地路径"（未下载的行没有路径 ⇒ 永远匹配不上，正是我们要的 ✓）
    //   老模式：比 basename（下载落盘路径与列表项都是绝对路径 ⇒ basename 才是"同一首"的判据 ✓）
    func index_of(string path): int {
        if has_queue() {
            if path == "" { return -1 }
            int i = 0
            while i < qLocal.len() {
                if qLocal[i] == path { return i }
                i = i + 1
            }
            return -1
        }
        string b = dirs.basename(path)
        if b == "" { return -1 }
        int i = 0
        while i < list.len() {
            if dirs.basename(list[i]) == b { return i }
            i = i + 1
        }
        return -1
    }

    // ==================== 播放规则（纯逻辑 ✓ 离线可测）====================

    // "这首放完之后，下一首该是谁"：给下标；**-1 = 该停**（列表放完了 ✓）
    //   LOOP_ONE ⇒ 还是自己 ✓ / LOOP_ALL ⇒ 回到 0 ✓ / LOOP_OFF ⇒ 到底 -1 ✓
    func next_index_on_end(): int {
        int n = count()                        // ★ 队列在用时就是队列长度（见 count ✓）
        if n == 0 { return -1 }
        if loopMode == LOOP_ONE { return index }
        int nxt = index + 1
        if nxt < n { return nxt }
        if loopMode == LOOP_ALL { return 0 }
        return -1
    }

    // 手动"下一首 / 上一首"：同样受循环模式约束（LOOP_OFF 时到头就是 -1 ✓）
    func next_index(): int {
        int n = count()
        if n == 0 { return -1 }
        int nxt = index + 1
        if nxt >= n { nxt = if loopMode == LOOP_OFF then -1 else 0 }
        return nxt
    }

    func prev_index(): int {
        int n = count()
        if n == 0 { return -1 }
        int p = index - 1
        if p < 0 { p = if loopMode == LOOP_OFF then -1 else n - 1 }
        return p
    }

    // ==================== 传输控制（要音频设备 ⇒ 离线只测"安全失败" ✓）====================

    func play_index(int i): bool {
        // ★ 队列模式（2026-10-09，移植自二创 LenoMusic-main ✓）：播"当前界面那张表"的第 i 首
        if has_queue() {
            if i < 0 or i >= qName.len() { return false }
            sound?.stop()                      // ★ 只停**不销毁**：销毁会让引擎引用归 0 ⇒ 切歌也要重开设备 ✗
            reset_stream()                     //   （见 swap_sound 的注释 ✓）
            index = i
            err = ""
            string lp = local_at(i)
            if lp != "" and files.exists(lp) {
                return open_local(lp)          // ★ 已下载 ⇒ 直接播本地文件（不必再下 ✓）
            }
            // ★ 没下载 ⇒ 边下边播：求宿主把整首**顺序追加写**到目标文件（take_stream_request 取走 ✓）
            //   此刻还不知道总时长 ⇒ streamDur 先留 0，等 Sound 建起来按文件头补上 ✓（见 try_open_stream）
            streaming = true
            streamDone = false
            streamGot = 0
            streamTotal = 0
            streamDur = 0.0
            streamPath = ""
            wantStream = true
            wantIndex = i
            playing = true                     // 用户意图 = 在播（等首片落盘期间界面显示"正在加载…" ✓）
            return true
        }
        // 老口径：播"扫下载目录"扫出来的第 i 个文件 ✓
        if i < 0 or i >= list.len() { return false }
        sound?.stop()                          // ★ 同上：只停不销毁（引擎要一直活着 ✓）
        reset_stream()
        index = i
        return open_local(list[i])
    }

    // 直接开一个本地文件发声（已下载的曲子 / 老口径的列表项都走它 ✓）
    func open_local(string path): bool {
        var s = audio.createSound(path)
        if not s.isInit() {
            // ⚠ 这里**不销毁**旧对象（打开失败时把原来的留着更稳；引擎引用计数也别掉到 0 ✓）
            playing = false
            err = "打不开这首音频（文件坏了？或本机没有可用的音频设备）"
            return false
        }
        s.setVolume(effective_volume())
        s.setLooping(false)          // 单曲循环由本文件的规则管 ⇒ 不用引擎的 looping ✓
        s.play()
        swap_sound(s)                // ★ 先建好新的，再销毁旧的（见 swap_sound 的注释 ✓）
        playing = true
        err = ""
        openTicks = 0                            // 开起来了 ⇒ 自愈计时归零 ✓
        return true
    }

    // ★★ 换音频对象：**先把新的建好、再销毁旧的** —— 让 miniaudio 引擎的引用计数**永不掉到 0** ✓
    //   为什么这一条是"停顿一下"的根治（2026-10-09 实测反馈 ✓）：
    //     Music 模块的 `Sound.uninit()` 在**最后一个实例**销毁时会 `ma_dll_engine_uninit()` **关掉引擎**
    //     ⇒ 引擎一关，下次 `createSound` 就得**重新打开音频设备**（实测几百毫秒）⇒ 每次"停下等缓冲 → 重建"
    //     都会静音一下 ✗（切歌、边下边播续播都中招 ✓）
    //   现在：旧对象一直留到新对象建好之后才销毁 ⇒ 引用计数在切换过程中始终 ≥ 1 ⇒ 引擎常驻 ✓
    func swap_sound(Sound s) {
        Sound? old = sound
        sound = s
        if old != null { old?.uninit() }
    }

    // 播放 / 暂停 切换（暂停 = stop，位置保留 ✓；恢复 = play ✓）
    func toggle(): bool {
        if playing {
            sound?.pause()
            playing = false
            return true
        }
        // ★ 等缓冲中"恢复" ⇒ 只把意图置回在播（等待循环下一拍自动接管 ✓）
        if waiting {
            playing = true
            return true
        }
        // ⚠ 同理：边下边播里"字段里那个对象"不是这一首的 ⇒ 不能拿它 resume（会给上一首续播 ✗）
        if sound != null and (not streaming or streamOpened) {
            sound?.resume()
            playing = true
            return true
        }
        // 没声又没在等（例如"边下边播还没出第一片"）⇒ 重播当前下标 ✓
        if index < 0 and count() > 0 { return play_index(0) }
        return play_index(index)
    }

    func next(): bool {
        int i = next_index()
        if i < 0 { return false }
        return play_index(i)
    }

    func prev(): bool {
        int i = prev_index()
        if i < 0 { return false }
        return play_index(i)
    }

    func stop(): void {
        sound?.stop()
        playing = false
    }

    // 停止 + 清掉边下边播（界面按"停止"按钮时用 ✓ —— 单 stop() 会留着"还在等缓冲"的分支）
    func stop_all(): void {
        stop()
        reset_stream()
    }

    // 直接跳到第 s 秒（比例版见 seek_ratio ✓）
    //   ⚠ miniaudio 的 seek 之后音频是**停着**的 ⇒ 必须 resume（否则"拖完就静音" ✗ 实测 ✓）
    func seek_seconds(float s): bool {
        if s < 0.0 { s = 0.0 }
        // ★ 边下边播：拖到**未下载区** ⇒ 先停下等缓冲（约每 1 秒探一次 ✓）；拖到已下区 ⇒ 正常 seek ✓
        if streaming and not streamDone and s > avail_seconds() - 0.3 {
            begin_wait(s, true)
            return true
        }
        // ⚠ 声没建起来（流还在等首片）⇒ 拦下来：别去 seek 上一首那个对象 ✗（见字段处 ⚠）
        if sound == null or (streaming and not streamOpened) { return false }
        bool ok = sound.seek(s)
        if ok {
            sound?.resume()
            playing = true
        }
        return ok
    }

    // 拖进度：按比例 0..1（要时长 ⇒ 时长未知就返回 false ✓）
    //   ⚠ 调用前先问 `can_seek()`（试听那个截断文件不让拖 ✗ 见它的注释 ✓）
    func seek_ratio(float r): bool {
        float d = duration()
        if d <= 0.0 { return false }
        if r < 0.0 { r = 0.0 }
        if r > 1.0 { r = 1.0 }
        return seek_seconds(d * r)
    }

    // 能不能拖进度：**只有"完整文件"可以** ✓（2026-10-07）
    //   · 试听播的是"前一段"的**截断文件** ✗ —— `duration()` 是文件头声明的**总时长**，比实际
    //     可播的部分长 ⇒ 拖着拖就跳到并不存在的位置（要么静音、要么直接结束 ✗ 实测 ✓）
    //   · 列表里的歌 = 已经下完的完整文件 ✓ ⇒ 可拖
    func can_seek(): bool {
        // ★ 2026-10-09：边下边播**也可以拖**（拖到未下区会自动等缓冲 ✓ 见 seek_seconds）
        if streaming { return true }
        return sound != null and index >= 0
    }

    func set_volume(float v) {
        if v < 0.0 { v = 0.0 }
        if v > 1.0 { v = 1.0 }
        volume = v
        sound?.setVolume(effective_volume())
    }

    func set_muted(bool m) {
        muted = m
        sound?.setVolume(effective_volume())
    }

    func effective_volume(): float { return if muted then 0.0 else volume }

    // 总时长（秒）——★ 边下边播：优先用**文件头声明的总时长**（进度条分母 ⇒ 停声期间也得留着 ✓）
    func duration(): float {
        if streaming {
            if streamDur > 0.0 { return streamDur }
            // ★ 声还没建起来 ⇒ 返回 0（"还不知道"）——**绝不能**退回读 `sound`：那是**上一首**的时长
            //   ⇒ 用户看到的正是"时长还是上一首那个 243s、进度条一动不动" ✗（2026-10-10 修 ✓）
            if not streamOpened { return 0.0 }
            if sound == null { return 0.0 }
            return sound.getDuration()
        }
        if sound == null { return 0.0 }
        return sound.getDuration()
    }

    // 当前播放位置（秒）——等待缓冲时返回"要跳到的那个位置"（进度条不跳回 0 ✓）
    //   ★ 声一没（正重建 / 失败）也**不能归零** ✗ —— 用影子位置顶住（见 tick ✓）
    func position(): float {
        if waiting { return waitPos }
        // ★ 边下边播：声**没建起来**（等首片 / 建失败）⇒ 一律走影子位置 ——
        //   绝不能读 `sound`：那里面可能躺着**上一首**（只 stop 不销毁 ✓）⇒ 位置就钉死在上一首了 ✗
        if streaming and not streamOpened { return shadowPos }
        if sound == null {
            if streaming { return shadowPos }
            return 0.0
        }
        return sound.getPosition()
    }

    // 播放进度 0..1（时长未知 ⇒ 0 ✓）
    //   ★ 二期"边下边播"要改的就是这里：分母对"还在下的那首"按**已下比例**折算 ✓
    func ratio(): float {
        float d = duration()
        if d <= 0.0 { return 0.0 }
        float r = position() / d
        if r < 0.0 { r = 0.0 }
        if r > 1.0 { r = 1.0 }
        return r
    }

    // ==================== 歌词（懒加载 ✓ 与音频同名 + .lrc ✓ 见 dl_engine 的落盘命名）====================

    // 当前这首该配哪个 .lrc（没在播 ⇒ "" ✓）
    func lrc_path(): string {
        // ★ 队列模式（2026-10-09，移植自二创）：
        //   ① 已下载的 ⇒ 按**本地路径**同名（strip_ext + ".lrc" ✓）
        //   ② 还没下载的（边下边播中）⇒ 按"输出目录 + 消毒基名 + .lrc"拼 —— 歌词常与音频同时落盘
        //      ⇒ 先"没有歌词"、一出现就补读 ✓（靠 ensure_lrc 的 mtime/size 判定发现 ✓）
        if has_queue() {
            string lp = local_at(index)
            if lp != "" { return strip_ext(lp) + ".lrc" }
            string tg = tag_at(index)
            if outDir == "" or tg == "" { return "" }
            return dirs.join(outDir, tg + ".lrc")
        }
        string c = current()
        if c == "" { return "" }
        return strip_ext(c) + ".lrc"
    }

    // 换歌了就重读一次；读不到 ⇒ 空歌词（界面会说"没有歌词" ✓ 不报错 ✓）
    //   ⚠ 读文件可能抛（权限/占用）⇒ 必须接住：**歌词读失败绝不能把播放搞崩** ✗
    //   ⚠ 写法上的两个坑（都编译不过 ✓ 2026-10-08 踩过）：
    //     ① `: void` + **裸 `return`** ⇒ 编译器嫌"期望 null、实际 any" ✗ ⇒ 用 if 包住整段、不裸 return ✓
    //     ② 给 `lrc.secs`（**字段的字段**）赋 `[]` ⇒ 推断不出元素类型 ✗（本地 `Lrc` 却没事 ✓）
    //        ⇒ 统一用 `lrc_from_text("")` 造空表（同一条路径，也正好是单测覆盖的那条 ✓）
    //   ⚠ 缓存键换成**歌词文件路径**（不是"哪首"✓）：试听 → 本地文件的切换、以及"歌词比歌晚到"
    //     这两种情况，用"哪首"当键都判不出来 ✗
    func ensure_lrc() {
        string p = lrc_path()
        // ★★ 文件**变了**也要重读（2026-10-08 实测踩到）：只按"路径"判断是不够的 ✗
        //    场景：重新「下载歌词」会把同名文件**覆盖**成逐字版 ✓ 而路径没变
        //    ⇒ 不重读就一直用着旧的**纯 LRC**（没有逐字时间 ⇒ 卡拉OK一格格不动 ✓ 用户截图就是这个 ✓）
        //    顺带也覆盖了"歌词比歌晚到"（首次出现 ⇒ mtime 由 -1 变成真值 ⇒ 也是"变了" ✓）
        int mt = -1
        int sz = -1
        if p != "" {
            try {
                var st = dirs.stat(p)
                if st.exists {
                    mt = st.mtime
                    sz = st.size                      // ⚠ mtime 只有**秒级**粒度 ⇒ 同一秒内被覆盖会漏 ✗ 再叠一层大小 ✓
                }
            } catch e {
                mt = -1
                sz = -1
            }
        }
        bool need = (p != lrcFor) or (not lrcTried) or (mt != lrcMtime) or (sz != lrcSize)
        if need {
            lrcFor = p
            lrcTried = true
            lrcMtime = mt
            lrcSize = sz
            lrc = lrc_from_text("")
            if p != "" {
                try {
                    if files.exists(p) { lrc = lrc_from_text(files.read(p)) }
                } catch e {
                    lrc = lrc_from_text("")        // 读失败 = 没歌词（界面会说清 ✓）
                }
            }
        }
    }

    // 给界面直接喂 ListBox 的歌词行（没歌词 ⇒ 一句说明，别给空表 ✗）
    func lyric_lines(): Array[string] {
        ensure_lrc()
        if lrc.texts.len() == 0 {
            return ["（这首没有歌词 —— 下载时勾上「同时下载歌词」就能带上）"]
        }
        return lrc.texts
    }

    // 歌词用的"对齐时刻"（= 播放位置 − 偏移 ✓）
    //   ⚠ 歌词相关的**一律**走这里 ✗ 别再直接用 `position()` ✓（不然将来那个偏移只生效一半 ✓）
    func lyric_pos(): float {
        return position() - lrcShift
    }

    // 现在唱到第几行（-1 = 还没到第一句 ✓）
    func lyric_index(): int {
        ensure_lrc()
        return lrc_index_at(lrc.secs, lyric_pos())
    }

    // ★ 这一句"已经唱到第几个字"（**浮点** ✓ 亚字素 ✓）—— 就是"有逐字就用、没有就退回" ✓
    //   ① 有逐字时间（这句在 `wt_line` 里有一段 ✓）：按**每个字的实际起始秒**定位
    //      ⇒ 字与字之间的**停顿不刷** ✓（这才是"和唱歌同步"的手感 ✓）
    //   ② 没有（普通 .lrc ✓）⇒ 退回"句内进度 × 字数"的线性近似 ✓
    func lyric_sung(): float {
        if index < 0 { return 0.0 }
        int li = lyric_index()
        if li < 0 or li >= lrc.texts.len() { return 0.0 }
        int cnt = lrc.texts[li].len()
        if cnt <= 0 { return 0.0 }
        float p = lyric_pos()
        // ① 逐字：把属于这一句的那些 (起点,结束) 收出来（它们在 wt_* 里是**连续一段** ✓）
        Array[float] ws = []
        Array[float] we = []
        int k = 0
        while k < lrc.wt_line.len() {
            if lrc.wt_line[k] == li {
                ws.add(lrc.wt_sec[k])
                we.add(lrc.wt_end[k])
            }
            k = k + 1
        }
        if ws.len() > 0 { return word_sung(ws, we, p, cnt) }
        // ② 退回线性（近似，但至少在动 ✓）
        return lyric_progress() * _float(cnt)
    }

    // 这首歌词里有多少条"逐字时间"（0 = 纯 LRC ⇒ 会退回线性 ✓ 界面/自检都能读 ✓）
    func lyric_word_count(): int {
        ensure_lrc()
        return lrc.wt_line.len()
    }

    // 歌词总句数（界面按它裁可见范围 ✓）
    func lyric_count(): int {
        ensure_lrc()
        return lrc.secs.len()
    }

    // 第 i 句的文字 / 时间（越界 ⇒ "" / -1 ✓ 不崩）
    func lyric_text_at(int i): string {
        ensure_lrc()
        if i < 0 or i >= lrc.texts.len() { return "" }
        return lrc.texts[i]
    }

    func lyric_time(int i): float {
        ensure_lrc()
        if i < 0 or i >= lrc.secs.len() { return -1.0 }
        return lrc.secs[i]
    }

    // 当前句 → 下一句 之间的进度 0..1 —— **平滑上滚**就靠它 ✓（2026-10-08）
    //   语义：这一句已经"唱了多少"⇒ 画的时候把整块按这个比例往上推一点 ⇒ 看着是连续滚的 ✓
    //   没有下一句 / 时间戳相同 ⇒ 返回 0（不推 ✓ 免得瞬间跳一下 ✗）
    func lyric_progress(): float {
        ensure_lrc()
        float p = lyric_pos()
        int i = lrc_index_at(lrc.secs, p)
        if i < 0 { return 0.0 }
        float t0 = lrc.secs[i]
        float t1 = t0 + 4.0
        if i + 1 < lrc.secs.len() { t1 = lrc.secs[i + 1] }
        float span = t1 - t0
        if span <= 0.05 { return 0.0 }
        float r = (p - t0) / span
        if r < 0.0 { r = 0.0 }
        if r > 1.0 { r = 1.0 }
        return r
    }

    // ==================== 边下边播（★ 2026-10-09，移植自二创 LenoMusic-main ✓）====================
    // 思路：宿主把整首**顺序追加写**到目标文件；播放器直接播这个"边下边长大的文件" ✓
    //   · 播到已下边界（`isAtEnd` 但整首没完）⇒ begin_wait 停下、约每 1 秒探一次 ⇒ 缓冲长了一格就
    //     resume_at 重建 Sound（从而读到新追加的数据 ✓）+ 跳回原处续播（界面无感 ✓）
    //   · 用户拖到未下区 ⇒ 同样 begin_wait（waitForSeek = true ✓）
    //   ⚠ 为什么"重建"而不是让老 Sound 接着读：Sound 是 createSound 时按当时文件内容建的，
    //     后来追加的数据它看不见 ✗ ⇒ 必须重开一个（miniaudio 读的是当前文件 ✓）

    // 宿主每 120ms 取一次"要不要开始下当前这首"（要 ⇒ 返回下标；取走后自动清零 ✓；不要 ⇒ -1 ✓）
    func take_stream_request(): int {
        if not wantStream { return -1 }
        wantStream = false
        return wantIndex
    }

    // 宿主告诉播放器"这首开始写了，文件在 path"（首片落盘后调 ✓）
    func begin_stream(string path) {
        if not streaming { return }
        streamPath = path
        try_open_stream()
    }

    // 宿主报进度（got = 已下字节；total = 目标总字节，<=0 = 未知 ✓）
    func feed_buffer(int got, int total) {
        if not streaming { return }
        streamGot = got
        if total > 0 { streamTotal = total }
        // 还没出声、也没在等待 ⇒ 文件够建 Sound 了就先开（首片到时从这条进来 ✓）
        // ★ 判据同上：要的是"**这一条流**的声建起来了没"，不是"字段里有没有对象" ✗（见字段处 ⚠）
        if not streamOpened and not waiting { try_open_stream() }
    }

    // 整首下完（path = 最终文件全路径 ✓）
    func finish_stream(string path) {
        if not streaming { return }
        streamDone = true
        if path != "" {
            streamPath = path
            if index >= 0 and index < qLocal.len() { qLocal[index] = path }   // 记成本地已有 ✓
        }
        streamGot = streamTotal
        if waiting { resume_at(waitPos); return }   // 等待中 ⇒ 缓冲肯定够了 ⇒ 立刻续播 ✓
        // ★ 2026-10-10 修：**正在播**也必须重建一次 —— 手里那个 Sound 可能还是"文件只下到
        //   一半时建的"，只播得动**旧长度** ✗（"下完 + 改名"那条路本来就会重建 ✓ 见 stream_switched，
        //   这里是**没改名**那条路的补漏 ✓）；不重建就会播到旧末尾、被 tick 当成"放完"切下一首 ✗✗
        //   ⚠ 位置用 `position()`：声没建起来时它自己会返回影子位置 ✓（见 position ✓）
        if playing and streamPath != "" { resume_at(position()) }
    }

    // 下失败（网断了 / 取不到直链 ✓）⇒ 写明原因；★ **不能**把播放状态清空 ✗
    //   （用户实测的"刚听 3 秒就停住 + 时间 / 时长归零 + 点播放与拖进度全失效"正是这里 ✓）
    //   已经下到一段（streamGot > 0）⇒ 保住播放状态，把已下的那段当"这首就到这儿" ✓
    //   一点都没下到（连首片都没有）才回到干净态 —— 那时本来也没东西可播 ✓
    func fail_stream(string why) {
        if why != "" { err = why }
        if streaming and streamGot > 0 {
            waiting = false
            streamDone = true                    // ⚠ 置真：否则播到边界会再等 ⇒ 永远等不到新数据 ✗
            if playing and not streamOpened and streamPath != "" { resume_at(shadowPos) }
            return
        }
        streaming = false
        waiting = false
        playing = false
        close_sound()
    }

    // 已下比例 0..1（总长未知 ⇒ 1.0 ✓ 免得显示成"永远 0%"）
    func buf_ratio(): float {
        if streamDone { return 1.0 }
        if streamTotal <= 0 { return 1.0 }
        float r = _float(streamGot) / _float(streamTotal)
        if r < 0.0 { r = 0.0 }
        if r > 1.0 { r = 1.0 }
        return r
    }

    // 已下部分折算成"可用秒数"（拖进度 / 等缓冲的判据 ✓）
    func avail_seconds(): float {
        float d = duration()
        if streamDone { return d }
        return d * buf_ratio()
    }

    // 在不在边下边播 / 在不在等缓冲（界面文案与进度条要它 ✓）
    func is_streaming(): bool { return streaming }
    func is_waiting(): bool { return waiting }

    // 建 Sound 去播 streamPath（刚能播时调 ✓）
    //   ⚠ 失败（文件还太小 ⇒ miniaudio 打不开）⇒ 继续等下一拍（**不报错** ✓ 首片只有 1MB 时可能失败 ✓）
    func try_open_stream() {
        if not streaming { return }
        if streamPath == "" { return }
        // ⚠ 这里判的是 **streamOpened**（不是 `sound != null` ✗）—— 换歌时上一首的 Sound
        //   还躺在字段里（只 stop 不销毁 ✓）⇒ 用 `sound != null` 会把"这一首还没声音"误判成
        //   "已经有声了"⇒ 流的对象永远建不起来、进度条钉死（2026-10-10 用户实测的 bug ✓）
        if streamOpened { return }
        if waiting { return }
        var s = audio.createSound(streamPath)
        if not s.isInit() {
            // ⚠ 这里**别动 `sound` 字段**（2026-10-10 修）：它可能躺着**上一首**那个对象
            //   （换歌只 stop 不销毁 ✓ 见字段处 ⚠）—— 置 null 就再没人 uninit 它（丢句柄 ✗）
            //   而"这一首还没声"这件事**由 streamOpened 表达** ⇒ 字段留着无妨 ✓
            return                              // 还太短 ⇒ 等下一次 feed_buffer 再试 ✓
        }
        float d = s.getDuration()
        if d > 0.0 { streamDur = d }
        s.setVolume(effective_volume())
        s.setLooping(false)
        s.play()
        swap_sound(s)                            // ★ 先建后销（见 swap_sound ✓）——这里会顺手销毁
                                                 //   上一首那个已停的 Sound ✓（引擎引用始终 ≥1 ✓）
        streamOpened = true                      // ★ 本次流的声**建起来了**（后面都用它判 ✓）
        streamBuiltBytes = streamGot              // ★ 记下"这个 Sound 是按多少字节建的"（见字段处 ⚠ ✓）
        playing = true
        err = ""
        openTicks = 0
    }

    // 进入等待：先停下发声，记住"等够之后要跳到哪"（forSeek = 用户拖的 / false = 播到边界 ✓）
    //   ★ 2026-10-09：这里**只 stop、不销毁** —— 销毁会让引擎引用计数归 0（见 swap_sound 的注释），
    //     续播时又得重开音频设备 ⇒ "停顿一下" ✗；反正它已经到末尾 / 被 stop，不会再有声音 ✓
    func begin_wait(float pos, bool forSeek) {
        waitPos = pos
        shadowPos = pos
        waitForSeek = forSeek
        waitTicks = 0
        lastGot = streamGot
        waiting = true
        playing = true
        sound?.stop()                            // 停止发声（进度条位置由 position() 返回 waitPos ✓）
    }

    // 等待循环：每 2 拍探一次（120ms 一拍 ⇒ 约 240ms ✓ 比原先 8 拍（约 1 秒）灵敏得多，
    //   用户对"播到边界后停多久"是很敏感的；探测本身只是比两个整数，代价可忽略 ✓）
    func tick_wait() {
        if not playing { return }                // 用户暂停了 ⇒ 别自作主张续播 ✓
        if streamPath == "" { waiting = false; return }
        if streamDone {
            waitTicks = waitTicks + 1
            if waitTicks < 2 { return }
            waitTicks = 0
            resume_at(waitPos)
            return
        }
        waitTicks = waitTicks + 1
        if waitTicks < 2 { return }
        waitTicks = 0
        if streamGot <= lastGot { return }       // 这一秒没长 ⇒ 接着等 ✓
        lastGot = streamGot
        // 拖到未下区的情形：目标秒要落在**已下范围**里才续播（留 0.5 秒余量 ✓）
        if waitForSeek and waitPos > avail_seconds() - 0.5 { return }
        resume_at(waitPos)
    }

    // 重建 Sound 并跳到 pos 续播（等待结束的统一出口 ✓）
    func resume_at(float pos) {
        close_sound()
        streamOpened = false                     // ★ 声先没了 ⇒ 建回来之前一律按"没声"算 ✓
        waiting = false
        waitPos = pos                            // ★ 失败退回等待时也用它（不沿用陈旧位置 ✗）
        shadowPos = pos
        if streamPath == "" { return }
        var s = audio.createSound(streamPath)
        if not s.isInit() {
            waiting = true                       // 还打不开 ⇒ 回到等待（约 1 秒后再试 ✓）
            waitTicks = 0
            return
        }
        float d = s.getDuration()
        if d > 0.0 { streamDur = d }
        s.setVolume(effective_volume())
        s.setLooping(false)
        if pos > 0.0 { s.seek(pos) }
        s.play()
        swap_sound(s)                            // ★ 先建后销：引擎在切换中始终活着（见 swap_sound ✓）
        streamOpened = true                      // ★ 声重建好了（见字段处 ⚠ ✓）
        streamBuiltBytes = streamGot              // ★ 同上：这个 Sound 只覆盖到"当前已下"的字节 ✓
        playing = true
        err = ""
        openTicks = 0
    }

    // ★ 宿主"去掉 `@` 改名"之前的**先松手**：返回当前播放位置（没在边下边播 ⇒ -1 ✓）
    //   为什么必须拆出来：Windows 下**文件被 Sound 读着就改不了名** ✗ ⇒ 只能先放掉音频对象再改 ✓
    //   （顺序由宿主保证：pause_for_rename -> rename -> stream_switched ✓ 见 musicdl_gui.pollStreams）
    func stream_pause_for_rename(): float {
        if not streaming { return -1.0 }
        // 本来就没声、也没在等缓冲 ⇒ 播放器**没占着文件**（改名不会失败）⇒ 报 -1，宿主直接改 ✓
        // ⚠ 判"播放器占不占着这个文件"：流的声没建起来 ⇒ 没占着（哪怕字段里躺着上一首的 ✗）
        if (sound == null or (streaming and not streamOpened)) and not waiting { return -1.0 }
        float pos = position()
        close_sound()
        streamOpened = false                     // ★ 一句"声没了"的实情：标志跟着一起落（见字段处 ⚠ ✓）
        waiting = false
        lastGot = streamGot
        return pos
    }

    // ★ 宿主改名成功之后：用**最终文件**接着播（path = 去掉 `@` 的那个路径 ✓）
    func stream_switched(string path, float pos) {
        // ⚠ 先记账（**即使已经不在流**也要记）：这首下完了就该被当成"本地已有" ✓
        //   —— 否则用户暂停着、或流已经收摊，会白下完一首还一直被当"没下载" ✗
        if index >= 0 and index < qLocal.len() { qLocal[index] = path }
        if not streaming { return }
        streamPath = path
        streamDone = true
        shadowPos = pos
        waitPos = pos
        if playing {
            resume_at(pos)
            // ★ 保险：万一重开失败，**必须**落进"等待循环"继续重试
            //   —— 绝不留在"没声又没在等"的僵态（时间显示 0:00 / 0:00，看着像卡死 ✗）
            if sound == null and not waiting {
                waiting = true
                waitTicks = 0
            }
        } else {
            waiting = false                    // 用户暂停着 ⇒ 保持静音（点播放会走"本地文件"那条 ✓）
        }
    }

    // 清掉"边下边播 / 等待"的一切状态（换首 / 换队 / 停止时调 ✓）
    func reset_stream() {
        streaming = false
        streamOpened = false
        streamBuiltBytes = 0
        streamPath = ""
        streamGot = 0
        streamTotal = 0
        streamDone = false
        streamDur = 0.0
        wantStream = false
        wantIndex = -1
        waiting = false
        waitPos = 0.0
        waitForSeek = false
        waitTicks = 0
        lastGot = 0
        openTicks = 0
        shadowPos = 0.0
    }

    // ==================== （原"试听"这一段已退役 ✓ 见 previewing 字段处的说明）====================

    // ==================== 推进（主循环 120ms 调一次 ✓）====================

    // 放完了 ⇒ 按循环模式往下走；该停就停 ✓
    //   ★ 2026-10-09（移植自二创）：多两条"边下边播"的路 —— ① 等缓冲中走 tick_wait；
    //     ② 播到"已下边界"变成等缓冲（那**不是**真的放完 ✓）
    func tick() {
        // ★ 等缓冲中 ⇒ 走等待循环（探测缓冲 ✓），不推进
        if waiting { tick_wait(); return }
        if not playing { return }
        // ⚠ 判"声还在不在"：边下边播时**字段里有对象 ≠ 这一首有声**（那可能是上一首的 ✗ 见字段处 ⚠）
        if sound == null or (streaming and not streamOpened) {
            // ★★ 自愈：边下边播里"声没了"绝不能就此僵住 ✗
            //   （症状就是用户报的：时间 / 时长归零、点播放与拖进度全失效 ✓）
            //   约每 1 秒按**影子位置**重开一次：文件还在长、以及已经下完两种都能救回来 ✓
            if streaming and streamPath != "" {
                openTicks = openTicks + 1
                if openTicks >= 8 {
                    openTicks = 0
                    resume_at(shadowPos)
                }
            }
            return
        }
        openTicks = 0
        shadowPos = sound.getPosition()          // 记位置：声一没也能显示"听到哪儿了" ✓
        if streamDur <= 0.0 {                    // 流式解码器头几拍可能量不出时长 ⇒ 补记一次 ✓
            float dd = sound.getDuration()
            if dd > 0.0 { streamDur = dd }
        }
        if not sound.isAtEnd() { return }
        // ★★ 2026-10-10 修（用户实测："边下边播时播一会儿自己跳到下一首"）：
        //   先问一句"**文件是不是比我建这个 Sound 时更长了**" —— 长了就说明我们只是播到了
        //   那个 Sound 的**旧末尾**（追加/改名后的数据它看不见 ✓ 见字段处 ⚠）⇒ 重建续播 ✓
        //   绝不能往下走"播完 ⇒ 切下一首"那条路 ✗✗（那个"很奇怪"的自动跳歌就是它 ✓）
        if streaming and streamGot > streamBuiltBytes {
            resume_at(position())
            return
        }
        // ★ 边下边播：播到了"已下边界"但整首还没完 ⇒ 先停下等缓冲（不是真的放完 ✓）
        if streaming and not streamDone {
            begin_wait(position(), false)
            return
        }
        int i = next_index_on_end()
        endedCount = endedCount + 1
        if i < 0 {
            playing = false
            return
        }
        play_index(i)
    }

    func close_sound() {
        if sound != null { sound?.uninit() }
        sound = null
    }

    func close() {
        stop()
        reset_stream()
        close_sound()
    }
}
