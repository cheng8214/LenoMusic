// ⚠ import 必须放在**文件最前面**（在用到模块之前 ✗ —— 本文件先前把它们放在分隔注释之后，
//   后来新增的"歌词解析"用到 `strings` 就报"模块未导入"了 ✓ 2026-10-08 挪到顶上 ✓）
import dirs
import files
import strings
import "Music" as audio
use audio.Sound

// ==================== 显示用：从文件名拆"歌名 / 歌手"（纯逻辑 ✓ 能离线单测）====================
// 依据：下载落盘的名字是 `sanitizefilename(job[1] + " - " + job[2])`
//       —— `job[1]` = **歌名**(F_NAME=1)、`job[2]` = **歌手**(F_ARTIST=2)（见 dl_engine:377 + 字段表 ✓）
//   ⇒ 即 **"歌名 - 歌手"**（与下载目录里的实物一致 ✓，如 `后来 - 刘若英.flac` ✓）
//   ⚠⚠ 2026-10-07 修：先前按"歌手 - 歌名"拆，于是播放条**大小两行正好接反** ✗
//      （大行显示歌手、小行显示歌名 ✗ —— 随手拿一个真实文件就能看出来 ✓）
//   ⚠ 按**最后**一处 `" - "` 切：歌名自己带 `" - "` 也不怕（`A - B - 歌手` ⇒ 歌名 `A - B` ✓）
//   ⚠ 拆不出（用户自己丢进来的歌 / 名字里没有分隔符）⇒ 歌手 ""、整条当歌名 ✓ —— 不硬猜 ✗

// ==================== 歌词折行（纯逻辑 ✓ 能离线单测）====================
// 为什么要有：一句 30+ 字的歌词，在"当前句"17pt 下会**超出浮层宽度顶到边上** ✗（先前实测 ✓）
//   ⚠ 判宽**不量字体**（那样就得有 Font、离线测不了 ✗）—— 改用**可视单元**：
//     中文/日文/韩文/全角标点 = 2 单元，其余 = 1 单元 ✓（CJK 大致就是半角两倍宽 ✓ 够准 ✓）
//     调用方按字号换算上限：1 单元 ≈ 字号 ÷ 2（`max_units = 可用宽 ÷ (字号/2)` ✓）

// 这个码点占"两个半角单元"吗（常用 CJK 范围；够了 ✓ 冷僻区不追求 ✓）
// ⚠ 用十进制写（十六进制字面量在这个语言里没把握 ✗ 别赌 ✓），注释里标 16 进制便于核对 ✓
export func is_wide_cp(int cp): bool {
    if cp < 0 { return false }
    if cp >= 4352 and cp <= 4447 { return true }          // 0x1100-0x115F 谚文字母
    if cp >= 11904 and cp <= 42191 { return true }        // 0x2E80-0xA4CF 部首/汉字/假名/注音…
    if cp >= 44032 and cp <= 55203 { return true }        // 0xAC00-0xD7A3 谚文音节
    if cp >= 63744 and cp <= 64255 { return true }        // 0xF900-0xFAFF 兼容汉字
    if cp >= 65072 and cp <= 65135 { return true }        // 0xFE30-0xFE6F 全角标点
    if cp >= 65280 and cp <= 65376 { return true }        // 0xFF00-0xFF60 全角形式
    if cp >= 65504 and cp <= 65510 { return true }        // 0xFFE0-0xFFE6 全角符号
    if cp >= 131072 { return true }                       // ≥0x20000 扩展汉字
    return false
}

// 一句歌词按单元折成 1..N 段（空串 ⇒ 空表 ✓；`maxUnits` 太小按 4 兜底 ✓ 免得死循环 ✗）
export func wrap_units(string text, int maxUnits): Array[string] {
    Array[string] parts = []
    if text == null { return parts }
    int total = text.len()
    if total == 0 { return parts }
    if maxUnits < 4 { maxUnits = 4 }
    string cur = ""
    int w = 0
    int i = 0
    while i < total {
        int cw = 1
        if is_wide_cp(strings.codepoint_at(text, i)) { cw = 2 }
        if w + cw > maxUnits and cur != "" {         // 放不下就断（**断在字与字之间** ✓ 不切半个字）
            parts.add(cur)
            cur = ""
            w = 0
        }
        cur = cur + text.sub_str(i, 1)
        w = w + cw
        i = i + 1
    }
    if cur != "" { parts.add(cur) }
    return parts
}

// ==================== 歌词"空档"判定（纯逻辑 ✓ 能离线测）====================
// 为什么要有：长**前奏** / 长**间奏**时，画面上"什么都没在动" ✗ ⇒ 容易以为卡住了 ✓
//   ⇒ 到那种时候给一句话（"前奏中…" / "间奏中…"）✓
//   ⚠ 阈值**不能太敏感** ✗：普通句间隔（2~4 秒）不该冒提示 ✓（那会一直闪 ✓ 反而烦）
// 返回：0 = 不提示；1 = 还没到第一句（前奏）；2 = 这句唱过一阵、下一句还很远（间奏）
export func lyric_stage(float pos, float cur_t, float next_t, bool has_cur, bool has_next): int {
    if not has_cur {
        if cur_t - pos > 1.5 { return 1 }        // 第一句还早 ⇒ 前奏 ✓（第一句在 0:00 时**不**提示 ✓）
        return 0
    }
    if not has_next { return 0 }                 // 最后一句：不猜"什么时候结束" ✗
    if next_t - pos > 6.0 and pos - cur_t > 2.5 { return 2 }
    return 0
}

// 去掉扩展名（找**最后**一个点 ✓）："a.b.mp3" ⇒ "a.b"；没有点 ⇒ 原样 ✓
export func strip_ext(string name): string {
    if name == null { return "" }
    int dot = -1
    int q = name.find(".")
    while q >= 0 {
        dot = q
        q = name.find(".", q + 1)
    }
    if dot <= 0 { return name }
    return name.slice(0, dot)
}

// 最后一处 `" - "` 的下标（没有 ⇒ -1 ✓）
func last_sep(string n): int {
    int sep = -1
    int q = n.find(" - ")
    while q >= 0 {
        sep = q
        q = n.find(" - ", q + 1)
    }
    return sep
}

// 歌手 = **最后**一个 " - " **之后**那段（拆不出 ⇒ "" ✓）
export func split_artist(string filename): string {
    if filename == null { return "" }
    string n = strip_ext(filename)
    int q = last_sep(n)
    if q <= 0 { return "" }
    int rest = n.len() - q - 3
    if rest <= 0 { return "" }
    return n.sub_str(q + 3, rest)
}

// 歌名 = **最后**一个 " - " **之前**那段（拆不出 ⇒ 整条 ✓）
export func split_title(string filename): string {
    if filename == null { return "" }
    string n = strip_ext(filename)
    int q = last_sep(n)
    if q <= 0 { return n }
    return n.slice(0, q)
}

// ==================== 歌词（.lrc）解析（纯逻辑 ✓ 能离线单测）====================
// 形如：[00:12.34]歌词文本 —— 一行可能挂**多个**时间标签（`[00:12][01:20]同一句` ⇒ 拆成两条 ✓）
//   ⚠ 元信息行 `[ti:歌名] [ar:歌手] [by:xxx]`：标签里没有 `mm:ss` 那个形状 ⇒ 整行跳过 ✓
//   ⚠ 时间认三种写法：`[mm:ss.xx]`（百分秒 ✓ 最常见）、`[mm:ss]`、`[mm:ss.xxx]` ✓
//   ⚠ 一切按**码点**走：歌词是中文 ⇒ 按字节切会切坏 ✗（`strings.to_codepoints` ✓）
export struct Lrc {
    Array[float] secs
    Array[string] texts
}

// 码点数组的一段 ⇒ 字符串（按码点拼 ✓）
func cp_slice(Array[int] cps, int from, int count): string {
    string out = ""
    int i = from
    int last = from + count
    while i < last {
        if i >= 0 and i < cps.len() { out = out + strings.from_codepoint(cps[i]) }
        i = i + 1
    }
    return out
}

// 一个时间标签（"mm:ss.xx"）⇒ 秒 ✓；**不是这个形状就返回 -1**（`[ti:…]` 走这条 ✓）
func lrc_tag_secs(string tag): float {
    Array[int] c = strings.to_codepoints(tag)
    int mm = 0
    int i = 0
    int d = 0
    while i < c.len() and c[i] >= 48 and c[i] <= 57 { mm = mm * 10 + (c[i] - 48); i = i + 1; d = d + 1 }
    if d == 0 { return -1.0 }
    if i >= c.len() or c[i] != 58 { return -1.0 }        // ':'
    i = i + 1
    int ss = 0
    d = 0
    while i < c.len() and c[i] >= 48 and c[i] <= 57 { ss = ss * 10 + (c[i] - 48); i = i + 1; d = d + 1 }
    if d == 0 { return -1.0 }
    float frac = 0.0
    if i < c.len() and c[i] == 46 {                      // '.'
        i = i + 1
        int cs = 0
        int n = 0
        while i < c.len() and c[i] >= 48 and c[i] <= 57 { cs = cs * 10 + (c[i] - 48); i = i + 1; n = n + 1 }
        float sc = 1.0
        int t = 0
        while t < n { sc = sc * 10.0; t = t + 1 }
        if n > 0 { frac = _float(cs) / sc }
    }
    if i != c.len() { return -1.0 }                      // 尾巴上还有别的字符 ⇒ 不认 ✓
    return _float(mm * 60 + ss) + frac
}

// 一行 ⇒ 往 out 里加 0..N 条（元信息/空行 ⇒ 0 条 ✓）
func lrc_add_line(string line, Lrc out) {
    if line.trim() == "" { return }
    Array[int] cps = strings.to_codepoints(line)
    Array[float] ts = []
    int i = 0
    // 先把行首连续的 [..] 标签都吃掉（一行挂多个时间戳的情形 ✓）
    while i < cps.len() and cps[i] == 91 {               // '['
        int j = i + 1
        while j < cps.len() and cps[j] != 93 { j = j + 1 }   // ']'
        if j >= cps.len() { return }                     // 不闭合 ⇒ 这行不要 ✓
        float t = lrc_tag_secs(cp_slice(cps, i + 1, j - i - 1))
        if t < 0.0 { return }                            // [ti:…] 之类 ⇒ 整行跳过 ✓
        ts.add(t)
        i = j + 1
    }
    if ts.len() == 0 { return }                          // 没有任何时间标签 ⇒ 跳过（纯文本行 ✓）
    string text = cp_slice(cps, i, cps.len() - i).trim()
    for ts to t2 { out.secs.add(t2); out.texts.add(text) }
}

// 升序排（同时间的保持原顺序 ✓ —— 插入排序稳定 ✓）
func lrc_sort(Lrc out) {
    int n = out.secs.len()
    int i = 1
    while i < n {
        float t = out.secs[i]
        string s = out.texts[i]
        int j = i - 1
        while j >= 0 and out.secs[j] > t {
            out.secs[j + 1] = out.secs[j]
            out.texts[j + 1] = out.texts[j]
            j = j - 1
        }
        out.secs[j + 1] = t
        out.texts[j + 1] = s
        i = i + 1
    }
}

// 解析一整份 .lrc（换行 `\r\n` / `\n` / `\r` 都认 ✓）
export func lrc_from_text(string raw): Lrc {
    Lrc out = new Lrc()
    out.secs = []
    out.texts = []
    if raw == null or raw == "" { return out }
    string s = raw.replace("\r\n", "\n")
    s = s.replace("\r", "\n")
    Array[string] lines = s.split("\n")
    for lines to ln { lrc_add_line(_str(ln), out) }
    lrc_sort(out)
    return out
}

// 当前唱到第几行：最后一个 `secs[i] <= sec` 的下标 ✓（一条都没到 ⇒ -1 ✓）
export func lrc_index_at(Array[float] secs, float sec): int {
    int hit = -1
    int i = 0
    while i < secs.len() {
        if secs[i] <= sec { hit = i } else { return hit }
        i = i + 1
    }
    return hit
}

// player.leno — 音乐下载器：**播放器状态机**（纯逻辑为主 ⇒ 能离线单测 ✓）
//
// 分工（照本应用既有分层：dl_engine / dl_window / musicdl_gui ✓）：
//   本文件           —— 列表 / 索引 / 播放暂停 / 循环 / 音量 / "放完自动下一首"的**规则**（可测 ✓）
//   player_bar.leno  —— 画界面（**嵌在主界面表格下方的播放条**，不另开窗口 ✓）
//   musicdl_gui.leno —— 接线：给它目录、把播放条加进根布局、每 120ms 调一次 tick() ✓
//
// ⚠ 为什么把"规则"与"发声"分开（这是本文件唯一的设计要点）：
//   离线单测里建 Sound 可能失败（无声卡 / 文件是假的 ✓），但"放完之后下一首该是谁"这种
//   规则**必须能测** ⇒ 拆成 `next_index_on_end()`（纯 ✓）+ `tick()`（带声音 ✓）✓
//
// ★ 底层用 LenoMusic（miniaudio：mp3/flac/wav/ogg 都能解 ✓）。已实测的三条（2026-10-07 ✓）：
//   · 下载是**顺序追加写最终文件** ⇒ 部分文件**前缀自洽** ⇒ 截断 mp3 也能 load/播/给位置 ✓
//   · `stop()` **保留播放位置** ⇒ 暂停 = stop、恢复 = play（模块里已包成 pause/resume ✓）
//   · `getDuration()` = 文件头声明的**总时长** ✗ 与"当前可播长度"不一定一致
//     ⇒ 对"还在下的那首"，进度条分母要按**已下比例**折算（二期"边下边播"再落地 ✓）
export const LOOP_OFF = 0        // 放完列表就停
export const LOOP_ALL = 1        // 放完回到第一首
export const LOOP_ONE = 2        // 单曲循环

export struct Player {
    Array[string] list               // 播放列表（**文件全路径**，已按文件名排序 ✓）
    int index = -1                   // 当前下标（-1 = 没选）
    bool playing = false             // 用户意图：在播（暂停 ⇒ false ✓）
    float volume = 0.8
    bool muted = false
    int loopMode = 1                 // LOOP_ALL（列表循环；字段默认值只能是字面量 ✗ ⇒ 不写常量名 ✓）
                                     //   0=LOOP_OFF / 1=LOOP_ALL / 2=LOOP_ONE（见上面三个 export const ✓）
    Sound? sound = null
    string err = ""                  // 最近一次失败原因（无声卡 / 文件坏 ⇒ 界面要能说清 ✓）
    int endedCount = 0               // 自检计数：一共自动推进过几次 ✓

    // ---- 试听（"点一下立刻听"，与播放列表**并存的一套最小状态** ✓）----
    //   媒体文件由调用方先准备好（哪怕只有**前一段** ✓ —— 实测"顺序写 ⇒ 截断文件前缀自洽、能播" ✓）
    //   试听会**独占音频**：开始试听即停掉列表里那首 ✓；放完自动收摊、不推进列表 ✓
    bool previewing = false
    string previewName = ""          // 界面显示用（"试听：xxx" ✓）
    string previewPath = ""          // 临时文件路径（收摊时可删 ✓）

    // ---- 歌词（2026-10-08 ✓）：**懒加载** —— 换歌才重读一次，其它时候零开销 ✓ ----
    Lrc lrc
    string lrcFor = ""               // 已经读的是**哪个歌词文件**（路径 ✓ 变了才重读 ✗ 见 ensure_lrc）
    string scanDir = ""              // 最近一次 `scan` 的目录（试听态"去输出目录找同名歌词"要用 ✓）
    bool lrcTried = false

    // ==================== 列表（纯逻辑 ✓ 离线可测）====================

    // 扫一个目录里的音频文件（按文件名升序 ✓）；返回扫到几个
    //   ⚠ `dirs.listdir` 给的是**名字**（不含路径 ✗）⇒ 自己 join ✓
    func scan(string dir): int {
        close()
        scanDir = dir                     // ★ 记下这次的目录（2026-10-08）：试听态取歌词要用 ✓ 见 lrc_path
        list = []
        index = -1
        if not dirs.exists(dir) { return 0 }
        // ⚠ `dirs.listdir` 返回的**不是数组**（对它调 `.len()` 会报「类型 object 上不存在方法 'len'」✗）
        //   但**可以直接 for 迭代**拿到名字 ✓ ⇒ 这里只用迭代，不碰 `.len()` ✓
        var names = dirs.listdir(dir)
        Array[string] hits = []
        for names to n {
            string nm = _str(n)
            if is_audio(nm) { hits.add(dirs.join(dir, nm)) }
        }
        list = sort_by_name(hits)
        if list.len() > 0 { index = 0 }
        return list.len()
    }

    // 是不是音频：按扩展名（**大小写都认** ✓）
    //   ⚠ 写成显式大小写表：这里不去依赖 `strings.lower` 的可用性（少一个踩坑点 ✓）
    func is_audio(string name): bool {
        string e = dirs.extname(name)
        for ext_cases() to x {
            if e == x { return true }
        }
        return false
    }

    func ext_cases(): Array[string] {
        return [".mp3", ".MP3", ".flac", ".FLAC", ".wav", ".WAV", ".ogg", ".OGG", ".m4a", ".M4A"]
    }

    // 按**文件名**（不含目录 ✓）排序 —— 插入排序：列表通常几十条，够用且无依赖 ✓
    //   ⚠ 比较必须**大小写不敏感**：直接 `a < b` 是字节序 ⇒ "C.MP3" 会排在 "a.flac" 之前 ✗
    //     （实测踩过 ✓）⇒ 折 ASCII 小写再比，与资源管理器一致 ✓
    func sort_by_name(Array[string] paths): Array[string] {
        Array[string] out = []
        for paths to p {
            int at = 0
            string key = dirs.basename(_str(p))
            while at < out.len() and name_less(dirs.basename(out[at]), key) { at = at + 1 }
            out.insert(at, _str(p))
        }
        return out
    }

    // 文件名比较：ASCII 折小写后按码点比（非 ASCII 原样 ⇒ 与字节序一致 ✓）
    func name_less(string a, string b): bool {
        Array[int] ca = strings.to_codepoints(a)
        Array[int] cb = strings.to_codepoints(b)
        int n = ca.len()
        if cb.len() < n { n = cb.len() }
        int i = 0
        while i < n {
            int x = lower_cp(ca[i])
            int y = lower_cp(cb[i])
            if x != y { return x < y }
            i = i + 1
        }
        return ca.len() < cb.len()
    }

    func lower_cp(int c): int {
        if c >= 65 and c <= 90 { return c + 32 }      // 'A'..'Z' ⇒ 'a'..'z'
        return c
    }

    func count(): int { return list.len() }

    func current(): string {
        if index < 0 or index >= list.len() { return "" }
        return list[index]
    }

    func current_name(): string {
        string c = current()
        if c == "" { return "" }
        return dirs.basename(c)
    }

    // 按**下标**取曲名（播放条的歌单要逐行显示 ✓；越界返回 "" ✓ 不崩）
    func name_at(int i): string {
        if i < 0 or i >= list.len() { return "" }
        return dirs.basename(list[i])
    }

    // 按**文件名**找下标（找不到 -1 ✓）—— 整首下完后"切到完整文件接着播"要用 ✓
    //   只比 basename：下载落盘路径与列表项都是绝对路径，basename 才是"同一首"的判据 ✓
    func index_of(string path): int {
        string b = dirs.basename(path)
        if b == "" { return -1 }
        int i = 0
        while i < list.len() {
            if dirs.basename(list[i]) == b { return i }
            i = i + 1
        }
        return -1
    }

    // ==================== 播放规则（纯逻辑 ✓ 离线可测）====================

    // "这首放完之后，下一首该是谁"：给下标；**-1 = 该停**（列表放完了 ✓）
    //   LOOP_ONE ⇒ 还是自己 ✓ / LOOP_ALL ⇒ 回到 0 ✓ / LOOP_OFF ⇒ 到底 -1 ✓
    func next_index_on_end(): int {
        if list.len() == 0 { return -1 }
        if loopMode == LOOP_ONE { return index }
        int nxt = index + 1
        if nxt < list.len() { return nxt }
        if loopMode == LOOP_ALL { return 0 }
        return -1
    }

    // 手动"下一首 / 上一首"：同样受循环模式约束（LOOP_OFF 时到头就是 -1 ✓）
    func next_index(): int {
        if list.len() == 0 { return -1 }
        int nxt = index + 1
        if nxt >= list.len() { nxt = if loopMode == LOOP_OFF then -1 else 0 }
        return nxt
    }

    func prev_index(): int {
        if list.len() == 0 { return -1 }
        int p = index - 1
        if p < 0 { p = if loopMode == LOOP_OFF then -1 else list.len() - 1 }
        return p
    }

    // ==================== 传输控制（要音频设备 ⇒ 离线只测"安全失败" ✓）====================

    func play_index(int i): bool {
        if i < 0 or i >= list.len() { return false }
        // 一旦播列表里的歌 ⇒ 试听立刻作废（试听是"插播" ✓）
        previewing = false
        previewName = ""
        previewPath = ""
        close_sound()
        index = i
        var s = audio.createSound(list[i])
        if not s.isInit() {
            sound = null
            playing = false
            err = "打不开这首音频（文件坏了？或本机没有可用的音频设备）"
            return false
        }
        s.setVolume(effective_volume())
        s.play()
        s.setLooping(false)          // 单曲循环由本文件的规则管 ⇒ 不用引擎的 looping ✓
        sound = s
        playing = true
        err = ""
        return true
    }

    // 播放 / 暂停 切换（暂停 = stop，位置保留 ✓；恢复 = play ✓）
    func toggle(): bool {
        if playing {
            sound?.pause()
            playing = false
            return true
        }
        if sound != null {
            sound?.resume()
            playing = true
            return true
        }
        if index < 0 and list.len() > 0 { return play_index(0) }
        return play_index(index)
    }

    func next(): bool {
        int i = next_index()
        if i < 0 { return false }
        return play_index(i)
    }

    func prev(): bool {
        int i = prev_index()
        if i < 0 { return false }
        return play_index(i)
    }

    func stop(): void {
        sound?.stop()
        playing = false
    }

    // 直接跳到第 s 秒（比例版见 seek_ratio ✓）
    //   ⚠ miniaudio 的 seek 之后音频是**停着**的 ⇒ 必须 resume（否则"拖完就静音" ✗ 实测 ✓）
    func seek_seconds(float s): bool {
        if sound == null { return false }
        if s < 0.0 { s = 0.0 }
        bool ok = sound.seek(s)
        if ok {
            sound?.resume()
            playing = true
        }
        return ok
    }

    // 拖进度：按比例 0..1（要时长 ⇒ 时长未知就返回 false ✓）
    //   ⚠ 调用前先问 `can_seek()`（试听那个截断文件不让拖 ✗ 见它的注释 ✓）
    func seek_ratio(float r): bool {
        float d = duration()
        if d <= 0.0 { return false }
        if r < 0.0 { r = 0.0 }
        if r > 1.0 { r = 1.0 }
        return seek_seconds(d * r)
    }

    // 能不能拖进度：**只有"完整文件"可以** ✓（2026-10-07）
    //   · 试听播的是"前一段"的**截断文件** ✗ —— `duration()` 是文件头声明的**总时长**，比实际
    //     可播的部分长 ⇒ 拖着拖就跳到并不存在的位置（要么静音、要么直接结束 ✗ 实测 ✓）
    //   · 列表里的歌 = 已经下完的完整文件 ✓ ⇒ 可拖
    func can_seek(): bool {
        if previewing { return false }
        return sound != null and index >= 0
    }

    func set_volume(float v) {
        if v < 0.0 { v = 0.0 }
        if v > 1.0 { v = 1.0 }
        volume = v
        sound?.setVolume(effective_volume())
    }

    func set_muted(bool m) {
        muted = m
        sound?.setVolume(effective_volume())
    }

    func effective_volume(): float { return if muted then 0.0 else volume }

    func duration(): float {
        if sound == null { return 0.0 }
        return sound.getDuration()
    }

    func position(): float {
        if sound == null { return 0.0 }
        return sound.getPosition()
    }

    // 播放进度 0..1（时长未知 ⇒ 0 ✓）
    //   ★ 二期"边下边播"要改的就是这里：分母对"还在下的那首"按**已下比例**折算 ✓
    func ratio(): float {
        float d = duration()
        if d <= 0.0 { return 0.0 }
        float r = position() / d
        if r < 0.0 { r = 0.0 }
        if r > 1.0 { r = 1.0 }
        return r
    }

    // ==================== 歌词（懒加载 ✓ 与音频同名 + .lrc ✓ 见 dl_engine 的落盘命名）====================

    // 当前这首该配哪个 .lrc（没在播 ⇒ "" ✓）
    func lrc_path(): string {
        // ⚠⚠ 试听态必须**单独算** ✗✗（2026-10-08 用户实测踩到）：
        //   试听不在播放列表里 ⇒ `current()` 是 `""` ⇒ 先前这里直接返回 `""`
        //   ⇒ **试听期间永远没有歌词** ✗（点「词」是空的；下完切成本地文件后才可能有 ✓）
        //   正解：试听那个临时文件旁边**没有** .lrc ✗，但**同一首在输出目录里**有 ✓
        //     —— 试听名（`previewName`）就是下载落盘的文件名主体（"歌名 - 歌手" ✓ 见宿主 startPreview ✓）
        //       而引擎落歌词用的正是同一个基名（`dl_engine:376-378` `<歌名> - <歌手>.lrc` ✓）
        //     ⇒ 直接去输出目录取同名 .lrc ✓（还没下完 ⇒ 不存在 ⇒ 先"没有歌词" ✓ 一出现就补读 ✓ 见 ensure_lrc）
        if previewing {
            if scanDir == "" or previewName == "" { return "" }
            return dirs.join(scanDir, previewName + ".lrc")
        }
        string c = current()
        if c == "" { return "" }
        return strip_ext(c) + ".lrc"
    }

    // 换歌了就重读一次；读不到 ⇒ 空歌词（界面会说"没有歌词" ✓ 不报错 ✓）
    //   ⚠ 读文件可能抛（权限/占用）⇒ 必须接住：**歌词读失败绝不能把播放搞崩** ✗
    //   ⚠ 写法上的两个坑（都编译不过 ✓ 2026-10-08 踩过）：
    //     ① `: void` + **裸 `return`** ⇒ 编译器嫌"期望 null、实际 any" ✗ ⇒ 用 if 包住整段、不裸 return ✓
    //     ② 给 `lrc.secs`（**字段的字段**）赋 `[]` ⇒ 推断不出元素类型 ✗（本地 `Lrc` 却没事 ✓）
    //        ⇒ 统一用 `lrc_from_text("")` 造空表（同一条路径，也正好是单测覆盖的那条 ✓）
    //   ⚠ 缓存键换成**歌词文件路径**（不是"哪首"✓）：试听 → 本地文件的切换、以及"歌词比歌晚到"
    //     这两种情况，用"哪首"当键都判不出来 ✗
    func ensure_lrc() {
        string p = lrc_path()
        bool need = (p != lrcFor) or (not lrcTried)
        // ★ 还差一条（2026-10-08）：上次读时**文件还没出现**（歌词常常比歌晚到 ✓，
        //   比如试听的后台整首下载：音频先落盘、.lrc 随后 ✓）⇒ 一出现就补读 ✓
        //   没有它 ⇒ 歌词明明下下来了，画布也一直停在"没有歌词" ✗（用户实测过 ✓）
        if not need and lrc.texts.len() == 0 and p != "" {
            try {
                if files.exists(p) { need = true }
            } catch e {
                need = false                   // 查不到就是没有（不崩 ✓）
            }
        }
        if need {
            lrcFor = p
            lrcTried = true
            lrc = lrc_from_text("")
            if p != "" {
                try {
                    if files.exists(p) { lrc = lrc_from_text(files.read(p)) }
                } catch e {
                    lrc = lrc_from_text("")        // 读失败 = 没歌词（界面会说清 ✓）
                }
            }
        }
    }

    // 给界面直接喂 ListBox 的歌词行（没歌词 ⇒ 一句说明，别给空表 ✗）
    func lyric_lines(): Array[string] {
        ensure_lrc()
        if lrc.texts.len() == 0 {
            return ["（这首没有歌词 —— 下载时勾上「同时下载歌词」就能带上 ✓）"]
        }
        return lrc.texts
    }

    // 现在唱到第几行（-1 = 还没到第一句 ✓）
    func lyric_index(): int {
        ensure_lrc()
        return lrc_index_at(lrc.secs, position())
    }

    // 歌词总句数（界面按它裁可见范围 ✓）
    func lyric_count(): int {
        ensure_lrc()
        return lrc.secs.len()
    }

    // 第 i 句的文字 / 时间（越界 ⇒ "" / -1 ✓ 不崩）
    func lyric_text_at(int i): string {
        ensure_lrc()
        if i < 0 or i >= lrc.texts.len() { return "" }
        return lrc.texts[i]
    }

    func lyric_time(int i): float {
        ensure_lrc()
        if i < 0 or i >= lrc.secs.len() { return -1.0 }
        return lrc.secs[i]
    }

    // 当前句 → 下一句 之间的进度 0..1 —— **平滑上滚**就靠它 ✓（2026-10-08）
    //   语义：这一句已经"唱了多少"⇒ 画的时候把整块按这个比例往上推一点 ⇒ 看着是连续滚的 ✓
    //   没有下一句 / 时间戳相同 ⇒ 返回 0（不推 ✓ 免得瞬间跳一下 ✗）
    func lyric_progress(): float {
        ensure_lrc()
        float p = position()
        int i = lrc_index_at(lrc.secs, p)
        if i < 0 { return 0.0 }
        float t0 = lrc.secs[i]
        float t1 = t0 + 4.0
        if i + 1 < lrc.secs.len() { t1 = lrc.secs[i + 1] }
        float span = t1 - t0
        if span <= 0.05 { return 0.0 }
        float r = (p - t0) / span
        if r < 0.0 { r = 0.0 }
        if r > 1.0 { r = 1.0 }
        return r
    }

    // ==================== 试听（点一下立刻听 ✓）====================

    // 试听某个文件（路径由调用方准备好 ✓，可以只是"前一段" ✓）
    //   返回 false 时 `err` 会写清原因（本机没声卡 / 文件是空的 ✓）
    func preview(string path, string title): bool {
        close_sound()                     // 试听独占音频：先把列表那首停掉 ✓
        previewing = true
        previewName = title
        previewPath = path
        var s = audio.createSound(path)
        if not s.isInit() {
            sound = null
            playing = false
            previewing = false
            err = "试听打不开这首音频（本机没有可用的音频设备？或试听文件是空的）"
            return false
        }
        s.setVolume(effective_volume())
        s.play()
        s.setLooping(false)
        sound = s
        playing = true
        err = ""
        return true
    }

    func stop_preview() {
        if not previewing { return }
        stop()
        close_sound()
        previewing = false
        previewName = ""
        previewPath = ""
    }

    func preview_name(): string { return previewName }

    // ==================== 推进（主循环 120ms 调一次 ✓）====================

    // 放完了 ⇒ 按循环模式往下走；该停就停 ✓
    func tick() {
        if not playing or sound == null { return }
        if not sound.isAtEnd() { return }
        if previewing {
            // 试听放完（或把"前一段"听完了 ✓）⇒ 收摊，**不**推进播放列表 ✓
            playing = false
            previewing = false
            previewName = ""
            previewPath = ""
            close_sound()
            return
        }
        int i = next_index_on_end()
        endedCount = endedCount + 1
        if i < 0 {
            playing = false
            return
        }
        play_index(i)
    }

    func close_sound() {
        if sound != null { sound?.uninit() }
        sound = null
    }

    func close() {
        stop()
        close_sound()
    }
}
