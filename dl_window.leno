// dl_window.leno — 音乐下载器：**下载窗口**（从 musicdl_gui.leno 拧出来的独立模块 ✓）
//
// 分层（照 电脑清理大师 的 cleaner_detail.leno、Trae签到 的 trae_core.leno 同款 ✓）：
//   dl_engine.leno    ← **纯逻辑**：网络 / 取直链 / 落盘 / 行格式（不 import SDL3 ⇒ 可单测 ✓）
//   dl_window.leno    ← **本文件**：下载对话框（窗口 + 任务表 + 总进度 + 按钮 + 每 120ms 刷新）
//   musicdl_gui.leno  ← 主界面：搜索、勾选、右键菜单；"要下哪些歌"由它判定后把数据交进来 ✓
//
// ⚠ 一处**必须留在主界面**的东西：`threads.start` 及其 worker 入口
//   实测（musicdl_gui 里记着原话）：线程入口必须是**起线程那个文件**的具名全局函数 ——
//   跨模块会当场抛「线程入口必须是当前文件的函数 ✗ 子线程不会加载别的模块的全局变量」
//   ⇒ 本模块只把"用户点了开始"这层意图暴露成 `wantStart`；主界面在 120ms 定时器里
//     真正起 N 个线程（**多首歌并行**），再把它们与各自的命令通道用 `attach()` 交回本窗口 ✓
//     （谁起线程谁持有入口 ✓；命令必须**人人发一条** ⇒ 见 sendcmd ✓）
//
// ⚠ 另一处不搬的：**"要下哪些歌"的判定**（勾选的行 / 选中行 / 只下歌词）属主界面业务策略
//   ⇒ 留在 musicdl_gui.leno（cleaner_detail 的分工同款：本模块"给数据就画" ✓）
//
// ★ 2026-10-07：本窗口从**模态**改成**非模态**（开着下载框时主窗口照样能用 ✓）
//   · 差别只在"进不进模态栈"：`runModal = pushModal + run`，而事件循环里
//     `if _isModal() and wid != _modalTop() { 跳过该窗口的全部事件 }` ⇒ **模态会吞掉主窗口的事件** ✗
//   · 现在走 `createModelessDialog`（不 pushModal）+ `dlg.run(...)`：两个窗口都在 `_runWids` 里，
//     各收各的事件、各自重绘（重绘请求是全局标志 ✓）；关掉本窗口只会摘掉它自己那一项 ✓
//   ⇒ **"不重复打开"因此成了主界面的责任**：见本文件末尾的 `reuse_if_open` ✓
//     （原先每点一次"下载"就 `new` 一个 DlWindow + 一个新窗口 ⇒ 点两下就是两个框 ✗）
import "SDL3" as SDL3
import dirs
import files
import strings
import threads
import times
import "./dl_engine.leno" as eng
import "./dl_history.leno" as hist       // 下载历史（纯逻辑模块 ✓ 见它的文件头）
use SDL3.(Event, Renderer, Window, TitleBar, Label, Button, Table, ProgressBar, VBox, HBox, TabControl, Scancode)

// flags 里有没有某项（与主界面、引擎层的同名私有函数各管各的，不跨模块 ✓）
func hasflag(Array[string] flags, string name): bool {
    for flags to f {
        if f == name { return true }
    }
    return false
}

// 打开目录（资源管理器/文件管理器定位）。失败无处可报 ⇒ 返回 bool 让调用方提示
// （主界面的右键菜单"打开下载目录"也用这一个实现 ⇒ 不两处漂移 ✓）
// 在资源管理器里**定位**（选中）这个文件 ✓
//   ⚠⚠ 不能拿 `openfolder` 那套 ✗：Windows 上 `cmd /c start "" "<文件>"` 会用**默认程序打开它** ✗
//      （用户实测点名 ✓）⇒ 必须走 `explorer /select,"<文件>"` ✓
export func reveal(string path): bool {
    if path == "" { return false }
    if not files.exists(path) { return false }
    string cmd = ""
    if _os() == "windows" {
        cmd = "explorer /select,\"" + path + "\""
    } else if _os() == "macos" {
        cmd = "open -R \"" + path + "\""
    } else {
        // Linux：没有统一的"选中"⇒ 退而打开它所在目录 ✓（自己截最后一段分隔符 ✓ 不依赖 dirname ✓）
        string dir = path
        int i = path.len() - 1
        while i >= 0 {
            string ch = path.slice(i, i + 1)
            if ch == "/" or ch == "\\" {
                dir = path.slice(0, i)
                i = -1
            } else {
                i = i - 1
            }
        }
        if dir == "" { dir = "/" }
        cmd = "xdg-open \"" + dir + "\""
    }
    bool ok = true
    try {
        _exec(cmd)
    } catch e {
        ok = false
    }
    return ok
}

export func openfolder(string path): bool {
    if path == "" { return false }
    string cmd = ""
    if _os() == "windows" {
        cmd = "cmd /c start \"\" \"" + path + "\""
    } else if _os() == "macos" {
        cmd = "open \"" + path + "\""
    } else {
        cmd = "xdg-open \"" + path + "\""
    }
    bool ok = true
    try {
        _exec(cmd)
    } catch e {
        ok = false
    }
    return ok
}

// ==================== 下载窗口 ====================

export struct DlWindow {
    // ---- 本轮任务（打开时由主界面给定；之后只读）----
    Array[Array[string]] jobs
    Array[string] flags
    string outdir = ""
    bool lyriconly = false
    int maxw = 4                     // 并行线程数上限（**设置**里的值，主界面传进来 ⇒ 只显示口径 ✓）

    // ---- 运行状态 ----
    bool open = false                // 窗口开着（tick() 的总开关 ✓；主界面靠它防重复打开 ✓）
    bool closing = false             // 窗口该收了（事件回调据此返回 false ✓）
    bool started = false
    bool paused = false
    bool finished = false
    bool cancelling = false
    bool wantStart = false           // 置 true ⇒ 主界面负责 threads.start（语言硬约束，见文件头 ⚠）
    int done = 0
    int fail = 0
    int lrc = 0                      // 本轮已拿到的歌词数

    // ---- 每任务进度 ----
    Array[string] status             // 每任务状态文字
    Array[int] got                   // 每任务已下字节
    Array[int] exp                   // 每任务期望字节

    // ---- 控件（build() 里赋值；`open` 为 true 之后才会被 tick/回调碰到 ✓）----
    Window dlg
    TabControl tabs                  // ★ 页签：0 = 下载（任务表）/ 1 = 历史（见 build ✓）
    Table table
    ProgressBar bar
    Label info
    Label stat

    // ---- ★ 下载历史（2026-10-09 加「历史」页签 ✓）----
    //   `histItems` = **完整记录**（含文件路径 ✓，与 histTable 的行**一一对应** ⇒ 右键按行号取它）
    //   `histLbl`   = 计数/提示行
    Table histTable
    Label histLbl
    Array[Array[string]] histItems = []
    // 每条任务的**落盘路径**（`start` 消息里带着 ✓ 缓存下来 ⇒ 失败/取消也能记下"半截文件在哪"）
    Array[string] paths = []
    // ★ 按钮提成**字段**（2026-10-08 ✓）：先前是 build 里的局部变量 ⇒ 除了"开始"那一下，
    //   别处（例如右键「重试」）改不动它们的可用态 ✗ ⇒ 现在统一由 `setRunningUi` 管 ✓
    Button startBtn
    Button pauseBtn
    Button cancelBtn
    Button clearBtn
    Button openBtn
    Button closeBtn

    // ★ 右键「重试」要把**哪些下标**重下 —— 列在这里，由主界面起线程 ✓
    //   （与 `wantStart` 同一条硬约束：`threads.start` 必须在起线程那个文件里 ✓ 见文件头 ⚠）
    Array[int] retryList

    // ★ 「清空」遗留的线程（2026-10-09 ✓）：清空时若还在下载 ⇒ 先发取消，再把 worker 挪到这儿 ——
    //   本轮的结果已经不要了（表都清了 ✗），但线程**必须有人 join**（不然句柄没人回收 ✓）
    //   ⇒ 由 tick() 悄悄收：谁停了就 join 掉、抛出的异常也吞掉（那正是"取消"引起的 ✓）
    Array[Thread] orphan

    // ---- 与主界面 / worker 的连线（**多首歌并行**：N 个 worker ✓）----
    Label? hostLbl = null            // 主界面状态栏：结束时回写一句（open 时传进来一次 ✓）
    Array[Thread] threads            // 本次所有 worker（看完没完要看**全部** ✓）
    Channel? ch = null               // 所有 worker **共用**的进度消息通道（消息带全量下标 ⇒ 按 idx 归位 ✓）
    Array[Channel] cmds              // **每个 worker 一条**命令通道（一条被某个 worker 取走，别的就收不到了 ✗）

    // —— 构建窗口并显示（**非模态** ✓）——
    // ⚠ `run()` 第一句是 `registerOnly(...)`；**主循环已在跑时它立即返回、不阻塞** ⇒
    //   收尾动作必须写在按钮/事件回调里（cleaner_master 踩过："点确认什么也不发生" ✗）
    // ⚠ 非模态 ⇒ 别再用 `runModal`：它是 `pushModal + run`，而模态会让主窗口**收不到任何事件** ✗
    func build() {
        string title = if lyriconly then "下载歌词" else "下载"
        int dw = 860
        int dh = 500                     // ★ 加「历史」页签后加高一点（不然历史表只剩三四行 ✓）
        int tbH = SDL3.DIALOG_TB_H
        // ★ 非模态对话框（**不 pushModal**）⇒ 主窗口照样收事件 ✓
        //   `createDialogWindow` 是模态那条（UTILITY 标志 + 自动 raise）；非模态这条不自动置前
        //   ⇒ 下面自己补一个 `raise()`，否则新窗口可能开在主窗口**后面**（观感像"没反应" ✗）
        dlg = SDL3.createModelessDialog({title: title, w: dw, h: tbH + dh})
        dlg.raise()
        TitleBar tb = SDL3.dialogTitleBar(dlg, title)
        var droot = SDL3.createVBox({x: 0, y: 0, w: dw, h: dh, padX: 16, padY: 14, spacing: 8})
        dlg.setRootAt(droot, 0, tb.get_h())
        // ★ 2026-10-09：内容拆成**两个页签**（页 0 = 下载任务 / 页 1 = 下载历史 ✓）
        //   为什么用页签、不再开一个窗口：任务与历史是同一条流程的两面（刚下完就想回头看看 ✓），
        //   而本窗口已经是**非模态**的；再开一个窗口只多一个"要记得关"的东西 ✗
        //   （做法照 leno_gui 数据看板 dashboard.leno 与主界面：`setPageLayout` ⇒ 页内也是布局驱动 ✓）
        //   padY 12：页签头与页内容之间留一口气（原先 0 ⇒ 按钮行紧贴「下载 / 历史」标签，挤 ✗）
        //   spacing 10：表 / 进度条 / 说明 / 按钮各行之间也松一点 ✓
        var page0 = SDL3.createVBox({padX: 0, padY: 12, spacing: 10})

        // 重置本轮状态
        closing = false
        started = false
        paused = false
        finished = false
        cancelling = false
        wantStart = false
        done = 0
        fail = 0
        lrc = 0
        status = []
        got = []
        exp = []
        paths = []
        orphan = []                  // 上一批"被清空"留下的线程（新窗口实例本来也是空的 ✓ 写在这里防漏 ✓）
        int totalExp = 0
        Array[Array[string]] rows = []
        for jobs to j {
            int e = _int(j[eng.F_BYTES])
            if e <= 0 { e = 1 }
            got.add(0)
            exp.add(e)
            status.add("等待中")
            paths.add("")        // 落盘路径：start 消息到了就填 ✓（失败/取消时也能记下"半截文件在哪"）
            totalExp = totalExp + e
            // "只下歌词"模式：格式/大小那两列没有意义 ⇒ 显示 "-"（歌词约几十 KB，不值得标）
            // 进度列写**数值**（progress 单元格把该列文本当数值 ⇒ 别写"37%"以外的花活也行 ✓）
            rows.add([eng.songlabel(j), if lyriconly then "-" else j[eng.F_EXT], if lyriconly then "-" else j[eng.F_SIZETEXT], "0", "等待中"])
        }

        table = SDL3.createTable({
            headers: ["歌曲", "格式", "大小", "进度", "状态"],
            // 列宽合计 = **824**（页内容区实宽 828 ⇒ 留 4px 余量 ✓ 同历史表口径）
            //   进度列放宽：要装下"条 + 百分比" ✓；状态列居中（与"大小"右对齐分得开 ✓）
            col_widths: [360.0, 64.0, 96.0, 104.0, 200.0],
            aligns: [0, 1, 2, 1, 1],
            header_aligns: [0, 1, 2, 1, 1],
            zebra: true, row_h: 26, header_h: 28, font_size: 13,
            sortable: false, col_reorder: false, resizable: false,
            empty_text: "还没有任务 —— 勾选歌曲后点「下载勾选」",
            // ★ 进度列 = **真进度条**（2026-10-07）：原先这列只能把进度写成文字"37%" ✗
            //   观感与下面那条总进度条**同源**（都出 sdl_progress.drawBar ✓）⇒ 不会一大一小两种样式
            cell_types: ["", "", "", "progress", ""],
            // ★ 每行前面挂个小音符（与主界面同款 ✓）：`image_path` = 图标列**默认图标**
            //   ⇒ 一次给、换数据也不掉 ✓（不必逐行 set_row_image ✗ 见 sdl_table 的 imgDefault ✓）
            image_col: 0, image_size: 16, image_gap: 6,
            image_path: dirs.join(dirs.join(dirs.res_dir(), "images"), "music.png")
        })
        table.set_rows(rows)
        // ★ 任务表右键菜单（2026-10-08 ✓ 用户反馈"下载里面也没有菜单" ✓）：
        //   针对**某一行**的操作（重试这一首 / 复制文件名 / 打开目录 ✓）—— 原先只有底下那排
        //   全局按钮，"这一首失败了想再下一次"只能整批重来 ✗
        table.on_context_will_open(func(int row) { buildMenu(row) })
        table.on_context_select(func(int row, string id) { onMenu(row, id) })
        table.get_context_menu().set_image_size(18)      // 菜单项图标尺寸（与主界面同一口径 ✓）
        page0.add(table, {grow: 1, shrink: 1, align: 3})

        bar = SDL3.createProgressBar({h: 16, show_text: true, font_size: 12})
        bar.set_value(0.0)
        page0.add(bar, {grow: 0, shrink: 0, align: 3})

        string infotext = ""
        string stattext = "下载中会实时显示每一首的进度；暂停/取消随时可用"
        if jobs.len() == 0 {
            // ★ 空任务（2026-10-09 ✓）：主界面那个下载图标现在**没勾选也开窗** ⇒ 空任务是它的**正常长相**，
            //   得把"怎么往里加任务"说清楚（表格那行空文案 + 这两句 ✓）
            infotext = "还没有任务 —— 回结果表勾选歌曲（或右键某一行「下载这一首」），再点「下载勾选」"
            stattext = "「历史」页签里是以前下载过的记录（可复制文件名 / 定位文件 / 删记录 / 清空）"
        } else {
            // 并行度走引擎那一处口径（任务少就少开 ✓，上限来自**设置** ✓）—— 顺带让用户看得见"是并行在下" ✓
            int nw = eng.dl_workers(jobs.len(), maxw)
            infotext = "共 " + _str(jobs.len()) + " 首"
            if nw > 1 { infotext = infotext + "，" + _str(nw) + " 个线程并行下" }
            if lyriconly {
                infotext = infotext + "，点「开始下载歌词」开始（只抓 .lrc，不碰音频）"
            } else {
                infotext = infotext + "，点「开始下载」开始（合计约 " + strings.fmt_size(totalExp) + "）"
                if hasflag(flags, "lyric") { infotext = infotext + "，并顺带下载歌词" }
            }
        }
        info = SDL3.dialogLabel(infotext, 12)
        page0.add(info, {grow: 0, shrink: 0, align: 0})
        stat = SDL3.dialogLabel(stattext, 12)
        page0.add(stat, {grow: 0, shrink: 0, align: 0})

        startBtn = SDL3.createButton({w: 130, h: 32, text: (if lyriconly then "开始下载歌词" else "开始下载"), type: "primary", font_size: 13})
        pauseBtn = SDL3.createButton({w: 90, h: 32, text: "暂停", type: "dark", font_size: 13})
        cancelBtn = SDL3.createButton({w: 90, h: 32, text: "取消", type: "dark", font_size: 13})
        // ★ 「清空」按钮（2026-10-09，用户口径）：把**任务表整表**清掉 —— 已完成的、以及**正在下载的**
        //   都能删；有下载在跑时**先提示**（确认框里说清"会取消它们"⇒ 见 askClearTasks ✓）
        //   ⚠ 与「取消」不同：取消只停下载、行还留着（状态写"已取消"✓）；清空是把行也抹掉 ✓
        clearBtn = SDL3.createButton({w: 96, h: 32, text: "清空", type: "dark", font_size: 13})
        clearBtn.set_tip("清空任务列表（含正在下载的 —— 会先取消它们；**不动**已下载的文件）")
        openBtn = SDL3.createButton({w: 110, h: 32, text: "打开目录", type: "dark", font_size: 13})
        closeBtn = SDL3.createButton({w: 90, h: 32, text: "关闭", type: "dark", font_size: 13})
        pauseBtn.set_enabled(false)
        cancelBtn.set_enabled(false)
        clearBtn.set_enabled(jobs.len() > 0)     // 空表没什么可清 ⇒ 灰着（点不动 ≠ 点了没反应 ✓）
        if jobs.len() == 0 {
            // 空任务（正常走不到：主界面两个入口都先检查 jobs.len() ✓）—— 但真到了也别让"开始"点了没反应 ✗
            startBtn.set_enabled(false)
        }
        page0.add(SDL3.dialogButtonRow([startBtn, pauseBtn, cancelBtn, clearBtn, openBtn, closeBtn], 10), {grow: 0, shrink: 0, align: 3})

        // ---- 页签：0 = 下载（上面那整套）/ 1 = 历史（见 buildHistoryPage ✓）----
        tabs = SDL3.createTabControl({x: 0, y: 0, w: dw - 32, h: dh - 30, tabs: ["下载", "历史"], active: 0,
                                      show_header: true, border: false, bg_color: #F5F6F8FF})
        tabs.setPageLayout(0, page0)
        tabs.setPageLayout(1, buildHistoryPage())
        droot.add(tabs, {grow: 1, shrink: 1, align: 3})

        startBtn.on_click(func() {
            if started { return }
            started = true
            finished = false
            cancelling = false
            paused = false
            done = 0
            fail = 0
            setRunningUi(true)          // 统一口径：开始 ⇒ 灰掉「开始」、亮起「暂停/取消」✓
            stat.set_text("开始下载…")
            // ⚠ 这里**不起线程**：threads.start 与其 worker 入口必须同一个文件（见文件头 ⚠）
            //   ⇒ 只置意图，主界面在定时器里起线程、再把 Thread/Channel 用 attach() 交回来 ✓
            wantStart = true
            SDL3.markFrameRedraw()
        })
        pauseBtn.on_click(func() {
            if not started or finished { return }
            if paused {
                // 继续：**每个** worker 都挂在各自命令通道的 receive 上 ⇒ 得人人发一条才都继续 ✓
                paused = false
                pauseBtn.set_text("暂停")
                sendcmd("resume")
                stat.set_text("已继续")
            } else {
                paused = true
                pauseBtn.set_text("继续")
                sendcmd("pause")
                stat.set_text("已暂停（当前分片下完后停在原处，可继续）")
            }
            SDL3.markFrameRedraw()
        })
        cancelBtn.on_click(func() {
            if not started or finished { return }
            cancelling = true
            sendcmd("cancel")
            stat.set_text("正在取消…")
            SDL3.markFrameRedraw()
        })
        clearBtn.on_click(func() { askClearTasks() })
        openBtn.on_click(func() {
            if not openfolder(outdir) {
                stat.set_text("打开目录失败：" + outdir)
            }
        })
        closeBtn.on_click(func() { close() })
        // 标题栏 ✕ 必须自己接（TitleBar 只置 closeRequested ✓）
        tb.on_close(func() { close() })

        // ★ `dlg.run`（**不是** `runModal`）：只 registerOnly —— 主循环已在跑 ⇒ 立即返回、不阻塞 ✓
        //   回调返回 false ⇒ 主循环只销毁**这一个**窗口（其余窗口继续跑 ✓ 见 sdl_window 的收尾段）
        dlg.run(
            func(Event ev): bool {
                if ev.isQuit() { return false }
                if ev.isWindowClose() { close(); return false }
                if ev.isKeyDown() and ev.scancode() == Scancode.ESCAPE { close(); return false }
                if closing { return false }
                return true
            },
            func(Renderer r) { SDL3.dialogFramePaint(r, dw, tbH + dh) }
        )
        // ⚠ `open` 放在**控件都建好之后**：tick() 的总开关就是它（早置会让 tick 摸到空控件 ✗）
        open = true
        SDL3.markFrameRedraw()
    }

    // 把窗口提到前台（"已经开着时再点一次入口"就靠它 ✓）
    //   ⚠ 只在 `dlg.ok` 时才碰 SDL：纯逻辑单测可以 `new` 一个**没建过窗口**的 DlWindow ✓
    func bringToFront() {
        if dlg.ok { dlg.raise() }
    }

    // 主界面起好线程/通道后交回本窗口（语言硬约束的接口，见文件头 ⚠）
    func attach(Array[Thread] ts, Channel msgch, Array[Channel] cmdchs) {
        threads = ts
        ch = msgch
        cmds = cmdchs
    }

    // 把一条命令发给**每个** worker（多 worker 各有一条命令通道 ⇒ 少发一个它就不动 ✗）
    func sendcmd(string what) {
        for cmds to c {
            if c is Channel { c.try_send(what) }
        }
    }

    // 关闭窗口：还在下就补发取消（worker 会自己退出），然后让事件处理器返回 false
    func close() {
        if started and not finished {
            sendcmd("cancel")
        }
        open = false
        closing = true
        SDL3.markFrameRedraw()
    }

    // 排空下载通道 + 刷新控件（主界面每 120ms 调一次 ✓）
    func tick() {
        if not open { return }
        // ★ 「清空」遗留的线程（见 clearstate 的注释）：谁停了就 join 掉；收干净后连通道一起收 ✓
        //   ⚠ 不 join 会让线程句柄一直挂着（清空是"不要结果"，但不是"可以不管资源" ✗）
        if orphan.len() > 0 {
            int orphanErrors = 0          // 被取消的 worker 退出时多半会带异常 ⇒ 只计数不打扰用户 ✓
            Array[Thread] keep = []
            for orphan to t {
                if t is Thread {
                    if t.state() == "running" {
                        keep.add(t)
                    } else {
                        try {
                            t.join()
                        } catch e {
                            // 这一轮已经作废 ⇒ 返回值/异常都不再关心（异常多半就是"取消"引起的 ✓）
                            // ⚠ 语言不允许空 catch（会静默吞异常 ✗）⇒ 记个数；这里既不显示也不上报 ✓
                            orphanErrors = orphanErrors + 1
                        }
                    }
                }
            }
            orphan = keep
            if orphan.len() == 0 {
                if ch is Channel { ch.close() }
                ch = null
                cmds = []
            }
        }
        if ch is Channel {
            var m = ch.try_receive()
            int n = 0
            while m != null and n < 4000 {
                if m is Array => mv { applymsg(mv) }
                m = ch.try_receive()
                n = n + 1
            }
        }
        refresh()
        // 收尾：**所有** worker 都结束、且通道排空 ⇒ 逐个 join 取权威结果（写法照 文件搜索 ✓）
        if started and not finished {
            int running = 0
            for threads to t {
                if t is Thread {
                    if t.state() == "running" { running = running + 1 }
                }
            }
            if running > 0 { return }
            if ch is Channel {
                if ch.len() > 0 { return }
            }
            finished = true
            int okSum = 0
            int failSum = 0
            int lrcSum = 0
            string errtext = ""
            for threads to t {
                if t is Thread {
                    try {
                        var r = t.join() as Array[string]
                        if r != null and r.len() >= 3 {
                            okSum = okSum + _int(r[0])
                            failSum = failSum + _int(r[1])
                            lrcSum = lrcSum + _int(r[2])
                        }
                    } catch e {
                        // 某个 worker 异常：按"一条失败"计，但仍然把原因露出来（别整段吞掉 ✓）
                        failSum = failSum + 1
                        if errtext == "" { errtext = eng.errmsg(e) }
                    }
                }
            }
            threads = []
            string sum = "成功 " + _str(okSum) + " 首，失败 " + _str(failSum) + " 首，歌词 " + _str(lrcSum) + " 首"
            if errtext != "" { sum = sum + "（线程异常：" + errtext + "）" }
            if ch is Channel { ch.close() }
            ch = null
            cmds = []
            bar.set_value(100.0)
            if cancelling {
                stat.set_text("已取消：" + sum + "（已下完的文件保留在 " + outdir + "）")
            } else {
                stat.set_text("下载结束：" + sum + "（文件在 " + outdir + "）")
            }
            info.set_text("全部任务已处理完，可「打开目录」查看")
            // 主界面状态栏也回一句（窗口一关就只剩它了 ⇒ 别让结果随窗口消失 ✓）
            if hostLbl is Label { hostLbl.set_text("下载结束：" + sum) }
            setRunningUi(false)          // 结束后「开始」重新可用（想整批再来一次也行 ✓ 配合右键重试 ✓）
            SDL3.markFrameRedraw()
        }
    }

    // 一条进度消息 → 状态数组（消息格式见 dl_engine 头部 ✓）
    func applymsg(Array mv) {
        string kind = _str(mv[0])
        int idx = _int(mv[1])
        if kind == "resolve" {
            setstatus(idx, "取直链…")
        } else if kind == "start" {
            setstatus(idx, "下载中…")
            int e = _int(mv[3])
            if e > 0 and idx >= 0 and idx < exp.len() { exp[idx] = e }
            // 落盘路径（消息第 5 段 ✓ 见 dl_engine 的 start/done 两条）先缓存起来 ⇒ 失败也能记下它 ✓
            if idx >= 0 and idx < paths.len() { paths[idx] = _str(mv[4]) }
            if idx >= 0 and idx < jobs.len() {
                info.set_text("正在下载：" + eng.songlabel(jobs[idx]))
            }
        } else if kind == "progress" {
            if idx >= 0 and idx < got.len() {
                got[idx] = _int(mv[2])
                int tot = _int(mv[3])
                if tot > 0 { exp[idx] = tot }
            }
        } else if kind == "lyric" {
            // 歌词落盘：字节数单独记，状态行补一句（音频状态在前，歌词在后 ✓）
            int lb = _int(mv[2])
            lrc = lrc + 1
            string cur = ""
            if idx >= 0 and idx < status.len() { cur = status[idx] }
            if cur == "等待中" or cur == "下载中…" {
                setstatus(idx, "歌词 " + strings.fmt_size(lb))
            } else {
                setstatus(idx, cur + " +歌词")
            }
        } else if kind == "done" {
            int gotb = _int(mv[2])
            if idx >= 0 and idx < got.len() { got[idx] = gotb }
            setstatus(idx, "完成 " + strings.fmt_size(gotb))
            done = done + 1
            // 落盘路径优先取消息里的（权威 ✓）；消息没带就退回 start 时缓存的
            string outp = _str(mv[4])
            if outp == "" and idx >= 0 and idx < paths.len() { outp = paths[idx] }
            notehistory(idx, "完成", outp, gotb)      // ★ 记历史（终态才记 ✓ 见 notehistory）
        } else if kind == "fail" {
            setstatus(idx, "失败：" + _str(mv[4]))
            fail = fail + 1
            string fp = ""
            if idx >= 0 and idx < paths.len() { fp = paths[idx] }
            notehistory(idx, "失败：" + _str(mv[4]), fp, -1)
        } else if kind == "cancelled" {
            setstatus(idx, "已取消")
            info.set_text("已取消剩余任务（已下完的文件保留）")
            string cp = ""
            if idx >= 0 and idx < paths.len() { cp = paths[idx] }
            notehistory(idx, "已取消", cp, -1)
        } else if kind == "fatal" {
            stat.set_text("下载器出错：" + _str(mv[4]))
        }
    }

    func setstatus(int idx, string text) {
        if idx >= 0 and idx < status.len() { status[idx] = text }
    }

    // ==================== ★ 「历史」页签（2026-10-09）====================
    //   · 记录存在 %APPDATA%\LenoMusicDl\history.json —— 纯逻辑在 dl_history.leno（可单测 ✓）
    //   · 本页就三件事：表格 + 右键（复制 / 定位 / 删这一条）+ 工具行（刷新 / 清空 / 打开目录）
    //   · 表格行与 `histItems` **一一对应**（右键按行号取记录 ✓；过滤/排序一律不开 ✗ 免得错位）

    func buildHistoryPage(): VBox {
        // 口径与下载页一致：padY 12（页签头与工具行拉开）/ spacing 10 ✓
        var page = SDL3.createVBox({padX: 0, padY: 12, spacing: 10})

        // 工具行：按钮**同高同距**（30/8 太挤 ⇒ 32/10），宽度按文字长短给（96 / 116 / 116 ✓）
        var row = SDL3.createHBox({h: 32, padX: 0, padY: 0, spacing: 10})
        Button refreshBtn = SDL3.createButton({w: 96, h: 32, text: "刷新", type: "dark", font_size: 13})
        refreshBtn.set_tip("重新从磁盘读一遍历史（在别处改过文件时用）")
        refreshBtn.on_click(func() { reloadHistory(); SDL3.markFrameRedraw() })
        row.add(refreshBtn, {grow: 0, shrink: 0, basis: 96, align: 3})

        Button clearBtn = SDL3.createButton({w: 116, h: 32, text: "清空历史", type: "dark", font_size: 13})
        clearBtn.set_tip("删掉全部历史记录（**不动**已经下载好的文件）")
        clearBtn.on_click(func() { askClearHistory() })
        row.add(clearBtn, {grow: 0, shrink: 0, basis: 116, align: 3})

        Button openDirBtn = SDL3.createButton({w: 116, h: 32, text: "打开目录", type: "dark", font_size: 13})
        openDirBtn.set_tip("打开下载目录（历史里的文件都在那儿）")
        openDirBtn.on_click(func() { if not openfolder(outdir) { stat.set_text("打开目录失败：" + outdir) } })
        row.add(openDirBtn, {grow: 0, shrink: 0, basis: 116, align: 3})

        row.add(SDL3.createLabel({text: ""}), {grow: 1, shrink: 0, align: 1})
        page.add(row, {grow: 0, shrink: 0, align: 3})

        // 5 列：注意「完成时间」是**格式化后的文本**（记录里存的是 Unix 秒 ⇒ 见 hist.htime_text ✓）
        // 列宽合计 = **824**，页内容区实宽 = 窗口 860 − 根容器 padX 16×2 − 页签 0 = **828**
        //   ⇒ 留 4px 余量：既铺满（旧账 300+60+90+218+130 = 798 ⇒ 右侧空 30px 一条灰带 ✗）又不出横向滚动条 ✓
        //   ⚠ 旧账还有一处观感问题：「大小」右对齐、「状态」左对齐，两者**紧贴** ⇒ 看着像同一列 ✗
        //     ⇒ 现在「状态」改**居中**、宽度收到 134 ⇒ 与「大小」之间有明确分界 ✓
        histTable = SDL3.createTable({
            headers: ["歌曲", "格式", "大小", "状态", "完成时间"],
            col_widths: [380.0, 64.0, 96.0, 134.0, 150.0],
            aligns: [0, 1, 2, 1, 1],
            header_aligns: [0, 1, 2, 1, 1],
            zebra: true, row_h: 26, header_h: 28, font_size: 13,
            sortable: false, col_reorder: false, resizable: false,
            empty_text: "还没有下载记录 —— 下完一首就会自动记在这儿"
        })
        histTable.on_context_will_open(func(int r) { buildHistMenu(r) })
        histTable.on_context_select(func(int r, string id) { onHistMenu(r, id) })
        histTable.get_context_menu().set_image_size(18)
        page.add(histTable, {grow: 1, shrink: 1, align: 3})

        //   ⚠ 不要再给 `truncate:1 + max_w`（2026-10-09 实测）：那组合让 Label 的盒子只剩几十像素宽
        //     ⇒ 页面底部会显示成"共 0 记…" ✗（这行文本长度本来就固定、约 400px）⇒ 自然展开最省事 ✓
        histLbl = SDL3.createLabel({text: "正在读历史…", font_size: 12})
        page.add(histLbl, {grow: 0, shrink: 0, align: 1})

        reloadHistory()          // 建页时先读一次（窗口每次打开都是最新的 ✓）
        return page
    }

    // 从磁盘重读 + 重刷表格
    func reloadHistory() {
        histItems = hist.load()
        Array[Array[string]] rows = []
        for histItems to r {
            rows.add([hist.hlabel(r), hist.hext(r), hist.hsize(r), hist.hstatus(r), hist.htime_text(r)])
        }
        histTable.set_rows(rows)
        histLbl.set_text("共 " + _str(histItems.len()) + " 条记录（新的在前；右键某行可复制 / 定位 / 删这一条）")
    }

    // 记一条历史（每首任务到**终态**时调一次：完成 / 失败 / 已取消 ✓ —— 中间态不记）
    //   ⚠ 每次追加都**重读并重刷表**：一条记录只有几十字节 ⇒ 这点 IO 可忽略，
    //     换来"历史页永远是最新的"（省掉一套脏标记 ✓）
    func notehistory(int idx, string statusText, string path, int bytes) {
        if idx < 0 or idx >= jobs.len() { return }
        string label = eng.songlabel(jobs[idx])
        string ext = ""
        if lyriconly {
            ext = "lrc"
        } else if jobs[idx].len() > eng.F_EXT {
            ext = jobs[idx][eng.F_EXT]
        }
        string size = "-"
        if bytes > 0 { size = strings.fmt_size(bytes) }
        Array[Array[string]] one = [hist.mkrow(label, ext, size, statusText, path, times.now())]
        hist.append(one)
        reloadHistory()
    }

    // 清空历史：**先问一句**（不可撤销，但对已下载文件没有任何影响 ✓）
    func askClearHistory() {
        if histItems.len() == 0 {
            stat.set_text("历史本来就是空的")
            SDL3.markFrameRedraw()
            return
        }
        SDL3.msgBox("清空下载历史", [
            "会删掉全部 " + _str(histItems.len()) + " 条记录。",
            "已经下载好的文件**不受影响**（历史只是个记录本）"
        ], "清空", "取消", true, func() {
            if hist.clear() {
                reloadHistory()
                stat.set_text("历史已清空（文件没动）")
            } else {
                stat.set_text("清空失败：历史文件不可写？")
            }
            SDL3.markFrameRedraw()
        })
    }

    func buildHistMenu(int r) {
        histTable.clearContextItems()
        if r < 0 or r >= histItems.len() { return }
        histTable.addContextItem({label: "复制文件名", id: "hcopy", image: wicon("copyname.png")})
        bool hasFile = hist.hpath(histItems[r]) != ""
        histTable.addContextItem({label: "在资源管理器里定位", id: "hreveal", image: wicon("open_folder.png")})
        histTable.setContextItemEnabled("hreveal", hasFile)   // 失败/取消的记录没有文件 ⇒ 置灰 ✓
        histTable.addContextSeparator()
        histTable.addContextItem({label: "删除这一条记录", id: "hdel", image: wicon("delete_file.png")})
    }

    func onHistMenu(int r, string id) {
        if r < 0 or r >= histItems.len() { return }
        Array[string] rec = histItems[r]
        if id == "hcopy" {
            string nm = hist.hlabel(rec)
            string e = hist.hext(rec)
            if e != "" { nm = nm + "." + e }
            SDL3.setClipboardText(nm)
            stat.set_text("已复制文件名：" + nm)
            SDL3.markFrameRedraw()
            return
        }
        if id == "hreveal" {
            string p = hist.hpath(rec)
            if not reveal(p) { stat.set_text("找不到这个文件：" + p) }
            return
        }
        if id == "hdel" {
            if hist.remove_at(r) {
                reloadHistory()
                stat.set_text("已删除 1 条历史记录")
            } else {
                stat.set_text("删除失败（历史文件不可写？）")
            }
            SDL3.markFrameRedraw()
            return
        }
    }

    // ==================== 任务表右键菜单（2026-10-08 ✓）====================
    //   用户原话："下载里面也没有菜单" ✓ —— 底下那排按钮都是**全局**的（开始/暂停/取消/打开/关闭 ✗）
    //   ⇒ 针对**某一行**什么也做不了：失败了想单独再下一次、想复制文件名都得自己找 ✗
    //   现在给任务表挂上：重试这一首 / 重试全部失败项 / 复制文件名 / 打开下载目录 ✓
    // 菜单项图标路径（文件名见 images/*.png ✓ 同主界面的 micon ✓）
    //   ⚠ 键是 `image`（不是 `icon` ✗）；尺寸在表创建处统一 `set_image_size(18)` ✓
    func wicon(string file): string {
        return dirs.join(dirs.join(dirs.res_dir(), "images"), file)
    }

    func buildMenu(int row) {
        table.clearContextItems()
        bool failedRow = false
        if row >= 0 and row < status.len() {
            string st = status[row]
            if strings.has(st, "失败") or strings.has(st, "取消") { failedRow = true }
        }
        if row >= 0 {
            // 「重试」用下载箭头图标（语义就是"再下一次" ✓）；「复制文件名」用用户给的 copyname ✓
            table.addContextItem({label: "重试这一首", id: "retryrow", image: wicon("download_arrow.png")})
            // ⚠ 只能在"上一轮已结束"时重试（见 queueRetry 的注释 ✓）；且"完成"的行没什么好重试的
            table.setContextItemEnabled("retryrow", failedRow and started and finished)
            table.addContextItem({label: "重试全部失败项", id: "retryfail", image: wicon("download_arrow.png")})
            table.setContextItemEnabled("retryfail", hasFailed() and started and finished)
            table.addContextSeparator()
            table.addContextItem({label: "复制文件名", id: "copyrow", image: wicon("copyname.png")})
            table.addContextItem({label: "打开下载目录", id: "openfolder", image: wicon("open_folder.png")})
        }
    }

    // 还有"失败/取消"的任务吗（决定「重试全部失败项」能不能点 ✓）
    func hasFailed(): bool {
        for status.len() to i {
            if strings.has(status[i], "失败") or strings.has(status[i], "取消") { return true }
        }
        return false
    }

    func onMenu(int row, string id) {
        if id == "copyrow" {
            if row < 0 or row >= jobs.len() { return }
            string nm = eng.songlabel(jobs[row])
            if not lyriconly and jobs[row].len() > eng.F_EXT and jobs[row][eng.F_EXT] != "" {
                nm = nm + "." + jobs[row][eng.F_EXT]      // 落盘时就是这个名（见 dl_engine 的命名 ✓）
            }
            SDL3.setClipboardText(nm)
            stat.set_text("已复制文件名：" + nm)
            SDL3.markFrameRedraw()
            return
        }
        if id == "openfolder" {
            if not openfolder(outdir) { stat.set_text("打开目录失败：" + outdir) }
            return
        }
        if id == "retryrow" { queueRetry([row]); return }
        if id == "retryfail" {
            Array[int] idxs = []
            for status.len() to i {
                if strings.has(status[i], "失败") or strings.has(status[i], "取消") { idxs.add(i) }
            }
            queueRetry(idxs)
            return
        }
    }

    // 排队重试：把那些行拨回「等待中」、进度清零，并置 `retryList` ⇒ 主界面在定时器里起线程 ✓
    //   ⚠ 只允许"上一轮已结束"时重试 ✗：主界面重试时会 `attach()`，而 attach 是**整体替换**
    //     threads/cmds —— 若还有 worker 在跑，它们就被顶掉且没人 join/收尾 ✗（菜单里那两项也据此置灰 ✓）
    func queueRetry(Array[int] idxs) {
        if idxs.len() == 0 { return }
        if not finished {
            stat.set_text("先等这一轮跑完再重试（免得把正在跑的线程顶掉）")
            SDL3.markFrameRedraw()
            return
        }
        for idxs to r {                      // ⚠ `for 数组 to r` 拿到的是**元素** ✓（这里元素就是下标 ✓）
            if r >= 0 and r < status.len() { status[r] = "等待中" }
            if r >= 0 and r < got.len() { got[r] = 0 }
        }
        retryList = idxs
        started = true
        finished = false
        cancelling = false
        paused = false
        setRunningUi(true)
        info.set_text("准备重试 " + _str(idxs.len()) + " 首…")
        stat.set_text("正在重试 " + _str(idxs.len()) + " 首")
        SDL3.markFrameRedraw()
    }

    // 运行态下的按钮可用性（开始 ⇄ 暂停/取消 ✓）—— 开始、重试、结束都走这一个口径 ✓
    func setRunningUi(bool running) {
        startBtn.set_enabled(not running and jobs.len() > 0)
        pauseBtn.set_enabled(running)
        cancelBtn.set_enabled(running)
        clearBtn.set_enabled(jobs.len() > 0)     // 有行才可清（空表 ⇒ 灰 ✓ 与"点了没反应"划清界限 ✓）
        if not running { pauseBtn.set_text("暂停") }
    }

    // ==================== ★ 任务表「清空」（2026-10-09）====================
    // 用户口径原话："清空可以删除【已完成】和【下载中】的，但清空前要提示当前有下载" ✓
    //   · 有 worker 在跑 ⇒ 确认框第一句就点明"还有 N 首未完成，清空会取消它们" ✓
    //   · 已经下好的文件**一律不动**（与历史页「清空历史」同一口径 ✓ 见 askClearHistory）
    //   · 清空只动**本窗口的任务表**；历史页那些记录还在（已经落盘了 ✓）

    func askClearTasks() {
        if jobs.len() == 0 {
            stat.set_text("任务列表本来就是空的")
            SDL3.markFrameRedraw()
            return
        }
        int pending = 0
        for status to s {
            if not istaskdone(s) { pending = pending + 1 }
        }
        bool busy = started and not finished
        Array[string] lines = []
        if busy {
            lines.add("⚠ 当前还有下载在跑（" + _str(pending) + " 首未完成）—— 清空会**取消**它们。")
            lines.add("已经下完的部分文件会保留在磁盘上（不删除、不回退）。")
        } else {
            lines.add("列表里 " + _str(jobs.len()) + " 条任务会从表里移除。")
            lines.add("已经下载好的文件**不受影响**（「历史」页签里仍能查到这些记录）。")
        }
        SDL3.msgBox("清空任务列表", lines, "清空", "取消", true, func() { doClearTasks() })
    }

    // 状态是不是**终态**（完成 / 失败 / 已取消）—— 关键词与 refresh 里那套保持同一口径 ✓
    func istaskdone(string s): bool {
        if strings.has(s, "完成") { return true }
        if strings.has(s, "失败") { return true }
        if strings.has(s, "取消") { return true }
        return false
    }

    // 清空（确认后走这里）：数据先归零，再刷控件
    func doClearTasks() {
        bool busy = clearstate()
        table.set_rows([])
        bar.set_value(0.0)
        setRunningUi(false)                       // 「清空」自身这时也会变灰（jobs 已空 ✓ 见 setRunningUi）
        if busy {
            info.set_text("已清空任务列表 —— 正在下载的已取消（已下完的文件保留在 " + outdir + "）")
        } else {
            info.set_text("已清空任务列表（已下载的文件保留在 " + outdir + "）")
        }
        stat.set_text("任务列表已清空 —— 「历史」页签里仍能查到以前的记录")
        SDL3.markFrameRedraw()
    }

    // 清空里的**纯逻辑**部分（不碰任何控件 ⇒ 没建窗口也能单测 ✓ 见 test/test_dl_window_open.leno）
    //   返回"清空前是不是还在下载"（调用方据此选提示语 ✓）
    //   ⚠ 还在跑时：先 `sendcmd("cancel")` 让 worker 自己退出，再把它们挪进 `orphan`（tick 负责 join ✓）
    //     —— 为什么不用现成那套收尾：那套会等 join、还会回写"下载结束：成功 x 首" ✗
    //     （表都清了，用户不想再看这一轮的结果 ✓）
    func clearstate(): bool {
        bool busy = started and not finished
        if busy {
            cancelling = true
            sendcmd("cancel")
            for threads to t {
                if t is Thread { orphan.add(t) }
            }
        }
        threads = []
        started = false
        finished = false
        paused = false
        cancelling = false
        wantStart = false            // ⚠ 主界面看的就是它 ⇒ 不复位会立刻又起一轮（刚清空就被填回来 ✗）
        retryList = []               // 重试下标同理（不清就会去起线程下那些已删掉的行 ✗）
        done = 0
        fail = 0
        lrc = 0
        jobs = []
        status = []
        got = []
        exp = []
        paths = []
        return busy
    }

    // 刷新任务表 + 总进度条（每 120ms 一次）
    // 两种口径：正常下载按**字节**加权；"只下歌词"没有分片进度 ⇒ 按**任务条数**推进
    func refresh() {
        int gotb = 0
        int expb = 0
        int ndone = 0
        int i = 0
        while i < jobs.len() {
            int g = 0
            int e = 1
            if i < got.len() { g = got[i] }
            if i < exp.len() and exp[i] > 0 { e = exp[i] }
            gotb = gotb + g
            expb = expb + e
            bool finishedOne = false
            if i < status.len() and (strings.has(status[i], "完成") or strings.has(status[i], "歌词") or strings.has(status[i], "失败") or strings.has(status[i], "取消")) {
                finishedOne = true
            }
            if finishedOne { ndone = ndone + 1 }
            int pct = 0
            if lyriconly {
                if finishedOne { pct = 100 }
            } else {
                pct = g * 100 / e
                if pct > 100 { pct = 100 }
            }
            // 进度列是 progress 单元格：写**数值**就行（"37" 当百分数、"0.37" 当比例，都认 ✓
            //   解析规则见 sdl_progress.parseProgress —— 它把非数字（如"等待中"）当 0，不抛错 ✓）
            table.set_cell(i, 3, _str(pct))
            if i < status.len() { table.set_cell(i, 4, status[i]) }
            i = i + 1
        }
        float v = 0.0
        if lyriconly {
            if jobs.len() > 0 { v = 100.0 * _float(ndone) / _float(jobs.len()) }
        } else if expb > 0 {
            v = 100.0 * _float(gotb) / _float(expb)
        }
        if v > 100.0 { v = 100.0 }
        bar.set_value(v)
    }
}

// 打开下载窗口：构建 UI、进模态、返回窗口实例（调用方持有它，每 120ms 调 tick() ✓）
//   jobs / flags 由主界面判定好再传进来（本模块不碰"选哪些歌"的策略 ✓）
//   hostLbl     = 主界面状态栏：下载结束时回写一句（窗口关掉后结果仍看得见 ✓）
//   maxworkers  = 并行线程数上限（来自**设置**，见 dl_settings.leno ✓）
export func open_download(Array[Array[string]] jobs, Array[string] flags, string outdir, Label hostLbl, int maxworkers): DlWindow {
    DlWindow w = new DlWindow()
    w.jobs = jobs
    w.flags = flags
    w.outdir = outdir
    w.hostLbl = hostLbl
    w.maxw = maxworkers
    w.lyriconly = hasflag(flags, "lyriconly")
    w.build()
    return w
}

// ==================== 防重复打开（2026-10-07 改非模态后必须 ✓）====================
// 已经开着 ⇒ **置前并返回 true**；调用方据此"不再开第二个" ✓
//   为什么现在必须有：模态时主窗口根本收不到事件（点不动）⇒ 点不出第二个框；
//   改非模态后主窗口能继续点，而 `open_download` 每次都 `new` 一个新窗口 ⇒ 点两下两个框 ✗
// 归口在这里（而不是主界面各入口各写一遍）：三个入口（勾选 / 选中行 / 只下歌词）共用同一条规则 ✓
//   ⚠ 纯逻辑：`open` 是窗口自己的状态 ⇒ 不建窗口也能单测（test/test_dl_window_open.leno ✓）
//   ⚠ 不比对"模式"：已有窗口在下**歌词**、你点的是**音频** ⇒ 也只置前（那是另一批任务，抢掉更糟 ✗）
//     说明由调用方写进状态栏 ✓
export func reuse_if_open(DlWindow? w): bool {
    if w is DlWindow => p {
        if p.open {
            p.bringToFront()
            return true
        }
    }
    return false
}
